      "_depth": 0
    },
    {
      "name": "failed_reason",
      "in": "body",
      "type": "number",
      "required": false,
      "description": "不通过必传 不通过理由 1 货品成色太差； 2 货品与线索单不一致；  3 货品为假； 4 协商一致退货； 5 其他。",
      "example": "1",
      "_depth": 0
    }
  ],
  "responseParams": [],
