      "example": "11300",
      "_depth": 0
    },
    {
      "name": "consignment_price",
      "in": "body",
      "type": "number",
      "required": false,
      "description": "寄卖价",
      "example": "11300",
      "_depth": 0
    },
    {
      "name": "clue_order_id",
      "in": "body",
      "type": "number",
      "required": true,
      "description": "回收订单ID",
      "example": "123",
      "_depth": 0
    },
    {
      "name": "is_passed",
      "in": "body",
      "type": "number",
      "required": true,
      "description": "是否通过 1: 通过 2:不通过",
