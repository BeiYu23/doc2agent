{
  "id": "doudian.recycle.resale.quote.result",
  "platform": "doudian",
  "group": "recycle",
  "name": "resale.quote.result",
  "description": "服务商质检完成报价/修改报价信息",
  "method": "GET",
  "path": "/resale/quote/result",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
