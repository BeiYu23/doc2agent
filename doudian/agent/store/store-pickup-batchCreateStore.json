{
  "id": "doudian.store.pickup.batchCreateStore",
  "platform": "doudian",
  "group": "store",
  "name": "pickup.batchCreateStore",
  "description": "批量创建门店",
  "method": "GET",
  "path": "/pickup/batchCreateStore",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 店铺"
  },
  "notes": [
    "文档书: 自提门店API（版本 V1.01）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "store_info_list",
      "in": "body",
      "type": "array",
      "required": true,
      "description": "门店信息列表，最大数量100",
      "example": "",
      "_depth": 0
    },
    {
      "name": "announcement",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "门店公告",
      "example": "正常营业",
      "_depth": 1
    },
    {
      "name": "address",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "详细地址",
      "example": "江湾城路95号",
      "_depth": 1
    },
    {
      "name": "contact",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "联系方式",
      "example": "19812122322",
      "_depth": 1
    },
    {
      "name": "district",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "区",
      "example": "杨浦区",
      "_depth": 1
    },
    {
      "name": "province",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "省",
      "example": "上海市",
      "_depth": 1
    },
    {
      "name": "district_code",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "区code",
      "example": "-",
      "_depth": 1
    },
    {
      "name": "city_code",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "城市code",
      "example": "-",
      "_depth": 1
    },
    {
      "name": "street",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "4级地址 街道/镇",
      "example": "-",
      "_depth": 1
    },
    {
      "name": "name",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "门店名称",
      "example": "测试门店4",
      "_depth": 1
    },
    {
      "name": "biz_type",
      "in": "body",
      "type": "mixed",
      "required": true,
      "description": "业务类型 2:到店自提",
      "example": "2",
      "_depth": 1
    },
    {
      "name": "biz_line",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "行业线(燃油场景必填) 0:电动车 1:服饰 2:新车 3:燃油",
      "example": "3",
      "_depth": 1
    },
    {
      "name": "store_code",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "门店编码",
      "example": "A014",
      "_depth": 1
    },
    {
      "name": "open_time",
      "in": "body",
      "type": "object",
      "required": true,
      "description": "营业时间",
      "example": "",
      "_depth": 1
    },
    {
      "name": "custom",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "-",
      "example": "-",
      "_depth": 2
    },
    {
      "name": "day_map",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "1:周一、2:周一、3:周三、4:周四、5:周五、6:周六、7:周日  时间是空格分隔，比如08:30-11:00 13:00-17:00",
      "example": "{\n\"1\": \"08:00-20:00\",\n\"2\": \"08:00-20:00\",\n\"3\": \"08:00-20:00\",\n\"4\": \"08:00-20:00\",\n\"5\": \"08:00-20:00\",\n\"6\": \"08:00-20:00\",\n\"7\": \"08:00-20:00\"\n}",
      "_depth": 2
    },
    {
      "name": "city",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "市",
      "example": "上海市",
      "_depth": 1
    },
    {
      "name": "threshold",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "门店接单阈值",
      "example": "100",
      "_depth": 1
    },
    {
      "name": "province_code",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "省份code",
      "example": "-",
      "_depth": 1
    },
    {
      "name": "street_code",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "4级地址code",
      "example": "-",
      "_depth": 1
    }
  ],
  "responseParams": [
    {
      "name": "data",
      "type": "object",
      "description": "批量创建结果",
      "example": ""
    }
  ],
  "responseCodes": [
    {
      "code": "10000",
      "meaning": "success",
      "action": "正常处理"
    },
    {
      "code": "50002",
      "meaning": "业务处理失败 / -301:Error 1105 (HY000): unexpected EOF（sub_code: isv.business-failed:-301）",
      "action": "请稍后再试",
      "sub_code": "isv.business-failed:-301",
      "sub_msg": "-301:Error 1105 (HY000): unexpected EOF"
    },
    {
      "code": "50002",
      "meaning": "业务处理失败 / -32:提交门店信息异常, 请修改后重试（sub_code: isv.business-failed:-32）",
      "action": "请修改门店信息后再试",
      "sub_code": "isv.business-failed:-32",
      "sub_msg": "-32:提交门店信息异常, 请修改后重试"
    }
  ],
