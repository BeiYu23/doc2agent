{
  "id": "doudian.selection.supplyCenter.order.logistics",
  "platform": "doudian",
  "group": "selection",
  "name": "supplyCenter.order.logistics",
  "description": "精选货源发货状态数据同步",
  "method": "GET",
  "path": "YOUR_SECRET_KEY",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 店铺"
  },
  "notes": [
    "文档书: 精选货源API（版本 V1.01）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "pur_order_id",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "精选货源订单号",
      "example": "123",
      "_depth": 0
    },
    {
      "name": "express_type",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "发货类型 1 整单发货 2 分单发货",
      "example": "1",
      "_depth": 0
    },
    {
      "name": "pack_info",
      "in": "body",
      "type": "object",
      "required": false,
      "description": "分单发货必传",
      "example": "",
      "_depth": 0
    },
    {
      "name": "shipped_pur_sub_orders",
      "in": "body",
      "type": "array",
      "required": false,
      "description": "精选货源子订单号列表",
      "example": "12",
      "_depth": 1
    },
    {
      "name": "express_time",
      "in": "body",
      "type": "number",
      "required": true,
      "description": "发货时间，秒级时间戳",
      "example": "1698146585",
      "_depth": 0
    }
  ],
  "responseParams": [],
  "responseCodes": [
    {
      "code": "10000",
      "meaning": "成功",
      "action": "正常处理"
    }
  ],
  "examples": {
    "request": "curl -X GET 'https://openapi-fxg.jinritemai.YOUR_SECRET_KEY?app_key=your_appkey_here&method=supplyCenter.order.logistics&access_token=your_accesstoken_here&param_json={}&timestamp=2018-06-19%2016:06:59&v=2&sign=your_sign_here'",
    "responseSuccess": {
      "code": 10000,
      "msg": "success",
      "sub_code": "",
      "sub_msg": ""
    },
    "responseError": {
      "sub_code": "",
      "sub_msg": ""
    }
  },
  "source": "https://op.jinritemai.com/docs/api-docs/1438/5321",
