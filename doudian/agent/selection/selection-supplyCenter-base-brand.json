{
  "id": "doudian.selection.supplyCenter.base.brand",
  "platform": "doudian",
  "group": "selection",
  "name": "supplyCenter.base.brand",
  "description": "精选货源获取类目品牌",
  "method": "GET",
  "path": "/supplyCenter/base/brand",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 见平台说明"
  },
  "notes": [
    "文档书: 精选货源API（版本 V1.01）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "category_id",
      "in": "body",
      "type": "number",
      "required": true,
      "description": "类目id",
      "example": "123",
      "_depth": 0
    },
    {
      "name": "query",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "品牌前缀（中文或者英文），适用于不需要品牌资质的场景，根据前缀搜索品牌",
      "example": "wu",
      "_depth": 0
    },
    {
      "name": "brand_ids",
      "in": "body",
      "type": "array",
      "required": false,
      "description": "（选填）品牌ids，传了品牌ids默认直接拿品牌id搜索并返回结果(放在brand_list里)，不会使用其他入参",
      "example": "[123]",
      "_depth": 0
    }
  ],
  "responseParams": [
    {
      "name": "brand_list",
      "type": "array",
      "description": "品牌列表，无关乎授权",
      "example": ""
    }
  ],
  "responseCodes": [
    {
      "code": "10000",
      "meaning": "success",
      "action": "正常处理"
    },
    {
      "code": "40004",
      "meaning": "非法的参数 / 参照品牌接口（sub_code: isv.parameter-invalid:66666）",
      "action": "https://op.jinritemai.com/docs/api-docs/14/1267",
      "sub_code": "isv.parameter-invalid:66666",
      "sub_msg": "参照品牌接口"
    }
  ],
  "examples": {
    "request": "curl -X GET 'https://openapi-fxg.jinritemai.YOUR_SECRET_KEY?app_key=your_appkey_here&method=supplyCenter.base.brand&access_token=your_accesstoken_here&param_json={}&timestamp=2018-06-19%2016:06:59&v=2&sign=your_sign_here'",
    "responseSuccess": {
      "data": {
        "brand_list": [
          {
            "brand_id": "123",
            "name_cn": "中文名",
            "name_en": "xxxx"
          }
        ]
      },
      "code": 10000,
      "msg": "success",
      "sub_code": "",
      "sub_msg": ""
    },
    "responseError": {
      "code": 40004,
      "msg": "非法的参数",
      "sub_code": "isv.parameter-invalid:66666",
      "sub_msg": "参照品牌接口"
    }
  },
  "source": "https://op.jinritemai.com/docs/api-docs/1438/5328",
  "updatedAt": "2023-10-25",
  "_file_stem": "selection-supplyCenter-base-brand",
  "cnName": "精选货源获取类目品牌"
}
