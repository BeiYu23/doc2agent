{
  "id": "doudian.selection.supplyCenter.base.category",
  "cnName": "精选货源获取类目",
  "docUrl": "/docs/doudian/selection/selection-supplyCenter-base-category",
  "name": "supplyCenter.base.category",
  "platform": "doudian",
  "group": "selection",
  "description": "精选货源获取类目",
  "method": "GET",
  "path": "YOUR_SECRET_KEY",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 见平台说明"
  },
  "notes": [
    "文档书: 精选货源API（版本 V1.01）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "cid",
      "in": "body",
      "type": "number",
      "required": true,
      "description": "父类目id，根据父id可以获取子类目。首次请求传值为0 可以获取所有一级类目。循环调用接口获取最小层级类目id，根据响应参数判断is_leaf=true或false。is_leaf=true表示是叶子节点，获取最小层级类目id，is_leaf=false表示不是子节点，请求参数cid=上一次响应参数id，直到获取最小层级类目id。",
      "example": "0",
      "_depth": 0
    }
  ],
  "responseParams": [
    {
      "name": "data",
      "type": "array",
      "description": "返回列表",
      "example": ""
    }
  ],
  "responseCodes": [
    {
      "code": "10000",
      "meaning": "success",
      "action": "正常处理"
    },
    {
      "code": "40004",
      "meaning": "非法的参数 / 参照商品类目接口（sub_code: isv.parameter-invalid:66666）",
      "action": "https://op.jinritemai.com/docs/api-docs/13/1820",
      "sub_code": "isv.parameter-invalid:66666",
      "sub_msg": "参照商品类目接口"
    }
  ],
  "examples": {
    "request": "curl -X GET 'https://openapi-fxg.jinritemai.YOUR_SECRET_KEY?app_key=your_appkey_here&method=supplyCenter.base.category&access_token=your_accesstoken_here&param_json={}&timestamp=2018-06-19%2016:06:59&v=2&sign=your_sign_here'",
    "responseSuccess": {
      "data": {
        "data": [
          {
            "enable": "true",
            "id": "20005",
            "is_leaf": "true",
            "level": "1",
            "name": "女装",
            "parent_id": "20215"
          }
        ]
      },
      "code": 10000,
      "msg": "success",
      "sub_code": "",
      "sub_msg": ""
    },
    "responseError": {
      "code": 40004,
      "msg": "非法的参数",
      "sub_code": "isv.parameter-invalid:66666",
      "sub_msg": "参照商品类目接口"
    }
  },
  "source": "https://op.jinritemai.com/docs/api-docs/1438/5325",
