{
  "id": "doudian.selection.supplyCenter.material.search",
  "cnName": "素材中心--素材搜索",
  "docUrl": "/docs/doudian/selection/selection-supplyCenter-material-search",
  "name": "supplyCenter.material.search",
  "platform": "doudian",
  "group": "selection",
  "description": "素材中心--素材搜索接口",
  "method": "GET",
  "path": "/supplyCenter/material/search",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 见平台说明"
  },
  "notes": [
    "文档书: 精选货源API（版本 V1.01）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "material_id",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "素材id",
      "example": "7000291764753940780",
      "_depth": 0
    },
    {
      "name": "material_name",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "文件名称，支持模糊匹配",
      "example": "模糊匹配",
      "_depth": 0
    },
    {
      "name": "material_type",
      "in": "body",
      "type": "array",
      "required": false,
      "description": "素材类型，空-不限； photo-图片；video-视频；",
      "example": "photo",
      "_depth": 0
    },
    {
      "name": "operate_status",
      "in": "body",
      "type": "array",
      "required": false,
      "description": "素材状态，0-待下载；1-有效；4-回收站中；",
      "example": "[0,1,4]",
      "_depth": 0
    },
    {
      "name": "audit_status",
      "in": "body",
      "type": "array",
      "required": false,
      "description": "审核状态，1-待审核；2-审核中；3-通过 ；4-拒绝；注意：只有AuditStatus=3时ByteUrl才会返回；",
      "example": "[1,2,3,4]",
      "_depth": 0
    },
    {
      "name": "create_time_start",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "搜索创建开始时间，格式：yyyy-MM-dd HH:mm:ss",
      "example": "2022-08-12 12:00:12",
      "_depth": 0
    },
    {
      "name": "create_time_end",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "搜索创建结束时间，格式：yyyy-MM-dd HH:mm:ss",
      "example": "2022-11-12 12:00:12",
      "_depth": 0
    },
    {
      "name": "material_id_list",
      "in": "body",
      "type": "array",
      "required": false,
      "description": "素材id列表",
      "example": "[700029176475394000,700029176475394000]",
      "_depth": 0
    },
    {
      "name": "page_num",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "第几页，1，2，……，默认值：1",
      "example": "1",
      "_depth": 0
    },
    {
      "name": "page_size",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "页大小，1，2，……，100，默认值：50",
      "example": "20",
      "_depth": 0
    },
    {
      "name": "order_type",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "排序方式，0-按照创建时间倒序 ；1-按照创建时间升序；6-按照素材大小降序；7-按照素材大小升序；",
      "example": "1",
      "_depth": 0
    }
  ],
  "responseParams": [
    {
      "name": "material_info_list",
      "type": "array",
      "description": "素材列表信息",
      "example": ""
    },
    {
      "name": "total",
      "type": "number",
      "description": "总数",
      "example": "1234"
    }
  ],
  "responseCodes": [
    {
      "code": "10000",
      "meaning": "success",
      "action": "正常处理"
    },
    {
      "code": "40004",
      "meaning": "非法的参数 / 参照查询素材接口（sub_code: isv.parameter-invalid:40002）",
      "action": "https://op.jinritemai.com/docs/api-docs/69/1148",
      "sub_code": "isv.parameter-invalid:40002",
      "sub_msg": "参照查询素材接口"
    },
    {
      "code": "40004",
      "meaning": "非法的参数 / 参照查询素材接口（sub_code: isv.parameter-invalid:40004）",
      "action": "https://op.jinritemai.com/docs/api-docs/69/1148",
      "sub_code": "isv.parameter-invalid:40004",
      "sub_msg": "参照查询素材接口"
    },
    {
      "code": "20000",
      "meaning": "系统错误 / 参照查询素材接口（sub_code: isp.service-error:20000）",
      "action": "https://op.jinritemai.com/docs/api-docs/69/1148",
      "sub_code": "isp.service-error:20000",
      "sub_msg": "参照查询素材接口"
    },
    {
      "code": "50002",
      "meaning": "业务处理失败 / 参照查询素材接口（sub_code: isv.business-failed:50002）",
      "action": "https://op.jinritemai.com/docs/api-docs/69/1148",
      "sub_code": "isv.business-failed:50002",
      "sub_msg": "参照查询素材接口"
    }
  ],
  "examples": {
    "request": "curl -X GET 'https://openapi-fxg.jinritemai.YOUR_SECRET_KEY?app_key=your_appkey_here&method=supplyCenter.material.search&access_token=your_accesstoken_here&param_json={}&timestamp=2018-06-19%2016:06:59&v=2&sign=your_sign_here'",
