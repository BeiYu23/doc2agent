{
  "id": "doudian.selection.supplyCenter.cargo.list",
  "platform": "doudian",
  "group": "selection",
  "name": "supplyCenter.cargo.list",
  "description": "精选货源获取货品列表",
  "method": "GET",
  "path": "/supplyCenter/cargo/list",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 见平台说明"
  },
  "notes": [
    "文档书: 精选货源API（版本 V1.01）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "page",
      "in": "body",
      "type": "number",
      "required": true,
      "description": "页码，从1开始，最大为100；page* size最大不能超过1万条",
      "example": "1",
      "_depth": 0
    },
    {
      "name": "size",
      "in": "body",
      "type": "number",
      "required": true,
      "description": "页数，填写范围1~100；page* size最大不能超过1万条",
      "example": "10",
      "_depth": 0
    },
    {
      "name": "use_cursor",
      "in": "body",
      "type": "boolean",
      "required": false,
      "description": "是否使用游标，true 使用，false 不使用；使用游标能遍历全量商品，不会受到只能查询到10000个数据的影响。 特别说明：使用游标查询时，page字段失效，只会查询当前游标后面size条数据；根据获取查询数据为空来判断本次遍历结束；查询过程中数据发生变更，可能重复、遗漏数据；需要保证每次查询的筛选条件一致。",
      "example": "true",
      "_depth": 0
    },
    {
      "name": "cursor_id",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "游标id，结合use_cursor使用（use_cursor=true）;首次查询时不需要传值，每次查询结果会返回cursor_id，下一次查询时复制给该字段。当查询返回数据为空时，结束遍历。",
      "example": "WzE2ODI1Nzc4MjksMTc2NDMxMDczMDU3MDg0M10=",
      "_depth": 0
    },
    {
      "name": "name",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "商品标题，支持模糊匹配",
      "example": "标题",
      "_depth": 0
    },
    {
      "name": "product_id",
      "in": "body",
      "type": "array",
      "required": false,
      "description": "商品id，最大支持传入100个；",
      "example": "12345",
      "_depth": 0
    },
    {
      "name": "status",
      "in": "body",
      "type": "number",
      "required": false,
      "description": "商品在店铺中状态: 0-在线；1-下线；2-删除；详见商品状态机：https://op.jinritemai.com/docs/question-docs/92/2070",
      "example": "0",
      "_depth": 0
    },
    {
      "name": "check_status",
      "in": "body",
      "type": "number",
      "required": false,
      "description": "商品审核状态: 1-未提交；2-待审核；3-审核通过；4-审核未通过；5-封禁；7-审核通过待上架；详见商品状态机：https://op.jinritemai.com/docs/question-docs/92/2070",
      "example": "3",
      "_depth": 0
    },
    {
      "name": "start_time",
      "in": "body",
      "type": "number",
      "required": false,
      "description": "商品创建开始时间，unix时间戳，单位：秒；",
      "example": "1619161933",
      "_depth": 0
    },
    {
      "name": "end_time",
      "in": "body",
      "type": "number",
      "required": false,
      "description": "商品创建结束时间，unix时间戳，单位：秒；",
      "example": "1619162000",
      "_depth": 0
    },
    {
      "name": "update_start_time",
      "in": "body",
      "type": "number",
      "required": false,
      "description": "商品更新开始时间，unix时间戳，单位：秒；注意：查询范围是update_start_time和update_end_time之间的数据，不包含入参时间。",
      "example": "1619161933",
      "_depth": 0
    },
    {
      "name": "update_end_time",
      "in": "body",
      "type": "number",
      "required": false,
      "description": "商品更新结束时间，unix时间戳，单位：秒；注意：查询范围是update_start_time和update_end_time之间的数据，不包含入参时间。",
      "example": "1619162000",
      "_depth": 0
    }
  ],
  "responseParams": [
    {
      "name": "data",
      "type": "array",
      "description": "商品数据",
      "example": ""
    },
    {
      "name": "total",
      "type": "number",
      "description": "本次查询返回的商品总数",
      "example": "10000"
    },
    {
      "name": "page",
      "type": "number",
      "description": "当前页码",
      "example": "10"
    },
    {
      "name": "size",
      "type": "number",
      "description": "页数（每页数量）",
      "example": "100"
    },
    {
      "name": "cursor_id",
      "type": "string",
      "description": "使用游标时，每次查询会返回该值，作为下次查询的入参使用。",
      "example": "WzE2ODI1Nzc4MjksMTc2NDMxMDczMDU3MDg0M10="
    }
  ],
  "responseCodes": [
    {
      "code": "10000",
      "meaning": "success",
      "action": "正常处理"
    },
    {
      "code": "40004",
      "meaning": "非法的参数 / 参照商品列表接口（sub_code: isv.parameter-invalid:66666）",
      "action": "https://op.jinritemai.com/docs/api-docs/14/633",
      "sub_code": "isv.parameter-invalid:66666",
      "sub_msg": "参照商品列表接口"
    }
  ],
