{
  "id": "doudian.selection.supplyCenter.cargo.createTags",
  "platform": "doudian",
  "group": "selection",
  "name": "supplyCenter.cargo.createTags",
  "description": "针对精选货源所属的货品打标",
  "method": "GET",
  "path": "YOUR_SECRET_KEY",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 见平台说明"
  },
  "notes": [
    "文档书: 精选货源API（版本 V1.01）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "tags",
      "in": "body",
      "type": "array",
      "required": true,
      "description": "要打标的标签列表",
      "example": "",
      "_depth": 0
    },
    {
      "name": "cargo_id",
      "in": "body",
      "type": "mixed",
      "required": true,
      "description": "货品ID，相同货品重复打相同tag_code会覆写tag_val",
      "example": "3631318731020023",
      "_depth": 1
    },
    {
      "name": "tag_code",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "标签名，目前仅支持 DSC_cargo_7day_ret_no_reason = 七天无理由",
      "example": "DSC_cargo_7day_ret_no_reason",
      "_depth": 1
    },
    {
      "name": "tag_val",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "标签值，DSC_cargo_7day_ret_no_reason（0-不支持，1-支持）",
      "example": "1",
      "_depth": 1
    }
  ],
  "responseParams": [
    {
      "name": "failed_tags",
      "type": "array",
      "description": "失败的标签",
      "example": ""
    }
  ],
  "responseCodes": [
    {
      "code": "10000",
      "meaning": "success",
      "action": "正常处理"
    },
    {
      "code": "50002",
      "meaning": "业务处理失败 / 内部系统错误（sub_code: isv.business-failed:50002）",
      "action": "直接重试，覆写即可",
      "sub_code": "isv.business-failed:50002",
      "sub_msg": "内部系统错误"
    },
    {
      "code": "40002",
      "meaning": "缺少必选参数 / 缺少必要参数（sub_code: isv.missing-parameter:40002）",
      "action": "按照报错信息处理",
      "sub_code": "isv.missing-parameter:40002",
      "sub_msg": "缺少必要参数"
    },
    {
      "code": "40004",
      "meaning": "非法的参数 / 不支持的参数（sub_code: isv.parameter-invalid:40004）",
      "action": "按照报错信息处理",
      "sub_code": "isv.parameter-invalid:40004",
      "sub_msg": "不支持的参数"
    }
  ],
  "examples": {
    "request": "curl -X GET 'https://openapi-fxg.jinritemai.YOUR_SECRET_KEY?app_key=your_appkey_here&method=supplyCenter.cargo.createTags&access_token=your_accesstoken_here&param_json={}&timestamp=2018-06-19%2016:06:59&v=2&sign=your_sign_here'",
    "responseSuccess": {
      "data": {
        "failed_tags": [
          {
            "cargo_id": "3631318731020023",
            "tag_code": "DSC_cargo_7day_ret_no_reason"
          }
        ]
      },
      "code": 10000,
      "msg": "success",
      "sub_code": "",
      "sub_msg": ""
    },
    "responseError": {
      "code": 50002,
      "msg": "业务处理失败",
      "sub_code": "isv.business-failed:50002",
      "sub_msg": "内部系统错误"
    }
  },
  "source": "https://op.jinritemai.com/docs/api-docs/1438/5940",
  "updatedAt": "2023-12-19",
  "_file_stem": "selection-supplyCenter-cargo-createTags"
}
