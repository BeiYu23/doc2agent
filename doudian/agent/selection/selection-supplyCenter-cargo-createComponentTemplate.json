      "sub_code": "isv.parameter-invalid:40004",
      "sub_msg": "参照创建商品尺寸模板接口"
    },
    {
      "code": "40004",
      "meaning": "非法的参数 / 参照创建商品尺寸模板接口（sub_code: isv.parameter-invalid:40002）",
      "action": "https://op.jinritemai.com/docs/api-docs/14/1992",
      "sub_code": "isv.parameter-invalid:40002",
      "sub_msg": "参照创建商品尺寸模板接口"
    }
  ],
  "examples": {
    "request": "curl -X GET 'https://openapi-fxg.jinritemai.YOUR_SECRET_KEY?app_key=your_appkey_here&method=supplyCenter.cargo.createComponentTemplate&access_token=your_accesstoken_here&param_json={}&timestamp=2018-06-19%2016:06:59&v=2&sign=your_sign_here'",
