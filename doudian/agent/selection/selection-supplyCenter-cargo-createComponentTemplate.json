{
  "id": "doudian.selection.supplyCenter.cargo.createComponentTemplate",
  "cnName": "创建尺码模板",
  "docUrl": "/docs/doudian/selection/selection-supplyCenter-cargo-createComponentTemplate",
  "name": "supplyCenter.cargo.createComponentTemplate",
  "platform": "doudian",
  "group": "selection",
  "description": "创建尺码模板",
  "method": "GET",
  "path": "YOUR_SECRET_KEY",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 见平台说明"
  },
  "notes": [
    "文档书: 精选货源API（版本 V1.01）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "template_type",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "模板类型：尺码模板",
      "example": "size_info",
      "_depth": 0
    },
    {
      "name": "template_sub_type",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "模板子类型: clothing(服装)、undies(内衣)、shoes(鞋靴类)、children_clothing(童装)",
      "example": "clothing",
      "_depth": 0
    },
    {
      "name": "template_name",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "模板名称",
      "example": "模板名称1",
      "_depth": 0
    },
    {
      "name": "component_front_data",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "商品组件数据 json，表格行列顺序以selectedSize和selectedSpecs的顺序为准",
      "example": "{\"title\":\"测试模板3\",\"desc\":\"测试\",\"tempName\":\"测试模板3副本1副本1\",\"configTable\":[{\"size\":\"XS\",\"specMap\":{\"身高（cm）\":\"1\",\"体重（斤）\":\"2\",\"胸围（cm）\":\"3\"}},{\"size\":\"M\",\"specMap\":{\"身高（cm）\":\"10\",\"体重（斤）\":\"10\",\"胸围（cm）\":\"10\"}}],\"selectedSpecs\":[\"身高（cm）\",\"体重（斤）\",\"胸围（cm）\"],\"specOptions\":[\"身高（cm）\",\"体重（斤）\",\"胸围（cm）\"],\"selectedSize\":[\"XS\",\"M\"]}",
      "_depth": 0
    },
    {
      "name": "shareable",
      "in": "body",
      "type": "boolean",
      "required": false,
      "description": "是否设置为公有模板(多个商品可共用)。true-是，false-不是；不传默认fasle",
      "example": "true",
      "_depth": 0
    },
    {
      "name": "category_id",
      "in": "body",
      "type": "number",
      "required": false,
      "description": "类目id，用来确定模板类型",
      "example": "214691",
      "_depth": 0
    }
  ],
  "responseParams": [
    {
      "name": "template_id",
      "type": "number",
      "description": "模板ID",
      "example": "101"
    }
  ],
  "responseCodes": [
    {
      "code": "10000",
      "meaning": "success",
      "action": "正常处理"
    },
    {
      "code": "40004",
      "meaning": "非法的参数 / 参照创建商品尺寸模板接口（sub_code: isv.parameter-invalid:40004）",
