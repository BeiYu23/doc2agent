{
  "id": "doudian.logistics.instantShopping.callDeliveryPlatform",
  "platform": "doudian",
  "group": "logistics",
  "name": "instantShopping.callDeliveryPlatform",
  "description": "即时零售呼叫平台运力",
  "method": "GET",
  "path": "YOUR_SECRET_KEY",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 店铺"
  },
  "notes": [
    "文档书: 物流发货API（版本 V1.01）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "shop_order_id",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "抖音电商shop order单id",
      "example": "6917539978356459031",
      "_depth": 0
    },
    {
      "name": "store_id",
      "in": "body",
      "type": "mixed",
      "required": true,
      "description": "门店ID",
      "example": "1111409547",
      "_depth": 0
    },
    {
      "name": "verify_code_type",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "是否需要取件码（0=不需要，1=需要）",
      "example": "0/1",
      "_depth": 0
    },
    {
      "name": "serial_number_list",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "序列码列表，如果包含有多个序列码，请用\"_\"英文下划线分割（属于数码手机类目的商品订单才需要传序列码。）",
      "example": "353245234",
      "_depth": 0
    },
    {
      "name": "need_receiver_code",
      "in": "body",
      "type": "boolean",
      "required": false,
      "description": "是否需要收件码；true：需要；false：不需要",
      "example": "true",
      "_depth": 0
    },
    {
      "name": "sku_trace_info_list",
      "in": "body",
      "type": "array",
      "required": false,
      "description": "sku单的医疗溯源码信息;",
      "example": "",
      "_depth": 0
    },
    {
      "name": "sku_order_id",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "对应sku单id",
      "example": "4945338777763599988",
      "_depth": 1
    },
    {
      "name": "batch_and_trace_code_list",
      "in": "body",
      "type": "array",
      "required": false,
      "description": "批次+溯源码list（设计为list是可能有多个item单）",
      "example": "",
      "_depth": 1
    },
    {
      "name": "batch_code",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "批次code",
      "example": "12345",
      "_depth": 2
    },
    {
      "name": "trace_code",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "溯源码code",
      "example": "12345",
      "_depth": 2
    }
  ],
  "responseParams": [
    {
      "name": "delivery_distance",
      "type": "mixed",
      "description": "订单配送距离，单位米",
      "example": "3200"
    },
    {
      "name": "delivery_fee",
      "type": "mixed",
      "description": "订单配送价格，单位分",
      "example": "100"
    },
    {
      "name": "pickup_goods_code",
      "type": "string",
      "description": "四到六位验证码",
      "example": "2412"
    }
  ],
