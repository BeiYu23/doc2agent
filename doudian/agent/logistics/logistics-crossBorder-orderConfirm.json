{
  "id": "doudian.logistics.crossBorder.orderConfirm",
  "cnName": "服务商接单",
  "docUrl": "/docs/doudian/logistics/logistics-crossBorder-orderConfirm",
  "name": "crossBorder.orderConfirm",
  "platform": "doudian",
  "group": "logistics",
  "description": "服务商接单",
  "method": "GET",
  "path": "/crossBorder/orderConfirm",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 店铺"
  },
  "notes": [
    "文档书: 物流发货API（版本 V1.01）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "vendor",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "字节给供应链服务商定义的编码",
      "example": "NBNXYB",
      "_depth": 0
    },
    {
      "name": "order_id",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "字节电商平台的交易订单号",
      "example": "4752902481541269011",
      "_depth": 0
    },
    {
      "name": "status",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "接单状态",
      "example": "0",
      "_depth": 0
    },
    {
      "name": "occurrence_time",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "物流状态的真实发生时间",
      "example": "2020-12-15 17:20:46",
      "_depth": 0
    },
    {
      "name": "error_info",
      "in": "body",
      "type": "object",
      "required": false,
      "description": "接单失败",
      "example": "-",
      "_depth": 0
    },
    {
      "name": "error_code",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "错误码",
      "example": "1",
      "_depth": 1
    },
    {
      "name": "error_msg",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "错误信息",
      "example": "test",
      "_depth": 1
    },
    {
      "name": "deliver_info",
      "in": "body",
      "type": "object",
      "required": false,
      "description": "运单信息",
      "example": "-",
      "_depth": 0
    },
    {
      "name": "carrier",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "快递公司编码",
      "example": "yunda",
      "_depth": 1
    },
    {
      "name": "trans_no",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "运单号",
      "example": "123334543",
      "_depth": 1
    },
    {
      "name": "ship_address",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "发货地址",
      "example": "{\"city\":{\"name\":\"仁川广域市\",\"id\":\"\"},\"detail\":\"仁川广域市西区正西津2路32\"}",
      "_depth": 1
    },
    {
      "name": "waybill",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "电子面单url(pdf格式)",
      "example": "https://sf6-ttcdn-tos.pstatp.com/obj/temai/%E6%96%87%E5%AD%97%E6%96%87%E7%A8%BF1.pdf",
      "_depth": 1
    },
    {
      "name": "product_num",
      "in": "body",
      "type": "number",
      "required": false,
      "description": "商品件数",
      "example": "1",
      "_depth": 1
    },
    {
      "name": "mark",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "大头笔",
      "example": "YD",
      "_depth": 1
    },
    {
      "name": "delivery_name",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "发货人姓名",
      "example": "小明",
      "_depth": 1
    },
    {
      "name": "delivery_tel",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "发货人电话",
      "example": "13160111111",
      "_depth": 1
    }
  ],
  "responseParams": [],
  "responseCodes": [
    {
      "code": "10000",
      "meaning": "success",
      "action": "正常处理"
    },
    {
