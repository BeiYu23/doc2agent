      "action": "请核实订单信息",
      "sub_code": "isv.business-failed:10001",
      "sub_msg": "订单不存在，请联系履约确认是否已推单成功"
    },
    {
      "code": "50002",
      "meaning": "业务处理失败 / 交易单已关闭，请核实交易单状态（sub_code: isv.business-failed:10003）",
      "action": "请核实交易单状态",
      "sub_code": "isv.business-failed:10003",
      "sub_msg": "交易单已关闭，请核实交易单状态"
    }
  ],
  "examples": {
    "request": "curl -X GET 'https://openapi-fxg.jinritemai.com/dutyFree/orderOperate?app_key=your_appkey_here&method=dutyFree.orderOperate&access_token=your_accesstoken_here&param_json={}&timestamp=2018-06-19%2016:06:59&v=2&sign=your_sign_here'",
    "responseSuccess": {
