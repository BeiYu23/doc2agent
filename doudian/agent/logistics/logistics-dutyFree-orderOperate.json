{
  "id": "doudian.logistics.dutyFree.orderOperate",
  "platform": "doudian",
  "group": "logistics",
  "name": "dutyFree.orderOperate",
  "description": "海南项目服务商回传实操节点",
  "method": "GET",
  "path": "/dutyFree/orderOperate",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 店铺"
  },
  "notes": [
    "文档书: 物流发货API（版本 V2.01）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "order_id",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "订单id",
      "example": "3214321413241",
      "_depth": 0
    },
    {
      "name": "occurrence_time",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "物流状态的真实发生时间，yyyy-MM-dd hh:mm:ss",
      "example": "2021-06-18 11:00:00",
      "_depth": 0
    },
    {
      "name": "status",
      "in": "body",
      "type": "number",
      "required": true,
      "description": "节点状态：1 出库异常，2 已出库 ， 3  提货公司揽收异常，4 提货公司已揽收，5 已送达自提点， 6 消费者已提货，7 提货异常，8已核销，9 核销异常",
      "example": "1",
      "_depth": 0
    },
    {
      "name": "verification_info",
      "in": "body",
      "type": "object",
      "required": false,
      "description": "核销信息，status传入8时必填",
      "example": "-",
      "_depth": 0
    },
    {
      "name": "leave_type",
      "in": "body",
      "type": "number",
      "required": true,
      "description": "离岛工具：1 飞机，2 火车， 3 轮船",
      "example": "1",
      "_depth": 1
    },
    {
      "name": "leave_ticket_no",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "离岛工具票号",
      "example": "21413241",
      "_depth": 1
    },
    {
      "name": "leave_time",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "用户所填交通工具离岛时间 yyyy-MM-dd hh:mm:ss",
      "example": "2021-06-18 11:00:00",
      "_depth": 1
    },
    {
      "name": "transportation",
      "in": "body",
      "type": "object",
      "required": false,
      "description": "发货信息，邮寄模式或会员购模式下，status传入2时必填",
      "example": "-",
      "_depth": 0
    },
    {
      "name": "domestic_carrier",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "国内快递公司编码 按字节定义的编码推送",
      "example": "JD",
      "_depth": 1
    },
    {
      "name": "domestic_trans_no",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "运单号",
      "example": "JD321413241",
      "_depth": 1
    },
    {
      "name": "error_info",
      "in": "body",
      "type": "object",
      "required": false,
      "description": "节点异常，status传入1、3、7、9时必填",
      "example": "-",
      "_depth": 0
    },
    {
      "name": "error_code",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "返回失败编码，商家只回传不可逆转的失败",
      "example": "1001",
      "_depth": 1
    },
    {
      "name": "error_msg",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "返回详细失败原因",
      "example": "核销失败",
      "_depth": 1
    }
  ],
  "responseParams": [],
  "responseCodes": [
    {
      "code": "10000",
      "meaning": "success",
      "action": "正常处理"
    },
    {
