      "in": "body",
      "type": "number",
      "required": true,
      "description": "省ID",
      "example": "41",
      "_depth": 0
    }
  ],
  "responseParams": [
    {
      "name": "data",
      "type": "array",
      "description": "响应结果",
      "example": ""
    }
  ],
  "responseCodes": [
