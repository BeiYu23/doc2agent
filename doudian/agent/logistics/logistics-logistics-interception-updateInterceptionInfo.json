  },
  "notes": [
    "文档书: 物流发货API（版本 V2.01）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "inner_shop_id",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "店铺ID",
      "example": "1234",
      "_depth": 0
    },
    {
      "name": "resource_code",
      "in": "body",
      "type": "string",
