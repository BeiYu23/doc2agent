      "description": "资源编码",
      "example": "RC_XXXXX",
      "_depth": 0
    },
    {
      "name": "waybill_no",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "运单号",
      "example": "1234567",
      "_depth": 0
    },
    {
      "name": "return_result",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "结果：1-拦截/退回成功；2-拦截/退回失败",
      "example": "1",
      "_depth": 0
    },
    {
      "name": "result_code",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "失败原因编码：（return_result=1时为空，return_result=2时必传）\n拦截失败：\n10000——运单号有误\n10001——包裹未揽件\n10002——包裹已派件\n10003——包裹已签收\n11404——系统异常\n10004——包裹已终止\n10005——快递商无法识别网点\n10006——信息不全\n10007——系统超时，请重新发起\n10008——重复拦截\n10009——物流轨迹异常\n10010——收件地址不支持派送\n10011——物流商资源编码有误\n10012——派件网点增值服务异常\n10013——其他\n10014——网点不具备拦截能力\n10015——非抖音电商电子面单\n10016——拦截前已丢失\n退回失败：\n10001——用户签收\n10002——包裹丢失\n10003——包裹破损\n10004——操作不规范（物理退回、逻辑未退回）\n10005——包裹未退回发件站点\n10006——取消拦截\n10007——弃件\n20000——其他",
      "example": "10001",
      "_depth": 0
    },
    {
      "name": "result_message",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "拦截失败/退回失败原因（return_result=1时为空，return_result=2时必传；长度不能超过100英文字符，一个中文相当于3个英文字符）",
      "example": "包裹未揽件",
      "_depth": 0
    },
    {
      "name": "status",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "状态：（默认2——退回）\n1——拦截\n2——退回",
      "example": "1",
      "_depth": 0
    },
    {
      "name": "operation_time",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "实操时间",
      "example": "2023-07-25 12:00:00",
      "_depth": 0
    },
    {
      "name": "express",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "物流商编码：\nzhongtong——中通\njtexpress——极兔\nyunda——韵达\nshentong——申通\nyuantong——圆通",
      "example": "zhongtong",
      "_depth": 0
    }
  ],
