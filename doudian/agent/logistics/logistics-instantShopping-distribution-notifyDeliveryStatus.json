{
  "id": "doudian.logistics.instantShopping.distribution.notifyDeliveryStatus",
  "platform": "doudian",
  "group": "logistics",
  "name": "instantShopping.distribution.notifyDeliveryStatus",
  "description": "抖音侧订单状态变更回调",
  "method": "GET",
  "path": "YOUR_SECRET_KEY",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 见平台说明"
  },
  "notes": [
    "文档书: 物流发货API（版本 V1.01）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "delivery_id",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "抖音运单id(以此id为主)",
      "example": "\"a_7372453214286987305\"",
      "_depth": 0
    },
    {
      "name": "distributor_delivery_id",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "配送商运单id",
      "example": "\"DH2024052459066015\"",
      "_depth": 0
    },
    {
      "name": "distributor_code",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "抖音为每个配送商分配的标识信息",
      "example": "\"MOCK_DELIVERY\"",
      "_depth": 0
    },
    {
      "name": "status",
      "in": "body",
      "type": "mixed",
      "required": true,
      "description": "运单状态，见附录F02",
      "example": "102",
      "_depth": 0
    },
    {
      "name": "update_time",
      "in": "body",
      "type": "mixed",
      "required": true,
      "description": "状态变更时间，格式为秒时间戳",
      "example": "1716537685",
      "_depth": 0
    },
    {
      "name": "rider_name",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "骑手姓名",
      "example": "\"朱涛\"",
      "_depth": 0
    },
    {
      "name": "rider_phone",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "骑手电话",
      "example": "\"13684541145\"",
      "_depth": 0
    },
    {
      "name": "rider_lat",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "骑手当前所在纬度（火星坐标系GCJ02）",
      "example": "39.973390",
      "_depth": 0
    },
    {
      "name": "rider_lng",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "骑手当前所在经度（火星坐标系GCJ02）",
      "example": "116.347004",
      "_depth": 0
    },
    {
      "name": "cancel_code",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "取消原因code，取消态必填",
      "example": "0",
      "_depth": 0
    },
    {
      "name": "cancel_reason",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "取消原因描述，取消态必填",
      "example": "\"\"",
      "_depth": 0
    },
    {
      "name": "notify_time",
      "in": "body",
      "type": "mixed",
      "required": true,
      "description": "通知时间",
      "example": "1716537685",
      "_depth": 0
    },
    {
      "name": "distributor_rider_id",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "配送商骑手id",
      "example": "\"4575457\"",
      "_depth": 0
    },
    {
      "name": "cancel_price",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "取消费用，单位：分，取消运单时必填",
      "example": "0",
      "_depth": 0
    },
    {
      "name": "delivery_reverse",
      "in": "body",
      "type": "object",
      "required": false,
      "description": "返件相关信息",
      "example": "",
      "_depth": 0
    },
    {
      "name": "reverse_id",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "返件单ID",
      "example": "7257267285",
      "_depth": 1
    },
    {
      "name": "status",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "返件状态枚举：\n- 返件初始化：100\n- 返件中：200\n- 返件完成：300\n- 返件取消：400\n- 无需返件：900",
      "example": "900",
      "_depth": 1
    },
    {
      "name": "delivered_images",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "妥投举证图片；（图片url，如果是多个，通过逗号分隔）",
      "example": "\"https://media-order-jd.imdada.cn/order-finish/d640f142063a40ccb919439fc413d221.jpeg,https://media-order-jd.imdada.cn/order-finish/031652144dcf4ff6be0e15f3ab5078ee.jpeg\"",
      "_depth": 0
    },
    {
      "name": "delivered_desc",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "妥投描述",
      "example": "\"放在家门口\"",
      "_depth": 0
    },
    {
      "name": "rider_im_open_status",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "骑手IM功能开启标记，0：未知；1：开启；2：不开启",
      "example": "1",
      "_depth": 0
    }
  ],
