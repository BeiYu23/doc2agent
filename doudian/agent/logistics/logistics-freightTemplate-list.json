{
  "id": "doudian.logistics.freightTemplate.list",
  "cnName": "获取运费模板列表",
  "docUrl": "/docs/doudian/logistics/logistics-freightTemplate-list",
  "name": "freightTemplate.list",
  "platform": "doudian",
  "group": "logistics",
  "description": "获取运费模板列表",
  "method": "GET",
  "path": "/freightTemplate/list",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 店铺"
  },
  "notes": [
    "文档书: 物流发货API（版本 V2.02）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "name",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "运费模板名称，支持模糊搜索",
      "example": "模版1",
      "_depth": 0
    },
    {
      "name": "page",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "页数（默认为0，第一页从0开始）",
      "example": "0",
      "_depth": 0
    },
    {
      "name": "size",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "每页模板数（默认为10），最大值是100",
      "example": "10",
      "_depth": 0
    }
  ],
  "responseParams": [
    {
      "name": "List",
      "type": "array",
      "description": "运费模版列表",
      "example": ""
    },
    {
      "name": "Count",
      "type": "number",
      "description": "总数",
      "example": "1"
    }
  ],
  "responseCodes": [
    {
      "code": "10000",
      "meaning": "success",
      "action": "正常处理"
    },
    {
