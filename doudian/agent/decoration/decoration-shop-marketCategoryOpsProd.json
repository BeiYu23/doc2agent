  "params": [
    {
      "name": "infos",
      "in": "body",
      "type": "array",
      "required": true,
      "description": "需要更新的item、分类关系",
      "example": "",
      "_depth": 0
    },
    {
      "name": "item_id",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "商品ID",
      "example": "7337543193975587098",
      "_depth": 1
    },
    {
      "name": "item_type",
      "in": "body",
      "type": "mixed",
      "required": true,
      "description": "类型枚举，表示item_id归属类型\n1：商品",
      "example": "1",
      "_depth": 1
    },
    {
      "name": "category_id_list",
      "in": "body",
      "type": "array",
      "required": true,
      "description": "店铺分类页生效的叶子类目ID，支持一二级分类。\n如果一级分类下面存在子分类，则绑定失败。",
      "example": "[\"7337543193975587098\",\"7337543193975587091\",\"7337543193975587092\"]",
      "_depth": 1
    },
    {
      "name": "ops_type",
      "in": "body",
      "type": "mixed",
      "required": true,
      "description": "操作类型\n1：添加\n2：删除\n3：移动(先删除原分类，再添加到新分类)",
      "example": "1",
      "_depth": 1
    },
    {
      "name": "tmp_id",
      "in": "body",
      "type": "mixed",
      "required": true,
      "description": "页面ID，建议指定对应要更新的页面ID",
      "example": "7337543193975587098",
      "_depth": 0
    }
  ],
  "responseParams": [
    {
      "name": "item_tips",
      "type": "string",
      "description": "商品提示信息",
      "example": "{\"7337543193975587098\":\"商品信息不存在\"}"
    }
  ],
