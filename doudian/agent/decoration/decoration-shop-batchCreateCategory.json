{
  "id": "doudian.decoration.shop.batchCreateCategory",
  "platform": "doudian",
  "group": "decoration",
  "name": "shop.batchCreateCategory",
  "description": "批量创建类目接口",
  "method": "GET",
  "path": "/shop/batchCreateCategory",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 店铺"
  },
  "notes": [
    "文档书: 店铺装修API（版本 V1.01）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "tmp_id",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "页面id,请使用【/shop/openShopPageManagementList】接口查询页面id或访问店铺装修列表页面获取页面id。",
      "example": "735278978958386",
      "_depth": 0
    },
    {
      "name": "category_info_list",
      "in": "body",
      "type": "array",
      "required": true,
      "description": "一级页面分类列表，最大支持一次传入一级+二级类目总数500个。",
      "example": "",
      "_depth": 0
    },
    {
      "name": "children_category_list",
      "in": "body",
      "type": "array",
      "required": false,
      "description": "二级页面分类列表",
      "example": "",
      "_depth": 1
    },
    {
      "name": "rank",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "页面类目排序字段，在同级别优先级权重，越大则越靠前，可选范围[100000]，相同排序数字，创建时间最新的靠前排列。0排序在最后面，以此类推。",
      "example": "100",
      "_depth": 2
    },
    {
      "name": "name",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "一级页面名称，支持最小1个字符，最大8个字符。",
      "example": "葡萄",
      "_depth": 2
    },
    {
      "name": "name",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "一级页面名称，支持最小1个字符，最大8个字符。",
      "example": "水果",
      "_depth": 1
    },
    {
      "name": "rank",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "页面类目排序字段，在同级别优先级权重，越大则越靠前，可选范围[100000]，相同排序数字，创建时间最新的靠前排列。0排序在最后面，以此类推。",
      "example": "100",
      "_depth": 1
    }
  ],
  "responseParams": [
    {
      "name": "tmp_id",
      "type": "string",
      "description": "页面id，成功时有值。",
      "example": "7352789789583868197"
    },
    {
      "name": "category_list",
      "type": "array",
      "description": "一级分类列表。成功后返回页面完整分类列表。",
      "example": ""
    },
    {
      "name": "failed_category_list",
      "type": "array",
      "description": "失败分类列表",
      "example": ""
    }
  ],
  "responseCodes": [
    {
      "code": "10000",
      "meaning": "success",
      "action": "正常处理"
    },
    {
      "code": "40002",
      "meaning": "缺少必选参数 / 缺少页面id（sub_code: isv.missing-parameter:10003）",
      "action": "请填写页面id",
      "sub_code": "isv.missing-parameter:10003",
      "sub_msg": "缺少页面id"
    },
    {
      "code": "40004",
      "meaning": "非法的参数 / 单次创建一级+二级分类总数超过限制（sub_code: isv.parameter-invalid:20162）",
      "action": "请减少单次创建分类数",
      "sub_code": "isv.parameter-invalid:20162",
      "sub_msg": "单次创建一级+二级分类总数超过限制"
    },
    {
      "code": "50002",
      "meaning": "业务处理失败 / 一级类目下分类总数（sub_code: isv.business-failed:20163）",
      "action": "页面内一级分类总数最多100个",
      "sub_code": "isv.business-failed:20163",
      "sub_msg": "一级类目下分类总数"
    }
  ],
  "examples": {
    "request": "curl -X GET 'https://openapi-fxg.jinritemai.com/shop/batchCreateCategory?app_key=your_appkey_here&method=shop.batchCreateCategory&access_token=your_accesstoken_here&param_json={}&timestamp=2018-06-19%2016:06:59&v=2&sign=your_sign_here'",
    "responseSuccess": {
      "data": {
        "category_list": [
          {
            "children_category_list": [
              {
                "cid": "7352789789583868196",
                "name": "葡萄",
                "rank": "100"
              }
            ],
            "cid": "7352789789583868198",
            "name": "水果",
            "rank": "100"
          }
        ],
        "failed_category_list": [
          {
            "cid": "7352789789583868195",
            "level": "2",
            "msg": "rank值超出范围(0~100000)",
            "name": "葡萄",
            "parent_name": "水果"
          }
        ],
        "tmp_id": "7352789789583868197"
      },
      "code": 10000,
      "msg": "success",
      "sub_code": "",
      "sub_msg": ""
    },
    "responseError": {
      "code": 40002,
      "msg": "缺少必选参数",
      "sub_code": "isv.missing-parameter:10003",
      "sub_msg": "缺少页面id"
    }
  },
  "source": "https://op.jinritemai.com/docs/api-docs/167/6439",
  "updatedAt": "2024-04-18",
  "_file_stem": "decoration-shop-batchCreateCategory"
}
