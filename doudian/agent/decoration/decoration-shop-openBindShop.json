{
  "id": "doudian.decoration.shop.openBindShop",
  "platform": "doudian",
  "group": "decoration",
  "name": "shop.openBindShop",
  "description": "店铺装修-绑定门店",
  "method": "GET",
  "path": "/shop/openBindShop",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 店铺"
  },
  "notes": [
    "文档书: 店铺装修API（版本 V1.01）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "tmp_id",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "需要和门店绑定的页面",
      "example": "7332399246898888986",
      "_depth": 0
    },
    {
      "name": "shop_list",
      "in": "body",
      "type": "array",
      "required": true,
      "description": "需要绑定的门店",
      "example": "[\"155753860\"]",
      "_depth": 0
    }
  ],
  "responseParams": [
    {
      "name": "shop_success",
      "type": "array",
      "description": "成功门店",
      "example": "[\"155753860\"]"
    },
    {
      "name": "shop_fail",
      "type": "array",
      "description": "失败门店",
      "example": ""
    }
  ],
  "responseCodes": [
    {
      "code": "10000",
      "meaning": "success",
      "action": "正常处理"
    },
    {
      "code": "20000",
      "meaning": "系统错误 / RPC错误（sub_code: isp.service-error:10004）",
      "action": "根据报错内容排查",
      "sub_code": "isp.service-error:10004",
      "sub_msg": "RPC错误"
    },
    {
      "code": "50002",
      "meaning": "业务处理失败 / 40002:系统开小差了，请稍后重试哟（sub_code: isv.business-failed:40002）",
      "action": "根据报错内容排查",
      "sub_code": "isv.business-failed:40002",
      "sub_msg": "40002:系统开小差了，请稍后重试哟"
    }
  ],
  "examples": {
    "request": "curl -X GET 'https://openapi-fxg.jinritemai.com/shop/openBindShop?app_key=your_appkey_here&method=shop.openBindShop&access_token=your_accesstoken_here&param_json={}&timestamp=2018-06-19%2016:06:59&v=2&sign=your_sign_here'",
    "responseSuccess": {
      "data": {
        "shop_fail": [
          {
            "msg": "\"无门店权限\"",
            "shop_fail": "[\"155753860\"]"
          }
        ],
        "shop_success": "[\"155753860\"]"
      },
      "code": 10000,
      "msg": "success",
      "sub_code": "",
      "sub_msg": ""
    },
    "responseError": {
      "code": 20000,
      "msg": "系统错误",
      "sub_code": "isp.service-error:10004",
      "sub_msg": "RPC错误"
    }
  },
  "source": "https://op.jinritemai.com/docs/api-docs/167/6303",
  "updatedAt": "2026-04-02",
  "_file_stem": "decoration-shop-openBindShop"
}
