  "params": [
    {
      "name": "tmp_id",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "需要解绑的页面id",
      "example": "7332399246898888986",
      "_depth": 0
    },
    {
      "name": "shop_id_list",
      "in": "body",
      "type": "array",
      "required": false,
      "description": "需要解绑的店铺id。如果选择全部清空，会删除页面下所有门店，不需要传这个。",
      "example": "[\"155753860\"]",
      "_depth": 0
    },
    {
      "name": "is_batch_del",
      "in": "body",
      "type": "boolean",
      "required": true,
      "description": "是否全部清空",
      "example": "false",
      "_depth": 0
    }
  ],
  "responseParams": [],
