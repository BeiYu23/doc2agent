{
  "id": "doudian.supply-chain.supplyChain.supplyProduct.add",
  "platform": "doudian",
  "group": "supply-chain",
  "name": "supplyChain.supplyProduct.add",
  "description": "创建产品",
  "method": "GET",
  "path": "/supplyChain/supplyProduct/add",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 供应商"
  },
  "notes": [
    "文档书: 供销平台API（版本 V1.01）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "outer_product_id",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "推荐使用，外部商家编码，支持字符串",
      "example": "232334",
      "_depth": 0
    },
    {
      "name": "category_leaf_id",
      "in": "body",
      "type": "number",
      "required": true,
      "description": "叶子类目ID通过/supplier/getSupplierCategory接口获取",
      "example": "20000",
      "_depth": 0
    },
    {
      "name": "name",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "商品名称，最多60个字符(30个汉字)，不能含emoj表情",
      "example": "xxx补水液",
      "_depth": 0
    },
    {
      "name": "recommend_remark",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "商家推荐语，不能含emoj表情",
      "example": "这个产品很好啊",
      "_depth": 0
    },
    {
      "name": "pic",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "商品轮播图，多张图片用 \\\"|\\\" 分开，第一张图为主图，最多5张，至少600x600，大小不超过1M。",
      "example": "img_url1|img_url2|img_url3",
      "_depth": 0
    },
    {
      "name": "description",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "商品描述，目前只支持图片。多张图片用 \\\"|\\\" 分开。不能用其他网站的文本粘贴，这样会出现css样式不兼容。",
      "example": "img_url1|img_url2|img_url3",
      "_depth": 0
    },
    {
      "name": "weight",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "重量",
      "example": "1000",
      "_depth": 0
    },
    {
      "name": "weight_unit",
      "in": "body",
      "type": "number",
      "required": true,
      "description": "重量单位，0-kg, 1-g",
      "example": "1",
      "_depth": 0
    },
    {
      "name": "remark",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "预留字段，供应商可见备注",
      "example": "备注",
      "_depth": 0
    },
    {
      "name": "quality_list",
      "in": "body",
      "type": "array",
      "required": false,
      "description": "资质，可通过/suppyProduct/GetSupplyProductUpdateRule获取",
      "example": "",
      "_depth": 0
    },
    {
      "name": "quality_key",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "资质key",
      "example": "3457***9470978",
      "_depth": 1
    },
    {
      "name": "quality_name",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "资质名称",
      "example": "进货凭证",
      "_depth": 1
    },
    {
      "name": "quality_attachments",
      "in": "body",
      "type": "array",
      "required": true,
      "description": "资质",
      "example": "",
      "_depth": 1
    },
    {
      "name": "media_type",
      "in": "body",
      "type": "number",
      "required": true,
      "description": "1-图片，2-pdf",
      "example": "1",
      "_depth": 2
    },
    {
      "name": "url",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "凭证url",
      "example": "\\\"http://www.byted***.com/YYYY\\\"",
      "_depth": 2
    },
    {
      "name": "spec_name",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "如果不填，则规格名为各级规格名用 \\\"-\\\" 自动生成",
      "example": "颜色-尺码",
      "_depth": 0
    },
    {
      "name": "specs",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "通用规格，能被同类产品通用。多规格用^分隔，规格与规格值用|分隔，多个规格值用,分隔。",
      "example": "颜色|红色,黑色^尺码|S,M",
      "_depth": 0
    },
    {
      "name": "spec_prices",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "sku详情，数量应该等于规格1规格2规格3，sku数量和规格组合数必须一致， sku库存数量必须大于0。suggest_retail_price表示建议零售价不能低于supply_price.stockNum因为历史原因格式是驼峰注意，incremental目前只支持传true,sync_stock_List在只有全国仓模式下也是个数组",
      "example": "[{\t\\\"spec_detail_name1\\\":\\\"红色\\\",\t\\\"spec_detail_name2\\\":\\\"S\\\",\t\\\"spec_detail_name3\\\":\\\"\\\",\t\\\"sync_stock_List\\\":[{\t\t\\\"out_warehouseId\\\":\\\"w11111\\\",\t\t\\\"incremental\\\":true,\t\t\\\"idempotentId\\\":\\\"d11111\\\",\t\t\\\"stockNum\\\":1\t}],\t\\\"supply_price\\\":100,\\\"suggest_retail_price\\\":110,\\\"outer_sku_id\\\":\\\"\\\"},{\t\\\"spec_detail_name1\\\":\\\"红色\\\",\t\\\"spec_detail_name2\\\":\\\"M\\\",\t\\\"spec_detail_name3\\\":\\\"\\\",\t\\\"sync_stock_List\\\":[{\t\t\\\"out_warehouseId\\\":\\\"w11111\\\",\t\t\\\"incremental\\\":true,\t\t\\\"idempotentId\\\":\\\"d11111\\\",\t\t\\\"stockNum\\\":1\t}],\t\\\"supply_price\\\":100,\\\"suggest_retail_price\\\":110,\\\"outer_sku_id\\\":\\\"\\\"},{\t\\\"spec_detail_name1\\\":\\\"黑色\\\",\t\\\"spec_detail_name2\\\":\\\"S\\\",\t\\\"spec_detail_name3\\\":\\\"\\\",\t\\\"sync_stock_List\\\":[{\t\t\\\"out_warehouseId\\\":\\\"w11111\\\",\t\t\\\"incremental\\\":true,\t\t\\\"idempotentId\\\":\\\"d11111\\\",\t\t\\\"stockNum\\\":1\t}],\t\\\"supply_price\\\":100,\\\"suggest_retail_price\\\":110,\\\"outer_sku_id\\\":\\\"\\\"},{\t\\\"spec_detail_name1\\\":\\\"黑色\\\",\t\\\"spec_detail_name2\\\":\\\"M\\\",\t\\\"spec_detail_name3\\\":\\\"\\\",\t\\\"sync_stock_List\\\":[{\t\t\\\"out_warehouseId\\\":\\\"w11111\\\",\t\t\\\"incremental\\\":true,\t\t\\\"idempotentId\\\":\\\"d11111\\\",\t\t\\\"stockNum\\\":1\t}],\\\"supply_price\\\":100,\\\"suggest_retail_price\\\":110,\\\"outer_sku_id\\\":\\\"\\\"}]",
      "_depth": 0
    },
    {
      "name": "spec_pic",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "如颜色-尺寸, 颜色就是主规格, 颜色如黑,白,黄,它们图片url以逗号分隔 注：\\\"pic\\\"、\\\"description\\\"、\\\"spec_pic\\\"这三个字段里的传入的图片数量总和，不得超过50张。",
      "example": "img_url,img_url,img_url",
      "_depth": 0
    },
    {
      "name": "product_format_new",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "属性，通过/supplyProduct/getSupplyProductUpdateRule获取 格式：{\"property_id\":[{\"value\":value,\"name\":\"property_name\",\"diy_type\":0}]} name的类型是string，value和diy_type的类型是number",
      "example": "{\\\"405\\\":[{\\\"value\\\":27664,\\\"name\\\":\\\"复习资料\\\",\\\"diy_type\\\":0}],\\\"449\\\":[{\\\"value\\\":0,\\\"name\\\":\\\"佚名\\\",\\\"diy_type\\\":0}],\\\"501\\\":[{\\\"value\\\":7310,\\\"name\\\":\\\"否\\\",\\\"diy_type\\\":0}],\\\"855\\\":[{\\\"value\\\":61683,\\\"name\\\":\\\"北京出版社\\\",\\\"diy_type\\\":0}],\\\"1088\\\":[{\\\"value\\\":407,\\\"name\\\":\\\"小学五年级\\\",\\\"diy_type\\\":0}],\\\"1319\\\":[{\\\"value\\\":0,\\\"name\\\":\\\"1\\\",\\\"diy_type\\\":0}],\\\"1601\\\":[{\\\"value\\\":13911,\\\"name\\\":\\\"通用版\\\",\\\"diy_type\\\":0}],\\\"1618\\\":[{\\\"value\\\":0,\\\"name\\\":\\\"9787218122861\\\",\\\"diy_type\\\":0}],\\\"1831\\\":[{\\\"value\\\":0,\\\"name\\\":\\\"小学英语看图说话写话二年级\\\",\\\"diy_type\\\":0}],\\\"2000\\\":[{\\\"value\\\":34762,\\\"name\\\":\\\"无\\\",\\\"diy_type\\\":0}],\\\"2229\\\":[{\\\"value\\\":0,\\\"name\\\":\\\"1\\\",\\\"diy_type\\\":0}],\\\"2763\\\":[{\\\"value\\\":25193,\\\"name\\\":\\\"英语\\\",\\\"diy_type\\\":0}],\\\"3271\\\":[{\\\"value\\\":0,\\\"name\\\":\\\"1\\\",\\\"diy_type\\\":0}],\\\"3296\\\":[{\\\"value\\\":0,\\\"name\\\":\\\"16.80元\\\",\\\"diy_type\\\":0}]}",
      "_depth": 0
    },
    {
      "name": "extends",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "扩展信息",
      "example": "{}",
      "_depth": 0
    },
    {
      "name": "white_back_ground_pic_url",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "素材中心url",
      "example": "白底图",
      "_depth": 0
    }
  ],
  "responseParams": [
    {
      "name": "product_id",
      "type": "number",
      "description": "product_id",
      "example": "11111"
    },
    {
      "name": "outer_product_id",
      "type": "string",
      "description": "outer_product_id",
      "example": "1111"
    },
    {
      "name": "create_time",
      "type": "number",
      "description": "create_time",
      "example": "1657800575"
    },
    {
      "name": "sku_list",
      "type": "array",
      "description": "sku列表",
      "example": ""
    }
  ],
  "responseCodes": [
    {
      "code": "10000",
      "meaning": "success",
      "action": "正常处理"
    },
    {
