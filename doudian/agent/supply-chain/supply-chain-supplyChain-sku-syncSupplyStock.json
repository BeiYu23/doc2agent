{
  "id": "doudian.supply-chain.supplyChain.sku.syncSupplyStock",
  "platform": "doudian",
  "group": "supply-chain",
  "name": "supplyChain.sku.syncSupplyStock",
  "description": "设置库存",
  "method": "GET",
  "path": "YOUR_SECRET_KEY",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 供应商"
  },
  "notes": [
    "文档书: 供销平台API（版本 V2.01）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "sku_id",
      "in": "body",
      "type": "mixed",
      "required": true,
      "description": "skuid",
      "example": "111111111111",
      "_depth": 0
    },
    {
      "name": "product_id",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "productid",
      "example": "11111111",
      "_depth": 0
    },
    {
      "name": "out_warehouse_id",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "外部仓库编码",
      "example": "w12345",
      "_depth": 0
    },
    {
      "name": "incremental",
      "in": "body",
      "type": "boolean",
      "required": false,
      "description": "是否增量同步，当前供销平台只支持增量同步",
      "example": "true",
      "_depth": 0
    },
    {
      "name": "idempotent_id",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "请求幂等键",
      "example": "w12345_0_1656262875",
      "_depth": 0
    },
    {
      "name": "stock_num",
      "in": "body",
      "type": "mixed",
      "required": true,
      "description": "库存变更量，负值代表减",
      "example": "10",
      "_depth": 0
    },
    {
      "name": "stock_serial_no_list",
      "in": "body",
      "type": "array",
      "required": false,
      "description": "库存实物序列号，如手机即为每个手机的IMEI",
      "example": "[\"123\"]",
      "_depth": 0
    }
  ],
  "responseParams": [
    {
      "name": "released_stock_serial_no_list",
      "type": "array",
      "description": "库存调减返回释放的库存实物序列号，如手机即为每个手机的IMEI",
      "example": "[\"123\"]"
    }
  ],
  "responseCodes": [
    {
      "code": "10000",
      "meaning": "success",
      "action": "正常处理"
    }
  ],
  "examples": {
    "request": "curl -X GET 'https://openapi-fxg.jinritemai.YOUR_SECRET_KEY?app_key=your_appkey_here&method=supplyChain.sku.syncSupplyStock&access_token=your_accesstoken_here&param_json={}&timestamp=2018-06-19%2016:06:59&v=2&sign=your_sign_here'",
    "responseSuccess": {
      "data": {
        "released_stock_serial_no_list": "[\"123\"]"
      },
      "code": 10000,
      "msg": "success",
      "sub_code": "",
      "sub_msg": ""
    },
    "responseError": {
      "sub_code": "",
      "sub_msg": ""
    }
  },
  "source": "https://op.jinritemai.com/docs/api-docs/172/2553",
  "updatedAt": "2025-02-17",
  "_file_stem": "supply-chain-supplyChain-sku-syncSupplyStock",
  "cnName": "设置库存"
}
