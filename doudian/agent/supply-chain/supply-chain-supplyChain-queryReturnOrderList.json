      "type": "string",
      "required": false,
      "description": "订单标准状态；1-待抖店商家同意退款；2-待供应商同意退款；3-待买家退货；4-买家已退货，待供应商确认收货；5-退款中；6-退款成功；7-售后仲裁中；8-待供应商同意退货申请；9-待商家/分销商退货；11-待平台审核退款；12-待平台审核退货申请；13-已退货，待平台审核退款；20-售后取消；21-售后关闭；22-售后拒绝；23-售后异常",
      "example": "1",
      "_depth": 0
    },
    {
      "name": "create_date_begin",
      "in": "body",
      "type": "number",
      "required": false,
      "description": "创建时间开始，单位为秒（查询范围包含开始值）",
      "example": "1626856525",
      "_depth": 0
    },
    {
      "name": "create_date_end",
      "in": "body",
      "type": "number",
      "required": false,
      "description": "创建结束开始，单位为秒（查询范围包含开始值）",
      "example": "1626856525",
      "_depth": 0
    },
    {
      "name": "page",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "页数，从1开始",
      "example": "1",
      "_depth": 0
    },
    {
      "name": "size",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "每页数量，最多100个",
      "example": "50",
      "_depth": 0
    },
    {
      "name": "order_type",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "售后类型；1-退货退款，3-退款",
      "example": "1",
      "_depth": 0
    },
    {
      "name": "order_asc",
      "in": "body",
      "type": "boolean",
      "required": false,
      "description": "是否创建时间升序排列",
      "example": "false",
      "_depth": 0
    }
