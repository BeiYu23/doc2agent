{
  "id": "doudian.supply-chain.supplyChain.brand.list",
  "platform": "doudian",
  "group": "supply-chain",
  "name": "supplyChain.brand.list",
  "description": "获取品牌信息",
  "method": "GET",
  "path": "/supplyChain/brand/list",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 供应商"
  },
  "notes": [
    "文档书: 供销平台API（版本 V1.01）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "category_id",
      "in": "body",
      "type": "number",
      "required": true,
      "description": "类目id",
      "example": "11111111",
      "_depth": 0
    },
    {
      "name": "brand_name",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "品牌前缀",
      "example": "华为",
      "_depth": 0
    }
  ],
  "responseParams": [
    {
      "name": "auth_brand_list",
      "type": "array",
      "description": "品牌列表",
      "example": ""
    }
  ],
  "responseCodes": [
    {
      "code": "10000",
      "meaning": "成功",
      "action": "正常处理"
    }
  ],
  "examples": {
    "request": "curl -X GET 'https://openapi-fxg.jinritemai.com/supplyChain/brand/list?app_key=your_appkey_here&method=supplyChain.brand.list&access_token=your_accesstoken_here&param_json={}&timestamp=2018-06-19%2016:06:59&v=2&sign=your_sign_here'",
    "responseSuccess": {
      "data": {
        "auth_brand_list": [
          {
            "brand_id": "1111111",
            "name_cn": "华为",
            "name_en": "HUIWEI"
          }
        ]
      },
      "code": 10000,
      "msg": "success",
      "sub_code": "",
      "sub_msg": ""
    },
    "responseError": {
      "sub_code": "",
      "sub_msg": ""
    }
  },
