    },
    {
      "name": "data_sync_mode",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "platform_pull:平台拉取；erp_push:ERP推送（为空时默认erp_push）",
      "example": "platform_pull",
      "_depth": 1
    },
    {
      "name": "status",
      "in": "body",
      "type": "mixed",
      "required": true,
      "description": "状态枚举：\n1：授权；0：取消授权",
      "example": "1",
      "_depth": 1
    },
    {
      "name": "type",
      "in": "body",
      "type": "mixed",
      "required": true,
      "description": "类型: 1:库存；",
      "example": "1",
      "_depth": 1
    },
    {
      "name": "app_name",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "",
      "example": "",
      "_depth": 1
    },
    {
      "name": "app_key",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "",
      "example": "",
      "_depth": 1
    },
    {
      "name": "platform_shop_id_list",
      "in": "body",
      "type": "array",
      "required": true,
      "description": "店铺id",
      "example": "[1,2,3]",
      "_depth": 1
    },
    {
      "name": "access_code",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "访问编码",
      "example": "sadggfdfsdfdgdggf",
      "_depth": 1
    },
    {
      "name": "cargo_owner_id",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "erp货主id",
      "example": "124343a",
      "_depth": 1
    },
    {
      "name": "company_id",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "公司id",
      "example": "\"1111\"",
      "_depth": 1
    },
    {
      "name": "check_list",
      "in": "body",
      "type": "array",
      "required": true,
      "description": "库存类型枚举（英文是枚举值）：\n在库=stock_quantity;\n销售待出库占用=order_pending_quantity;\n销退在途=sales_return_quantity\n采购在途=purchase_quantity;\n调拨在途=transfer_quantity",
      "example": "[\"stock_quantity\",\"order_pending_quantity\"]",
      "_depth": 1
    }
  ],
  "responseParams": [
    {
      "name": "code",
      "type": "mixed",
      "description": "code",
      "example": "0"
    },
    {
      "name": "msg",
