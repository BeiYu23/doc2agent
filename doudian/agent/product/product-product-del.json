{
  "id": "doudian.product.product.del",
  "platform": "doudian",
  "group": "product",
  "name": "product.del",
  "description": "删除商品",
  "method": "GET",
  "path": "/product/del",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 店铺"
  },
  "notes": [
    "文档书: 商品API（版本 V2.01）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "product_id",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "商品ID",
      "example": "356545645645454",
      "_depth": 0
    },
    {
      "name": "out_product_id",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "外部商品ID",
      "example": "4156451",
      "_depth": 0
    },
    {
      "name": "delete_forever",
      "in": "body",
      "type": "boolean",
      "required": false,
      "description": "是否彻底删除",
      "example": "false",
      "_depth": 0
    },
    {
      "name": "store_id",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "门店ID，不建议小时达一期用，即时零售单店版，无需使用",
      "example": "1111420330",
      "_depth": 0
    }
  ],
  "responseParams": [],
