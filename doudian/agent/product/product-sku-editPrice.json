{
  "id": "doudian.product.sku.editPrice",
  "platform": "doudian",
  "group": "product",
  "name": "sku.editPrice",
  "description": "编辑sku价格",
  "method": "GET",
  "path": "/sku/editPrice",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 店铺"
  },
  "notes": [
    "文档书: 商品API（版本 V1.03）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "price",
      "in": "body",
      "type": "mixed",
      "required": true,
      "description": "售价 (单位 分)",
      "example": "3200",
      "_depth": 0
    },
    {
      "name": "code",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "sku编码",
      "example": "aaa",
      "_depth": 0
    },
    {
      "name": "sku_id",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "skuid",
      "example": "1233245",
      "_depth": 0
    },
    {
      "name": "out_sku_id",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "外部skuid",
      "example": "132345654",
      "_depth": 0
    },
    {
      "name": "product_id",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "商品id",
      "example": "322315645454655",
      "_depth": 0
    },
    {
      "name": "out_product_id",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "外部商品id",
      "example": "2634786238745687465",
      "_depth": 0
    },
    {
      "name": "store_id",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "即时零售连锁版，通过传入主品id+门店id对该门店下的子品进行操作，即时零售单店版，无需使用",
      "example": "12345",
      "_depth": 0
    }
  ],
