  },
  "notes": [
    "文档书: 商品API（版本 V2.01）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "category_leaf_id",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "叶子类目ID",
      "example": "23362",
      "_depth": 0
    },
    {
      "name": "key_properties",
      "in": "body",
      "type": "array",
      "required": false,
      "description": "关键属性",
      "example": "",
      "_depth": 0
    },
    {
      "name": "property_values",
      "in": "body",
      "type": "array",
      "required": false,
      "description": "属性值",
      "example": "",
      "_depth": 1
    },
    {
      "name": "value_name",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "属性值",
      "example": "测试",
      "_depth": 2
    },
    {
      "name": "value_id",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "属性值ID",
      "example": "0",
      "_depth": 2
    },
    {
      "name": "property_id",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "属性ID",
      "example": "1618",
      "_depth": 1
    },
    {
      "name": "spu_id",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "SPU ID（传SPUID时，关键属性不用传，传关键属性时，SPU ID不用传，两个都传的情况下，会以SPU ID为准，查询SPU）",
      "example": "7120712486076088620",
      "_depth": 0
    },
    {
      "name": "channel",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "0：门捷列夫，1：标准类目2.0",
      "example": "0",
      "_depth": 0
    }
