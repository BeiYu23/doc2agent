      "name": "spu_id",
      "type": "mixed",
      "description": "SPU ID",
      "example": "7120712486076088620"
    },
    {
      "name": "spu_name",
      "type": "string",
      "description": "SPU名",
      "example": "小王子/981013"
    },
    {
      "name": "category_leaf_id",
      "type": "mixed",
      "description": "类目ID",
      "example": "23362"
    },
    {
      "name": "property_infos",
