  "docUrl": "/docs/doudian/product/product-sku-editCode",
  "name": "sku.editCode",
  "platform": "doudian",
  "group": "product",
  "description": "修改sku编码",
  "method": "GET",
  "path": "/sku/editCode",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
