      "name": "code",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "编码",
      "example": "abc",
      "_depth": 0
    },
    {
      "name": "sku_id",
      "in": "body",
      "type": "number",
      "required": false,
      "description": "skuid",
      "example": "123246",
      "_depth": 0
    },
    {
      "name": "out_sku_id",
      "in": "body",
      "type": "number",
      "required": false,
      "description": "外部skuid",
      "example": "32135135",
      "_depth": 0
    },
    {
      "name": "product_id",
      "in": "body",
      "type": "number",
      "required": false,
      "description": "商品id",
      "example": "321545421545474",
      "_depth": 0
    },
    {
      "name": "out_product_id",
      "in": "body",
      "type": "number",
      "required": false,
      "description": "外部商品id",
      "example": "3234156453136545",
      "_depth": 0
    }
  ],
  "responseParams": [],
