{
  "id": "doudian.product.product.qualificationConfig",
  "platform": "doudian",
  "group": "product",
  "name": "product.qualificationConfig",
  "description": "获取类目下需要填写的资质列表",
  "method": "GET",
  "path": "/product/qualificationConfig",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 店铺"
  },
  "notes": [
    "文档书: 商品API（版本 V3.01）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "category_id",
      "in": "body",
      "type": "number",
      "required": true,
      "description": "类目ID",
      "example": "20215",
      "_depth": 0
    }
  ],
  "responseParams": [
    {
      "name": "config_list",
      "type": "array",
      "description": "资质列表",
      "example": ""
    }
  ],
  "responseCodes": [
    {
      "code": "10000",
      "meaning": "success",
      "action": "正常处理"
    },
    {
      "code": "50002",
      "meaning": "业务处理失败 / 请指定类目（sub_code: isv.business-failed:2010004）",
      "action": "请检查类目信息",
      "sub_code": "isv.business-failed:2010004",
      "sub_msg": "请指定类目"
    },
    {
      "code": "50002",
      "meaning": "业务处理失败 / 获取类目配置失败，请稍后重试（sub_code: isv.business-failed:2010001）",
      "action": "请稍后重试",
      "sub_code": "isv.business-failed:2010001",
      "sub_msg": "获取类目配置失败，请稍后重试"
    }
  ],
  "examples": {
    "request": "curl -X GET 'https://openapi-fxg.jinritemai.com/product/qualificationConfig?app_key=your_appkey_here&method=product.qualificationConfig&access_token=your_accesstoken_here&param_json={}&timestamp=2018-06-19%2016:06:59&v=2&sign=your_sign_here'",
    "responseSuccess": {
      "data": {
        "config_list": [
          {
            "is_required": "true",
            "key": "3457058945162709852",
            "matchable_rule": [
              {
                "is_qualification_required": "true",
                "rule_clause": {}
              }
            ],
            "name": "质检报告",
            "text_list": "[           \"需为近一年由第三方权威质检机构出具的一份含有CMA或CNAS认证的质检报告。\",           \"-检测报告里的商品名称、品牌、生产商名称等信息与商详发布的商品信息需一致\",           \"-如报告无品牌名称，需提供含品牌名称、商品名称及生产单位的产品实拍图\",           \"-涉及特殊材质的商品，需提供材质（面料）或成品质检报告，质检报告须包含材质成分（纺织品还需包含面料含量)、对应的商品货号或款号或商品名称。特殊材质包含但不限于蚕丝、真丝、羽绒、鸭绒、鹅绒、羊绒、羊毛、牛皮、羊皮、真皮、移膜革、猪皮等（包括皮草类）。\"         ]"
          }
        ]
      },
      "code": 10000,
      "msg": "success",
      "sub_code": "",
      "sub_msg": ""
    },
    "responseError": {
      "code": 50002,
      "msg": "业务处理失败",
      "sub_code": "isv.business-failed:2010004",
      "sub_msg": "请指定类目"
    }
  },
  "source": "https://op.jinritemai.com/docs/api-docs/14/1382",
  "updatedAt": "2023-01-03",
  "_file_stem": "product-product-qualificationConfig"
}
