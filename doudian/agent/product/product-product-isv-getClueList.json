            "first_name": "女装",
            "pic_url": "http://p3-tt.byteimg.com/image-pair-YOUR_SECRET_KEY~tplv-sfvsc053ke-image.image",
            "second_cid": "20224",
            "second_name": "连衣裙"
          }
        ],
        "total": "100"
      },
      "code": 10000,
      "msg": "success",
      "sub_code": "",
      "sub_msg": ""
    },
    "responseError": {
      "code": 20000,
      "msg": "系统错误",
      "sub_code": "isp.service-error:501",
      "sub_msg": "查询店铺失败"
    }
  },
  "source": "https://op.jinritemai.com/docs/api-docs/14/2195",
  "updatedAt": "2024-02-28",
