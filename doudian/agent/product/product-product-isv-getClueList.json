{
  "id": "doudian.product.product.isv.getClueList",
  "platform": "doudian",
  "group": "product",
  "name": "product.isv.getClueList",
  "description": "提供给isv，根据店铺获取线索",
  "method": "GET",
  "path": "/product/isv/getClueList",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 店铺"
  },
  "notes": [
    "文档书: 商品API（版本 V3.01）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "source_channel_code",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "渠道，competitive：搜索热招商机，shop_exclusive：店铺专属商机，query_none_less：搜索蓝海商机，industry_selected：行业趋势商机",
      "example": "competitive",
      "_depth": 0
    },
    {
      "name": "first_cid",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "一级类目id",
      "example": "20005",
      "_depth": 0
    },
    {
      "name": "second_cid",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "二级类目id",
      "example": "20224",
      "_depth": 0
    },
    {
      "name": "clue_info",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "品牌名或线索名",
      "example": "线索名称",
      "_depth": 0
    },
    {
      "name": "current",
      "in": "body",
      "type": "mixed",
      "required": true,
      "description": "当前页(从1开始)",
      "example": "1",
      "_depth": 0
    },
    {
      "name": "page_size",
      "in": "body",
      "type": "mixed",
      "required": true,
      "description": "每页条数",
      "example": "100",
      "_depth": 0
    },
    {
      "name": "competitive_clue_type",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "爆款类型，0：趋势爆款，1：行业爆款，2：品牌爆款，3：货源地爆款",
      "example": "0",
      "_depth": 0
    }
  ],
  "responseParams": [
    {
      "name": "data",
      "type": "array",
      "description": "返回值",
      "example": ""
    },
    {
      "name": "total",
      "type": "mixed",
      "description": "总条数",
      "example": "100"
    }
  ],
  "responseCodes": [
    {
      "code": "10000",
      "meaning": "success",
      "action": "正常处理"
    },
    {
      "code": "20000",
      "meaning": "系统错误 / 查询店铺失败（sub_code: isp.service-error:501）",
      "action": "联系开发者",
      "sub_code": "isp.service-error:501",
      "sub_msg": "查询店铺失败"
    },
    {
      "code": "20000",
      "meaning": "系统错误 / 系统异常（sub_code: isp.service-error:502）",
      "action": "联系开发者",
      "sub_code": "isp.service-error:502",
      "sub_msg": "系统异常"
    },
    {
      "code": "20000",
      "meaning": "系统错误 / 系统异常（sub_code: isp.service-error:503）",
      "action": "联系开发者",
      "sub_code": "isp.service-error:503",
      "sub_msg": "系统异常"
    },
    {
      "code": "40004",
      "meaning": "非法的参数 / 分页参数不合法（sub_code: isv.parameter-invalid:504）",
      "action": "分页参数不合法",
      "sub_code": "isv.parameter-invalid:504",
      "sub_msg": "分页参数不合法"
    },
    {
      "code": "40004",
      "meaning": "非法的参数 / 渠道类型不存在（sub_code: isv.parameter-invalid:505）",
      "action": "渠道类型不存在",
      "sub_code": "isv.parameter-invalid:505",
      "sub_msg": "渠道类型不存在"
    },
    {
      "code": "50002",
      "meaning": "业务处理失败 / 系统异常（sub_code: isv.business-failed:500）",
      "action": "联系开发者",
      "sub_code": "isv.business-failed:500",
      "sub_msg": "系统异常"
    }
  ],
  "examples": {
    "request": "curl -X GET 'https://openapi-fxg.jinritemai.com/product/isv/getClueList?app_key=your_appkey_here&method=product.isv.getClueList&access_token=your_accesstoken_here&param_json={}&timestamp=2018-06-19%2016:06:59&v=2&sign=your_sign_here'",
    "responseSuccess": {
      "data": {
        "data": [
          {
            "brand_id": "100002",
            "brand_name_cn": "示例品牌名称",
            "brand_name_en": "Example Brand Name",
            "clue_id": "29979",
            "clue_name": "线索名称",
