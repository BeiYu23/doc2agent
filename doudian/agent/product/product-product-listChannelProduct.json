      "name": "main_product_id",
      "in": "body",
      "type": "number",
      "required": true,
      "description": "主商品ID。不需要此查询条件可传0",
      "example": "3232323232323232",
      "_depth": 0
    },
    {
      "name": "channel_id",
      "in": "body",
      "type": "array",
      "required": false,
      "description": "渠道ID",
      "example": "1771739938745351",
      "_depth": 0
    },
    {
      "name": "channel_type",
      "in": "body",
      "type": "array",
      "required": false,
      "description": "渠道类型：3商家自卖，4达人带货",
      "example": "3",
      "_depth": 0
    },
    {
      "name": "kol_id",
      "in": "body",
      "type": "array",
      "required": false,
      "description": "绑定的达人ID",
      "example": "1111",
      "_depth": 0
    },
    {
      "name": "status",
      "in": "body",
      "type": "number",
      "required": false,
      "description": "渠道品状态：0下架，2上架，3封禁",
      "example": "2",
      "_depth": 0
    },
    {
      "name": "start_time",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "有效期开始时间",
      "example": "2023-07-01 00:00:00",
      "_depth": 0
    },
    {
      "name": "end_time",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "有效期结束时间",
      "example": "2023-07-21 00:00:00",
      "_depth": 0
    },
    {
      "name": "page",
      "in": "body",
      "type": "number",
      "required": true,
      "description": "第几页，从1开始",
      "example": "1",
      "_depth": 0
    },
    {
      "name": "size",
      "in": "body",
      "type": "number",
      "required": true,
      "description": "每页数量，默认20，最多50",
      "example": "10",
      "_depth": 0
    }
  ],
  "responseParams": [
    {
      "name": "data",
      "type": "array",
      "description": "渠道品列表",
      "example": ""
    },
    {
      "name": "total",
      "type": "number",
      "description": "总数",
      "example": "12"
    },
    {
      "name": "page",
      "type": "number",
      "description": "当前页面数",
      "example": "1"
    },
    {
      "name": "size",
      "type": "number",
      "description": "每页数目大小",
      "example": "10"
