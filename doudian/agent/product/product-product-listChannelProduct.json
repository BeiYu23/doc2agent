{
  "id": "doudian.product.product.listChannelProduct",
  "platform": "doudian",
  "group": "product",
  "name": "product.listChannelProduct",
  "description": "检索渠道商品",
  "method": "GET",
  "path": "/product/listChannelProduct",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
