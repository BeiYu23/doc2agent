{
  "id": "doudian.product.sku.list",
  "platform": "doudian",
  "group": "product",
  "name": "sku.list",
  "description": "获取商品sku列表",
  "method": "GET",
  "path": "/sku/list",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 店铺"
  },
  "notes": [
    "文档书: 商品API（版本 V2.01）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "product_id",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "商品ID；抖店系统生成。",
      "example": "3213654123157",
      "_depth": 0
    },
    {
      "name": "out_product_id",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "外部商品ID；商家创建商品时自定义。",
      "example": "243523452435",
      "_depth": 0
    }
  ],
  "responseParams": [
    {
      "name": "data",
      "type": "array",
      "description": "sku列表",
      "example": ""
    }
  ],
  "responseCodes": [
    {
      "code": "10000",
      "meaning": "success",
      "action": "正常处理"
    },
    {
      "code": "50002",
      "meaning": "业务处理失败 / 5:[product_id]或[out_product_id]为0（sub_code: isv.business-failed:5）",
      "action": "检查参数",
      "sub_code": "isv.business-failed:5",
      "sub_msg": "5:[product_id]或[out_product_id]为0"
    },
    {
      "code": "40002",
      "meaning": "缺少必选参数 / [product_id]与[out_product_id]参数至少传一个（sub_code: isv.missing-parameter:3）",
      "action": "检查参数",
      "sub_code": "isv.missing-parameter:3",
      "sub_msg": "[product_id]与[out_product_id]参数至少传一个"
    },
    {
      "code": "40004",
      "meaning": "非法的参数 / 该商品不属于你（sub_code: isv.parameter-invalid:4）",
      "action": "检查参数",
      "sub_code": "isv.parameter-invalid:4",
      "sub_msg": "该商品不属于你"
    },
    {
      "code": "50002",
      "meaning": "业务处理失败 / 获取库存数失败（sub_code: isv.business-failed:7）",
      "action": "检查参数",
      "sub_code": "isv.business-failed:7",
      "sub_msg": "获取库存数失败"
    },
    {
      "code": "50002",
      "meaning": "业务处理失败 / 获取总店店铺标签失败（sub_code: isv.business-failed:2010001）",
      "action": "检查参数",
      "sub_code": "isv.business-failed:2010001",
      "sub_msg": "获取总店店铺标签失败"
    },
    {
      "code": "50002",
      "meaning": "业务处理失败 / 请求被限流, 请稍后再试（sub_code: isv.business-failed:2010401）",
      "action": "限流，稍后重试",
      "sub_code": "isv.business-failed:2010401",
      "sub_msg": "请求被限流, 请稍后再试"
    }
  ],
