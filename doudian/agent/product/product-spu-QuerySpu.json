      "example": "F911",
      "_depth": 1
    },
    {
      "name": "book_name",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "【选填】书名",
      "example": "童话世界",
      "_depth": 1
    },
    {
      "name": "goods_number",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "【选填】货号",
      "example": "W91216040101",
      "_depth": 1
    },
    {
      "name": "brand_id",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "【选填】品牌",
      "example": "2078711068",
      "_depth": 1
    },
    {
      "name": "series",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "【选填】系列",
      "example": "JAMES 系列",
      "_depth": 1
    },
    {
      "name": "registration_approval",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "【选填】备案/批准文号",
      "example": "粤G妆网备字2023292746",
      "_depth": 1
    },
    {
      "name": "status",
      "in": "body",
      "type": "array",
      "required": false,
      "description": "【选填】SPU状态：1-上线，2-下线，3-审核中，4-审核不通过",
      "example": "[1,2]",
      "_depth": 0
    },
    {
      "name": "channel",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "0：门捷列夫，1：标准类目2.0",
      "example": "0",
      "_depth": 0
    }
  ],
  "responseParams": [
    {
      "name": "total",
