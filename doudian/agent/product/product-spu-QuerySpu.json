      "in": "body",
      "type": "mixed",
      "required": true,
      "description": "【必填】从第0页开始",
      "example": "0",
      "_depth": 0
    },
    {
      "name": "size",
      "in": "body",
      "type": "mixed",
      "required": true,
      "description": "【必填】最大值为20",
      "example": "20",
      "_depth": 0
    },
    {
      "name": "category_id",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "【选填】叶子类目ID",
      "example": "31860",
      "_depth": 0
    },
    {
      "name": "properties",
      "in": "body",
