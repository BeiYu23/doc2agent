  "docUrl": "/docs/doudian/product/product-compass-CommonProductQueryData",
  "name": "compass.CommonProductQueryData",
  "platform": "doudian",
  "group": "product",
  "description": "数据T+1生成，建议第二天10点之后查询",
  "method": "GET",
  "path": "/compass/CommonProductQueryData",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 店铺"
  },
  "notes": [
    "文档书: 商品API（版本 V1.04）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "end_date",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "周期结束时间,T-1;如3月24号查询近7天的数据，入参date_type=21&&end_date=“2023-03-23”",
      "example": "2022/11/15 23:59:59",
      "_depth": 0
    },
    {
      "name": "date_type",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "REALTIME          = 1   // 实时 BeginDate和EndDate都不传入 表示查询今日实时数据 BeginDate和EndDate都传入 表示查询BeginDate～EndDate的实时数据；     DAY               = 2   // 自然日 BeginDate和EndDate都传入 表示查询趋势 只传入BeginDate表示查询该自然日；     WEEK              = 3   // 自然周 传入BeginDate（周一的日期） 指定对应自然周；     MONTH             = 4   // 自然月 传入BeginDate（月一号的日期） 指定对应自然月；     LAST_ONE_DAYS     = 20  // 近一日；     LAST_SEVEN_DAYS   = 21  // 近七日 当日为基准；     LAST_THREE_DAYS   = 22  // 近三日 当日为基准；     LAST_ONE_MONTH    = 23  // 近30日 当日为基准；",
      "example": "21",
      "_depth": 0
    },
    {
      "name": "activity_id",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "大促id，非大促默认使用空字符串“”",
      "example": "105241",
      "_depth": 0
    },
    {
      "name": "begin_date",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "周期开始时间",
      "example": "2022/11/15 00:00:00",
      "_depth": 0
    },
    {
      "name": "product_id",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "商品id",
      "example": "3579566747054921902",
      "_depth": 0
    },
    {
      "name": "page_no",
      "in": "body",
      "type": "number",
      "required": false,
      "description": "页码，默认为1",
      "example": "1",
      "_depth": 0
    },
    {
      "name": "page_size",
      "in": "body",
      "type": "number",
      "required": false,
      "description": "页面大小，默认为10",
      "example": "10",
      "_depth": 0
    },
    {
      "name": "sorted_field",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "排序字段，支持product_show_ucnt,product_click_ucnt,product_click_ratio,pay_ucnt,pay_cnt,product_pay_ratio",
      "example": "product_show_ucnt",
      "_depth": 0
    },
    {
      "name": "is_asc",
      "in": "body",
      "type": "boolean",
      "required": false,
      "description": "排序方向，默认降序",
      "example": "false",
      "_depth": 0
    }
  ],
  "responseParams": [
    {
      "name": "product_list",
      "type": "array",
      "description": "商品数据",
      "example": ""
    }
  ],
