{
  "id": "doudian.product.sku.detail",
  "platform": "doudian",
  "group": "product",
  "name": "sku.detail",
  "description": "获取商品sku详情",
  "method": "GET",
  "path": "/sku/detail",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 店铺"
  },
  "notes": [
    "文档书: 商品API（版本 V2.01）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "sku_id",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "sku id",
      "example": "1234",
      "_depth": 0
    },
    {
      "name": "code",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "sku code",
      "example": "cccc",
      "_depth": 0
    }
  ],
  "responseParams": [
    {
      "name": "id",
      "type": "mixed",
      "description": "sku id",
      "example": "1111"
    },
    {
      "name": "open_user_id",
      "type": "mixed",
      "description": "app_key",
      "example": "2222"
    },
    {
      "name": "out_sku_id",
      "type": "mixed",
      "description": "外部的skuId",
      "example": "3333"
    },
    {
      "name": "product_id",
      "type": "mixed",
      "description": "商品ID",
      "example": "4444"
    },
    {
      "name": "spec_detail_id1",
      "type": "mixed",
      "description": "第一级子规格",
      "example": "5555"
    },
    {
      "name": "spec_detail_id2",
      "type": "mixed",
      "description": "第二级子规格",
      "example": "0"
    },
    {
      "name": "spec_detail_id3",
      "type": "mixed",
      "description": "第三级子规格",
      "example": "0"
    },
    {
      "name": "spec_detail_name1",
      "type": "string",
      "description": "第一级子规格名",
      "example": "规格1"
    },
    {
      "name": "spec_detail_name2",
      "type": "string",
      "description": "第二级子规格名",
      "example": "规格2"
    },
    {
      "name": "spec_detail_name3",
      "type": "string",
      "description": "第三级子规格名",
      "example": "规格3"
    },
    {
      "name": "customs_report_info",
      "type": "object",
      "description": "海关申报要素",
      "example": ""
    },
    {
      "name": "price",
      "type": "mixed",
      "description": "价格",
      "example": "12"
    },
    {
      "name": "settlement_price",
      "type": "mixed",
      "description": "结算价格",
      "example": "12"
    },
    {
      "name": "spec_id",
      "type": "mixed",
      "description": "规格ID",
      "example": "2333"
    },
    {
      "name": "create_time",
      "type": "mixed",
      "description": "创建时间",
      "example": "1621611875"
    },
    {
      "name": "code",
      "type": "string",
      "description": "sku外部编码",
      "example": "cccc"
    },
    {
      "name": "sku_type",
      "type": "mixed",
      "description": "0-普通 1-区域库存",
      "example": "0"
    },
    {
      "name": "supplier_id",
      "type": "string",
      "description": "供应商ID",
      "example": "333"
    },
    {
      "name": "stock_num",
      "type": "mixed",
      "description": "sku_type=0时，表示库存数量 sku_type=1时，使用stock_map",
      "example": "11"
    },
    {
      "name": "prehold_stock_num",
      "type": "mixed",
      "description": "sku_type=0时，表示预占库存数量 sku_type=1时，使用prehold_stock_map",
      "example": "11"
    },
    {
      "name": "prom_stock_num",
      "type": "mixed",
      "description": "活动库存",
      "example": "11"
    },
    {
      "name": "step_stock_num",
      "type": "mixed",
      "description": "阶梯库存",
      "example": "11"
    },
    {
      "name": "prehold_step_stock_num",
      "type": "mixed",
      "description": "预占阶梯库存",
      "example": "11"
    },
    {
      "name": "prom_step_stock_num",
      "type": "mixed",
      "description": "活动阶梯库存",
      "example": "11"
    },
    {
      "name": "stock_map",
      "type": "string",
      "description": "如果sku_type=0，为空 如果sku_type=1，则为区域仓库存映射表，key为out_warehouse_id，value为库存",
      "example": "无"
    },
    {
      "name": "prehold_stock_map",
      "type": "string",
      "description": "如果sku_type=0，为空 如果sku_type=1，则为区域仓库存映射表，key为out_warehouse_id，value为占用库存",
      "example": "无"
    },
    {
      "name": "product_id_str",
      "type": "string",
      "description": "商品 ID 字符串",
      "example": "111"
    },
    {
      "name": "ship_rule_map",
      "type": "string",
      "description": "如果sku_type=0，为空 如果sku_type=1，则为区域仓库存映射表，key为out_warehouse_id，value为sku 在对应仓中的发货时效",
      "example": ""
    },
    {
      "name": "is_suit",
      "type": "mixed",
      "description": "是否套装，0 否，1 是",
      "example": "1"
    },
    {
      "name": "suit_num",
      "type": "mixed",
      "description": "套装内数量",
      "example": "10"
    },
    {
      "name": "volume",
      "type": "mixed",
      "description": "容量单位ml，酒类专有",
      "example": "100"
    },
    {
      "name": "status",
      "type": "mixed",
      "description": "sku状态：0有效，1无效",
      "example": "0"
    },
    {
      "name": "multi_time_stocks",
      "type": "array",
      "description": "时效库存",
      "example": ""
    },
    {
      "name": "batch_stocks",
      "type": "array",
      "description": "批次库存",
      "example": ""
    },
    {
      "name": "gift_suit_detail",
      "type": "array",
      "description": "礼盒明细品（子品）列表",
      "example": ""
    }
  ],
  "responseCodes": [
    {
      "code": "10000",
      "meaning": "success",
      "action": "正常处理"
    },
    {
      "code": "40004",
      "meaning": "非法的参数 / code: 1715469761741840, 找不到对应的sku（sub_code: isv.parameter-invalid:20050）",
