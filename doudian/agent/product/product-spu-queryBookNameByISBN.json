      "_depth": 0
    },
    {
      "name": "page_size",
      "in": "body",
      "type": "mixed",
      "required": true,
      "description": "页大小。范围1-100",
      "example": "10",
      "_depth": 0
    },
    {
      "name": "channel",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "获取数据的类目版本。0:门捷列夫类目；1:标准类目",
      "example": "1/0",
      "_depth": 0
    }
