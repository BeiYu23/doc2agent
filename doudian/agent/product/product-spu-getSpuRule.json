      "action": "查看操作人信息",
      "sub_code": "isv.risk-control-failed:20121002",
      "sub_msg": "操作人非法"
    },
    {
      "code": "50002",
      "meaning": "业务处理失败 / 商家不存在（sub_code: isv.business-failed:20121103）",
      "action": "查看操作人信息",
      "sub_code": "isv.business-failed:20121103",
