    },
    {
      "code": "20000",
      "meaning": "系统错误 / 读取失败（sub_code: isp.service-error:2010013）",
      "action": "重试",
      "sub_code": "isp.service-error:2010013",
      "sub_msg": "读取失败"
    },
    {
      "code": "50002",
      "meaning": "业务处理失败 / 2012001:获取商家信息失败（sub_code: isv.business-failed:2012001）",
