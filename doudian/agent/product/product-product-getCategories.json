{
  "id": "doudian.product.product.getCategories",
  "platform": "doudian",
  "group": "product",
  "name": "product.getCategories",
  "description": "获取商家可选类目",
  "method": "GET",
  "path": "/product/getCategories",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 店铺"
  },
  "notes": [
    "文档书: 商品API（版本 V2.01）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "id",
      "in": "body",
      "type": "mixed",
      "required": true,
      "description": "父类目id，传0可以获取一级类目",
      "example": "0",
      "_depth": 0
    },
    {
      "name": "channel",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "类目渠道，0：门捷列夫类目，1:标准类目；若不传入，当id=0时，由类目服务内部自行开关控制：0:默认查询门捷列夫类目；1:获取商家灰度标，跟随大盘灰度节奏切换；2:默认查询标准类目",
      "example": "0",
      "_depth": 0
    }
  ],
  "responseParams": [
    {
      "name": "category_list",
      "type": "array",
      "description": "父类目本身信息以及子类目信息",
      "example": ""
    }
  ],
  "responseCodes": [
    {
      "code": "10000",
      "meaning": "success",
      "action": "正常处理"
    },
    {
      "code": "40004",
      "meaning": "非法的参数（sub_code: isv.parameter-invalid:2012004）",
      "action": "请检查参数后重试",
