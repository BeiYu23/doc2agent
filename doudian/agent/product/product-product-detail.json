      "type": "string",
      "description": "【即将废弃】推荐使用product_format_new；属性名称|属性值 之间用|分隔, 多组之间用^分开",
      "example": "{\"货号\":\"8888\"}"
    },
    {
      "name": "spec_pics",
      "type": "array",
      "description": "规格图片",
      "example": ""
    },
    {
      "name": "spec_prices",
      "type": "array",
