{
  "id": "doudian.product.product.detail",
  "platform": "doudian",
  "group": "product",
  "name": "product.detail",
  "description": "查询商品详情",
  "method": "GET",
  "path": "/product/detail",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 店铺"
  },
  "notes": [
    "文档书: 商品API（版本 V12.01）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "product_id",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "商品ID，抖店系统生成，店铺下唯一；长度19位",
      "example": "3558192687276554544",
      "_depth": 0
    },
    {
      "name": "out_product_id",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "外部商家编码，商家自定义字段",
      "example": "dy001",
      "_depth": 0
    },
    {
      "name": "show_draft",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "true：读取草稿数据；false：读取线上数据；不传默认为false",
      "example": "false",
      "_depth": 0
    },
    {
      "name": "store_id",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "门店ID，不建议小时达一期用，即时零售单店版，无需使用",
      "example": "1111420330",
      "_depth": 0
    }
  ],
  "responseParams": [
    {
      "name": "product_id",
      "type": "mixed",
      "description": "商品ID，抖店系统生成，店铺下唯一；长度19位。",
      "example": "3539925204033339668"
    },
    {
      "name": "product_id_str",
      "type": "string",
      "description": "商品ID（字符串类型），抖店系统生成，店铺下唯一；长度19位。",
      "example": "3539925204033339668"
    },
    {
      "name": "out_product_id",
      "type": "mixed",
      "description": "【即将废弃】外部商家编码，商家自定义字段。推荐使用，outer_product_id字段",
      "example": "133321"
    },
    {
      "name": "outer_product_id",
      "type": "string",
      "description": "外部商家编码，商家自定义字段，支持最多 255个字符",
      "example": "dy001"
    },
    {
      "name": "open_user_id",
      "type": "mixed",
      "description": "【已废弃】open应用id",
      "example": "\"\""
    },
    {
      "name": "name",
      "type": "string",
      "description": "商品标题，规则：至少输入8个字（16个字符）以上~输入30个字（60个字符）以内。；标题不规范会引起商品下架，影响您的正常销售，详见商品发布规范：https://school.jinritemai.com/doudian/web/article/101800?from=shop_article",
      "example": "夏季男生白色短袖"
    },
    {
      "name": "description",
      "type": "string",
      "description": "商品详情，最大支持50张图片，单张详情图宽高比不超2000*2000px，大小5M内，仅支持jpg/jpeg/png格式，返回HTML格式；注意：商品详情不规范，会引起商品下架，影响您的正常销售：https://school.jinritemai.com/doudian/web/article/101800?from=shop_article",
      "example": "<p><img src=\\\"https://p3-aio.ecombdimg.com/obj/ecom-shop-material/v1_xPfNJOkX_71153427046487984750183_661ff1f563801d97f382e0ac114a09e6_sx_805824_www933-933\\\" style=\\\"max-width:100%;\\\"/><img src=\\\"https://p3-aio.ecombdimg.com/obj/ecom-shop-material/v1_xPfNJOkX_71153426724709337920183_dd825b6f3c1bc43ec26faea488447709_sx_1059417_www1080-933\\\" style=\\\"max-width:100%;\\\"/><img src=\\\"https://p3-aio.ecombdimg.com/obj/ecom-shop-material/v1_xPfNJOkX_71153465487927217040183_d963cc36ef6e66c0cba70e4cb2188f88_sx_436442_www1920-1080\\\" style=\\\"max-width:100%;\\\"/></p>"
    },
    {
      "name": "delivery_method",
      "type": "mixed",
      "description": "承诺发货时间，单位是天; 不传则默认为2天，当presell_type为0或2均只支持传入2；当presell_type为1时支持可选值为: 2、3、5、7、10、15；",
      "example": "7"
    },
    {
      "name": "cdf_category",
      "type": "string",
      "description": "海南免税，海关限购分类编码，仅海淘商品有值返回。",
      "example": "\"\""
    },
    {
      "name": "status",
      "type": "mixed",
      "description": "商品在店铺中状态: 0-在线；1-下线；2-删除；详见商品状态机：https://op.jinritemai.com/docs/question-docs/92/2070",
      "example": "1"
    },
    {
      "name": "spec_id",
      "type": "mixed",
      "description": "商品规格，新增商品是全局唯一，注意：有部分历史存量商品可能存在规格复用",
      "example": "1737144307943485"
    },
    {
      "name": "check_status",
      "type": "mixed",
      "description": "商品审核状态: 1-未提交；2-待审核；3-审核通过；4-审核未通过；5-封禁；7-审核通过待上架；详见商品状态机：https://op.jinritemai.com/docs/question-docs/92/2070",
      "example": "1"
    },
    {
      "name": "mobile",
      "type": "string",
      "description": "【已废弃】手机号",
      "example": "15677775555"
    },
    {
      "name": "brand_id",
      "type": "mixed",
      "description": "【已废弃】品牌id，推荐使用standard_brand_id字段，通过【/brand/list】获取，无品牌id商品返回默认值：596120136；",
      "example": "596120136"
    },
    {
      "name": "is_sub_product",
      "type": "boolean",
      "description": "是否是组合商品的子商品；true-是，false-不是；",
      "example": "true"
    },
    {
      "name": "draft_status",
      "type": "mixed",
      "description": "草稿状态；0-无草稿,1-未提审,2-待审核,3-审核通过,4-审核未通过。详见：https://op.jinritemai.com/docs/question-docs/92/2070",
      "example": "2"
    },
    {
      "name": "category_detail",
      "type": "object",
      "description": "类目详情；商品类目id可使用【/shop/getShopCategory】查询",
      "example": ""
    },
    {
      "name": "pay_type",
      "type": "mixed",
      "description": "【已废弃】支持的支付方式：0货到付款 1在线支付 2两者都支持",
      "example": "1"
    },
    {
      "name": "recommend_remark",
      "type": "string",
      "description": "【已废弃】商家推荐语",
      "example": "真的很好啊"
    },
    {
      "name": "extra",
      "type": "string",
      "description": "额外信息，如资质",
      "example": "{\\\"category_detail\\\":{\\\"first_cid\\\":20117,\\\"second_cid\\\":22139,\\\"third_cid\\\":28901,\\\"fourth_cid\\\":31800,\\\"first_cname\\\":\\\"本地生活服务\\\",\\\"second_cname\\\":\\\"餐饮美食卡券\\\",\\\"third_cname\\\":\\\"甜品/冰淇淋/咖啡/冷饮\\\",\\\"fourth_cname\\\":\\\"咖啡\\\",\\\"is_leaf\\\":true},\\\"class_quality\\\":\\\"\\\",\\\"is_publish\\\":1,\\\"quality_opId\\\":\\\"7132044312682119463\\\",\\\"quality_report\\\":\\\"\\\"}"
    },
    {
      "name": "is_create",
      "type": "mixed",
      "description": "【已废弃】无业务意义",
      "example": "【已废弃】"
    },
    {
      "name": "create_time",
      "type": "string",
      "description": "商品创建时间，时间格式：yyyy-mm-dd hh:mm:ss",
      "example": "2022-07-04 13:29:47"
    },
    {
      "name": "update_time",
      "type": "string",
      "description": "商品更新时间，时间格式：yyyy-mm-dd hh:mm:ss",
      "example": "2022-07-08T16:29:01+08:00"
    },
    {
      "name": "pic",
      "type": "array",
