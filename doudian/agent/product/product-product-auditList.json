{
  "id": "doudian.product.product.auditList",
  "platform": "doudian",
  "group": "product",
  "name": "product.auditList",
  "description": "审核记录列表",
  "method": "GET",
  "path": "/product/auditList",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 店铺"
  },
  "notes": [
    "文档书: 商品API（版本 V2.01）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "publish_status",
      "in": "body",
      "type": "mixed",
      "required": true,
      "description": "指定审核状态返回商品列表：0-审核中 1-审核通过 2-审核拒绝",
      "example": "0",
      "_depth": 0
    },
    {
      "name": "page",
      "in": "body",
      "type": "mixed",
      "required": true,
      "description": "第几页（第一页为0，最大为99）",
      "example": "0",
      "_depth": 0
    },
    {
      "name": "size",
      "in": "body",
      "type": "mixed",
      "required": true,
      "description": "每页返回条数，最多支持100条",
      "example": "20",
      "_depth": 0
    },
    {
      "name": "product_id",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "商品id",
      "example": "11",
      "_depth": 0
    }
  ],
  "responseParams": [
    {
      "name": "records",
      "type": "array",
      "description": "审核记录列表",
      "example": ""
    },
    {
      "name": "total",
      "type": "mixed",
      "description": "总数量",
      "example": "11"
    }
  ],
  "responseCodes": [
    {
      "code": "10000",
      "meaning": "success",
      "action": "正常处理"
    },
    {
      "code": "50002",
      "meaning": "业务处理失败 / 2010001:系统异常,请重试（sub_code: isv.business-failed:2010001）",
      "action": "请稍后重试",
      "sub_code": "isv.business-failed:2010001",
      "sub_msg": "2010001:系统异常,请重试"
    },
    {
      "code": "50002",
      "meaning": "业务处理失败 / 2010004:page or size is invalid（sub_code: isv.business-failed:2010004）",
      "action": "page or size is invalid",
      "sub_code": "isv.business-failed:2010004",
      "sub_msg": "2010004:page or size is invalid"
    }
  ],
  "examples": {
    "request": "curl -X GET 'https://openapi-fxg.jinritemai.com/product/auditList?app_key=your_appkey_here&method=product.auditList&access_token=your_accesstoken_here&param_json={}&timestamp=2018-06-19%2016:06:59&v=2&sign=your_sign_here'",
    "responseSuccess": {
