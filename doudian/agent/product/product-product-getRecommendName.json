{
  "id": "doudian.product.product.getRecommendName",
  "platform": "doudian",
  "group": "product",
  "name": "product.getRecommendName",
  "description": "根据商品信息推荐商品标题相关信息",
  "method": "GET",
  "path": "/product/getRecommendName",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 店铺"
  },
  "notes": [
    "文档书: 商品API（版本 V1.06）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "scene",
      "in": "body",
      "type": "array",
      "required": true,
      "description": "暂时仅开放一种场景：1. product_name_prefix，表示基于 命中的商品类目属性 推荐 商品标题前缀",
      "example": "[\"product_name_prefix\"]",
      "_depth": 0
    },
    {
      "name": "category_leaf_id",
      "in": "body",
      "type": "mixed",
      "required": true,
      "description": "商品叶子类目id，请先使用【/product/getProductUpdateRule】接口查询类目id查看recommend_name_rule. satisfy_prefix是否=true",
      "example": "26150",
      "_depth": 0
    },
    {
      "name": "first_cid",
      "in": "body",
      "type": "mixed",
      "required": true,
      "description": "一级类目id，scene为product_name_prefix时必传，没有时传0",
      "example": "20080",
      "_depth": 0
    },
    {
      "name": "first_cid_name",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "一级类目名，scene为product_name_prefix时必传",
      "example": "时尚饰品",
      "_depth": 0
    },
    {
      "name": "second_cid",
      "in": "body",
      "type": "mixed",
      "required": true,
      "description": "二级类目id，scene为product_name_prefix时必传，没有时传0",
      "example": "20998",
      "_depth": 0
    },
    {
      "name": "second_cid_name",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "二级类目名，scene为product_name_prefix时必传",
      "example": "耳饰",
      "_depth": 0
    },
    {
      "name": "third_cid",
      "in": "body",
      "type": "mixed",
      "required": true,
      "description": "三级类目id，scene为product_name_prefix时必传，没有时传0",
      "example": "26150",
      "_depth": 0
    },
    {
      "name": "third_cid_name",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "三级类目名，scene为product_name_prefix时必传",
      "example": "耳钉",
      "_depth": 0
    },
    {
      "name": "select_property",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "商品类目属性，参考\"select_property\":{\"1687\":[{\"value\":0,\"name\":\"填入品牌名\"}],\"3320\":[{\"value\":18972,\"name\":\"99新\"}]}",
      "example": "{\"1687\":[{\"value\":0,\"name\":\"填入品牌名\"}],\"3320\":[{\"value\":18972,\"name\":\"99新\"}]}",
      "_depth": 0
    },
    {
      "name": "value",
      "in": "body",
      "type": "mixed",
      "required": true,
      "description": "属性id",
      "example": "27182",
      "_depth": 1
    },
    {
      "name": "name",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "属性名称",
      "example": "钛钢",
      "_depth": 1
    },
    {
      "name": "use_brand_name",
      "in": "body",
      "type": "boolean",
      "required": false,
      "description": "是否勾选使用品牌名",
      "example": "false",
      "_depth": 0
    }
  ],
  "responseParams": [
    {
      "name": "recommend_name",
      "type": "array",
      "description": "商品标题推荐结果，当返回值为空时，使用【/product/getProductUpdateRule】接口查询类目id查看recommend_name_rule.satisfy_prefix是否=true",
      "example": ""
    }
  ],
  "responseCodes": [
    {
      "code": "10000",
      "meaning": "success",
      "action": "正常处理"
    },
    {
      "code": "20000",
      "meaning": "系统错误（sub_code: isp.service-error:2010001）",
      "action": "重试",
      "sub_code": "isp.service-error:2010001",
      "sub_msg": "系统错误"
    },
    {
      "code": "40004",
      "meaning": "非法的参数 / 参数错误（sub_code: isv.parameter-invalid:2010004）",
      "action": "检查参数",
      "sub_code": "isv.parameter-invalid:2010004",
      "sub_msg": "参数错误"
    },
    {
      "code": "40004",
      "meaning": "非法的参数 / 不存在有效的标题推荐类场景（sub_code: isv.parameter-invalid:2010342）",
      "action": "检查scene参数",
      "sub_code": "isv.parameter-invalid:2010342",
      "sub_msg": "不存在有效的标题推荐类场景"
    },
    {
      "code": "50002",
      "meaning": "业务处理失败 / 110101049:没有品牌使用权限，不能加到标题前缀中（sub_code: isv.business-failed:110101049）",
      "action": "110101049:没有品牌使用权限，不能加到标题前缀中",
      "sub_code": "isv.business-failed:110101049",
      "sub_msg": "110101049:没有品牌使用权限，不能加到标题前缀中"
    }
  ],
  "examples": {
    "request": "curl -X GET 'https://openapi-fxg.jinritemai.com?app_key=your_appkey_here&method=&access_token=your_accesstoken_here&param_json={}&timestamp=2018-06-19%2016:06:59&v=2&sign=your_sign_here'",
    "responseSuccess": {
      "code": 10000,
      "msg": "success",
      "sub_code": "",
      "sub_msg": ""
    },
    "responseError": {
      "code": 20000,
      "msg": "系统错误",
      "sub_code": "isp.service-error:2010001",
