{
  "id": "doudian.product.product.title.recommend.query",
  "platform": "doudian",
  "group": "product",
  "name": "product.title.recommend.query",
  "description": "商品标题优化工具",
  "method": "GET",
  "path": "/product/title/recommend/query",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 店铺"
  },
  "notes": [
    "文档书: 商品API（版本 V1.01）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "merchant_id",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "服务商 ID",
      "example": "3914684281657388",
      "_depth": 0
    },
    {
      "name": "title",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "标题（仅参考）",
      "example": "夏季连衣裙",
      "_depth": 0
    }
  ],
  "responseParams": [
    {
      "name": "recommend_query_list",
      "type": "array",
      "description": "推荐词列表",
      "example": ""
    }
  ],
  "responseCodes": [
    {
      "code": "10000",
      "meaning": "成功",
      "action": "正常处理"
    }
  ],
  "examples": {
    "request": "curl -X GET 'https://openapi-fxg.jinritemai.YOUR_SECRET_KEY?app_key=your_appkey_here&method=product.title.recommend.query&access_token=your_accesstoken_here&param_json={}&timestamp=2018-06-19%2016:06:59&v=2&sign=your_sign_here'",
    "responseSuccess": {
      "data": {
        "recommend_query_list": [
          {
            "date": "2022-07-12",
            "leaf_category_id": "1123",
            "query": "夏季连衣裙",
            "search_host_degree": "1"
          }
        ]
      },
      "code": 10000,
      "msg": "success",
      "sub_code": "",
      "sub_msg": ""
    },
    "responseError": {
      "sub_code": "",
      "sub_msg": ""
    }
  },
  "source": "https://op.jinritemai.com/docs/api-docs/14/2163",
