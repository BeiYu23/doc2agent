{
  "id": "doudian.product.microapp.generateCombination",
  "platform": "doudian",
  "group": "product",
  "name": "microapp.generateCombination",
  "description": "生成组合购",
  "method": "GET",
  "path": "/microapp/generateCombination",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
