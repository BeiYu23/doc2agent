  ],
  "params": [
    {
      "name": "title",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "当前生成组合购的标题，长度为6-10个字符",
      "example": "组合购标题",
      "_depth": 0
    },
    {
      "name": "creator",
      "in": "body",
      "type": "number",
      "required": true,
      "description": "操作者账号id，飞鸽客服场景下即飞鸽客服id",
      "example": "11111",
      "_depth": 0
    },
    {
      "name": "comment",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "卖家留言，用于展示在C端组件首页上",
      "example": "这是商品组合购",
      "_depth": 0
    },
    {
      "name": "items",
      "in": "body",
      "type": "array",
      "required": false,
      "description": "商品信息",
      "example": "",
      "_depth": 0
    },
    {
      "name": "product_id",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "商品id",
      "example": "11",
      "_depth": 1
    },
    {
      "name": "sku_id",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "sku id",
      "example": "11",
      "_depth": 1
    },
    {
      "name": "sku_num",
      "in": "body",
      "type": "number",
      "required": true,
      "description": "sku数量",
      "example": "1",
      "_depth": 1
    },
    {
      "name": "price",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "价格",
      "example": "111",
      "_depth": 1
    }
  ],
  "responseParams": [
    {
      "name": "combo_link",
      "type": "string",
      "description": "生成的组合购短链接",
      "example": "https://v.douyin.com/dfadfsd"
