    {
      "name": "product_format_new",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "商品类目属性",
      "example": "{}",
      "_depth": 0
    },
    {
      "name": "value",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "属性id",
      "example": "32314111111",
