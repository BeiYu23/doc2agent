{
  "id": "doudian.product.product.qualityList",
  "platform": "doudian",
  "group": "product",
  "name": "product.qualityList",
  "description": "查询店铺商品质量情况，对标后台商品成长中心",
  "method": "GET",
  "path": "/product/qualityList",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 店铺"
  },
  "notes": [
    "文档书: 商品API（版本 V3.07）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "product_id",
      "in": "body",
      "type": "number",
      "required": false,
      "description": "商品ID",
      "example": "3502373827210525080",
      "_depth": 0
    },
    {
      "name": "product_name",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "商品名字",
      "example": "奈克牌皮鞋",
      "_depth": 0
    },
    {
      "name": "order_by",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "排序方式，降序“desc”，升序“asc”， 不传默认降序",
      "example": "desc",
      "_depth": 0
    },
    {
      "name": "page",
      "in": "body",
      "type": "number",
      "required": true,
      "description": "分页参数，页数从1开始",
      "example": "1",
      "_depth": 0
    },
    {
      "name": "page_size",
      "in": "body",
      "type": "number",
      "required": true,
      "description": "分页参数，每页大小，填写范围1~100；",
      "example": "20",
      "_depth": 0
    },
    {
      "name": "task_id",
      "in": "body",
      "type": "number",
      "required": true,
      "description": "【已废弃】开发者可以传入：9999999999",
      "example": "11013491",
      "_depth": 0
    },
    {
      "name": "diagnose_status",
      "in": "body",
      "type": "array",
      "required": false,
      "description": "商品诊断状态，0-待诊断；1-待优化；2-已修改审核中；3-已优化；以前的status 字段因为配置错误已经删除，请使用此新字段",
      "example": "[1]",
      "_depth": 0
    },
    {
      "name": "quality_score_version",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "质量分版本，枚举：new_quality_score-新版，middle_score-旧版中标质量分已废弃。",
      "example": "middle_score",
      "_depth": 0
    }
  ],
  "responseParams": [
    {
      "name": "quality_list",
      "type": "array",
      "description": "商品质量列表",
      "example": ""
    },
    {
      "name": "total",
      "type": "number",
      "description": "店铺待优化商品总量",
      "example": "50"
    }
  ],
  "responseCodes": [
    {
      "code": "10000",
      "meaning": "success",
      "action": "正常处理"
    },
    {
      "code": "40002",
      "meaning": "缺少必选参数 / 缺少必要参数（sub_code: isv.missing-parameter:2030003）",
      "action": "补充必要参数",
      "sub_code": "isv.missing-parameter:2030003",
      "sub_msg": "缺少必要参数"
    },
    {
      "code": "40004",
      "meaning": "非法的参数 / 参数值非法（sub_code: isv.parameter-invalid:2030004）",
      "action": "按要求填写参数值",
      "sub_code": "isv.parameter-invalid:2030004",
      "sub_msg": "参数值非法"
    },
    {
      "code": "20000",
      "meaning": "系统错误 / 系统异常（sub_code: isp.service-error:2030001）",
      "action": "等待后重试",
      "sub_code": "isp.service-error:2030001",
      "sub_msg": "系统异常"
    },
    {
      "code": "20000",
      "meaning": "系统错误 / 读取数据失败（sub_code: isp.service-error:2030201）",
      "action": "系统异常，请稍后重试",
      "sub_code": "isp.service-error:2030201",
      "sub_msg": "读取数据失败"
    },
    {
      "code": "50002",
      "meaning": "业务处理失败 / 2030013:读取商品失败（sub_code: isv.business-failed:2030013）",
      "action": "系统异常，请稍后重试",
      "sub_code": "isv.business-failed:2030013",
      "sub_msg": "2030013:读取商品失败"
    }
  ],
  "examples": {
    "request": "curl -X GET 'https://openapi-fxg.jinritemai.com?app_key=your_appkey_here&method=&access_token=your_accesstoken_here&param_json={}&timestamp=2018-06-19%2016:06:59&v=2&sign=your_sign_here'",
    "responseSuccess": {
      "code": 10000,
      "msg": "success",
      "sub_code": "",
      "sub_msg": ""
    },
    "responseError": {
      "code": 40002,
      "msg": "缺少必选参数",
      "sub_code": "isv.missing-parameter:2030003",
      "sub_msg": "缺少必要参数"
    }
  },
  "source": "https://op.jinritemai.com/docs/api-docs/14/938",
  "updatedAt": "2025-03-10",
  "_file_stem": "product-product-qualityList"
}
