      "name": "end_time",
      "in": "body",
      "type": "number",
      "required": true,
      "description": "玩法结束时间",
      "example": "1755267804",
      "_depth": 0
    },
    {
      "name": "product_query_condition_option",
      "in": "body",
      "type": "object",
      "required": false,
      "description": "商品查询条件选项",
      "example": "",
      "_depth": 0
    },
    {
      "name": "product_str_list",
      "in": "body",
      "type": "array",
      "required": false,
      "description": "商品ID列表或者商品名称列表",
      "example": "3641483758168855009",
      "_depth": 1
    },
    {
      "name": "product_number",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "货品号，商家内部编号",
      "example": "2033HH",
      "_depth": 1
    },
    {
      "name": "page_size",
      "in": "body",
      "type": "number",
      "required": true,
      "description": "页大小。最多支持100。",
      "example": "20",
      "_depth": 0
    },
    {
      "name": "activity_code",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "玩法编码。限时抢购：LimitTimeTimeBuy；限量抢购：LimitQuantityTimeBuy；普通降级促销：OrdinaryTimeBuy",
