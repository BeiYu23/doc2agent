      "_depth": 0
    },
    {
      "name": "start_time",
      "in": "body",
      "type": "number",
      "required": true,
      "description": "玩法开始时间",
      "example": "1755267804",
      "_depth": 0
    },
    {
      "name": "page",
      "in": "body",
      "type": "number",
      "required": true,
      "description": "页号。",
      "example": "1",
      "_depth": 0
    },
    {
      "name": "common_ctx_info",
      "in": "body",
      "type": "object",
      "required": false,
      "description": "通用上下文",
      "example": "",
