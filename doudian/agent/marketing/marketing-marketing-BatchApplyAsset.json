      "type": "string",
      "required": true,
      "description": "幂等id，请求方的唯一单号",
      "example": "\"123456789\"",
      "_depth": 0
    },
    {
      "name": "user_info",
      "in": "body",
      "type": "object",
      "required": true,
      "description": "用户信息",
      "example": "",
      "_depth": 0
    },
    {
      "name": "doudian_open_id",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "抖店openID",
      "example": "123456",
      "_depth": 1
    },
    {
      "name": "req_item_list",
      "in": "body",
      "type": "array",
      "required": true,
      "description": "待资产领取列表",
      "example": "",
      "_depth": 0
    },
    {
      "name": "apply_amount",
      "in": "body",
      "type": "mixed",
      "required": true,
      "description": "领券时固定传0",
      "example": "0",
      "_depth": 1
    },
    {
      "name": "coupon_meta_id",
      "in": "body",
      "type": "mixed",
      "required": true,
      "description": "批次Id，包含优惠券批次和红包批次ID",
      "example": "12345",
      "_depth": 1
    },
    {
      "name": "apply_num",
      "in": "body",
      "type": "mixed",
      "required": true,
      "description": "领取张数",
      "example": "1",
      "_depth": 1
    }
