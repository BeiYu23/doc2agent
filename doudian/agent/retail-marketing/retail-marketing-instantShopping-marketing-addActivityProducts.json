{
  "id": "doudian.retail-marketing.instantShopping.marketing.addActivityProducts",
  "platform": "doudian",
  "group": "retail-marketing",
  "name": "instantShopping.marketing.addActivityProducts",
  "description": "添加商品",
  "method": "GET",
  "path": "YOUR_SECRET_KEY",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 店铺"
  },
  "notes": [
    "文档书: 营销管理API【即时零售】（版本 V1.01）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "activity_id",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "活动id",
      "example": "123",
      "_depth": 0
    },
    {
      "name": "activity_type",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "活动类型，10：限时限量购，20：店铺券； 30：商品券",
      "example": "10",
      "_depth": 0
    },
    {
      "name": "activity_sub_type",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "活动子类型， 101限时秒杀，102，普通降价促销",
      "example": "101",
      "_depth": 0
    },
    {
      "name": "create_details",
      "in": "body",
      "type": "array",
      "required": true,
      "description": "待创建的优惠明细，批量创建时多条detail必须属于同一个门店",
      "example": "",
      "_depth": 0
    },
    {
      "name": "main_product_id",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "主品id",
      "example": "123",
      "_depth": 1
    },
    {
      "name": "main_sku_id",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "主skuId",
      "example": "123",
      "_depth": 1
    },
    {
      "name": "activity_detail",
      "in": "body",
      "type": "object",
      "required": false,
      "description": "优惠详情",
      "example": "",
      "_depth": 1
    },
    {
      "name": "stock_option",
      "in": "body",
      "type": "object",
      "required": false,
      "description": "库存设置",
      "example": "",
      "_depth": 2
    },
    {
      "name": "use_max_limit",
      "in": "body",
      "type": "boolean",
      "required": true,
      "description": "true：实际库存小于活动库存时，使用实际库存作为活动库存\nfalse：实际库存小于活动库存时，禁止提报",
      "example": "true",
      "_depth": 3
    },
    {
      "name": "activity_stock",
      "in": "body",
      "type": "number",
      "required": true,
      "description": "提报使用的活动库存",
      "example": "123",
      "_depth": 3
    },
    {
      "name": "activity_price",
      "in": "body",
      "type": "number",
      "required": false,
      "description": "活动价，单位：分",
      "example": "123",
      "_depth": 2
    },
    {
      "name": "limit_buy",
      "in": "body",
      "type": "number",
      "required": false,
      "description": "每人限购",
      "example": "123",
      "_depth": 2
    },
    {
      "name": "sub_product_id",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "子品ID",
      "example": "123",
      "_depth": 1
    },
    {
      "name": "sub_sku_id",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "子品SKUID",
      "example": "123",
      "_depth": 1
    },
    {
      "name": "store_id",
      "in": "body",
      "type": "number",
      "required": true,
      "description": "门店id",
      "example": "123",
      "_depth": 1
    }
  ],
  "responseParams": [
    {
      "name": "success_detail_list",
      "type": "array",
      "description": "成功创建的优惠明细",
      "example": ""
    },
    {
      "name": "fail_detail_list",
      "type": "array",
      "description": "失败创建的优惠明细",
