{
  "id": "doudian.industry.ddp_open.ai.reportUsage",
  "platform": "doudian",
  "group": "industry",
  "name": "ddp_open.ai.reportUsage",
  "description": "上报商家用量",
  "method": "GET",
  "path": "/ddp_open/ai/reportUsage",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 店铺"
  },
  "notes": [
    "文档书: 行业API（版本 V1.01）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "total_cnt",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "总可用 = used_cnt+remain_cnt+freezing_cnt",
      "example": "10.05",
      "_depth": 0
    },
    {
      "name": "used_cnt",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "已使用",
      "example": "0.05",
      "_depth": 0
    },
    {
      "name": "remain_cnt",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "剩余可用",
      "example": "9",
      "_depth": 0
    },
    {
      "name": "freezing_cnt",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "不可用（冻结）",
      "example": "1",
      "_depth": 0
    }
  ],
  "responseParams": [],
  "responseCodes": [
    {
      "code": "10000",
      "meaning": "成功",
      "action": "正常处理"
    }
  ],
  "examples": {
    "request": "curl -X GET 'https://openapi-fxg.jinritemai.com/ddp_open/ai/reportUsage?app_key=your_appkey_here&method=ddp_open.ai.reportUsage&access_token=your_accesstoken_here&param_json={}&timestamp=2018-06-19%2016:06:59&v=2&sign=your_sign_here'",
    "responseSuccess": {
      "code": 10000,
      "msg": "success",
      "sub_code": "",
      "sub_msg": ""
    },
    "responseError": {
      "sub_code": "",
      "sub_msg": ""
    }
  },
  "source": "https://op.jinritemai.com/docs/api-docs/1612/8357",
