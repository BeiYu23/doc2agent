{
  "id": "doudian.shop.max.products",
  "platform": "doudian",
  "group": "shop",
  "name": "max.products",
  "description": "批量获取店铺商品信息",
  "method": "GET",
  "path": "/max/products",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 店铺"
  },
  "notes": [
    "文档书: 店铺API（版本 V1.01）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "product_ids",
      "in": "body",
      "type": "array",
      "required": false,
      "description": "商品id列表，手动配置要传，数量一次最多50个，智能配置不需要传",
      "example": "123,456",
      "_depth": 0
    },
    {
      "name": "m_config_type",
      "in": "body",
      "type": "mixed",
      "required": true,
      "description": "配置类型 0 手动配置，1 智能配置，默认手动配置",
      "example": "0",
      "_depth": 0
    },
    {
      "name": "personalized_recommendation",
      "in": "body",
      "type": "boolean",
      "required": false,
      "description": "个性化推荐(千人千面)",
      "example": "false",
      "_depth": 0
    },
    {
      "name": "auto_param",
      "in": "body",
      "type": "object",
      "required": false,
      "description": "智能选品参数",
      "example": "",
      "_depth": 0
    },
    {
      "name": "display_num",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "展示数量",
      "example": "4",
      "_depth": 1
    },
    {
      "name": "order_type",
      "in": "body",
      "type": "mixed",
      "required": true,
      "description": "选品类型, 排序方式, 0-销量排序，1-好评率排序，2-价格排序，3-上新时间排序",
      "example": "0",
      "_depth": 1
    }
  ],
  "responseParams": [
    {
      "name": "status_code",
      "type": "mixed",
      "description": "状态码",
      "example": "0"
    },
    {
      "name": "status_msg",
      "type": "string",
      "description": "状态说明",
      "example": "success"
    },
    {
      "name": "data",
      "type": "object",
      "description": "data",
      "example": ""
    }
  ],
  "responseCodes": [
    {
      "code": "10000",
      "meaning": "success",
      "action": "正常处理"
    },
    {
      "code": "20000",
      "meaning": "系统错误 / 啊哦，服务器打瞌睡了，再试一次吧～（sub_code: isp.service-error:4）",
      "action": "再试一次",
      "sub_code": "isp.service-error:4",
      "sub_msg": "啊哦，服务器打瞌睡了，再试一次吧～"
    },
    {
      "code": "40004",
      "meaning": "非法的参数 / 参数不合法（sub_code: isv.parameter-invalid:5）",
      "action": "检查参数",
      "sub_code": "isv.parameter-invalid:5",
      "sub_msg": "参数不合法"
    }
  ],
  "examples": {
    "request": "curl -X GET 'https://openapi-fxg.jinritemai.com/max/products?app_key=your_appkey_here&method=max.products&access_token=your_accesstoken_here&param_json={}&timestamp=2018-06-19%2016:06:59&v=2&sign=your_sign_here'",
    "responseSuccess": {
      "data": {
        "data": {
          "products": [
            {
              "category_leaf_id": "20000",
              "check_status": "3",
              "name": "苹果手机",
              "original_price": "14",
              "pic": "https://p9-aio.ecombdimg.com/obj/ecom-shop-material/v1_xPfNJOkX_71153427046487984750183_661ff1f563801d97f382e0ac114a09e6_sx_805824_www933-933",
              "product_id": "123",
              "product_type": "1",
              "sale_price": "12",
              "sell_num": "99",
              "status": "0"
            }
          ]
        },
        "status_code": "0",
        "status_msg": "success"
      },
      "code": 10000,
      "msg": "success",
      "sub_code": "",
      "sub_msg": ""
    },
    "responseError": {
      "code": 20000,
      "msg": "系统错误",
      "sub_code": "isp.service-error:4",
      "sub_msg": "啊哦，服务器打瞌睡了，再试一次吧～"
    }
  },
  "source": "https://op.jinritemai.com/docs/api-docs/13/2837",
  "updatedAt": "2025-09-19",
  "_file_stem": "shop-max-products"
}
