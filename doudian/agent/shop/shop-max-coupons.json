  "name": "max.coupons",
  "platform": "doudian",
  "group": "shop",
  "description": "批量获取优惠券信息",
  "method": "GET",
  "path": "/max/coupons",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
