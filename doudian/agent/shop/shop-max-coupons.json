  },
  "notes": [
    "文档书: 店铺API（版本 V1.01）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "coupon_meta_ids",
      "in": "body",
      "type": "array",
      "required": false,
      "description": "优惠券id列表，手动配置的时候传",
      "example": "111,222",
      "_depth": 0
    },
    {
      "name": "m_config_type",
      "in": "body",
      "type": "mixed",
      "required": true,
      "description": "配置类型 0 手动配置，1 智能配置，默认手动配置",
      "example": "0",
      "_depth": 0
    }
  ],
  "responseParams": [
    {
      "name": "coupons",
