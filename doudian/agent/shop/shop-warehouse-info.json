      "type": "string",
      "required": true,
      "description": "仓库编码",
      "example": "ABC",
      "_depth": 0
    }
  ],
  "responseParams": [
    {
      "name": "data",
      "type": "object",
      "description": "仓库信息",
      "example": "-"
    }
  ],
  "responseCodes": [
