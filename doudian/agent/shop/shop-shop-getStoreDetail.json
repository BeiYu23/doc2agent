{
  "id": "doudian.shop.shop.getStoreDetail",
  "platform": "doudian",
  "group": "shop",
  "name": "shop.getStoreDetail",
  "description": "单个获取门店信息",
  "method": "GET",
  "path": "/shop/getStoreDetail",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 店铺"
  },
  "notes": [
    "文档书: 店铺API（版本 V1.01）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "store_id",
      "in": "body",
      "type": "number",
      "required": true,
      "description": "门店ID",
      "example": "123",
      "_depth": 0
    },
    {
      "name": "is_need_poi_audit_info",
      "in": "body",
      "type": "boolean",
      "required": false,
      "description": "是否需要poi审核信息，注：只要审核状态的审核不要传true，需要详细的提交信息时传true",
      "example": "true",
      "_depth": 0
    },
    {
      "name": "is_need_rel_shop_user",
      "in": "body",
      "type": "boolean",
      "required": false,
      "description": "是否需要关联的抖店信息，注：只要shopId不要传true，需要关联店铺名称等信息时传true",
      "example": "true",
      "_depth": 0
    },
    {
      "name": "is_need_charge_info",
      "in": "body",
      "type": "boolean",
      "required": false,
      "description": "是否需要负责人信息",
      "example": "true",
      "_depth": 0
    }
  ],
  "responseParams": [
    {
      "name": "store_detail",
      "type": "object",
      "description": "门店信息",
      "example": ""
    }
  ],
  "responseCodes": [
    {
      "code": "10000",
      "meaning": "success",
      "action": "正常处理"
    }
  ],
