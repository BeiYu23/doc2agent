{
  "id": "doudian.shop.max.activities",
  "platform": "doudian",
  "group": "shop",
  "name": "max.activities",
  "description": "批量获取活动信息",
  "method": "GET",
  "path": "/max/activities",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 店铺"
  },
  "notes": [
    "文档书: 店铺API（版本 V2.01）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "activity_ids",
      "in": "body",
      "type": "array",
      "required": false,
      "description": "活动id，手动配置的时候传，数量最多50个",
      "example": "111,222",
      "_depth": 0
    },
    {
      "name": "activity_type",
      "in": "body",
      "type": "mixed",
      "required": true,
      "description": "活动类型，7-限时限量购，100-店铺满减",
      "example": "7",
      "_depth": 0
    },
    {
      "name": "m_config_type",
      "in": "body",
      "type": "mixed",
      "required": true,
      "description": "配置类型 0 手动配置，1 智能配置，默认手动配置，（目前不支持智能配置）",
      "example": "0",
      "_depth": 0
    }
  ],
  "responseParams": [
    {
      "name": "status_code",
      "type": "mixed",
      "description": "状态码",
      "example": "0"
    },
    {
      "name": "status_msg",
      "type": "string",
      "description": "状态说明",
      "example": "success"
    },
    {
      "name": "data",
      "type": "object",
      "description": "data",
      "example": ""
    }
  ],
  "responseCodes": [
    {
      "code": "10000",
      "meaning": "success",
      "action": "正常处理"
    },
    {
      "code": "20000",
      "meaning": "系统错误 / 啊哦，服务器打瞌睡了，再试一次吧～（sub_code: isp.service-error:4）",
      "action": "再试一次",
      "sub_code": "isp.service-error:4",
      "sub_msg": "啊哦，服务器打瞌睡了，再试一次吧～"
    },
    {
      "code": "40004",
      "meaning": "非法的参数 / 参数不合法（sub_code: isv.parameter-invalid:5）",
      "action": "检查参数",
      "sub_code": "isv.parameter-invalid:5",
      "sub_msg": "参数不合法"
    }
  ],
