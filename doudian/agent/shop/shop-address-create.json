{
  "id": "doudian.shop.address.create",
  "cnName": "创建店铺地址库",
  "docUrl": "/docs/doudian/shop/shop-address-create",
  "name": "address.create",
  "platform": "doudian",
  "group": "shop",
  "description": "创建店铺地址库",
  "method": "GET",
  "path": "/address/create",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 店铺"
  },
  "notes": [
    "文档书: 店铺API（版本 V2.03）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "address",
      "in": "body",
      "type": "object",
      "required": true,
      "description": "地址信息",
      "example": "",
      "_depth": 0
    },
    {
      "name": "user_name",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "联系人姓名",
      "example": "张三",
      "_depth": 1
    },
    {
      "name": "mobile",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "手机号码",
      "example": "18012345678",
      "_depth": 1
    },
    {
      "name": "province_id",
      "in": "body",
      "type": "number",
      "required": true,
      "description": "省份ID",
      "example": "32",
      "_depth": 1
    },
    {
      "name": "city_id",
      "in": "body",
      "type": "number",
      "required": true,
      "description": "城市ID",
      "example": "330700",
      "_depth": 1
    },
    {
      "name": "town_id",
      "in": "body",
      "type": "number",
      "required": true,
      "description": "区ID",
      "example": "330782",
      "_depth": 1
    },
    {
      "name": "detail",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "详细地址",
      "example": "xxxxx",
      "_depth": 1
    },
    {
      "name": "street_id",
      "in": "body",
      "type": "number",
      "required": true,
      "description": "街道ID",
      "example": "330782003",
      "_depth": 1
    },
    {
      "name": "link_type",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "联系方式类型(0-手机,1-普通座机,2-企业座机)",
      "example": "0-手机,1-普通座机,2-企业座机",
      "_depth": 1
    },
    {
      "name": "fixed_phone",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "普通座机格式：区号-座机号-分机号(分机号选填)、区号3~4位、座机号7~8位、分机号不超过5位。企业座机：400/800开头不超过10位、95开头在5~8we",
      "example": "普通座机：400-12345678-1234，企业座机：40012345",
      "_depth": 1
    },
    {
      "name": "remark",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "售后备注，限制200字符",
      "example": "拒收到付",
      "_depth": 1
    },
    {
      "name": "store_id",
      "in": "body",
      "type": "number",
      "required": false,
      "description": "门店ID（新建地址绑定在该门店下，非门店场景无需填写）",
      "example": "123",
      "_depth": 0
    }
  ],
  "responseParams": [
    {
      "name": "address_id",
      "type": "number",
      "description": "新建地址ID",
      "example": "10000"
    }
  ],
  "responseCodes": [
    {
      "code": "10000",
      "meaning": "success",
      "action": "正常处理"
    },
    {
      "code": "40004",
