    },
    {
      "name": "name",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "仓库名称",
      "example": "test",
      "_depth": 0
    },
    {
      "name": "intro",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "仓库介绍",
      "example": "test",
      "_depth": 0
    },
    {
      "name": "warehouse",
      "in": "body",
      "type": "object",
      "required": false,
      "description": "仓信息",
      "example": "",
      "_depth": 0
    },
    {
      "name": "warehouse_location",
      "in": "body",
      "type": "object",
      "required": false,
      "description": "仓地址编码",
      "example": "",
