    {
      "name": "address_id4",
      "in": "body",
      "type": "number",
      "required": false,
      "description": "街道地址编码",
      "example": "0",
      "_depth": 2
    },
    {
      "name": "address_detail",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "详细地址",
      "example": "xx区xx号",
