{
  "id": "doudian.shop.address.list",
  "platform": "doudian",
  "group": "shop",
  "name": "address.list",
  "description": "批量查询地址库列表接口",
  "method": "GET",
  "path": "/address/list",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 店铺"
  },
  "notes": [
    "文档书: 店铺API（版本 V5.01）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "shop_id",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "【已废弃】店铺id",
      "example": "123",
      "_depth": 0
    },
    {
      "name": "page_size",
      "in": "body",
      "type": "mixed",
      "required": true,
      "description": "翻页每页数量，默认10",
      "example": "10",
      "_depth": 0
    },
    {
      "name": "page_no",
      "in": "body",
      "type": "mixed",
      "required": true,
      "description": "翻页页数，从1开始",
      "example": "1",
      "_depth": 0
    },
    {
      "name": "order_by",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "排序方式支持asc/desc",
      "example": "asc/desc",
      "_depth": 0
    },
    {
      "name": "order_field",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "排序字段；create_time-创建时间排序，update_time-更新时间排序；",
      "example": "create_time/update_time",
      "_depth": 0
    },
    {
      "name": "store_id",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "门店ID，抖超小时达业务使用传入后只获取该门店下地址列表；",
      "example": "123",
      "_depth": 0
    },
    {
      "name": "is_send_home_open_req",
      "in": "body",
      "type": "boolean",
      "required": false,
      "description": "大盘传false，即时零售商家必传true",
      "example": "false",
      "_depth": 0
    }
  ],
  "responseParams": [
    {
      "name": "total",
      "type": "mixed",
      "description": "地址总数",
      "example": "10"
    },
    {
      "name": "page_size",
      "type": "mixed",
      "description": "页码",
      "example": "1"
    },
    {
      "name": "page_no",
      "type": "mixed",
      "description": "每页数量",
      "example": "10"
    },
    {
      "name": "address_list",
      "type": "array",
      "description": "地址列表",
      "example": ""
    }
  ],
  "responseCodes": [
    {
      "code": "10000",
      "meaning": "success",
      "action": "正常处理"
    },
    {
      "code": "40004",
      "meaning": "非法的参数 / 请输入正确的排序方式（sub_code: isv.parameter-invalid:5001）",
      "action": "请输入正确参数",
      "sub_code": "isv.parameter-invalid:5001",
      "sub_msg": "请输入正确的排序方式"
    }
  ],
  "examples": {
    "request": "curl -X GET 'https://openapi-fxg.jinritemai.com/address/list?app_key=your_appkey_here&method=address.list&access_token=your_accesstoken_here&param_json={}&timestamp=2018-06-19%2016:06:59&v=2&sign=your_sign_here'",
    "responseSuccess": {
      "data": {
        "address_list": [
          {
            "address_id": "1",
            "biz_id": "123",
            "biz_type": "1",
            "common_phone": {
              "area_num": "0635",
              "auxiliary_num": "1111",
              "main_num": "5781308",
              "num": "0635-5781308-1111"
            },
            "company_phone": {
              "num": "40088881111234",
              "phone_num": "40088881111234"
            },
            "create_time": "\"1622103276\"",
            "is_default": "1-是；0-否",
            "is_send_default": "1-是；0-否",
            "link_type": "1",
            "mobile": "0635-5781308",
            "phone": "13288889999",
            "receiver_city": "北京",
            "receiver_detail": "xxxx",
            "receiver_district": "海淀区",
            "receiver_provinc": "北京市",
            "receiver_street": "丹棱街",
            "reciever_name": "张三",
            "remark": "请发顺丰快递",
            "update_time": "\"1622103276\""
          }
        ],
        "page_no": "10",
        "page_size": "1",
        "total": "10"
      },
      "code": 10000,
      "msg": "success",
      "sub_code": "",
      "sub_msg": ""
    },
    "responseError": {
      "code": 40004,
      "msg": "非法的参数",
      "sub_code": "isv.parameter-invalid:5001",
      "sub_msg": "请输入正确的排序方式"
    }
  },
  "source": "https://op.jinritemai.com/docs/api-docs/13/1435",
  "updatedAt": "2025-03-17",
  "_file_stem": "shop-address-list"
}
