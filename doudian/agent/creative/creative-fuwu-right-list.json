      "description": "起始页(从1开始)",
      "example": "1",
      "_depth": 0
    },
    {
      "name": "page_size",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "页大小(1~50)",
      "example": "10",
      "_depth": 0
    }
