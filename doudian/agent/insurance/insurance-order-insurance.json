{
  "id": "doudian.insurance.order.insurance",
  "platform": "doudian",
  "group": "insurance",
  "name": "order.insurance",
  "description": "根据订单ID，获取该订单对应的运费险保单的详细信息；\n1、status<=1&status=5的情况下ins_ensured_time_begin、ins_ensured_time_end没有意义（返回的是默认时间\"1754-08-31 06:49:25\"",
  "method": "GET",
  "path": "/order/insurance",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 店铺"
  },
  "notes": [
    "文档书: 保险API（版本 V1.05）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "order_id",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "订单id(可以加A也可以不加）",
      "example": "6496679971677798670",
      "_depth": 0
    }
  ],
  "responseParams": [
    {
      "name": "policy_info_list",
      "type": "array",
      "description": "保单详情列表",
      "example": ""
    }
  ],
  "responseCodes": [
    {
      "code": "10000",
      "meaning": "success",
      "action": "正常处理"
    },
    {
      "code": "50002",
      "meaning": "业务处理失败 / 查询保单信息失败（sub_code: isv.business-failed:9999）",
      "action": "业务处理失败，尝试重试",
      "sub_code": "isv.business-failed:9999",
      "sub_msg": "查询保单信息失败"
    },
    {
      "code": "50002",
      "meaning": "业务处理失败 / 参数错误,订单不存在（sub_code: isv.business-failed:2）",
      "action": "请检查order_id字段",
      "sub_code": "isv.business-failed:2",
      "sub_msg": "参数错误,订单不存在"
    }
  ],
  "examples": {
    "request": "curl -X GET 'https://openapi-fxg.jinritemai.com/order/insurance?app_key=your_appkey_here&method=order.insurance&access_token=your_accesstoken_here&param_json={}&timestamp=2018-06-19%2016:06:59&v=2&sign=your_sign_here'",
    "responseSuccess": {
      "data": {
        "policy_info_list": [
          {
            "appeal_status": "0",
            "approximate_return_fee": "1200",
            "claim_status": "0",
            "company_name": "\"中国人民财产保险股份有限公司\"",
            "fail_reason": "\"失败原因\"",
            "goods_info_list": [
              {
                "amount": "1",
                "category_id": "\"13-3004-3006\"",
                "product_id": "3436088998672617334",
                "product_name": "\"商品名称\"",
                "show_page_url": "\"https://sf1-ttcdn-tos.pstatp.com/obj/temai/6535e88c983f735cabb99f5b00f6212awww800-800\","
              }
            ],
            "ins_ensured_time_begin": "\"2020-09-17 14:48:08\"",
            "ins_ensured_time_end": "\"2020-12-16 14:48:08\"",
            "ins_policy_no": "\"10202009171446081711854084111\"",
            "insurance_hotline": "\"400-188-1949转1\"",
            "is_allow_appeal": "false",
            "merchant_premium": "60",
