{
  "id": "doudian.insurance.order.policy",
  "cnName": "查各种保险的保单",
  "docUrl": "/docs/doudian/insurance/insurance-order-policy",
  "name": "order.policy",
  "platform": "doudian",
  "group": "insurance",
  "description": "查各种保险的保单详情",
  "method": "GET",
  "path": "/order/policy",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 店铺"
  },
  "notes": [
    "文档书: 保险API（版本 V1.07）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "order_id",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "订单id",
      "example": "6496679971677798670",
      "_depth": 0
    },
    {
      "name": "ins_product_id",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "保单类型枚举值：\nreturnfreight2020v1-运费险；allergyinsurance2021-过敏险；plant7dinsurance2021-绿植养死包赔7天； plant15dinsurance2021-绿植养死包赔15天；insopenbox2022v12b-开箱无忧；foodsafety2022ecom2b\n-食安保；",
      "example": "returnfreight2020v1",
      "_depth": 0
    }
  ],
  "responseParams": [
    {
      "name": "policy_info",
      "type": "object",
      "description": "保单详情列表",
      "example": ""
    },
    {
      "name": "claim_info_list",
      "type": "array",
      "description": "理赔列表",
      "example": ""
    }
  ],
  "responseCodes": [
    {
      "code": "10000",
      "meaning": "success",
      "action": "正常处理"
    },
    {
      "code": "50002",
      "meaning": "业务处理失败 / 订单未找到（sub_code: isv.business-failed:2）",
      "action": "请检查订单信息",
      "sub_code": "isv.business-failed:2",
      "sub_msg": "订单未找到"
    },
    {
      "code": "50002",
      "meaning": "业务处理失败 / 查询保单失败（sub_code: isv.business-failed:9999）",
      "action": "请稍后重试",
      "sub_code": "isv.business-failed:9999",
      "sub_msg": "查询保单失败"
    }
  ],
  "examples": {
    "request": "curl -X GET 'https://openapi-fxg.jinritemai.com?app_key=your_appkey_here&method=&access_token=your_accesstoken_here&param_json={}&timestamp=2018-06-19%2016:06:59&v=2&sign=your_sign_here'",
    "responseSuccess": {
      "code": 10000,
      "msg": "success",
      "sub_code": "",
      "sub_msg": ""
    },
    "responseError": {
      "code": 50002,
      "msg": "业务处理失败",
      "sub_code": "isv.business-failed:2",
      "sub_msg": "订单未找到"
    }
  },
  "source": "https://op.jinritemai.com/docs/api-docs/32/1854",
  "updatedAt": "2023-04-17",
  "_file_stem": "insurance-order-policy"
}
