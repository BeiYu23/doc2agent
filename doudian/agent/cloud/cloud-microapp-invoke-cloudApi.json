{
  "id": "doudian.cloud.microapp.invoke.cloudApi",
  "cnName": "调用ISV云内应用",
  "docUrl": "/docs/doudian/cloud/cloud-microapp-invoke-cloudApi",
  "name": "microapp.invoke.cloudApi",
  "platform": "doudian",
  "group": "cloud",
  "description": "调用ISV云内应用接口",
  "method": "GET",
  "path": "YOUR_SECRET_KEY",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 见平台说明"
  },
  "notes": [
    "文档书: 电商云API（版本 V1.02）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "interface_name",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "云内应用提供的接口名",
      "example": "testName",
      "_depth": 0
    },
    {
      "name": "biz_param_json",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "入参，json字符串",
      "example": "{\"name\":\"test}",
      "_depth": 0
    },
    {
      "name": "use_test",
      "in": "body",
      "type": "mixed",
      "required": true,
      "description": "是否调用至\"测试环境\"云内应用的接口",
      "example": "1",
      "_depth": 0
    }
  ],
  "responseParams": [
    {
      "name": "biz_result_json",
      "type": "string",
      "description": "后端接口的返回值，json string",
      "example": "{\"age\":12345}"
    }
  ],
