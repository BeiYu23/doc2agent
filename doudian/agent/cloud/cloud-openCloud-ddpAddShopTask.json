  },
  "notes": [
    "文档书: 电商云API（版本 V1.03）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "data_list",
      "in": "body",
      "type": "array",
      "required": false,
      "description": "数据ID（仅业务单号），最多传10个",
      "example": "[\"123456789\"]",
      "_depth": 0
    },
    {
      "name": "shop_id",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "店铺ID（仅时间范围）",
      "example": "77977",
      "_depth": 0
    },
    {
      "name": "start_time",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "开始时间（仅时间范围）",
      "example": "1735545392",
      "_depth": 0
    },
    {
      "name": "end_time",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "结束时间（仅时间范围）",
      "example": "1735545492",
      "_depth": 0
    },
    {
      "name": "self_push_type",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "任务类型 0按更新时间 1按业务单号",
      "example": "0",
      "_depth": 0
    },
    {
      "name": "biz_id",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "业务类型 1订单 2售后 3商品",
      "example": "1",
      "_depth": 0
    },
    {
      "name": "range_type",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "范围类型 0自定义 1全量（仅商品）",
      "example": "0",
      "_depth": 0
    }
  ],
