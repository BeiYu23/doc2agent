{
  "id": "doudian.cloud.openCloud.v1.cr.token.get",
  "platform": "doudian",
  "group": "cloud",
  "name": "openCloud.v1.cr.token.get",
  "description": "获取上传镜像仓库的临时token",
  "method": "GET",
  "path": "YOUR_SECRET_KEY",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: "
  },
  "notes": [
    "文档书: 电商云API（版本 V2.01）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "volc_account_id",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "如果是强管控、跨境、微应用等租户，需要传火山账号id",
      "example": "2100044514",
      "_depth": 0
    }
  ],
  "responseParams": [
    {
      "name": "authorization_token",
      "type": "string",
