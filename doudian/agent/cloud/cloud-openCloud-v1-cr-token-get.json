    }
  ],
  "responseCodes": [
    {
      "code": "10000",
      "meaning": "成功",
      "action": "正常处理"
    }
  ],
  "examples": {
    "request": "curl -X GET 'https://openapi-fxg.jinritemai.YOUR_SECRET_KEY?app_key=your_appkey_here&method=openCloud.v1.cr.token.get&access_token=your_accesstoken_here&param_json={}&timestamp=2018-06-19%2016:06:59&v=2&sign=your_sign_here'",
