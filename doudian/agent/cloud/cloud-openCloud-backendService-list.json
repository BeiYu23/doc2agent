      "description": "容器服务ID",
      "example": "7020346200001000101",
      "_depth": 0
    },
    {
      "name": "bs_types",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "后端服务",
      "example": "\"bs_types\"",
      "_depth": 0
    },
    {
      "name": "bs_type",
      "in": "body",
      "type": "mixed",
      "required": true,
      "description": "服务类型",
      "example": "1",
      "_depth": 0
    },
    {
      "name": "paging",
      "in": "body",
      "type": "mixed",
      "required": true,
      "description": "分页",
      "example": "2",
      "_depth": 0
    },
    {
      "name": "page_index",
      "in": "body",
      "type": "mixed",
      "required": true,
      "description": "页码，从1开始",
      "example": "1",
      "_depth": 0
    },
    {
      "name": "page_size",
      "in": "body",
      "type": "mixed",
      "required": true,
      "description": "每页数量，最大100",
      "example": "20",
      "_depth": 0
    }
