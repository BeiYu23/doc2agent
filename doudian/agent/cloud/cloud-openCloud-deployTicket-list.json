            "cs_id": "cs_id",
            "extra": {},
            "image_version_id": "cs_id",
            "name": "name",
            "remark": "备注",
            "ticket_id": "ticket_id",
            "ticket_status": "1",
            "ticket_type": "1",
            "update_time": "create_time",
            "upgrade_strategy": "1"
          }
        ],
        "total": "1"
      },
      "code": 10000,
      "msg": "success",
      "sub_code": "",
      "sub_msg": ""
    },
    "responseError": {
      "sub_code": "",
      "sub_msg": ""
    }
  },
