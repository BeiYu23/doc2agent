      "name": "doudian_open_id",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "订单接口返回的doudian_open_id（t+2）",
      "example": "111",
      "_depth": 0
    },
    {
      "name": "encrypt_uid",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "外呼人群包计划生成的加密外呼ID",
      "example": "#sdiahdiaihhidhaihiahd",
      "_depth": 0
    },
    {
      "name": "order_id",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "店铺单id",
      "example": "12312312413",
      "_depth": 0
    },
    {
      "name": "encrypt_phone",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "加密手机号",
      "example": "$$sfasef24123$$",
      "_depth": 0
    },
    {
      "name": "outbound_type",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "外呼类型 0默认 1教育类(手机号和店铺单id必传)",
      "example": "1",
      "_depth": 0
    },
    {
      "name": "doudian_open_id_v2",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "订单接口返回的doudian_open_id（实时）",
      "example": "111",
      "_depth": 0
    },
    {
      "name": "after_sale_id",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "售后单id",
      "example": "12312312413",
      "_depth": 0
    },
    {
      "name": "is_downgrade",
      "in": "body",
      "type": "boolean",
      "required": false,
      "description": "是否自动降级使用收货人手机号",
      "example": "true",
      "_depth": 0
    }
  ],
  "responseParams": [
    {
      "name": "outbound_id",
      "type": "string",
      "description": "外呼id，有效期：1h，人群包外呼ID有效期：24h",
      "example": "17037442535v6Nz7_3u0"
