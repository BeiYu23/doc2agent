{
  "id": "doudian.member.member.getPhoneByOutboundId",
  "platform": "doudian",
  "group": "member",
  "name": "member.getPhoneByOutboundId",
  "description": "根据外呼id获取手机号（火山专用）",
  "method": "GET",
  "path": "/member/getPhoneByOutboundId",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
