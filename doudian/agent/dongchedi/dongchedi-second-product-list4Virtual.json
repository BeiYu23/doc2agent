{
  "id": "doudian.dongchedi.second.product.list4Virtual",
  "cnName": "【二方接口】获取商品列表",
  "docUrl": "/docs/doudian/dongchedi/dongchedi-second-product-list4Virtual",
  "name": "second.product.list4Virtual",
  "platform": "doudian",
  "group": "dongchedi",
  "description": "【二方接口】获取商品列表",
  "method": "GET",
  "path": "/second/product/list4Virtual",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 见平台说明"
  },
  "notes": [
    "文档书: 懂车帝业务（版本 V1.01）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "uid",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "商业化账号组uid，用作鉴权",
      "example": "15495388485",
      "_depth": 0
    },
    {
      "name": "productId",
      "in": "body",
      "type": "array",
      "required": false,
      "description": "小店商品id",
      "example": "[]",
      "_depth": 0
    },
    {
      "name": "name",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "小店商品名称",
      "example": "dde7ab64",
      "_depth": 0
    },
    {
      "name": "status",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "小店商品状态，0-上架中，1-下架中，2-删除中",
      "example": "8439796",
      "_depth": 0
    },
    {
      "name": "checkStatus",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "小店商品审核状态，1-待提交，2-审核中，3-审核通过，4-审核被驳回，5-被封禁",
      "example": "5946554",
      "_depth": 0
    },
    {
      "name": "shopId",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "fields:ShopId  小店店铺id",
      "example": "690582",
      "_depth": 0
    },
    {
      "name": "brandId",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "fields:BrandId, 品牌关联id",
      "example": "521150",
      "_depth": 0
    },
    {
      "name": "isOnline",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "在线商品筛选",
      "example": "5096401",
      "_depth": 0
    },
    {
      "name": "isOffline",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "下架中",
      "example": "5462059",
      "_depth": 0
    },
    {
      "name": "categoryIds",
      "in": "body",
      "type": "array",
      "required": false,
      "description": "新类目id列表",
      "example": "[]",
      "_depth": 0
    },
    {
      "name": "tagCode",
      "in": "body",
      "type": "array",
      "required": false,
      "description": "标签code，精确匹配",
      "example": "[]",
      "_depth": 0
    },
    {
      "name": "excludeTagCode",
      "in": "body",
      "type": "array",
      "required": false,
      "description": "排除标签code，精确匹配",
      "example": "[]",
      "_depth": 0
    },
    {
      "name": "sortField",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "排序字段，默认按创建时间",
      "example": "deb3322b",
      "_depth": 0
    },
    {
      "name": "sortDirection",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "排序顺序，asc-升序，desc-降序，默认desc",
      "example": "a6d727e1",
      "_depth": 0
    },
    {
      "name": "page",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "page",
      "example": "6264706",
      "_depth": 0
    },
    {
      "name": "size",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "size",
      "example": "6754427",
      "_depth": 0
    },
    {
      "name": "fields",
      "in": "body",
      "type": "array",
      "required": false,
      "description": "指定需要获取的字段，字段名从ListInfo4Virtual中取",
      "example": "[]",
      "_depth": 0
    },
    {
      "name": "scrollId",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "scroll_id",
      "example": "14d4adeb",
      "_depth": 0
    },
    {
      "name": "isPackageProduct",
      "in": "body",
      "type": "boolean",
      "required": false,
      "description": "fields:IsPackageProduct. 是否是组套商品",
      "example": "false",
      "_depth": 0
    }
  ],
  "responseParams": [
    {
      "name": "data",
      "type": "array",
      "description": "data",
      "example": "[]"
    },
    {
      "name": "total",
      "type": "mixed",
      "description": "total",
      "example": "3122445"
    },
    {
      "name": "page",
      "type": "mixed",
      "description": "page",
      "example": "6264706"
    },
    {
      "name": "size",
      "type": "mixed",
      "description": "size",
      "example": "6754427"
    },
    {
      "name": "scrollId",
      "type": "string",
      "description": "scroll_id",
      "example": "14d4adeb"
    },
    {
      "name": "cursorId",
      "type": "string",
      "description": "游标id，如果需要遍历则下次查询带上",
      "example": "a6595738"
    }
  ],
  "responseCodes": [
    {
      "code": "10000",
      "meaning": "success",
      "action": "正常处理"
    },
    {
      "code": "20000",
