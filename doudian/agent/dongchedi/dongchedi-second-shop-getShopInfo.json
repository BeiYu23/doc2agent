  "name": "second.shop.getShopInfo",
  "platform": "doudian",
  "group": "dongchedi",
  "description": "【二方接口】查询店铺信息",
  "method": "GET",
  "path": "/second/shop/getShopInfo",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 见平台说明"
  },
  "notes": [
    "文档书: 懂车帝业务（版本 V1.01）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "shopIds",
      "in": "body",
      "type": "array",
      "required": false,
      "description": "最多20个店铺",
      "example": "[]",
      "_depth": 0
    }
  ],
  "responseParams": [
    {
      "name": "shopInfoList",
      "type": "array",
      "description": "shop_info_list",
      "example": "[]"
    }
  ],
  "responseCodes": [
    {
      "code": "10000",
      "meaning": "success",
      "action": "正常处理"
    },
    {
      "code": "20000",
      "meaning": "系统错误 / shopIds不能为空（sub_code: isp.service-error:300001）",
      "action": "shopIds不能为空",
      "sub_code": "isp.service-error:300001",
      "sub_msg": "shopIds不能为空"
    }
  ],
  "examples": {
    "request": "curl -X GET 'https://openapi-fxg.jinritemai.com/second/shop/getShopInfo?app_key=your_appkey_here&method=second.shop.getShopInfo&access_token=your_accesstoken_here&param_json={}&timestamp=2018-06-19%2016:06:59&v=2&sign=your_sign_here'",
    "responseSuccess": {
      "data": {
        "shopInfoList": [
          {
            "encryptShopId": "4b19be0b",
