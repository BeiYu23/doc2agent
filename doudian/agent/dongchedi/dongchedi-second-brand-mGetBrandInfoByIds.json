{
  "id": "doudian.dongchedi.second.brand.mGetBrandInfoByIds",
  "platform": "doudian",
  "group": "dongchedi",
  "name": "second.brand.mGetBrandInfoByIds",
  "description": "【二方接口】根据brand_id查询品牌信息,翻页单次数量不超过300",
  "method": "GET",
  "path": "/second/brand/mGetBrandInfoByIds",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
