      "name": "uid",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "商业化账号组uid，用作鉴权",
      "example": "15495388485",
      "_depth": 0
    },
    {
      "name": "shopId",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "店铺ID",
      "example": "5055915",
      "_depth": 0
    },
    {
      "name": "auditStatus",
      "in": "body",
      "type": "array",
      "required": false,
      "description": "AuditStatus",
      "example": "[]",
      "_depth": 0
    },
    {
      "name": "enableDeDuplicate",
      "in": "body",
      "type": "boolean",
      "required": false,
      "description": "启用去重 如果存con'f'ig在重复ID则返回去重后的品牌信息",
      "example": "false",
      "_depth": 0
    },
    {
      "name": "bizTypes",
      "in": "body",
      "type": "array",
      "required": false,
      "description": "BizTypes",
      "example": "[]",
      "_depth": 0
    },
    {
      "name": "brandIds",
      "in": "body",
      "type": "array",
      "required": false,
      "description": "BrandIds",
      "example": "[]",
      "_depth": 0
    },
    {
      "name": "status",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "Status",
      "example": "4288570",
      "_depth": 0
    }
  ],
  "responseParams": [
