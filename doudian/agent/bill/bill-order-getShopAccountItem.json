      "example": "0",
      "_depth": 0
    },
    {
      "name": "time_type",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "时间类型 0 动账时间 1 下单时间",
      "example": "0",
      "_depth": 0
    },
    {
      "name": "start_index",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "开始下标  请求值为上一次响应参数的next_index，第一次请求不传",
      "example": "d746da31eee45e65d07b20f87d6844bbf72041350acc66af1711408070b62428",
      "_depth": 0
    },
    {
      "name": "product_id",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "产品id",
      "example": "33323233",
      "_depth": 0
    }
