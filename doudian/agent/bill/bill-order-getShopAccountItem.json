      "type": "string",
      "required": false,
      "description": "订单号(如果订单号未传，则时间必须传)",
      "example": "4847151209529677080",
      "_depth": 0
    },
    {
      "name": "size",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "查询数量(不传默认100，最大为1000)",
      "example": "100",
      "_depth": 0
    },
    {
      "name": "account_type",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "动账账户 0: 所有 1: 微信 2:支付宝 3:合众支付 4:聚合支付",
      "example": "0",
