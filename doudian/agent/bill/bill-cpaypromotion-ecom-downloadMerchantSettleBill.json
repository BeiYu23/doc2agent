{
  "id": "doudian.bill.cpaypromotion.ecom.downloadMerchantSettleBill",
  "platform": "doudian",
  "group": "bill",
  "name": "cpaypromotion.ecom.downloadMerchantSettleBill",
  "description": "1、通过【YOUR_SECRET_KEY】接口返回的download_id。调用接口生成文件下载的URL链接时效为1小时，失效后需重新调此接口获取新的链接。\n2、对应抖店的账单管理-支付补贴账单功能",
  "method": "GET",
  "path": "YOUR_SECRET_KEY",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 店铺"
  },
  "notes": [
    "文档书: 账单API（版本 V1.02）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "download_id",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "下载id，通过调用YOUR_SECRET_KEY接口获取",
      "example": "AID202508201651131593889324",
      "_depth": 0
    }
  ],
  "responseParams": [
    {
      "name": "url",
      "type": "string",
      "description": "文件下载url",
      "example": "https://tosv-ttpboe.byted.org/caijing-cf-for-open-YOUR_SECRET_KEY_20250612_20250612.zip"
    },
    {
