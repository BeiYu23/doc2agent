{
  "id": "doudian.bill.order.downloadShopAccountItem",
  "platform": "doudian",
  "group": "bill",
  "name": "order.downloadShopAccountItem",
  "description": "请求下载资金流水明细，得到download_id,download_id获取文件需要从order/downloadShopAccountItemFile接口获取，数据T+1生成，建议第二天15点之后下载",
  "method": "GET",
  "path": "/order/downloadShopAccountItem",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 店铺"
  },
  "notes": [
    "文档书: 账单API（版本 V1.10）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "start_time",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "开始时间",
      "example": "2021-10-01 00:00:00",
      "_depth": 0
    },
    {
      "name": "end_time",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "结束时间",
      "example": "2021-10-01 23:59:59",
      "_depth": 0
    },
    {
      "name": "order_id",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "订单号(如果订单号未传，则时间必须传)",
      "example": "4847151209529677080",
      "_depth": 0
    },
    {
      "name": "account_type",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "动账账户 0: 所有 1: 微信 2:支付宝 3:合众支付 4:聚合支付",
      "example": "0",
      "_depth": 0
    },
    {
      "name": "biz_type",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "计费类型 0:全部 1:巨量千川 2:精选联盟 3:值点商城 4:小店自卖 5:橙子建站 6:POI 7:抖+ 8:穿山甲 9:服务市场 10:服务市场外包客服 11:学浪",
      "example": "0",
      "_depth": 0
    },
    {
      "name": "time_type",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "时间类型 0 动账时间 1 下单时间",
      "example": "0",
      "_depth": 0
    },
    {
      "name": "product_id",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "产品id",
      "example": "33323233",
      "_depth": 0
    }
  ],
  "responseParams": [
    {
      "name": "code",
      "type": "string",
      "description": "返回code 100000为成功，其他为失败",
      "example": "10000"
    },
    {
      "name": "code_msg",
      "type": "string",
      "description": "返回描述",
      "example": "SUCCESS"
    },
    {
      "name": "download_id",
      "type": "string",
      "description": "下载id，有效期24小时",
      "example": "DL202110261638110918901284"
    }
  ],
  "responseCodes": [
    {
      "code": "10000",
      "meaning": "success",
      "action": "正常处理"
    },
    {
      "code": "40004",
      "meaning": "非法的参数 / 参数异常，请检查参数（sub_code: isv.parameter-invalid:500）",
      "action": "输入合法参数",
      "sub_code": "isv.parameter-invalid:500",
      "sub_msg": "参数异常，请检查参数"
    }
  ],
  "examples": {
    "request": "curl -X GET 'https://openapi-fxg.jinritemai.com?app_key=your_appkey_here&method=&access_token=your_accesstoken_here&param_json={}&timestamp=2018-06-19%2016:06:59&v=2&sign=your_sign_here'",
    "responseSuccess": {
      "code": 10000,
      "msg": "success",
      "sub_code": "",
      "sub_msg": ""
    },
    "responseError": {
      "code": 40004,
      "msg": "非法的参数",
      "sub_code": "isv.parameter-invalid:500",
      "sub_msg": "参数异常，请检查参数"
    }
  },
  "source": "https://op.jinritemai.com/docs/api-docs/46/1431",
  "updatedAt": "2023-05-29",
