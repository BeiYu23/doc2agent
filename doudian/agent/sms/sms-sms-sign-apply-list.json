{
  "id": "doudian.sms.sms.sign.apply.list",
  "platform": "doudian",
  "group": "sms",
  "name": "sms.sign.apply.list",
  "description": "查看短信签名申请单",
  "method": "GET",
  "path": "/sms/sign/apply/list",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 店铺"
  },
  "notes": [
    "文档书: 短信API（版本 V2.01）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "sms_account",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "短信发送渠道，主要做资源隔离",
      "example": "1234",
      "_depth": 0
    },
    {
      "name": "like",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "搜索",
      "example": "1",
      "_depth": 0
    },
    {
      "name": "page",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "页码，默认0",
      "example": "0",
      "_depth": 0
    },
    {
      "name": "size",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "每页大小，默认10",
      "example": "10",
      "_depth": 0
    },
    {
      "name": "sms_sign_apply_id",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "申请单id",
      "example": "444",
      "_depth": 0
    },
    {
      "name": "version",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "版本号v2则走新链路",
      "example": "v2",
      "_depth": 0
    },
    {
      "name": "shop_sub_account",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "商家消息组，不传则默认查询商家消息组",
      "example": "sjfeosa",
      "_depth": 0
    }
  ],
  "responseParams": [
    {
      "name": "total",
      "type": "mixed",
      "description": "总数",
      "example": "100"
    },
    {
      "name": "apply_list",
      "type": "array",
      "description": "短信签名申请单列表",
      "example": ""
    }
  ],
  "responseCodes": [
    {
      "code": "10000",
      "meaning": "success",
      "action": "正常处理"
    },
    {
      "code": "50002",
      "meaning": "业务处理失败 / 响应结果不符合预期（sub_code: isv.business-failed:628005100）",
      "action": "请根据错误信息描述检查",
      "sub_code": "isv.business-failed:628005100",
      "sub_msg": "响应结果不符合预期"
    },
    {
      "code": "20000",
      "meaning": "系统错误 / 628004205:Redis Get错误（sub_code: isp.service-error:628004205）",
      "action": "系统错误，请重试",
      "sub_code": "isp.service-error:628004205",
      "sub_msg": "628004205:Redis Get错误"
    }
  ],
  "examples": {
    "request": "curl -X GET 'https://openapi-fxg.jinritemai.com/sms/sign/apply/list?app_key=your_appkey_here&method=sms.sign.apply.list&access_token=your_accesstoken_here&param_json={}&timestamp=2018-06-19%2016:06:59&v=2&sign=your_sign_here'",
    "responseSuccess": {
      "data": {
        "apply_list": [
          {
            "sign": "abc",
            "sms_account": "1234",
            "sms_sign_apply_id": "2342341444",
            "status": "2",
            "status_remark": "签名重复"
          }
        ],
        "total": "100"
      },
      "code": 10000,
      "msg": "success",
      "sub_code": "",
      "sub_msg": ""
    },
    "responseError": {
      "code": 50002,
      "msg": "业务处理失败",
      "sub_code": "isv.business-failed:628005100",
      "sub_msg": "响应结果不符合预期"
    }
  },
  "source": "https://op.jinritemai.com/docs/api-docs/163/1523",
  "updatedAt": "2026-03-24",
  "_file_stem": "sms-sms-sign-apply-list",
  "cnName": "查看短信签名申请单"
}
