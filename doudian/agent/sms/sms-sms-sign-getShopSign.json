      "name": "message_group_info",
      "type": "object",
      "description": "消息组",
      "example": ""
    },
    {
      "name": "isv_available_sign_list",
      "type": "array",
      "description": "仅ISV专用消息组下的签名，sms_account=ISV消息组id",
      "example": ""
