{
  "id": "doudian.sms.sms.template.search",
  "cnName": "查询短信模板",
  "docUrl": "/docs/doudian/sms/sms-sms-template-search",
  "name": "sms.template.search",
  "platform": "doudian",
  "group": "sms",
  "description": "查询短信模板",
  "method": "GET",
  "path": "/sms/template/search",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 店铺"
  },
  "notes": [
    "文档书: 短信API（版本 V2.01）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "sms_account",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "短信发送渠道，主要做资源隔离",
      "example": "1234",
      "_depth": 0
    },
    {
      "name": "template_id",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "短信模板id",
      "example": "7238746",
      "_depth": 0
    },
    {
      "name": "template_content",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "短信模版内容",
      "example": "您购买的商品已重新发出，${name}快递运单号：${number}，关注“XXX”公众号刷新订单获取最新物流信息哦~给您造成不便敬请谅解。",
      "_depth": 0
    },
    {
      "name": "page",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "页码，默认0",
      "example": "0",
      "_depth": 0
    },
    {
      "name": "size",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "每页大小，默认10",
      "example": "10",
      "_depth": 0
    },
    {
      "name": "template_name",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "短信模版名称",
      "example": "618大促",
      "_depth": 0
    },
    {
      "name": "is_public",
      "in": "body",
      "type": "boolean",
      "required": false,
      "description": "是否查询公域模板",
      "example": "false",
      "_depth": 0
    },
    {
      "name": "version",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "短信版本，v2表示新版本",
      "example": "v2",
      "_depth": 0
    },
    {
      "name": "template_biz_sub_type",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "模板业务子类型",
      "example": "100000",
      "_depth": 0
    },
    {
      "name": "template_biz_type",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "模板业务类型",
      "example": "1",
      "_depth": 0
    }
  ],
  "responseParams": [
    {
      "name": "template_search_list",
      "type": "array",
      "description": "模板列表",
      "example": ""
    },
    {
      "name": "total",
      "type": "mixed",
      "description": "总条数",
      "example": "100"
    }
  ],
  "responseCodes": [
    {
      "code": "10000",
      "meaning": "success",
      "action": "正常处理"
    },
    {
      "code": "20000",
      "meaning": "系统错误 / 628004205:Redis Get错误（sub_code: isp.service-error:628004205）",
      "action": "系统内部错误，请重试",
      "sub_code": "isp.service-error:628004205",
      "sub_msg": "628004205:Redis Get错误"
    }
  ],
  "examples": {
    "request": "curl -X GET 'https://openapi-fxg.jinritemai.com/sms/template/search?app_key=your_appkey_here&method=sms.template.search&access_token=your_accesstoken_here&param_json={}&timestamp=2018-06-19%2016:06:59&v=2&sign=your_sign_here'",
    "responseSuccess": {
      "data": {
        "template_search_list": [
          {
            "channel_type": "CN_NTC",
            "is_public": "false",
            "sms_account": "1234",
            "template_content": "您购买的商品已重新发出，${name}快递运单号：${number}，关注“XXX”公众号刷新订单获取最新物流信息哦~给您造成不便敬请谅解。",
            "template_id": "43534",
            "template_name": "618大促"
          }
        ],
        "total": "100"
      },
      "code": 10000,
      "msg": "success",
      "sub_code": "",
      "sub_msg": ""
    },
    "responseError": {
      "code": 20000,
      "msg": "系统错误",
      "sub_code": "isp.service-error:628004205",
      "sub_msg": "628004205:Redis Get错误"
    }
  },
  "source": "https://op.jinritemai.com/docs/api-docs/163/1514",
  "updatedAt": "2026-04-20",
  "_file_stem": "sms-sms-template-search"
}
