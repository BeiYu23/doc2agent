{
  "id": "doudian.sms.sms.sign.getVersion",
  "platform": "doudian",
  "group": "sms",
  "name": "sms.sign.getVersion",
  "description": "获取短信签名版本",
  "method": "GET",
  "path": "/sms/sign/getVersion",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 店铺"
  },
  "notes": [
    "文档书: 短信API（版本 V1.01）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [],
  "responseParams": [
    {
      "name": "version",
      "type": "string",
      "description": "版本，v2是新链路",
      "example": "v2"
    }
  ],
  "responseCodes": [
    {
      "code": "10000",
      "meaning": "成功",
      "action": "正常处理"
    }
  ],
  "examples": {
    "request": "curl -X GET 'https://openapi-fxg.jinritemai.com/sms/sign/getVersion?app_key=your_appkey_here&method=sms.sign.getVersion&access_token=your_accesstoken_here&param_json={}&timestamp=2018-06-19%2016:06:59&v=2&sign=your_sign_here'",
    "responseSuccess": {
      "data": {
        "version": "v2"
      },
      "code": 10000,
      "msg": "success",
      "sub_code": "",
      "sub_msg": ""
    },
    "responseError": {
      "sub_code": "",
      "sub_msg": ""
    }
  },
  "source": "https://op.jinritemai.com/docs/api-docs/163/8160",
  "updatedAt": "2026-03-27",
  "_file_stem": "sms-sms-sign-getVersion"
}
