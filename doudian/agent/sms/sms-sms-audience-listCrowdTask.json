      "in": "body",
      "type": "string",
      "required": false,
      "description": "人群名称",
      "example": "test",
      "_depth": 0
    },
    {
      "name": "crowd_type_list",
      "in": "body",
      "type": "array",
      "required": false,
      "description": "人群任务类型 2-种子人群 3-规则圈选人群 4-行为圈群",
      "example": "[2,3]",
      "_depth": 0
