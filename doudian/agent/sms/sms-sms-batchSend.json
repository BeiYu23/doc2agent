{
  "id": "doudian.sms.sms.batchSend",
  "platform": "doudian",
  "group": "sms",
  "name": "sms.batchSend",
  "description": "批量短信发送",
  "method": "GET",
  "path": "/sms/batchSend",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 店铺"
  },
  "notes": [
    "文档书: 短信API（版本 V5.01）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "sms_account",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "短信发送渠道，主要做资源隔离",
      "example": "1234",
      "_depth": 0
    },
    {
      "name": "sign",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "短信签名",
      "example": "abc",
      "_depth": 0
    },
    {
      "name": "sms_message_list",
      "in": "body",
      "type": "array",
      "required": true,
      "description": "短信列表",
      "example": "",
      "_depth": 0
    },
    {
      "name": "scene_type",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "场景类型，1-售后退货寄件人",
      "example": "1",
      "_depth": 1
    },
    {
      "name": "after_sale_id",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "售后单id",
      "example": "13837776263",
      "_depth": 1
    },
    {
      "name": "template_param",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "参数",
      "example": "{\\\"code\\\":\\\"1234\\\"}",
      "_depth": 1
    },
    {
      "name": "post_tel",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "已废弃",
      "example": "13837776263",
      "_depth": 1
    },
    {
      "name": "order_id",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "订单id",
      "example": "13837776263",
      "_depth": 1
    },
    {
      "name": "douyin_open_id",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "抖音小程序openID",
      "example": "1282618212",
      "_depth": 1
    },
    {
      "name": "outbound_id",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "外呼id，由/member/getOutboundId接口获取。/member/getOutboundId当前还未开放，outbound_id暂不支持使用",
      "example": "17037442535v6Nz7_3u0",
      "_depth": 1
    },
    {
      "name": "template_id",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "短信模板id",
      "example": "60505C68",
      "_depth": 0
    },
    {
      "name": "tag",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "透传字段，回执的时候原样返回给调用方，最大长度512字符",
      "example": "123456",
      "_depth": 0
    },
    {
      "name": "user_ext_code",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "用户自定义扩展码，仅当允许自定义扩展码的时候生效",
      "example": "abc",
      "_depth": 0
    },
    {
      "name": "link_id",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "需要链接统计效果时必传，且    2. tag需要以map[string]interface{}的json形式传入，并且带上\"link_id\":\"\"",
      "example": "121292221",
      "_depth": 0
    },
    {
      "name": "mini_app_link_id",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "需要链接统计效果时必传，且    2. tag需要以map[string]interface{}的json形式传入，并且带上\"mini_app_link_id\":\"\"",
      "example": "21628162812",
      "_depth": 0
    }
  ],
  "responseParams": [
    {
      "name": "send_result_list",
      "type": "array",
      "description": "发送结果列表",
      "example": ""
    }
  ],
