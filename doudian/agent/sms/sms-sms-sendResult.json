{
  "id": "doudian.sms.sms.sendResult",
  "platform": "doudian",
  "group": "sms",
  "name": "sms.sendResult",
  "description": "查询短信发送结果",
  "method": "GET",
  "path": "/sms/sendResult",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 店铺"
  },
  "notes": [
    "文档书: 短信API（版本 V4.01）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "from_time",
      "in": "body",
      "type": "mixed",
      "required": true,
      "description": "开始时间-时间戳，单位秒",
      "example": "1618652575",
      "_depth": 0
    },
    {
      "name": "to_time",
      "in": "body",
      "type": "mixed",
      "required": true,
      "description": "结束时间-时间戳，单位秒",
      "example": "1618652575",
      "_depth": 0
    },
    {
      "name": "sms_account",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "短信发送渠道，主要做资源隔离",
      "example": "1234",
      "_depth": 0
    },
    {
      "name": "template_id",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "模版id",
      "example": "444",
      "_depth": 0
    },
    {
      "name": "status",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "发送状态： 未回执：1 发送失败：2 发送成功：3",
      "example": "1",
      "_depth": 0
    },
    {
      "name": "size",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "查询结果大小，默认是10",
      "example": "10",
      "_depth": 0
    },
    {
      "name": "page",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "查询结果页数，从0开始，默认是0",
      "example": "0",
      "_depth": 0
    },
    {
      "name": "sign",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "签名内容",
      "example": "21312",
      "_depth": 0
    },
    {
      "name": "post_tel",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "既支持明文，又支持密文",
      "example": "15088788987",
      "_depth": 0
    },
    {
      "name": "message_id",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "消息的唯一标识，可以用于查询短信到达等",
      "example": "7238746",
      "_depth": 0
    },
    {
      "name": "tpl_type",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "查询短信类型，默认是查普通文本短信：\n0是查询所有类型短信，1是查询普通文本短信，2是查询视频短信",
      "example": "1",
      "_depth": 0
    },
    {
      "name": "sms_test_verification",
      "in": "body",
      "type": "object",
      "required": false,
      "description": "明文手机号查询验证码",
      "example": "",
      "_depth": 0
    },
    {
      "name": "code",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "验证码",
      "example": "214213",
      "_depth": 1
    },
    {
      "name": "post_tel",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "明文手机号",
      "example": "12132131231",
      "_depth": 1
    }
  ],
  "responseParams": [
    {
      "name": "total",
      "type": "mixed",
      "description": "数量",
      "example": "100"
    },
    {
      "name": "sms_send_result_list",
      "type": "array",
      "description": "短信结果列表",
      "example": ""
    }
  ],
  "responseCodes": [
    {
      "code": "10000",
      "meaning": "success",
      "action": "正常处理"
    },
    {
      "code": "20000",
      "meaning": "系统错误 / 超时，请重试（sub_code: isp.service-error:500）",
      "action": "超时，请重试",
      "sub_code": "isp.service-error:500",
      "sub_msg": "超时，请重试"
    },
    {
      "code": "50002",
      "meaning": "业务处理失败 / 响应结果不符合预期（sub_code: isv.business-failed:628005100）",
      "action": "请根据错误信息描述检查",
      "sub_code": "isv.business-failed:628005100",
      "sub_msg": "响应结果不符合预期"
    },
    {
      "code": "20000",
      "meaning": "系统错误 / 628004205:Redis Get错误（sub_code: isp.service-error:628004205）",
      "action": "系统内部错误，请重试",
      "sub_code": "isp.service-error:628004205",
      "sub_msg": "628004205:Redis Get错误"
    },
    {
      "code": "50002",
      "meaning": "业务处理失败 / 628002001:您输入参数不正确，请检查后重试（sub_code: isv.business-failed:628002001）",
      "action": "业务错误，请检查",
      "sub_code": "isv.business-failed:628002001",
      "sub_msg": "628002001:您输入参数不正确，请检查后重试"
    },
    {
      "code": "50002",
      "meaning": "业务处理失败 / 628004002:请求超时（sub_code: isv.business-failed:628004002）",
      "action": "请求超时，请重试",
      "sub_code": "isv.business-failed:628004002",
      "sub_msg": "628004002:请求超时"
    },
    {
      "code": "50002",
      "meaning": "业务处理失败 / 628004004:Access Database error（sub_code: isv.business-failed:628004004）",
      "action": "628004004:Access Database error",
      "sub_code": "isv.business-failed:628004004",
      "sub_msg": "628004004:Access Database error"
    }
  ],
  "examples": {
    "request": "curl -X GET 'https://openapi-fxg.jinritemai.com/sms/sendResult?app_key=your_appkey_here&method=sms.sendResult&access_token=your_accesstoken_here&param_json={}&timestamp=2018-06-19%2016:06:59&v=2&sign=your_sign_here'",
    "responseSuccess": {
      "data": {
        "sms_send_result_list": [
          {
            "code": "0",
            "count": "1",
            "message": "abc",
            "message_id": "MessageID1",
            "send_time": "1618652575",
            "sms_content": "您购买的商品已重新发出，圆通快递快递运单号：1234，关注“XXX”公众号刷新订单获取最新物流信息哦~给您造成不便敬请谅解。",
            "status": "1",
            "tag": "12345"
          }
        ],
        "total": "100"
      },
      "code": 10000,
      "msg": "success",
      "sub_code": "",
      "sub_msg": ""
    },
    "responseError": {
      "code": 20000,
      "msg": "系统错误",
      "sub_code": "isp.service-error:500",
      "sub_msg": "超时，请重试"
    }
  },
  "source": "https://op.jinritemai.com/docs/api-docs/163/1517",
  "updatedAt": "2026-08-18",
  "_file_stem": "sms-sms-sendResult",
  "cnName": "查询短信发送结果"
}
