{
  "id": "doudian.sms.sms.public.template",
  "cnName": "公共模版查询",
  "docUrl": "/docs/doudian/sms/sms-sms-public-template",
  "name": "sms.public.template",
  "platform": "doudian",
  "group": "sms",
  "description": "公共模版查询接口",
  "method": "GET",
  "path": "/sms/public/template",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 店铺"
  },
  "notes": [
    "文档书: 短信API（版本 V3.01）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "size",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "每页数据大小",
      "example": "10",
      "_depth": 0
    },
    {
      "name": "page",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "第几页，从0开始",
      "example": "0",
      "_depth": 0
    },
    {
      "name": "template_id",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "模版id",
      "example": "ST_90251",
      "_depth": 0
    }
  ],
  "responseParams": [
    {
      "name": "total",
      "type": "mixed",
      "description": "数据总量",
      "example": "100"
    },
    {
      "name": "public_template_list",
      "type": "array",
      "description": "列表页数据",
      "example": ""
    }
  ],
  "responseCodes": [
    {
      "code": "10000",
      "meaning": "成功",
      "action": "正常处理"
    }
  ],
  "examples": {
    "request": "curl -X GET 'https://openapi-fxg.jinritemai.com/sms/public/template?app_key=your_appkey_here&method=sms.public.template&access_token=your_accesstoken_here&param_json={}&timestamp=2018-06-19%2016:06:59&v=2&sign=your_sign_here'",
    "responseSuccess": {
      "data": {
        "public_template_list": [
          {
            "channel_type": "CN_OTP",
            "template_content": "你的验证码是${code},3分钟内有效",
            "template_id": "ST_0000",
            "template_name": "验证码"
          }
        ],
        "total": "100"
      },
      "code": 10000,
      "msg": "success",
      "sub_code": "",
      "sub_msg": ""
    },
    "responseError": {
      "sub_code": "",
      "sub_msg": ""
    }
  },
  "source": "https://op.jinritemai.com/docs/api-docs/163/1526",
  "updatedAt": "2024-12-23",
  "_file_stem": "sms-sms-public-template"
}
