{
  "id": "doudian.sms.recycle.sms.applySmsTemplate",
  "platform": "doudian",
  "group": "sms",
  "name": "recycle.sms.applySmsTemplate",
  "description": "申请短信模板",
  "method": "GET",
  "path": "/recycle/sms/applySmsTemplate",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 见平台说明"
  },
  "notes": [
    "文档书: 短信API（版本 V1.01）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "sms_account",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "渠道账号",
      "example": "123312",
      "_depth": 0
    },
    {
      "name": "template_type",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "模版类型",
      "example": "CN_NTC",
      "_depth": 0
    },
    {
      "name": "template_name",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "模版名称",
      "example": "模板模板模板",
      "_depth": 0
    },
    {
      "name": "template_content",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "模版内容",
      "example": "1111",
      "_depth": 0
    }
  ],
  "responseParams": [
    {
      "name": "sms_template_id",
      "type": "string",
      "description": "模板id",
      "example": "ST_XXX"
    },
    {
      "name": "sms_template_apply_id",
      "type": "string",
      "description": "模板申请id",
      "example": "1231"
    }
  ],
  "responseCodes": [
    {
      "code": "10000",
      "meaning": "成功",
      "action": "正常处理"
    }
  ],
  "examples": {
    "request": "curl -X GET 'https://openapi-fxg.jinritemai.com/recycle/sms/applySmsTemplate?app_key=your_appkey_here&method=recycle.sms.applySmsTemplate&access_token=your_accesstoken_here&param_json={}&timestamp=2018-06-19%2016:06:59&v=2&sign=your_sign_here'",
    "responseSuccess": {
      "data": {
        "sms_template_apply_id": "1231",
        "sms_template_id": "ST_XXX"
      },
      "code": 10000,
      "msg": "success",
      "sub_code": "",
      "sub_msg": ""
    },
    "responseError": {
      "sub_code": "",
      "sub_msg": ""
    }
  },
