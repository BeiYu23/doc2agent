{
  "id": "doudian.sms.sms.getPreviewUserAmount",
  "platform": "doudian",
  "group": "sms",
  "name": "sms.getPreviewUserAmount",
  "description": "预估公域标签圈选人群包人群数量",
  "method": "GET",
  "path": "/sms/getPreviewUserAmount",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 店铺"
  },
  "notes": [
    "文档书: 短信API（版本 V1.01）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "audience_id",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "人群包ID",
      "example": "123111",
      "_depth": 0
    },
    {
      "name": "node_list",
      "in": "body",
      "type": "array",
      "required": false,
      "description": "规则圈选",
      "example": "",
      "_depth": 0
    },
    {
      "name": "condition",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "符号，nodeType =2 时必填：AND交集 OR并集 EXCEPT差集 LEFTPARENS左括号 RIGHTPARENS右括号",
      "example": "AND",
      "_depth": 1
    },
    {
      "name": "produce_id",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "生产包id，nodeType=1时必填",
      "example": "123",
      "_depth": 1
    },
    {
      "name": "node_type",
      "in": "body",
      "type": "number",
      "required": false,
      "description": "1值 2运算符",
      "example": "1",
      "_depth": 1
    }
  ],
  "responseParams": [
    {
      "name": "preview_user_amount",
      "type": "number",
      "description": "预估人群包数量",
      "example": "123"
    }
  ],
  "responseCodes": [
    {
      "code": "10000",
      "meaning": "成功",
      "action": "正常处理"
    }
  ],
