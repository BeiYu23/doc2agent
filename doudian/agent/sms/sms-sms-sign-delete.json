{
  "id": "doudian.sms.sms.sign.delete",
  "platform": "doudian",
  "group": "sms",
  "name": "sms.sign.delete",
  "description": "删除短信签名",
  "method": "GET",
  "path": "/sms/sign/delete",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 店铺"
  },
  "notes": [
    "文档书: 短信API（版本 V2.01）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "sms_account",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "短信发送渠道，主要做资源隔离",
      "example": "1234",
      "_depth": 0
    },
    {
      "name": "sign",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "签名",
      "example": "abc",
      "_depth": 0
    }
  ],
  "responseParams": [
    {
      "name": "code",
      "type": "mixed",
      "description": "是否成功 0表示成功",
      "example": "0"
    },
    {
      "name": "message",
      "type": "string",
      "description": "说明",
      "example": "成功"
    }
  ],
  "responseCodes": [
    {
      "code": "10000",
      "meaning": "success",
      "action": "正常处理"
    },
    {
      "code": "50002",
      "meaning": "业务处理失败 / 响应结果不符合预期（sub_code: isv.business-failed:628005100）",
      "action": "请根据错误信息描述检查",
      "sub_code": "isv.business-failed:628005100",
      "sub_msg": "响应结果不符合预期"
    }
  ],
  "examples": {
    "request": "curl -X GET 'https://openapi-fxg.jinritemai.com/sms/sign/delete?app_key=your_appkey_here&method=sms.sign.delete&access_token=your_accesstoken_here&param_json={}&timestamp=2018-06-19%2016:06:59&v=2&sign=your_sign_here'",
    "responseSuccess": {
      "data": {
        "code": "0",
        "message": "成功"
      },
      "code": 10000,
      "msg": "success",
      "sub_code": "",
      "sub_msg": ""
    },
    "responseError": {
      "code": 50002,
      "msg": "业务处理失败",
      "sub_code": "isv.business-failed:628005100",
      "sub_msg": "响应结果不符合预期"
    }
  },
  "source": "https://op.jinritemai.com/docs/api-docs/163/1520",
  "updatedAt": "2024-12-23",
  "_file_stem": "sms-sms-sign-delete",
  "cnName": "删除短信签名"
}
