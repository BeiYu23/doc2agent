{
  "id": "doudian.sms.sms.template.bind",
  "platform": "doudian",
  "group": "sms",
  "name": "sms.template.bind",
  "description": "绑定短信模板",
  "method": "GET",
  "path": "/sms/template/bind",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 店铺"
  },
  "notes": [
    "文档书: 短信API（版本 V1.01）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "sms_account",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "消息组id",
      "example": "sefa",
      "_depth": 0
    },
    {
      "name": "template_id",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "模板id，必须传入不带openId的模板",
      "example": "ST_8a19sefe",
      "_depth": 0
    },
    {
      "name": "template_biz_sub_type",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "模板子类型",
      "example": "100000",
      "_depth": 0
    },
    {
      "name": "template_biz_type",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "模板类型",
      "example": "1",
      "_depth": 0
    }
  ],
  "responseParams": [],
  "responseCodes": [
    {
      "code": "10000",
      "meaning": "成功",
      "action": "正常处理"
    }
  ],
  "examples": {
    "request": "curl -X GET 'https://openapi-fxg.jinritemai.com/sms/template/bind?app_key=your_appkey_here&method=sms.template.bind&access_token=your_accesstoken_here&param_json={}&timestamp=2018-06-19%2016:06:59&v=2&sign=your_sign_here'",
    "responseSuccess": {
      "code": 10000,
      "msg": "success",
      "sub_code": "",
      "sub_msg": ""
    },
    "responseError": {
      "sub_code": "",
      "sub_msg": ""
    }
  },
  "source": "https://op.jinritemai.com/docs/api-docs/163/8167",
  "updatedAt": "2026-04-20",
  "_file_stem": "sms-sms-template-bind",
  "cnName": "绑定短信模板"
}
