{
  "id": "doudian.sms.sms.template.apply.list",
  "platform": "doudian",
  "group": "sms",
  "name": "sms.template.apply.list",
  "description": "查询短信模板申请单",
  "method": "GET",
  "path": "/sms/template/apply/list",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 店铺"
  },
  "notes": [
    "文档书: 短信API（版本 V2.01）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "sms_account",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "短信发送渠道，主要做资源隔离",
      "example": "1234",
      "_depth": 0
    },
    {
      "name": "template_content",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "短信模板内容： 英文短信：整条短信（包括签名+模板+变量中的内容）最多支持140个英文字符，超出将按140个字符截取为多条短信进行发送，费用按截取的条数收费； 非英文短信：整条短信（包括签名+模板+变量中的内容）最多支持70字符，超出将按70个字符截取为多条短信进行发送，费用按截取的条数收费；",
      "example": "您购买的商品已重新发出，${name}快递运单号：${number}，关注“XXX”公众号刷新订单获取最新物流信息哦~给您造成不便敬请谅解。",
      "_depth": 0
    },
    {
      "name": "sms_template_apply_id",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "短信模板申请单id",
      "example": "23423423",
      "_depth": 0
    },
    {
      "name": "size",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "每页数量，默认10",
      "example": "10",
      "_depth": 0
    },
    {
      "name": "page",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "页码，默认0",
      "example": "0",
      "_depth": 0
    },
    {
      "name": "status",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "审核状态： 1:审核中 2:未通过 3:已开通 4:已关闭 5:免审",
      "example": "1",
      "_depth": 0
    },
    {
      "name": "version",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "短信版本，v2表示新版本",
      "example": "v2",
      "_depth": 0
    }
  ],
  "responseParams": [
    {
      "name": "template_apply_list",
      "type": "array",
      "description": "短信模板申请单列表",
      "example": ""
    },
    {
      "name": "total",
      "type": "mixed",
      "description": "总数",
      "example": "100"
    }
  ],
  "responseCodes": [
    {
      "code": "10000",
      "meaning": "success",
      "action": "正常处理"
    },
    {
      "code": "50002",
      "meaning": "业务处理失败 / 响应结果不符合预期（sub_code: isv.business-failed:628005100）",
      "action": "请根据错误码描述检查请求参数",
      "sub_code": "isv.business-failed:628005100",
      "sub_msg": "响应结果不符合预期"
    },
    {
      "code": "20000",
      "meaning": "系统错误 / 628004205:Redis Get错误（sub_code: isp.service-error:628004205）",
      "action": "系统内部错误，请重试",
      "sub_code": "isp.service-error:628004205",
      "sub_msg": "628004205:Redis Get错误"
    },
    {
      "code": "50002",
      "meaning": "业务处理失败 / 628004002:接口超时（sub_code: isv.business-failed:628004002）",
      "action": "请重试",
      "sub_code": "isv.business-failed:628004002",
      "sub_msg": "628004002:接口超时"
    }
  ],
  "examples": {
    "request": "curl -X GET 'https://openapi-fxg.jinritemai.YOUR_SECRET_KEY?app_key=your_appkey_here&method=sms.template.apply.list&access_token=your_accesstoken_here&param_json={}&timestamp=2018-06-19%2016:06:59&v=2&sign=your_sign_here'",
    "responseSuccess": {
      "data": {
        "template_apply_list": [
          {
            "channel_type": "模版类型",
            "public_fail_reason": "失败原因",
            "public_status": "3",
            "sms_account": "1234",
            "sms_template_apply_id": "23423423",
            "status": "1",
            "status_remark": "签名重复",
            "template_content": "您购买的商品已重新发出，${name}快递运单号：${number}，关注“XXX”公众号刷新订单获取最新物流信息哦~给您造成不便敬请谅解。",
            "template_id": "ST_123456",
            "template_name": "618大促"
          }
        ],
        "total": "100"
      },
      "code": 10000,
      "msg": "success",
      "sub_code": "",
      "sub_msg": ""
    },
    "responseError": {
      "code": 50002,
      "msg": "业务处理失败",
      "sub_code": "isv.business-failed:628005100",
      "sub_msg": "响应结果不符合预期"
    }
  },
  "source": "https://op.jinritemai.com/docs/api-docs/163/1516",
  "updatedAt": "2025-12-18",
  "_file_stem": "sms-sms-template-apply-list",
  "cnName": "查询短信模板申请单"
}
