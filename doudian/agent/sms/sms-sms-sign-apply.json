{
  "id": "doudian.sms.sms.sign.apply",
  "platform": "doudian",
  "group": "sms",
  "name": "sms.sign.apply",
  "description": "提交短信签名申请单",
  "method": "GET",
  "path": "/sms/sign/apply",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 店铺"
  },
  "notes": [
    "文档书: 短信API（版本 V3.01）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "sms_account",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "短信发送渠道，主要做资源隔离",
      "example": "12345",
      "_depth": 0
    },
    {
      "name": "sign",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "签名",
      "example": "abc",
      "_depth": 0
    },
    {
      "name": "version",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "版本号 v2则走新链路",
      "example": "v2",
      "_depth": 0
    },
    {
      "name": "auto_use_isv_dedicated_message_group",
      "in": "body",
      "type": "boolean",
      "required": false,
      "description": "是否使用isv专用消息组，为true且申请签名与抖店后台签名不一致时，将签名申请到isv专用消息组",
      "example": "true",
      "_depth": 0
    }
  ],
  "responseParams": [
    {
      "name": "sms_account",
      "type": "string",
      "description": "短信发送渠道，主要做资源隔离",
      "example": "1234"
    },
    {
      "name": "sms_sign_apply_id",
      "type": "string",
      "description": "短信签名申请单id",
      "example": "23423423"
    },
    {
      "name": "code",
      "type": "mixed",
      "description": "是否成功 0表示成功",
      "example": "0"
    },
    {
      "name": "message",
      "type": "string",
      "description": "说明",
      "example": "成功"
    },
    {
      "name": "sign",
      "type": "string",
      "description": "签名",
      "example": "abc"
    },
    {
      "name": "status",
      "type": "mixed",
      "description": "审核状态： 1:审核中 2:未通过 3:已开通 4:已关闭 5:免审核（店铺名和签名完全一致时返回）",
      "example": "1"
    },
    {
      "name": "shop_sub_account",
      "type": "string",
      "description": "签名申请到了哪个消息组",
      "example": "sefsfe"
    }
  ],
  "responseCodes": [
    {
      "code": "10000",
      "meaning": "success",
      "action": "正常处理"
    },
    {
      "code": "40004",
      "meaning": "非法的参数 / 签名已经存在（sub_code: isv.parameter-invalid:7）",
      "action": "签名已经存在",
