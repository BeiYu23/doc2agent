  "examples": {
    "request": "curl -X GET 'https://openapi-fxg.jinritemai.com/sms/sign/apply?app_key=your_appkey_here&method=sms.sign.apply&access_token=your_accesstoken_here&param_json={}&timestamp=2018-06-19%2016:06:59&v=2&sign=your_sign_here'",
    "responseSuccess": {
