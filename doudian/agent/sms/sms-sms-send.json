{
  "id": "doudian.sms.sms.send",
  "platform": "doudian",
  "group": "sms",
  "name": "sms.send",
  "description": "短信发送",
  "method": "GET",
  "path": "/sms/send",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 店铺"
  },
  "notes": [
    "文档书: 短信API（版本 V5.01）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "sms_account",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "短信发送渠道，主要做资源隔离",
      "example": "1234",
      "_depth": 0
    },
    {
      "name": "sign",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "签名",
      "example": "火山测试",
      "_depth": 0
    },
    {
      "name": "template_id",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "短信模版id",
      "example": "ST_60505c68",
      "_depth": 0
    },
    {
      "name": "template_param",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "短信模板占位符要替换的值",
      "example": "{\"code\":\"1234\"}",
      "_depth": 0
    },
    {
      "name": "tag",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "透传字段，回执的时候原样返回给调用方，最大长度512字符",
      "example": "回执",
      "_depth": 0
    },
    {
      "name": "post_tel",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "只允许传入平台指定的明文测试手机号，不再支持通过加密手机号发短信",
      "example": "13141313131",
      "_depth": 0
    },
    {
      "name": "user_ext_code",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "用户自定义扩展码，仅当允许自定义扩展码的时候生效",
      "example": "abc",
      "_depth": 0
    },
    {
      "name": "outbound_id",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "外呼id，由/member/getOutboundId接口获得，/member/getOutboundId当前还未开放，outbound_id暂不支持使用",
      "example": "17037442535v6Nz7_3u0",
      "_depth": 0
    },
    {
      "name": "link_id",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "短链ID，需要链接统计效果必传，并且tag需要以map[string]interface{}的json形式传入，并且带上\"link_id\":\"\"",
      "example": "12332222",
      "_depth": 0
    },
    {
      "name": "mini_app_link_id",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "小程序短链批次ID，需要链接统计效果必传，并且tag需要以map[string]interface{}的json形式传入，并且带上\"mini_app_link_id\":\"\"",
      "example": "272626262",
      "_depth": 0
    },
    {
      "name": "douyin_open_id",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "抖音openID",
      "example": "8787878787878",
      "_depth": 0
    },
    {
      "name": "sms_test_verification",
      "in": "body",
      "type": "object",
      "required": false,
      "description": "测试发送验证码",
      "example": "",
      "_depth": 0
    },
    {
      "name": "code",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "验证码",
      "example": "123456",
      "_depth": 1
    },
    {
      "name": "post_tel",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "明文手机号",
      "example": "12345678912",
      "_depth": 1
    },
    {
      "name": "order_id",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "订单id（店铺单）",
      "example": "123456",
      "_depth": 0
    },
    {
      "name": "after_sale_id",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "售后单id",
      "example": "123456",
      "_depth": 0
    },
    {
      "name": "scene_type",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "场景类型，1-售后退货寄件人",
      "example": "1",
      "_depth": 0
    }
  ],
  "responseParams": [
    {
      "name": "code",
      "type": "mixed",
      "description": "错误码，0表示成功",
      "example": "0"
    },
    {
      "name": "message",
      "type": "string",
      "description": "说明",
      "example": "abc"
    },
    {
      "name": "message_id",
      "type": "string",
      "description": "消息的唯一标识，可以用于查询短信到达等",
      "example": "435435435435"
    }
  ],
  "responseCodes": [
