{
  "id": "doudian.sms.sms.sign.search",
  "cnName": "查看短信签名",
  "docUrl": "/docs/doudian/sms/sms-sms-sign-search",
  "name": "sms.sign.search",
  "platform": "doudian",
  "group": "sms",
  "description": "查看短信签名",
  "method": "GET",
  "path": "/sms/sign/search",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 店铺"
  },
  "notes": [
    "文档书: 短信API（版本 V2.01）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "sms_account",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "短信发送渠道，主要做资源隔离",
      "example": "1234",
      "_depth": 0
    },
    {
      "name": "like",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "模糊搜索串",
      "example": "abc",
      "_depth": 0
    },
    {
      "name": "size",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "每页大小，默认10",
      "example": "10",
      "_depth": 0
    },
    {
      "name": "page",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "页码，默认0",
      "example": "0",
      "_depth": 0
    },
    {
      "name": "version",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "版本号 v2则走新链路",
      "example": "v2",
      "_depth": 0
    }
  ],
  "responseParams": [
    {
      "name": "sign_search_list",
      "type": "array",
      "description": "签名列表",
      "example": ""
    },
    {
      "name": "total",
      "type": "mixed",
      "description": "总数",
      "example": "100"
    }
  ],
  "responseCodes": [
    {
      "code": "10000",
      "meaning": "success",
      "action": "正常处理"
    },
    {
      "code": "20000",
      "meaning": "系统错误 / 628004205:Redis Get错误（sub_code: isp.service-error:628004205）",
      "action": "系统内部错误，请重试",
      "sub_code": "isp.service-error:628004205",
      "sub_msg": "628004205:Redis Get错误"
    }
  ],
  "examples": {
    "request": "curl -X GET 'https://openapi-fxg.jinritemai.com/sms/sign/search?app_key=your_appkey_here&method=sms.sign.search&access_token=your_accesstoken_here&param_json={}&timestamp=2018-06-19%2016:06:59&v=2&sign=your_sign_here'",
    "responseSuccess": {
      "data": {
        "sign_search_list": [
          {
            "sign": "abc",
            "sms_account": "1234"
          }
        ],
        "total": "100"
      },
      "code": 10000,
      "msg": "success",
      "sub_code": "",
      "sub_msg": ""
    },
    "responseError": {
      "code": 20000,
      "msg": "系统错误",
      "sub_code": "isp.service-error:628004205",
      "sub_msg": "628004205:Redis Get错误"
    }
  },
  "source": "https://op.jinritemai.com/docs/api-docs/163/1515",
  "updatedAt": "2026-03-11",
  "_file_stem": "sms-sms-sign-search"
}
