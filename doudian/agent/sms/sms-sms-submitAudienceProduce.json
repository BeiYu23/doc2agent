{
  "id": "doudian.sms.sms.submitAudienceProduce",
  "platform": "doudian",
  "group": "sms",
  "name": "sms.submitAudienceProduce",
  "description": "提交人群包圈选生产任务",
  "method": "GET",
  "path": "/sms/submitAudienceProduce",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 店铺"
  },
  "notes": [
    "文档书: 短信API（版本 V1.01）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "audience_id",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "人群包id",
      "example": "12312312",
      "_depth": 0
    },
    {
      "name": "audience_type",
      "in": "body",
      "type": "mixed",
      "required": true,
      "description": "人群包类型 0公域人群包 1私域人群包 2组合人群包",
      "example": "1",
      "_depth": 0
    },
    {
      "name": "valid_period",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "生产包有效期，可用枚举：1d/3d/7d/15d/30d",
      "example": "1d",
      "_depth": 0
    }
  ],
  "responseParams": [
    {
      "name": "produce_id",
      "type": "string",
      "description": "生产包id",
      "example": "123"
    }
  ],
  "responseCodes": [
    {
      "code": "10000",
      "meaning": "成功",
      "action": "正常处理"
    }
  ],
  "examples": {
    "request": "curl -X GET 'https://openapi-fxg.jinritemai.com/sms/submitAudienceProduce?app_key=your_appkey_here&method=sms.submitAudienceProduce&access_token=your_accesstoken_here&param_json={}&timestamp=2018-06-19%2016:06:59&v=2&sign=your_sign_here'",
    "responseSuccess": {
      "data": {
        "produce_id": "123"
      },
      "code": 10000,
      "msg": "success",
      "sub_code": "",
      "sub_msg": ""
    },
    "responseError": {
      "sub_code": "",
      "sub_msg": ""
    }
  },
  "source": "https://op.jinritemai.com/docs/api-docs/163/7786",
  "updatedAt": "2025-09-19",
  "_file_stem": "sms-sms-submitAudienceProduce"
}
