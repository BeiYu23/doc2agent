{
  "id": "doudian.sms.sms.template.apply",
  "platform": "doudian",
  "group": "sms",
  "name": "sms.template.apply",
  "description": "提交短信模板申请单",
  "method": "GET",
  "path": "/sms/template/apply",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 店铺"
  },
  "notes": [
    "文档书: 短信API（版本 V4.01）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "sms_account",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "短信发送渠道，主要做资源隔离",
      "example": "12345",
      "_depth": 0
    },
    {
      "name": "template_type",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "CN_NTC 国内通知短信 CN_MKT 国内营销短信 CN_OTP 国内验证码",
      "example": "CN_NTC",
      "_depth": 0
    },
    {
      "name": "template_name",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "短信模板名称",
      "example": "618大促",
      "_depth": 0
    },
    {
      "name": "template_content",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "短信模板内容： 英文短信：整条短信（包括签名+模板+变量中的内容）最多支持140个英文字符，超出将按140个字符截取为多条短信进行发送，费用按截取的条数收费； 非英文短信：整条短信（包括签名+模板+变量中的内容）最多支持70字符，超出将按70个字符截取为多条短信进行发送，费用按截取的条数收费；",
      "example": "您购买的商品已重新发出，${name}快递运单号：${number}，关注“XXX”公众号刷新订单获取最新物流信息哦~给您造成不便敬请谅解。",
      "_depth": 0
    },
    {
      "name": "is_public",
      "in": "body",
      "type": "boolean",
      "required": false,
      "description": "是否公域短信模板",
      "example": "false",
      "_depth": 0
    },
    {
      "name": "version",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "短信版本，v2表示新版本",
      "example": "v2",
      "_depth": 0
    },
    {
      "name": "template_biz_type",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "模板业务类型",
      "example": "1",
      "_depth": 0
    },
    {
      "name": "template_biz_sub_type",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "模板业务子类型",
      "example": "100000",
      "_depth": 0
    },
    {
      "name": "sign",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "volc_version = v2时生效 绑定签名",
      "example": "xxx",
      "_depth": 0
    },
    {
      "name": "template_params",
      "in": "body",
      "type": "array",
      "required": false,
      "description": "volc_version = v2时生效 模板的参数类型",
      "example": "",
      "_depth": 0
    },
    {
      "name": "name",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "变量名称",
      "example": "url",
      "_depth": 1
    },
    {
      "name": "param_type",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "参数类型,1普通变量,2链接变量",
      "example": "2",
      "_depth": 1
    },
    {
      "name": "template_traffic_driving",
      "in": "body",
      "type": "array",
      "required": false,
      "description": "volc_version = v2时生效 模板内容",
      "example": "",
      "_depth": 0
    },
    {
      "name": "name",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "变量名称",
      "example": "url",
      "_depth": 1
    },
    {
      "name": "content",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "变量值",
      "example": "z.douyin.com",
      "_depth": 1
    },
    {
      "name": "param_type",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "变量类型",
      "example": "2",
      "_depth": 1
    },
    {
      "name": "volc_version",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "模板版本",
      "example": "v2",
      "_depth": 0
    },
    {
      "name": "short_url_config",
      "in": "body",
      "type": "object",
      "required": false,
      "description": "volc_version = v2时生效",
      "example": "",
      "_depth": 0
    },
    {
      "name": "is_need_click_details",
      "in": "body",
      "type": "boolean",
      "required": false,
      "description": "0静态短链 1动态短链",
      "example": "false",
      "_depth": 1
    },
    {
      "name": "ua_check_strategy",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "0短链仅移动设备可访问 1短链所有设备可访问",
      "example": "1",
      "_depth": 1
    },
    {
      "name": "is_enabled",
      "in": "body",
      "type": "boolean",
      "required": false,
      "description": "0不开启 1开启",
      "example": "false",
      "_depth": 1
    }
  ],
  "responseParams": [
    {
      "name": "sms_account",
      "type": "string",
      "description": "短信发送渠道，主要做资源隔离",
      "example": "1234"
    },
    {
      "name": "template_content",
      "type": "string",
      "description": "短信模板内容： 英文短信：最多支持140个英文字符，超出将按140个字符截取为多条短信进行发送，费用按截取的条数收费； 非英文短信：最多支持140个英文字符，超出将按140个字符截取为多条短信进行发送，费用按截取的条数收费；",
      "example": "您购买的商品已重新发出，${name}快递运单号：${number}，关注“XXX”公众号刷新订单获取最新物流信息哦~给您造成不便敬请谅解。"
    },
    {
      "name": "template_name",
      "type": "string",
      "description": "短信模版名称",
      "example": "618大促"
    },
    {
      "name": "sms_template_id",
      "type": "string",
      "description": "模版id",
      "example": "234234"
    },
    {
      "name": "sms_template_apply_id",
      "type": "string",
      "description": "短信模板申请单id",
      "example": "23423423"
    },
    {
      "name": "code",
      "type": "mixed",
      "description": "是否成功 0表示成功",
      "example": "0"
    },
    {
      "name": "message",
      "type": "string",
      "description": "说明",
      "example": "成功"
    }
  ],
  "responseCodes": [
    {
      "code": "10000",
      "meaning": "success",
      "action": "正常处理"
    },
    {
      "code": "40004",
      "meaning": "非法的参数 / 7:模板中不允许包含\"【】\"等（sub_code: isv.parameter-invalid:7）",
      "action": "请根据错误码描述检查请求参数",
      "sub_code": "isv.parameter-invalid:7",
      "sub_msg": "7:模板中不允许包含\"【】\"等"
    },
    {
      "code": "50002",
      "meaning": "业务处理失败 / 响应结果不符合预期（sub_code: isv.business-failed:628005100）",
      "action": "请根据错误信息描述检查",
      "sub_code": "isv.business-failed:628005100",
      "sub_msg": "响应结果不符合预期"
    }
  ],
  "examples": {
    "request": "curl -X GET 'https://openapi-fxg.jinritemai.com/sms/template/apply?app_key=your_appkey_here&method=sms.template.apply&access_token=your_accesstoken_here&param_json={}&timestamp=2018-06-19%2016:06:59&v=2&sign=your_sign_here'",
    "responseSuccess": {
      "data": {
        "code": "0",
        "message": "成功",
        "sms_account": "1234",
        "sms_template_apply_id": "23423423",
        "sms_template_id": "234234",
        "template_content": "您购买的商品已重新发出，${name}快递运单号：${number}，关注“XXX”公众号刷新订单获取最新物流信息哦~给您造成不便敬请谅解。",
        "template_name": "618大促"
      },
      "code": 10000,
      "msg": "success",
      "sub_code": "",
      "sub_msg": ""
    },
    "responseError": {
      "code": 40004,
      "msg": "非法的参数",
      "sub_code": "isv.parameter-invalid:7",
      "sub_msg": "7:模板中不允许包含\"【】\"等"
    }
  },
  "source": "https://op.jinritemai.com/docs/api-docs/163/1527",
  "updatedAt": "2026-07-28",
  "_file_stem": "sms-sms-template-apply"
}
