{
  "id": "doudian.home-refund.retailCustom.afterSale.getAfterSaleList",
  "platform": "doudian",
  "group": "home-refund",
  "name": "retailCustom.afterSale.getAfterSaleList",
  "description": "售后列表接口",
  "method": "GET",
  "path": "YOUR_SECRET_KEY",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 店铺"
  },
  "notes": [
    "文档书: 到家售后管理（版本 V1.01）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "order_by",
      "in": "body",
      "type": "array",
      "required": false,
      "description": "排序方式，优先级按照列表顺序从前往后依次减小，写法为\"<字段名称> <排序方式>\"，字段名称目前支持\"status_deadline\"（逾期时间）、\"apply_time\"（申请时间）和 \"update_time\"（更新时间），排序方式目前支持\"asc\"（升序）和\"desc\"（降序）。按照\"逾期时间\"升序排列，会优先返回临近逾期时间的数据。",
      "example": "[\"status_deadline desc\"]",
      "_depth": 0
    },
    {
      "name": "standard_aftersale_status",
      "in": "body",
      "type": "array",
      "required": false,
      "description": "售后状态；6-待商家同意；7-待买家退货；8-待商家发货；11-待商家二次同意；12-售后成功；13-换货\\补寄\\维修待买家收货；14-换货\\补寄\\维修成功；27-商家一次拒绝；28-售后失败；29-商家二次拒绝；支持传多种状态，使用英文“,”分隔；注意：如传入非枚举值信息会被系统忽略，如传入都不合法则默认查询所有；",
      "example": "[6,7,11]",
      "_depth": 0
    },
    {
      "name": "update_end_time",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "更新时间结束，单位为秒（查询范围包含开始值）；当使用update_start_time和update_end_time时，请配合传入order_by= update_time否则会导致基于更新时间查询售后列表轮询数据遗漏；",
      "example": "1626856525",
      "_depth": 0
    },
    {
      "name": "aftersale_status",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "已废弃，推荐使用standard_aftersale_status字段。售后状态，枚举为6(待商家同意),7(待买家退货),8(待商家发货),11(待商家二次同意),12(售后成功),13(换货待买家收货),14(换货成功),27(商家一次拒绝),28(售后失败),29(商家二次拒绝)",
      "example": "2",
      "_depth": 0
    },
    {
      "name": "end_time",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "申请时间结束，单位为秒（查询范围不包含结束值）",
      "example": "1626856525",
      "_depth": 0
    },
    {
      "name": "amount_start",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "金额下限，单位为分（查询范围包含开始值）",
      "example": "300",
      "_depth": 0
    },
    {
      "name": "order_logistics_tracking_no",
      "in": "body",
      "type": "array",
      "required": false,
      "description": "正向物流单号",
      "example": "[\"SF12345678910\"]",
      "_depth": 0
    },
    {
      "name": "agree_refuse_sign",
      "in": "body",
      "type": "array",
      "required": false,
      "description": "售后申请: 是否拒签 （1：已同意拒签, 2：未同意拒签）",
      "example": "[1,2]",
      "_depth": 0
    },
    {
      "name": "aftersale_sub_type",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "售后子类型",
      "example": "8001",
      "_depth": 0
    },
    {
      "name": "aftersale_type",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "售后类型；0-退货退款；1-已发货仅退款；2-未发货仅退款；3-换货；6-价保；7-补寄；8-维修",
      "example": "1",
      "_depth": 0
    },
    {
      "name": "arbitrate_status",
      "in": "body",
      "type": "array",
      "required": false,
      "description": "已废弃，推荐使用standard_aftersale_status字段。售后状态，枚举为6(待商家同意),7(待买家退货),8(待商家发货),11(待商家二次同意),12(售后成功),13(换货待买家收货),14(换货成功),27(商家一次拒绝),28(售后失败),29(商家二次拒绝)",
      "example": "2",
      "_depth": 0
    },
    {
      "name": "need_special_type",
      "in": "body",
      "type": "boolean",
      "required": false,
      "description": "是否展示特殊售后",
      "example": "true/false",
      "_depth": 0
    },
    {
      "name": "order_logistics_state",
      "in": "body",
      "type": "array",
      "required": false,
      "description": "正向物流状态（仅支持拒签场景下的状态筛选，状态更新有一定时延。1：买家已拒签；2：买家已签收；3：快递退回中，运往商家，包含快递拦截成功；4：商家已签收）",
      "example": "[1,2,3,4]",
      "_depth": 0
    },
    {
      "name": "aftersale_status_to_final_start_time",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "售后完结时间开始，单位为秒（查询范围包含开始值），仅支持售后完结时间在近6个月内的售后单，按完结时间筛选；售后完结时间生成规则是平台根据商品的类型，售后状态等综合判断生成，当售后单有完结时间返回时售后单不可再做任何操作；",
      "example": "1626856525",
      "_depth": 0
    },
    {
      "name": "risk_flag",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "风控标签，枚举为-1(退货正常),1(退货异常)",
      "example": "-1",
      "_depth": 0
    },
    {
      "name": "size",
      "in": "body",
      "type": "mixed",
      "required": true,
      "description": "每页数量，最多100个",
      "example": "1",
      "_depth": 0
    },
    {
      "name": "refund_type",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "退款类型，枚举为0(原路退款),1(线下退款),2(备用金),3(保证金),4(无需退款)",
      "example": "1",
      "_depth": 0
    },
    {
      "name": "update_start_time",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "更新时间开始，单位为秒（查询范围包含开始值）；当使用update_start_time和update_end_time时，请配合传入order_by= update_time否则会导致基于更新时间查询售后列表轮询数据遗漏；",
      "example": "1626856525",
      "_depth": 0
    },
    {
      "name": "order_id",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "父订单号",
      "example": "4821845786203981633",
      "_depth": 0
    },
    {
      "name": "logistics_status",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "退货物流状态，枚举为1(全部),2(已发货),3(未发货)",
      "example": "2",
      "_depth": 0
    },
    {
      "name": "amount_end",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "金额上限，单位为分（查询范围不包含结束值）",
      "example": "1000",
      "_depth": 0
    },
    {
      "name": "page",
      "in": "body",
      "type": "mixed",
      "required": true,
      "description": "页码，从0开始",
      "example": "1",
      "_depth": 0
    },
    {
      "name": "aftersale_status_to_final_end_time",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "售后完结时间结束，单位为秒（查询范围包含开始值），仅支持售后完结时间在近6个月内的售后单，按完结时间筛选；售后完结时间生成规则是平台根据商品的类型，售后状态等综合判断生成，当售后单有完结时间返回时售后单不可再做任何操作；",
      "example": "1626856525",
      "_depth": 0
    },
    {
      "name": "reason",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "售后理由；1-七天无理由退货；2-非七天无理由退货；",
      "example": "1",
      "_depth": 0
    },
    {
      "name": "pay_type",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "付款方式，枚举为1(全部), 2(货到付款),3(线上付款)",
      "example": "2",
      "_depth": 0
    },
    {
      "name": "start_time",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "申请时间开始，单位为秒（查询范围包含开始值）",
      "example": "1626770133",
      "_depth": 0
    },
    {
      "name": "aftersale_id",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "售后单号",
      "example": "6987272148133888300",
      "_depth": 0
    },
    {
      "name": "order_flag",
      "in": "body",
      "type": "array",
      "required": false,
      "description": "插旗信息：0：灰 1：紫 2: 青 3：绿 4： 橙 5： 红",
      "example": "[1,2,3]",
      "_depth": 0
    }
  ],
  "responseParams": [
    {
      "name": "items",
      "type": "array",
      "description": "返回的数据",
      "example": ""
    },
    {
      "name": "has_more",
      "type": "boolean",
      "description": "是否还有更多",
      "example": "true"
    },
    {
      "name": "total",
      "type": "mixed",
      "description": "数据总数",
      "example": "1025"
    },
    {
      "name": "page",
      "type": "mixed",
      "description": "当前页码，原样返回",
      "example": "1"
    },
    {
      "name": "size",
      "type": "mixed",
      "description": "每一页的数量，原样返回",
      "example": "1"
    }
  ],
