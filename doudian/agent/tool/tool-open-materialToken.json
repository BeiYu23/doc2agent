{
  "id": "doudian.tool.open.materialToken",
  "platform": "doudian",
  "group": "tool",
  "name": "open.materialToken",
  "description": "素材上传接口访问token",
  "method": "GET",
  "path": "/open/materialToken",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 见平台说明"
  },
  "notes": [
    "文档书: 工具API（版本 V2.01）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "upload_num",
      "in": "body",
      "type": "mixed",
      "required": true,
      "description": "需要上传的素材数量",
      "example": "2",
      "_depth": 0
    },
    {
      "name": "file_extension",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "文件后缀名称，必须以\".\"开头",
      "example": ".xlsx",
      "_depth": 0
    },
    {
      "name": "biz_type",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "业务类型，  1: 素材中心 。 2: ImageX",
      "example": "2",
      "_depth": 0
    },
    {
      "name": "store_keys_array_json",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "当 biz_type 为 2，则可以自定义路径名",
      "example": "666/1.jpg",
      "_depth": 0
    }
  ],
  "responseParams": [
    {
      "name": "auth_query",
      "type": "string",
      "description": "获取下载地址query",
      "example": "https://imagex.bytedanceapi.com/?Action=ApplyImageUpload&FileExtension=.jpg&ServiceId=0cskzgtrpl&StoreKeys=6864478719709300238%2F666%2F1.jpg&UploadNum=1&Version=2018-08-01&X-Amz-Algorithm=AWS4-HMAC-SHA256&X-Amz-Credential=YOUR_ACCESS_KEY_ID%2F20230216%2Fcn-north-1%2FImageX%2Faws4_request&X-Amz-Date=20230216T091632Z&X-Amz-Expires=180&X-Amz-NotSignBody=&X-Amz-Signature=f549fadb3d1a98f04c8d29859361957e899323de76dd56bbdcf4379424cc3bb8&X-Amz-SignedHeaders=&X-Amz-SignedQueries=Action%3BFileExtension%3BServiceId%3BStoreKeys%3BUploadNum%3BVersion%3BX-Amz-Algorithm%3BX-Amz-Credential%3BX-Amz-Date%3BX-Amz-Expires%3BX-Amz-NotSignBody%3BX-Amz-SignedHeaders%3BX-Amz-SignedQueries"
    }
  ],
  "responseCodes": [
    {
      "code": "10000",
      "meaning": "success",
      "action": "正常处理"
    },
    {
      "code": "50002",
      "meaning": "业务处理失败 / 100000:参数错误（sub_code: isv.business-failed:100000）",
      "action": "联系开放平台同学",
      "sub_code": "isv.business-failed:100000",
      "sub_msg": "100000:参数错误"
    }
  ],
  "examples": {
    "request": "curl -X GET 'https://openapi-fxg.jinritemai.com/open/materialToken?app_key=your_appkey_here&method=open.materialToken&access_token=your_accesstoken_here&param_json={}&timestamp=2018-06-19%2016:06:59&v=2&sign=your_sign_here'",
    "responseSuccess": {
      "data": {
        "auth_query": "https://imagex.bytedanceapi.com/?Action=ApplyImageUpload&FileExtension=.jpg&ServiceId=0cskzgtrpl&StoreKeys=6864478719709300238%2F666%2F1.jpg&UploadNum=1&Version=2018-08-01&X-Amz-Algorithm=AWS4-HMAC-SHA256&X-Amz-Credential=YOUR_ACCESS_KEY_ID%2F20230216%2Fcn-north-1%2FImageX%2Faws4_request&X-Amz-Date=20230216T091632Z&X-Amz-Expires=180&X-Amz-NotSignBody=&X-Amz-Signature=f549fadb3d1a98f04c8d29859361957e899323de76dd56bbdcf4379424cc3bb8&X-Amz-SignedHeaders=&X-Amz-SignedQueries=Action%3BFileExtension%3BServiceId%3BStoreKeys%3BUploadNum%3BVersion%3BX-Amz-Algorithm%3BX-Amz-Credential%3BX-Amz-Date%3BX-Amz-Expires%3BX-Amz-NotSignBody%3BX-Amz-SignedHeaders%3BX-Amz-SignedQueries"
      },
      "code": 10000,
      "msg": "success",
      "sub_code": "",
      "sub_msg": ""
    },
    "responseError": {
      "code": 50002,
      "msg": "业务处理失败",
      "sub_code": "isv.business-failed:100000",
      "sub_msg": "100000:参数错误"
    }
  },
  "source": "https://op.jinritemai.com/docs/api-docs/162/2222",
  "updatedAt": "2024-09-04",
  "_file_stem": "tool-open-materialToken",
  "cnName": "素材上传接口访问token"
}
