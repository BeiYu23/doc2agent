{
  "id": "doudian.tool.fuwu.refund.search",
  "cnName": "服务市场订单退款单查询",
  "docUrl": "/docs/doudian/tool/tool-fuwu-refund-search",
  "name": "fuwu.refund.search",
  "platform": "doudian",
  "group": "tool",
  "description": "服务市场订单退款单查询",
  "method": "GET",
  "path": "/fuwu/refund/search",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 见平台说明"
  },
  "notes": [
    "文档书: 工具API（版本 V1.01）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "order_id",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "服务市场订单号",
      "example": "4968462294508977000",
      "_depth": 0
    },
    {
      "name": "start_time",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "退款开始时间",
      "example": "1716185632",
      "_depth": 0
    },
    {
      "name": "arbitrate_status",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "仲裁状态0：初始化 1：申请仲裁 99：仲裁关闭",
      "example": "1",
      "_depth": 0
    },
    {
      "name": "service_type",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "服务类型 1：软件",
      "example": "1",
      "_depth": 0
    },
    {
      "name": "end_time",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "退款结束时间",
      "example": "1716185632",
      "_depth": 0
    },
    {
      "name": "refund_status",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "退款状态0：初始化 1：已申请退款 2：退款拒绝 3：同意退款 9：退款取消 10：退款成功 99：退款关闭 100：资金退款成功",
      "example": "1",
      "_depth": 0
    },
    {
      "name": "refund_id",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "服务市场订单退款id",
      "example": "7133505927713554700",
      "_depth": 0
    },
    {
      "name": "refund_reason",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "退款原因1: \"软件功能描述与实际不符\" 2:\"软件有故障，完全无法使用\" 3:\"软件使用体验不佳（页面偶尔卡顿、闪退）\"4:\"48小时无理由退款\" 5:\"与服务商协商一致退款\" 6:\"服务数据、质量未达到承诺\" 7:\"服务商未进行对接\" 8:\"交付内容未通过平台审核\" 9:\"对交付时间不满意\" 10:\"服务商态度、专业度问题” 11:\"服务商要求加价\" 12:\"平台自动根据比例退款\" 999:\"其他\"",
      "example": "1",
      "_depth": 0
    },
    {
      "name": "size",
      "in": "body",
      "type": "mixed",
      "required": true,
      "description": "每页订单数(默认值10，最大100)",
      "example": "10",
      "_depth": 0
    },
    {
      "name": "page",
      "in": "body",
      "type": "mixed",
      "required": true,
      "description": "页数(第一页从1开始)",
      "example": "1",
      "_depth": 0
    },
    {
      "name": "rank",
      "in": "body",
      "type": "boolean",
      "required": false,
      "description": "退款时间排序默认降序",
      "example": "false",
      "_depth": 0
    },
    {
      "name": "buyer_Id",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "服务市场买家id(例如商家店铺id、百应id)",
      "example": "121231",
      "_depth": 0
    },
    {
      "name": "biz_type",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "业务类型1:商家 2:ebill 3:供应商 4:机构 5:团长",
      "example": "1",
      "_depth": 0
    }
  ],
  "responseParams": [
    {
      "name": "search_refund_list",
      "type": "array",
      "description": "服务市场退款信息列表",
      "example": ""
    },
    {
      "name": "total",
      "type": "mixed",
      "description": "总退款单数",
      "example": "100"
    }
  ],
  "responseCodes": [
    {
      "code": "10000",
      "meaning": "success",
      "action": "正常处理"
    },
    {
      "code": "40004",
      "meaning": "非法的参数 / 参数校验失败（sub_code: isv.parameter-invalid:1000001）",
      "action": "校正入参",
      "sub_code": "isv.parameter-invalid:1000001",
      "sub_msg": "参数校验失败"
    },
    {
      "code": "50002",
      "meaning": "业务处理失败（sub_code: isv.business-failed:1000004）",
      "action": "按返回的错误说明文本处理",
      "sub_code": "isv.business-failed:1000004",
      "sub_msg": "业务处理失败"
    }
  ],
  "examples": {
    "request": "curl -X GET 'https://openapi-fxg.jinritemai.com/fuwu/refund/search?app_key=your_appkey_here&method=fuwu.refund.search&access_token=your_accesstoken_here&param_json={}&timestamp=2018-06-19%2016:06:59&v=2&sign=your_sign_here'",
    "responseSuccess": {
      "data": {
        "search_refund_list": [
          {
            "apply_time": "1716185220",
            "arbitrate_status": "1",
            "order_id": "6929776762739168000",
            "pay_amount": "100",
            "pay_time": "1716185220",
            "reason_code": "1",
            "refund_amount": "120",
            "refund_id": "7133505927713550000",
            "refund_status": "1",
            "service_id": "1",
            "service_name": "退款服务",
            "service_type": "1",
            "shop_id": "11111",
            "shop_name": "抖店名称"
          }
        ],
        "total": "100"
      },
      "code": 10000,
      "msg": "success",
      "sub_code": "",
      "sub_msg": ""
    },
    "responseError": {
      "code": 40004,
      "msg": "非法的参数",
      "sub_code": "isv.parameter-invalid:1000001",
      "sub_msg": "参数校验失败"
    }
  },
  "source": "https://op.jinritemai.com/docs/api-docs/162/6531",
  "updatedAt": "2024-05-23",
  "_file_stem": "tool-fuwu-refund-search"
}
