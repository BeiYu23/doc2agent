{
  "id": "doudian.tool.rights.info",
  "cnName": "订购服务权益查询接口-服务市场",
  "docUrl": "/docs/doudian/tool/tool-rights-info",
  "name": "rights.info",
  "platform": "doudian",
  "group": "tool",
  "description": "订购服务权益查询接口-服务市场",
  "method": "GET",
  "path": "/rights/info",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 店铺, 供应商, "
  },
  "notes": [
    "文档书: 工具API（版本 V6.01）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "biz_type",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "授权主体类型，不传参默认查询店铺，2-ebill用户；3-供应商",
      "example": "3",
      "_depth": 0
    },
    {
      "name": "outer_biz_id",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "外部业务ID(模板市场为模板code)，非必传，不可与service_id同传",
      "example": "6859718390706503687",
      "_depth": 0
    },
    {
      "name": "service_id",
      "in": "body",
      "type": "number",
      "required": false,
      "description": "抖店服务市场服务ID，非必传，不可与outer_biz_id同传",
      "example": "111111",
      "_depth": 0
    }
  ],
  "responseParams": [
    {
      "name": "expire_time",
      "type": "string",
      "description": "权益到期时间",
      "example": "2022-02-01 11:22:11"
    },
    {
      "name": "rights_type",
      "type": "string",
      "description": "0-试用版，1-正式版",
      "example": "1"
    },
    {
      "name": "spec_type",
      "type": "string",
      "description": "规格类型，0-版本，其他待定",
      "example": "1"
    },
    {
      "name": "spec_val",
      "type": "string",
      "description": "规格名称",
      "example": "高级版"
    }
  ],
  "responseCodes": [
    {
      "code": "10000",
      "meaning": "success",
      "action": "正常处理"
    },
    {
      "code": "50002",
      "meaning": "业务处理失败 / 权益查询失败（sub_code: isv.business-failed:200）",
      "action": "请核对应用与授权主体",
      "sub_code": "isv.business-failed:200",
      "sub_msg": "权益查询失败"
    }
  ],
  "examples": {
    "request": "curl -X GET 'https://openapi-fxg.jinritemai.com/rights/info?app_key=your_appkey_here&method=rights.info&access_token=your_accesstoken_here&param_json={}&timestamp=2018-06-19%2016:06:59&v=2&sign=your_sign_here'",
    "responseSuccess": {
      "data": {
        "expire_time": "2022-02-01 11:22:11",
        "rights_type": "1",
        "spec_type": "1",
        "spec_val": "高级版"
      },
      "code": 10000,
      "msg": "success",
      "sub_code": "",
      "sub_msg": ""
    },
    "responseError": {
      "code": 50002,
      "msg": "业务处理失败",
      "sub_code": "isv.business-failed:200",
      "sub_msg": "权益查询失败"
    }
  },
  "source": "https://op.jinritemai.com/docs/api-docs/162/352",
  "updatedAt": "2023-08-01",
  "_file_stem": "tool-rights-info"
}
