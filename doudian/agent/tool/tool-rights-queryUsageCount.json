{
  "id": "doudian.tool.rights.queryUsageCount",
  "platform": "doudian",
  "group": "tool",
  "name": "rights.queryUsageCount",
  "description": "查询权益可使用次数",
  "method": "GET",
  "path": "/rights/queryUsageCount",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 店铺, 团长, 供应商, MCN机构, "
  },
  "notes": [
    "文档书: 工具API（版本 V1.01）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "outer_biz_id",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "外部业务ID(模板市场为模板code)，非必传，不可与service_id同传",
      "example": "6859718390706503687",
      "_depth": 0
    },
    {
      "name": "service_id",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "抖店服务市场服务ID，非必传，不可与outer_biz_id同传",
      "example": "11111",
      "_depth": 0
    }
  ],
  "responseParams": [
    {
      "name": "canDeductCount",
      "type": "mixed",
      "description": "可扣减次数",
      "example": "1000"
    },
    {
      "name": "frozenCount",
      "type": "mixed",
      "description": "冻结中的次数(处于退款中/换版本中等状态的次数)",
      "example": "500"
    },
    {
      "name": "totalCount",
      "type": "mixed",
      "description": "总的可使用次数",
      "example": "1500"
    }
  ],
  "responseCodes": [
    {
      "code": "10000",
      "meaning": "success",
      "action": "正常处理"
    },
    {
      "code": "40004",
      "meaning": "非法的参数 / 参数错误（sub_code: isv.parameter-invalid:100001）",
      "action": "修改为正确的传参",
      "sub_code": "isv.parameter-invalid:100001",
      "sub_msg": "参数错误"
    },
    {
      "code": "50002",
      "meaning": "业务处理失败 / 查询数据库错误（sub_code: isv.business-failed:200）",
      "action": "等待系统恢复后重试",
      "sub_code": "isv.business-failed:200",
      "sub_msg": "查询数据库错误"
    },
    {
      "code": "50002",
      "meaning": "业务处理失败 / 越权（sub_code: isv.business-failed:500）",
      "action": "仅查询或处理属于服务商自己的信息",
      "sub_code": "isv.business-failed:500",
      "sub_msg": "越权"
    }
  ],
  "examples": {
    "request": "curl -X GET 'https://openapi-fxg.jinritemai.com/rights/queryUsageCount?app_key=your_appkey_here&method=rights.queryUsageCount&access_token=your_accesstoken_here&param_json={}&timestamp=2018-06-19%2016:06:59&v=2&sign=your_sign_here'",
    "responseSuccess": {
      "data": {
        "canDeductCount": "1000",
        "frozenCount": "500",
        "totalCount": "1500"
      },
      "code": 10000,
      "msg": "success",
      "sub_code": "",
      "sub_msg": ""
    },
    "responseError": {
      "code": 40004,
      "msg": "非法的参数",
      "sub_code": "isv.parameter-invalid:100001",
      "sub_msg": "参数错误"
    }
  },
  "source": "https://op.jinritemai.com/docs/api-docs/162/6059",
  "updatedAt": "2024-01-12",
  "_file_stem": "tool-rights-queryUsageCount"
}
