{
  "id": "doudian.tool.appMessage.templateList",
  "platform": "doudian",
  "group": "tool",
  "name": "appMessage.templateList",
  "description": "获取消息模版列表",
  "method": "GET",
  "path": "/appMessage/templateList",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 店铺"
  },
  "notes": [
    "文档书: 工具API（版本 SNAPSHOT）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "page_index",
      "in": "body",
      "type": "number",
      "required": true,
      "description": "页码，从1开始",
      "example": "1",
      "_depth": 0
    },
    {
      "name": "page_size",
      "in": "body",
      "type": "number",
      "required": true,
      "description": "页大小",
      "example": "5",
      "_depth": 0
    }
  ],
  "responseParams": [
    {
      "name": "template_list",
      "type": "array",
      "description": "消息模板列表",
      "example": ""
    },
    {
      "name": "total",
      "type": "number",
      "description": "总数",
      "example": "2"
    }
  ],
  "responseCodes": [
    {
      "code": "10000",
      "meaning": "成功",
      "action": "正常处理"
    }
  ],
  "examples": {
    "request": "curl -X GET 'https://openapi-fxg.jinritemai.com/appMessage/templateList?app_key=your_appkey_here&method=appMessage.templateList&access_token=your_accesstoken_here&param_json={}&timestamp=2018-06-19%2016:06:59&v=2&sign=your_sign_here'",
    "responseSuccess": {
      "data": {
        "template_list": [
          {
            "content": "预警内容：{{.warning_content}}",
            "description": "异常预警",
            "example": "{\\\"title\\\":\\\"打单工具-物流异常预警\\\",\\\"content\\\":\\\"预警内容：您的3笔订单，物流出现异常情况，请及时查看。\\\",\\\"jumpUrl\\\":\\\"\\\"}",
            "msg_type": "1",
            "msg_type_str": "待处理任务",
            "params": [
              {
                "example_value": "物流异常",
                "is_necessary": "1",
                "param_desc": "预警标题",
                "param_name": "warning_title"
              }
            ],
            "status": "1",
            "template_id": "1",
            "template_name": "异常预警",
            "title": "{{.app_name}}-{{.warning_title}}预警"
          }
        ],
        "total": "2"
      },
      "code": 10000,
      "msg": "success",
      "sub_code": "",
      "sub_msg": ""
    },
    "responseError": {
      "sub_code": "",
      "sub_msg": ""
    }
  },
  "source": "https://op.jinritemai.com/docs/api-docs/162/3645",
  "updatedAt": "2023-05-08",
