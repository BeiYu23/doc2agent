{
  "id": "doudian.tool.open.QueryProductAgentResults",
  "platform": "doudian",
  "group": "tool",
  "name": "open.QueryProductAgentResults",
  "description": "查询任务结果",
  "method": "GET",
  "path": "/open/QueryProductAgentResults",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 店铺"
  },
  "notes": [
    "文档书: 工具API（版本 V1.01）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "task_id",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "任务id",
      "example": "ac131",
      "_depth": 0
    },
    {
      "name": "page",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "页码",
      "example": "1",
      "_depth": 0
    },
    {
      "name": "page_size",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "每页数量",
      "example": "10",
      "_depth": 0
    },
    {
      "name": "extra",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "额外参数的原始 JSON 字符串(map)，可空；非空时透传为 JSON",
      "example": "{\"key\": \"value\"}",
      "_depth": 0
    }
  ],
  "responseParams": [
    {
      "name": "status",
      "type": "string",
      "description": "Runing/Success/Fail",
      "example": "Runing"
    },
    {
      "name": "data",
      "type": "string",
      "description": "下游 data 原样透传(raw JSON)",
      "example": "[{\"task_id\": \"123\"}]"
    },
    {
      "name": "code",
      "type": "mixed",
      "description": "状态码",
      "example": "0"
    },
    {
      "name": "message",
      "type": "string",
      "description": "状态信息",
      "example": "success"
    },
    {
      "name": "page_info",
      "type": "string",
      "description": "下游 page_info 原样透传(raw JSON)",
      "example": "{\"page\": 1, \"page_size\": 10, \"total_count\": 50}"
    },
    {
      "name": "extra",
      "type": "string",
      "description": "下游 extra 原样透传(raw JSON)",
      "example": "{\"key\": \"value\"}"
    }
  ],
  "responseCodes": [
    {
      "code": "10000",
      "meaning": "成功",
      "action": "正常处理"
    }
  ],
  "examples": {
    "request": "curl -X GET 'https://openapi-fxg.jinritemai.com/open/QueryProductAgentResults?app_key=your_appkey_here&method=open.QueryProductAgentResults&access_token=your_accesstoken_here&param_json={}&timestamp=2018-06-19%2016:06:59&v=2&sign=your_sign_here'",
    "responseSuccess": {
      "data": {
        "code": "0",
        "data": "[{\"task_id\": \"123\"}]",
        "extra": "{\"key\": \"value\"}",
        "message": "success",
        "page_info": "{\"page\": 1, \"page_size\": 10, \"total_count\": 50}",
        "status": "Runing"
      },
      "code": 10000,
      "msg": "success",
      "sub_code": "",
      "sub_msg": ""
    },
    "responseError": {
      "sub_code": "",
      "sub_msg": ""
    }
  },
  "source": "https://op.jinritemai.com/docs/api-docs/162/8429",
