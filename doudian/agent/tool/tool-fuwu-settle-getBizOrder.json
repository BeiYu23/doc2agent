{
  "id": "doudian.tool.fuwu.settle.getBizOrder",
  "platform": "doudian",
  "group": "tool",
  "name": "fuwu.settle.getBizOrder",
  "description": "获取某一笔服务市场订单的结算信息",
  "method": "GET",
  "path": "/fuwu/settle/getBizOrder",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 见平台说明"
  },
  "notes": [
    "文档书: 工具API（版本 V1.01）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "order_id",
      "in": "body",
      "type": "mixed",
      "required": true,
      "description": "要查询的订单ID，仅支持查询服务市场订单，仅支持查询近一年内订单。",
      "example": "6930098883274470000",
      "_depth": 0
    }
  ],
  "responseParams": [
    {
      "name": "biz_order",
      "type": "object",
      "description": "服务市场订单结算信息",
      "example": ""
    }
  ],
  "responseCodes": [
    {
      "code": "10000",
      "meaning": "success",
      "action": "正常处理"
    },
    {
      "code": "40004",
      "meaning": "非法的参数 / 参数校验失败（sub_code: isv.parameter-invalid:1000001）",
      "action": "正确传参即可",
      "sub_code": "isv.parameter-invalid:1000001",
      "sub_msg": "参数校验失败"
    },
    {
      "code": "50002",
      "meaning": "业务处理失败 / 获取财经信息失败（sub_code: isv.business-failed:2300001）",
      "action": "按返回的错误说明文本处理",
      "sub_code": "isv.business-failed:2300001",
      "sub_msg": "获取财经信息失败"
    },
    {
      "code": "20000",
      "meaning": "系统错误 / 系统内部超时（sub_code: isp.service-error:1000004）",
      "action": "请稍后重试",
      "sub_code": "isp.service-error:1000004",
      "sub_msg": "系统内部超时"
    }
  ],
  "examples": {
    "request": "curl -X GET 'https://openapi-fxg.jinritemai.com/fuwu/settle/getBizOrder?app_key=your_appkey_here&method=fuwu.settle.getBizOrder&access_token=your_accesstoken_here&param_json={}&timestamp=2018-06-19%2016:06:59&v=2&sign=your_sign_here'",
    "responseSuccess": {
      "data": {
        "biz_order": {
          "order_id": "6930098883274470000",
          "pay_amount": "2000",
          "settle_status": "2",
          "settled_amount": "1200"
        }
      },
      "code": 10000,
      "msg": "success",
      "sub_code": "",
      "sub_msg": ""
    },
    "responseError": {
      "code": 40004,
      "msg": "非法的参数",
      "sub_code": "isv.parameter-invalid:1000001",
      "sub_msg": "参数校验失败"
    }
  },
