{
  "id": "doudian.tool.open.getAuthInfo",
  "cnName": "查询授权信息",
  "docUrl": "/docs/doudian/tool/tool-open-getAuthInfo",
  "name": "open.getAuthInfo",
  "platform": "doudian",
  "group": "tool",
  "description": "查询授权信息",
  "method": "GET",
  "path": "/open/getAuthInfo",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 见平台说明"
  },
  "notes": [
    "文档书: 工具API（版本 V1.01）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "auth_id",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "授权主体ID，这里为店铺ID",
      "example": "12121321212",
      "_depth": 0
    },
    {
      "name": "auth_subject_type",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "授权主体类型，默认为店铺授权，不需要填写。\n其他类型枚举值如下：YunCang -云仓；WuLiuShang -物流商；WLGongYingShang -物流供应商；MiniApp -小程序 MCN-联盟MCN机构 DouKe-联盟抖客 Colonel-联盟团长",
      "example": "WuLiuShang",
      "_depth": 0
    }
  ],
  "responseParams": [
    {
      "name": "status",
      "type": "string",
      "description": "授权状态，1为正常。枚举为\n0:待商家确认，1:正常，2:取消，3:过期。\n授权状态为正常时，需额外判断auth_end_time",
      "example": "1"
    },
    {
      "name": "auth_success_time",
      "type": "number",
      "description": "授权生效时间",
      "example": "1681351741"
    },
    {
      "name": "auth_end_time",
      "type": "number",
      "description": "授权截止时间",
      "example": "1681351741"
    },
    {
      "name": "auth_id",
      "type": "string",
      "description": "授权主体ID",
      "example": "12121212"
    },
    {
      "name": "auth_update_time",
      "type": "number",
      "description": "授权最近一次更新时间",
      "example": "1681351741"
    }
  ],
  "responseCodes": [
    {
      "code": "10000",
      "meaning": "success",
      "action": "正常处理"
    },
    {
      "code": "20000",
      "meaning": "系统错误 / 系统异常，请稍后重试（sub_code: isp.service-error:100001）",
      "action": "系统异常，请稍后重试",
      "sub_code": "isp.service-error:100001",
      "sub_msg": "系统异常，请稍后重试"
    },
    {
      "code": "40004",
      "meaning": "非法的参数 / auth_subject_type值非法（sub_code: isv.parameter-invalid:100003）",
      "action": "请填写正确的auth_subject_type",
      "sub_code": "isv.parameter-invalid:100003",
      "sub_msg": "auth_subject_type值非法"
    }
  ],
  "examples": {
    "request": "curl -X GET 'https://openapi-fxg.jinritemai.com/open/getAuthInfo?app_key=your_appkey_here&method=open.getAuthInfo&access_token=your_accesstoken_here&param_json={}&timestamp=2018-06-19%2016:06:59&v=2&sign=your_sign_here'",
    "responseSuccess": {
      "data": {
        "auth_end_time": "1681351741",
        "auth_id": "12121212",
        "auth_success_time": "1681351741",
        "auth_update_time": "1681351741",
        "status": "1"
      },
      "code": 10000,
      "msg": "success",
      "sub_code": "",
      "sub_msg": ""
    },
    "responseError": {
      "code": 20000,
      "msg": "系统错误",
      "sub_code": "isp.service-error:100001",
      "sub_msg": "系统异常，请稍后重试"
    }
  },
  "source": "https://op.jinritemai.com/docs/api-docs/162/3582",
  "updatedAt": "2023-04-18",
  "_file_stem": "tool-open-getAuthInfo"
}
