{
  "id": "doudian.tool.alliance.kol.basicInfo",
  "platform": "doudian",
  "group": "tool",
  "name": "alliance.kol.basicInfo",
  "description": "获取达人基本信息",
  "method": "GET",
  "path": "/alliance/kol/basicInfo",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 达人"
  },
  "notes": [
    "文档书: 工具API（版本 V1.01）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [],
  "responseParams": [
    {
      "name": "nick_name",
      "type": "string",
      "description": "昵称",
      "example": "测试昵称"
    },
    {
      "name": "avatar",
      "type": "string",
      "description": "头像",
      "example": "http://www.xxxx.com/avatar.png"
    }
  ],
  "responseCodes": [
    {
      "code": "10000",
      "meaning": "成功",
      "action": "正常处理"
    }
  ],
  "examples": {
    "request": "curl -X GET 'https://openapi-fxg.jinritemai.YOUR_SECRET_KEY?app_key=your_appkey_here&method=alliance.kol.basicInfo&access_token=your_accesstoken_here&param_json={}&timestamp=2018-06-19%2016:06:59&v=2&sign=your_sign_here'",
    "responseSuccess": {
      "data": {
        "avatar": "http://www.xxxx.com/avatar.png",
        "nick_name": "测试昵称"
      },
      "code": 10000,
      "msg": "success",
      "sub_code": "",
      "sub_msg": ""
    },
    "responseError": {
      "sub_code": "",
      "sub_msg": ""
    }
  },
  "source": "https://op.jinritemai.com/docs/api-docs/162/7604",
