{
  "id": "doudian.tool.open.UploadProductAgentTasks",
  "cnName": "上传任务",
  "docUrl": "/docs/doudian/tool/tool-open-UploadProductAgentTasks",
  "name": "open.UploadProductAgentTasks",
  "platform": "doudian",
  "group": "tool",
  "description": "上传任务",
  "method": "GET",
  "path": "/open/UploadProductAgentTasks",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 店铺"
  },
  "notes": [
    "文档书: 工具API（版本 V1.01）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "tasks",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "Task 数组的原始 JSON 字符串",
      "example": "[{\"xx\": \"xx\"}]",
      "_depth": 0
    },
    {
      "name": "task_type",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "任务类型：single_day(单天，不填默认 single_day)/multi_day(多天)",
      "example": "multi_day",
      "_depth": 0
    },
    {
      "name": "start_date",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "开始日期(包含)，task_type=multi_day 时必填，格式 20270701",
      "example": "20260713",
      "_depth": 0
    },
    {
      "name": "end_date",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "结束日期(包含)，task_type=multi_day 时必填，格式 20270727",
      "example": "20260726",
      "_depth": 0
    },
    {
      "name": "extra",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "额外参数的原始 JSON 字符串(map)，可空；非空时透传为 JSON",
      "example": "{\"key\": \"value\"}",
      "_depth": 0
    }
  ],
  "responseParams": [
    {
      "name": "code",
      "type": "mixed",
      "description": "状态码",
      "example": "0"
    },
    {
      "name": "message",
      "type": "string",
      "description": "状态信息",
      "example": "success"
    },
    {
      "name": "data",
      "type": "string",
      "description": "下游 data 原样透传(raw JSON)",
      "example": "[{\"id\": \"xx\", \"xx\": \"xx\"}]"
    },
    {
      "name": "extra",
      "type": "string",
      "description": "下游 extra 原样透传(raw JSON)",
      "example": "{\"key\": \"value\"}"
    }
  ],
  "responseCodes": [
    {
      "code": "10000",
      "meaning": "成功",
      "action": "正常处理"
    }
  ],
  "examples": {
    "request": "curl -X GET 'https://openapi-fxg.jinritemai.com/open/UploadProductAgentTasks?app_key=your_appkey_here&method=open.UploadProductAgentTasks&access_token=your_accesstoken_here&param_json={}&timestamp=2018-06-19%2016:06:59&v=2&sign=your_sign_here'",
    "responseSuccess": {
