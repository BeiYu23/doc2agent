{
  "id": "doudian.refund.afterSale.fillLogistics",
  "platform": "doudian",
  "group": "refund",
  "name": "afterSale.fillLogistics",
  "description": "售后商家填写物流信息",
  "method": "GET",
  "path": "/afterSale/fillLogistics",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 店铺"
  },
  "notes": [
    "文档书: 售后退款API（版本 V3.05）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "aftersale_id",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "售后单ID",
      "example": "7085126861562380588",
      "_depth": 0
    },
    {
      "name": "send_type",
      "in": "body",
      "type": "mixed",
      "required": true,
      "description": "发货类型；适用场景： send_type=1：用于补寄商家发货 send_type=3：超市预约上门取货；退货退款和换货场景下商家帮买家填写退货物流信息； send_type=4：维修场景下商家帮买家填写退货物流信息；",
      "example": "1",
      "_depth": 0
    },
    {
      "name": "company_code",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "物流公司编号\npick_up_type 2:线下取货;3:用户退回，无需物流公司，可传 -",
      "example": "yuantong",
      "_depth": 0
    },
    {
      "name": "tracking_no",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "物流单号\npick_up_type 2:线下取货;3:用户退回，无需快递单号，可传 -",
      "example": "YT1231231231",
      "_depth": 0
    },
    {
      "name": "book_time_begin",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "预约上门取货时间戳，单位：秒（目前抖超小时达店铺使用）",
      "example": "1655955000",
      "_depth": 0
    },
    {
      "name": "book_time_end",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "预约上门取货时间戳，单位：秒（目前抖超小时达店铺使用）",
      "example": "1655955600",
      "_depth": 0
    },
    {
      "name": "store_id",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "门店ID",
      "example": "门店ID",
      "_depth": 0
    },
    {
      "name": "pick_up_type",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "1:自行配送;2:线下取货;3:用户退回 ，不传默认自行配送；适用于send_type=3超市预约上门取货场景",
      "example": "1",
      "_depth": 0
    }
  ],
