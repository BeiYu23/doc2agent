{
  "id": "doudian.refund.afterSale.timeExtend",
  "platform": "doudian",
  "group": "refund",
  "name": "afterSale.timeExtend",
  "description": "此接口用来帮助商家进行延时收货，商家可以在还有2天到期的时间进行操作，会在原有剩余时间的基础上增加7天。",
  "method": "GET",
  "path": "/afterSale/timeExtend",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 店铺"
  },
  "notes": [
    "文档书: 售后退款API（版本 V3.04）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "aftersale_id",
      "in": "body",
      "type": "number",
      "required": true,
      "description": "售后单号",
      "example": "7036706918206930000",
      "_depth": 0
    }
  ],
  "responseParams": [],
  "responseCodes": [
    {
      "code": "10000",
      "meaning": "success",
      "action": "正常处理"
    },
    {
      "code": "40004",
      "meaning": "非法的参数 / 用户发货五天后才能延长收货（sub_code: isv.parameter-invalid:10001）",
      "action": "检查入参",
      "sub_code": "isv.parameter-invalid:10001",
      "sub_msg": "用户发货五天后才能延长收货"
    },
    {
      "code": "50002",
      "meaning": "业务处理失败 / 10014:查找售后单对应的用户信息失败（sub_code: isv.business-failed:10014）",
      "action": "检查入参",
      "sub_code": "isv.business-failed:10014",
      "sub_msg": "10014:查找售后单对应的用户信息失败"
    }
  ],
  "examples": {
    "request": "curl -X GET 'https://openapi-fxg.jinritemai.com/afterSale/timeExtend?app_key=your_appkey_here&method=afterSale.timeExtend&access_token=your_accesstoken_here&param_json={}&timestamp=2018-06-19%2016:06:59&v=2&sign=your_sign_here'",
    "responseSuccess": {
      "code": 10000,
      "msg": "success",
      "sub_code": "",
      "sub_msg": ""
    },
    "responseError": {
      "code": 40004,
      "msg": "非法的参数",
      "sub_code": "isv.parameter-invalid:10001",
      "sub_msg": "用户发货五天后才能延长收货"
    }
  },
  "source": "https://op.jinritemai.com/docs/api-docs/17/770",
  "updatedAt": "2021-08-03",
  "_file_stem": "refund-afterSale-timeExtend"
}
