{
  "id": "doudian.refund.open.reportOrderRecoveryResult",
  "cnName": "上报挽单执行结果",
  "docUrl": "/docs/doudian/refund/refund-open-reportOrderRecoveryResult",
  "name": "open.reportOrderRecoveryResult",
  "platform": "doudian",
  "group": "refund",
  "description": "上报挽单执行结果",
  "method": "GET",
  "path": "/open/reportOrderRecoveryResult",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 店铺"
  },
  "notes": [
    "文档书: 售后退款API（版本 V1.01）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "is_reach_consumer",
      "in": "body",
      "type": "boolean",
      "required": true,
      "description": "是否触达消费者",
      "example": "true",
      "_depth": 0
    },
    {
      "name": "reach_failed_reason",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "未触达原因",
      "example": "外呼未接通",
      "_depth": 0
    },
    {
      "name": "recover_result",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "挽单结果，枚举如下：success 挽单成功; no_reach_consumer 未能触达消费者；consumer_refuse 已触达但消费者拒绝；merchant_following 商家跟进中；merchant_abandon_recover 商家放弃挽单\n挽单失败原因",
      "example": "success",
      "_depth": 0
    },
    {
      "name": "recover_failed_reason",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "挽单失败原因",
      "example": "消费者认为补偿金额较少，拒绝挽单",
      "_depth": 0
    },
    {
      "name": "outbound_id",
      "in": "body",
      "type": "array",
      "required": false,
      "description": "外呼ID",
      "example": "[\"123\"]",
      "_depth": 0
    },
    {
      "name": "recover_trace_id",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "挽单ID",
      "example": "123456",
      "_depth": 0
    },
    {
      "name": "message_id",
      "in": "body",
      "type": "array",
      "required": false,
      "description": "短信ID",
      "example": "[\"123\"]",
      "_depth": 0
    },
    {
      "name": "conversation_id",
      "in": "body",
      "type": "array",
      "required": false,
      "description": "会话ID",
      "example": "[\"123\"]",
      "_depth": 0
    }
  ],
  "responseParams": [],
  "responseCodes": [
    {
      "code": "10000",
      "meaning": "success",
      "action": "正常处理"
    },
    {
      "code": "40004",
      "meaning": "非法的参数 / recoverTraceID不合法（sub_code: isv.parameter-invalid:10010）",
      "action": "请使用/open/getOrderRecoveryRecommendation接口返回的recoverTraceID",
      "sub_code": "isv.parameter-invalid:10010",
      "sub_msg": "recoverTraceID不合法"
    }
  ],
  "examples": {
    "request": "curl -X GET 'https://openapi-fxg.jinritemai.com/open/reportOrderRecoveryResult?app_key=your_appkey_here&method=open.reportOrderRecoveryResult&access_token=your_accesstoken_here&param_json={}&timestamp=2018-06-19%2016:06:59&v=2&sign=your_sign_here'",
    "responseSuccess": {
      "code": 10000,
      "msg": "success",
      "sub_code": "",
      "sub_msg": ""
    },
    "responseError": {
      "code": 40004,
      "msg": "非法的参数",
      "sub_code": "isv.parameter-invalid:10010",
      "sub_msg": "recoverTraceID不合法"
    }
  },
  "source": "https://op.jinritemai.com/docs/api-docs/17/8095",
  "updatedAt": "2026-02-13",
  "_file_stem": "refund-open-reportOrderRecoveryResult"
}
