{
  "id": "doudian.material.material.moveFolderToRecycleBin",
  "platform": "doudian",
  "group": "material",
  "name": "material.moveFolderToRecycleBin",
  "description": "将文件夹移动到回收站",
  "method": "GET",
  "path": "/material/moveFolderToRecycleBin",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 店铺, 供应商"
  },
  "notes": [
    "文档书: 素材中心API（版本 V2.01）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "folder_ids",
      "in": "body",
      "type": "array",
      "required": true,
      "description": "移动到回收站的文件夹id列表",
      "example": "[\"70032596029638413241510\"]",
      "_depth": 0
    }
  ],
  "responseParams": [
    {
      "name": "success_ids",
      "type": "array",
      "description": "操作成功的id list",
      "example": "[\"70032596029638413241510\"]"
    },
    {
      "name": "failed_map",
      "type": "string",
      "description": "操作失败的id map",
      "example": ""
    }
  ],
  "responseCodes": [
    {
      "code": "10000",
      "meaning": "成功",
      "action": "正常处理"
    }
  ],
  "examples": {
    "request": "curl -X GET 'https://openapi-fxg.jinritemai.com/material/moveFolderToRecycleBin?app_key=your_appkey_here&method=material.moveFolderToRecycleBin&access_token=your_accesstoken_here&param_json={}&timestamp=2018-06-19%2016:06:59&v=2&sign=your_sign_here'",
    "responseSuccess": {
      "data": {
        "failed_map": {},
        "success_ids": "[\"70032596029638413241510\"]"
      },
      "code": 10000,
      "msg": "success",
      "sub_code": "",
      "sub_msg": ""
    },
    "responseError": {
      "sub_code": "",
      "sub_msg": ""
    }
  },
