{
  "id": "doudian.material.material.searchFolder",
  "platform": "doudian",
  "group": "material",
  "name": "material.searchFolder",
  "description": "搜索文件夹",
  "method": "GET",
  "path": "/material/searchFolder",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 店铺, 供应商, 小程序"
  },
  "notes": [
    "文档书: 素材中心API（版本 V5.01）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "order_by",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "排序方式 0-创建时间倒序 1-创建时间正序 2-修改时间倒序 3-修改时间正序 4-文件夹名倒序 5-文件夹名正序",
      "example": "1",
      "_depth": 0
    },
    {
      "name": "page_num",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "分页的页数，从1开始",
      "example": "1",
      "_depth": 0
    },
    {
      "name": "page_size",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "每页返回的数量。最大为100，默认为50",
      "example": "40",
      "_depth": 0
    },
    {
      "name": "name",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "需要搜索的文件名片段",
      "example": "图片",
      "_depth": 0
    },
    {
      "name": "folder_id",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "文件夹id",
      "example": "\"70032596029638413241510\"",
      "_depth": 0
    },
    {
      "name": "create_time_start",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "创建时间最小值，包含这一秒",
      "example": "2020-09-03 18:28:00",
      "_depth": 0
    },
    {
      "name": "create_time_end",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "创建时间最大值，包含这一秒",
      "example": "2020-09-03 18:28:01",
      "_depth": 0
    },
    {
      "name": "parent_folder_id",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "父文件夹id",
      "example": "\"70032596029638413241510\"",
      "_depth": 0
    },
    {
      "name": "operate_status",
      "in": "body",
      "type": "array",
      "required": false,
      "description": "文件夹状态。1-有效 4-在回收站中",
      "example": "1",
      "_depth": 0
    }
  ],
  "responseParams": [
    {
      "name": "folder_info_list",
      "type": "array",
      "description": "文件夹列表",
      "example": ""
    },
    {
      "name": "total",
      "type": "number",
      "description": "符合筛选条件的文件夹数量",
      "example": "200"
    }
  ],
  "responseCodes": [
    {
      "code": "10000",
      "meaning": "success",
      "action": "正常处理"
    },
    {
      "code": "40004",
      "meaning": "非法的参数 / 文件夹ID无效或文件夹已被彻底删除（sub_code: isv.parameter-invalid:20001）",
      "action": "文件夹不存在的原因有：（1）主从延迟导致；（2）已被删除",
      "sub_code": "isv.parameter-invalid:20001",
      "sub_msg": "文件夹ID无效或文件夹已被彻底删除"
    },
    {
      "code": "20000",
      "meaning": "系统错误 / 系统异常，请稍后重试（sub_code: isp.service-error:10004）",
      "action": "系统异常，请稍后重试",
      "sub_code": "isp.service-error:10004",
      "sub_msg": "系统异常，请稍后重试"
    },
    {
      "code": "20000",
      "meaning": "系统错误 / 系统异常，请稍后重试（sub_code: isp.service-error:10006）",
      "action": "系统异常，请稍后重试",
      "sub_code": "isp.service-error:10006",
      "sub_msg": "系统异常，请稍后重试"
    }
  ],
  "examples": {
    "request": "curl -X GET 'https://openapi-fxg.jinritemai.com/material/searchFolder?app_key=your_appkey_here&method=material.searchFolder&access_token=your_accesstoken_here&param_json={}&timestamp=2018-06-19%2016:06:59&v=2&sign=your_sign_here'",
    "responseSuccess": {
      "data": {
        "folder_info_list": [
          {
            "create_time": "2020-09-03 18:28:01",
            "delete_time": "2020-09-03 18:28:01",
            "folder_attr": "0",
            "folder_id": "\"70032596029638413241510\"",
            "folder_type": "0",
            "name": "我是文件夹",
            "operate_status": "1",
            "parent_folder_id": "70032596029638413241510",
            "update_time": "2020-09-03 18:28:01"
          }
        ],
        "total": "200"
      },
      "code": 10000,
      "msg": "success",
      "sub_code": "",
      "sub_msg": ""
    },
    "responseError": {
      "code": 40004,
      "msg": "非法的参数",
      "sub_code": "isv.parameter-invalid:20001",
      "sub_msg": "文件夹ID无效或文件夹已被彻底删除"
    }
  },
  "source": "https://op.jinritemai.com/docs/api-docs/69/1149",
  "updatedAt": "2022-12-28",
  "_file_stem": "material-material-searchFolder"
}
