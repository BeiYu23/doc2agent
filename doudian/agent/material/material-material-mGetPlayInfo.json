{
  "id": "doudian.material.material.mGetPlayInfo",
  "platform": "doudian",
  "group": "material",
  "name": "material.mGetPlayInfo",
  "description": "批量获取视频信息",
  "method": "GET",
  "path": "/material/mGetPlayInfo",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 店铺, 供应商"
  },
  "notes": [
    "文档书: 素材中心API（版本 V2.01）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "vid_list",
      "in": "body",
      "type": "array",
      "required": true,
      "description": "vid列表，列表长度(1, 20)",
      "example": "[\"asd123asdqw\" ,\"asd1wdsadas\"]",
      "_depth": 0
    }
  ],
  "responseParams": [
    {
      "name": "success_map",
      "type": "string",
      "description": "获取成功map，key为vid，value是视频的播放信息",
      "example": ""
    },
    {
      "name": "failed_map",
      "type": "string",
      "description": "获取失败map，key为vid",
      "example": ""
    }
  ],
  "responseCodes": [
    {
      "code": "10000",
      "meaning": "success",
      "action": "正常处理"
    },
    {
      "code": "40004",
