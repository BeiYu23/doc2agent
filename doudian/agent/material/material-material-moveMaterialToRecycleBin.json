{
  "id": "doudian.material.material.moveMaterialToRecycleBin",
  "platform": "doudian",
  "group": "material",
  "name": "material.moveMaterialToRecycleBin",
  "description": "移动素材到回收站",
  "method": "GET",
  "path": "/material/moveMaterialToRecycleBin",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 店铺, 供应商"
  },
  "notes": [
    "文档书: 素材中心API（版本 V3.01）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "material_ids",
      "in": "body",
      "type": "array",
      "required": true,
      "description": "素材id列表，（1）数量不得超过100；（2）同一级目录下的素材",
      "example": "[\"7000291764753940780\"]",
      "_depth": 0
    }
  ],
  "responseParams": [
    {
      "name": "success_ids",
      "type": "array",
      "description": "成功的素材id列表",
      "example": "[\"7000291764753940780\"]"
    },
    {
      "name": "failed_map",
      "type": "string",
      "description": "失败素材列表",
      "example": ""
    }
  ],
  "responseCodes": [
    {
      "code": "10000",
      "meaning": "success",
      "action": "正常处理"
    },
    {
      "code": "40004",
      "meaning": "非法的参数 / 素材ID无效或状态错误（sub_code: isv.parameter-invalid:20001）",
      "action": "素材不存在，原因有：已被删除或主从延迟导致素材不存在",
      "sub_code": "isv.parameter-invalid:20001",
      "sub_msg": "素材ID无效或状态错误"
    },
    {
      "code": "40004",
      "meaning": "非法的参数 / 数据可能已被修改，请刷新后重新提交（sub_code: isv.parameter-invalid:22004）",
      "action": "重新选择参数，再重试",
      "sub_code": "isv.parameter-invalid:22004",
      "sub_msg": "数据可能已被修改，请刷新后重新提交"
    }
  ],
  "examples": {
    "request": "curl -X GET 'https://openapi-fxg.jinritemai.com/material/moveMaterialToRecycleBin?app_key=your_appkey_here&method=material.moveMaterialToRecycleBin&access_token=your_accesstoken_here&param_json={}&timestamp=2018-06-19%2016:06:59&v=2&sign=your_sign_here'",
    "responseSuccess": {
      "data": {
        "failed_map": {},
        "success_ids": "[\"7000291764753940780\"]"
      },
      "code": 10000,
      "msg": "success",
      "sub_code": "",
      "sub_msg": ""
    },
    "responseError": {
      "code": 40004,
      "msg": "非法的参数",
      "sub_code": "isv.parameter-invalid:20001",
      "sub_msg": "素材ID无效或状态错误"
    }
  },
  "source": "https://op.jinritemai.com/docs/api-docs/69/951",
  "updatedAt": "2022-09-06",
  "_file_stem": "material-material-moveMaterialToRecycleBin"
}
