{
  "id": "doudian.bic-inspect.orderCode.downloadOrderCodeByShop",
  "platform": "doudian",
  "group": "bic-inspect",
  "name": "orderCode.downloadOrderCodeByShop",
  "description": "预绑订单码，下载后订单进入预绑码状态【请勿使用该接口查询订单信息！！！】",
  "method": "GET",
  "path": "/orderCode/downloadOrderCodeByShop",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 店铺"
  },
  "notes": [
    "文档书: BIC质检API（版本 V1.04）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "order_id",
      "in": "body",
      "type": "number",
      "required": true,
      "description": "订单id",
      "example": "4652554264338243781",
      "_depth": 0
    }
  ],
  "responseParams": [
    {
      "name": "is_success",
      "type": "string",
      "description": "是否成功",
      "example": "SUCCESS"
    },
    {
      "name": "error_desc",
      "type": "string",
      "description": "错误信息",
      "example": "找不到对应订单"
    },
    {
      "name": "delivery_type",
      "type": "number",
      "description": "送检方式",
      "example": "0"
    },
    {
      "name": "ship_type",
      "type": "number",
      "description": "出仓方式",
      "example": "1"
    },
    {
      "name": "order_code",
      "type": "string",
      "description": "订单码",
      "example": "0704798730"
    },
    {
      "name": "reinspection_quota",
      "type": "number",
      "description": "当前复检额度",
      "example": "500"
    }
  ],
  "responseCodes": [
    {
      "code": "10000",
      "meaning": "success",
      "action": "正常处理"
    },
    {
      "code": "50002",
      "meaning": "业务处理失败 / 订单处理中（sub_code: isv.business-failed:1001）",
      "action": "请稍后重试",
      "sub_code": "isv.business-failed:1001",
      "sub_msg": "订单处理中"
    },
    {
      "code": "50002",
      "meaning": "业务处理失败 / 存在未维护sku的订单（sub_code: isv.business-failed:-1）",
      "action": "需要维护sku",
      "sub_code": "isv.business-failed:-1",
      "sub_msg": "存在未维护sku的订单"
    }
  ],
  "examples": {
    "request": "curl -X GET 'https://openapi-fxg.jinritemai.com?app_key=your_appkey_here&method=&access_token=your_accesstoken_here&param_json={}&timestamp=2018-06-19%2016:06:59&v=2&sign=your_sign_here'",
    "responseSuccess": {
      "code": 10000,
      "msg": "success",
      "sub_code": "",
      "sub_msg": ""
    },
    "responseError": {
      "code": 50002,
      "msg": "业务处理失败",
      "sub_code": "isv.business-failed:1001",
      "sub_msg": "订单处理中"
    }
  },
  "source": "https://op.jinritemai.com/docs/api-docs/51/1871",
  "updatedAt": "2024-08-01",
  "_file_stem": "bic-inspect-orderCode-downloadOrderCodeByShop"
}
