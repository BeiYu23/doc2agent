{
  "id": "doudian.bic-inspect.orderCode.erpShopBindOrderCode",
  "platform": "doudian",
  "group": "bic-inspect",
  "name": "orderCode.erpShopBindOrderCode",
  "description": "质检/查验订单商家发货接口，调用后会绑定订单和订单码，并生成qic入库单，\ndelivery_type 是 【0】&& ship_type 是【1】，对应一单一包裹模式；\ndelivery_type 是 【0】&& ship_type 是【3】，对应混订单",
  "method": "GET",
  "path": "/orderCode/erpShopBindOrderCode",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 店铺"
  },
  "notes": [
    "文档书: BIC质检API（版本 V1.11）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "shop_package_id",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "商家包裹id",
      "example": "6941730766905180453",
      "_depth": 0
    },
    {
      "name": "delivery_type",
      "in": "body",
      "type": "number",
      "required": true,
      "description": "送检方式",
      "example": "0",
      "_depth": 0
    },
    {
      "name": "ship_type",
      "in": "body",
      "type": "number",
      "required": true,
      "description": "出仓方式",
      "example": "1",
      "_depth": 0
    },
    {
      "name": "order_list",
      "in": "body",
      "type": "array",
      "required": true,
      "description": "订单列表",
      "example": "",
      "_depth": 0
    },
    {
      "name": "agency_id",
      "in": "body",
      "type": "number",
      "required": false,
      "description": "质检机构ID，复检订单必填，需要与仓库编码对应上",
      "example": "101",
      "_depth": 1
    },
    {
      "name": "warehouse_code",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "仓库编码，复检订单必填",
      "example": "02",
      "_depth": 1
    },
    {
      "name": "is_reinspection",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "1：是，2：否。注意：不是复检订单不可传0，直接不入参is_reinspection即可",
      "example": "1",
      "_depth": 1
    },
    {
      "name": "order_id",
      "in": "body",
      "type": "number",
      "required": true,
      "description": "订单id",
      "example": "4782860977949521619",
      "_depth": 1
    },
    {
      "name": "order_code",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "订单码",
      "example": "0822597409",
      "_depth": 1
    },
    {
      "name": "logistics_code",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "运单号",
      "example": "9595123123",
      "_depth": 1
    },
    {
      "name": "logistics_id",
      "in": "body",
      "type": "number",
      "required": false,
      "description": "物流公司id",
      "example": "12",
      "_depth": 1
    },
    {
      "name": "order_detail",
      "in": "body",
      "type": "array",
      "required": false,
      "description": "商品详情",
      "example": "",
      "_depth": 1
    },
    {
      "name": "combo_id",
      "in": "body",
      "type": "number",
      "required": true,
      "description": "该订单购买的商品对应平台的 sku_id",
      "example": "1696289587496995",
      "_depth": 2
    },
    {
      "name": "shop_qty",
      "in": "body",
      "type": "number",
      "required": true,
      "description": "发货数量",
      "example": "1",
      "_depth": 2
    },
    {
      "name": "sku_barcode",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "商品条码",
      "example": "预留扩展字段",
      "_depth": 2
    },
    {
      "name": "unique_code",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "\"商品唯一标识编码  （如：海宁基地服饰的溯源码信息）\"",
      "example": "预留扩展字段",
      "_depth": 2
    },
    {
      "name": "lot01",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "批次属性01",
      "example": "预留扩展字段",
      "_depth": 2
    }
  ],
  "responseParams": [
    {
      "name": "order_list",
      "type": "array",
      "description": "订单列表",
      "example": ""
    }
  ],
