{
  "id": "doudian.retail-bill.retail.settle.queryTradeBillItem",
  "platform": "doudian",
  "group": "retail-bill",
  "name": "retail.settle.queryTradeBillItem",
  "description": "即时零售交易账单查询接口",
  "method": "GET",
  "path": "/retail/settle/queryTradeBillItem",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 店铺"
  },
  "notes": [
    "文档书: 账单管理API【即时零售】（版本 V3.01）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "start_time",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "查询开始时间，格式为：yyyy-MM-dd HH:mm:ss，订单号未传的情况下，开始时间必须传",
      "example": "2024-01-28 21:46:44",
      "_depth": 0
    },
    {
      "name": "end_time",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "查询结束时间，和end_time的时间间隔建议不超过31天，格式为：yyyy-MM-dd HH:mm:ss，订单号未传的情况下，结束时间必须传",
      "example": "2024-08-29 21:46:44",
      "_depth": 0
    },
    {
      "name": "time_type",
      "in": "body",
      "type": "mixed",
      "required": true,
      "description": "时间类型   1 订单提交时间 2 订单完成时间  3 订单交易时间 4 订单结算时间\n订单交易时间：正向用户支付完成时间，逆向退款完成时间",
      "example": "3",
      "_depth": 0
    },
    {
      "name": "shop_order_id",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "店铺订单号(如果订单号未传，则时间必须传)",
      "example": "6917560149869397892",
      "_depth": 0
    },
    {
      "name": "order_id",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "子订单号(如果订单号未传，则时间必须传)",
      "example": "6917560149869397892",
      "_depth": 0
    },
    {
      "name": "cursor",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "查询游标，查询第一页时传空，后续查询使用前一次查询返回的next_cursor",
      "example": "1716963724|1689",
      "_depth": 0
    },
    {
      "name": "size",
      "in": "body",
      "type": "mixed",
      "required": true,
      "description": "查询数量，支持范围1～100",
      "example": "100",
      "_depth": 0
    }
  ],
  "responseParams": [
    {
      "name": "code",
      "type": "string",
      "description": "返回code 100000为成功，其他为失败",
      "example": "100000"
    },
    {
      "name": "code_msg",
      "type": "string",
      "description": "返回信息描述，失败状态下会有失败描述",
      "example": "success"
    },
    {
      "name": "has_next",
      "type": "boolean",
      "description": "满足当前查询条件的数据是否还有下一批，true代表还有数据，false代表没有数据",
      "example": "false"
    },
    {
      "name": "next_cursor",
      "type": "string",
      "description": "下一次查询的游标",
      "example": "1716963724|1689"
    },
    {
      "name": "data",
      "type": "array",
      "description": "交易账单流水明细",
      "example": ""
    }
  ],
  "responseCodes": [
    {
      "code": "10000",
      "meaning": "success",
      "action": "正常处理"
    },
    {
      "code": "50002",
