{
  "id": "doudian.stock.sku.syncStockBatch",
  "platform": "doudian",
  "group": "stock",
  "name": "sku.syncStockBatch",
  "description": "库存批量同步接口",
  "method": "GET",
  "path": "/sku/syncStockBatch",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 店铺"
  },
  "notes": [
    "文档书: 库存API（版本 V3.01）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "product_id",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "商品ID，整型格式",
      "example": "3337589750809921129",
      "_depth": 0
    },
    {
      "name": "idempotent_id",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "幂等ID，仅incremental=true时有用",
      "example": "2",
      "_depth": 0
    },
    {
      "name": "incremental",
      "in": "body",
      "type": "boolean",
      "required": true,
      "description": "true表示增量库存，false表示全量库存，默认为false",
      "example": "true",
      "_depth": 0
    },
    {
      "name": "sku_sync_list",
      "in": "body",
      "type": "array",
      "required": true,
      "description": "需要批量提交的skuid及对应的库存和仓；接口规则全部成功或全部失败，例：批量更新10个skuid库存，其中一个skuid信息不正确，这样整个请求都会失败，10个skuid都未更新成功。",
      "example": "",
      "_depth": 0
    },
    {
      "name": "batch_stock_items",
      "in": "body",
      "type": "array",
      "required": false,
      "description": "批次库存项",
      "example": "",
      "_depth": 1
    },
    {
      "name": "batch_type",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "批次库存类型：1为唯一码",
      "example": "1",
      "_depth": 2
    },
    {
      "name": "stock_num",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "批次库存数量",
      "example": "1",
      "_depth": 2
    },
    {
      "name": "unique_id",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "唯一码",
      "example": "\"356303487400309\"",
      "_depth": 2
    },
    {
      "name": "multi_time_stocks",
      "in": "body",
      "type": "array",
      "required": false,
      "description": "时效库存",
      "example": "",
      "_depth": 1
    },
    {
      "name": "stock_num",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "库存数",
      "example": "500",
      "_depth": 2
    },
    {
      "name": "time_desc",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "时效描述",
      "example": "5天内发",
      "_depth": 2
    },
    {
      "name": "time_type",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "时效",
      "example": "5",
      "_depth": 2
    },
    {
      "name": "outer_sku_id",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "外部sku编码，需要结合outer_product_id进行使用",
      "example": "232331",
      "_depth": 1
    },
    {
      "name": "sku_id",
      "in": "body",
      "type": "mixed",
      "required": true,
      "description": "skuid",
      "example": "99758050",
      "_depth": 1
    },
    {
      "name": "sku_type",
      "in": "body",
      "type": "mixed",
      "required": true,
      "description": "库存类型：0普通库存，1区域库存,10阶梯库存。 超市小时达子品传区域库存",
      "example": "1",
      "_depth": 1
    },
    {
      "name": "stock_num",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "普通库存数量",
      "example": "10",
      "_depth": 1
    },
    {
      "name": "step_stock_num",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "阶梯库存数量",
      "example": "10",
      "_depth": 1
    },
    {
      "name": "stock_map",
      "in": "body",
      "type": "array",
      "required": false,
      "description": "区域库存配置",
      "example": "",
      "_depth": 1
    },
    {
      "name": "batch_stock_items",
      "in": "body",
      "type": "array",
      "required": false,
      "description": "批次库存项",
      "example": "",
      "_depth": 2
    },
    {
      "name": "batch_type",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "批次库存类型：1为唯一码",
      "example": "1",
      "_depth": 3
    },
    {
      "name": "stock_num",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "批次库存数量",
      "example": "1",
      "_depth": 3
    },
    {
      "name": "unique_id",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "唯一码",
      "example": "\"356303487400309\"",
      "_depth": 3
    },
    {
      "name": "out_warehouse_id",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "仓id或到店自提门店id，场景①仓id，超市小时达子品传storeId。到店自提传入store_id（门店id）",
      "example": "123",
      "_depth": 2
    },
    {
      "name": "stock_num",
      "in": "body",
      "type": "mixed",
      "required": true,
      "description": "库存数量",
      "example": "10",
      "_depth": 2
    },
    {
      "name": "supplier_id",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "供应商ID",
      "example": "1",
      "_depth": 1
    },
    {
      "name": "outer_product_id",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "推荐使用，外部商家编码，支持字符串。",
      "example": "232334",
      "_depth": 0
    },
    {
      "name": "store_id",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "即时零售连锁版，通过传入主品id+门店id对该门店下的子品进行操作，即时零售单店版，无需使用",
      "example": "12345",
      "_depth": 0
    }
  ],
