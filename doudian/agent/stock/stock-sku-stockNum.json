      "action": "2010001:查询关联productId信息失败",
      "sub_code": "isv.business-failed:2010001",
      "sub_msg": "2010001:查询关联productId信息失败"
    },
    {
      "code": "50002",
      "meaning": "业务处理失败 / 20053:读取商品失败（sub_code: isv.business-failed:20053）",
      "action": "20053:读取商品失败",
      "sub_code": "isv.business-failed:20053",
      "sub_msg": "20053:读取商品失败"
    }
  ],
  "examples": {
