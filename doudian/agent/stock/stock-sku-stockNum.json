{
  "id": "doudian.stock.sku.stockNum",
  "platform": "doudian",
  "group": "stock",
  "name": "sku.stockNum",
  "description": "查询商品规格库存",
  "method": "GET",
  "path": "/sku/stockNum",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 店铺"
  },
  "notes": [
    "文档书: 库存API（版本 V2.01）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "sku_id",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "商品规格id，店铺商品id下唯一，抖店平台生成",
      "example": "12345",
      "_depth": 0
    },
    {
      "name": "code",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "sku商家编码，对应抖店后台商品sku商家编码。外部开发者自定义商品规格id，会校验在店铺下唯一性",
      "example": "abc",
      "_depth": 0
    },
    {
      "name": "out_warehouse_id",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "仓库编码（供应商编码）",
      "example": "AN871",
      "_depth": 0
    }
  ],
  "responseParams": [
    {
      "name": "sku_id",
      "type": "mixed",
      "description": "商品规格id，店铺商品id下唯一，抖店平台生成",
      "example": "12345"
    },
    {
      "name": "out_sku_id",
      "type": "mixed",
      "description": "外部开发者自定义商品规格id，会校验再店铺下唯一性",
      "example": "12345"
    },
    {
      "name": "code",
      "type": "string",
      "description": "sku商家编码，对应抖店后台商品sku商家编码",
      "example": "abc"
    },
    {
      "name": "sku_type",
      "type": "mixed",
      "description": "sku库存类型，0-普通库存；1-区域库存；10-阶梯库存；",
      "example": "0"
    },
    {
      "name": "stock_num",
      "type": "mixed",
      "description": "商品规格库存；如果sku_type=0，表示全国库存； 如果sku_type=1，且入参有out_warehouse_id，则表示该仓库的库存； 如果sku_type=1，且入参无out_warehouse_id，则为空；",
      "example": "12"
    },
    {
      "name": "prehold_stock_num",
      "type": "mixed",
      "description": "占用库存",
      "example": "12"
    },
    {
      "name": "prom_stock_num",
      "type": "mixed",
      "description": "活动库存",
      "example": "12"
    },
    {
      "name": "step_stock_num",
      "type": "mixed",
      "description": "阶梯库存",
      "example": "12"
    },
    {
      "name": "prehold_step_stock_num",
      "type": "mixed",
      "description": "阶梯占用库存",
      "example": "12"
    },
    {
      "name": "prom_step_stock_num",
      "type": "mixed",
      "description": "活动阶梯库存",
      "example": "12"
    },
    {
      "name": "stock_num_map",
      "type": "string",
      "description": "如果sku_type=0，为空 如果sku_type=1，则为区域仓库存映射表，key为out_warehouse_id，value为库存",
      "example": "1"
    },
    {
      "name": "prehold_stock_map",
      "type": "string",
      "description": "如果sku_type=0，为空 如果sku_type=1，则为区域仓库存映射表，key为out_warehouse_id，value为占用库存",
      "example": "1"
    },
    {
      "name": "ship_rule_map",
      "type": "string",
      "description": "如果sku_type=0，为空 如果sku_type=1，则为区域仓库存映射表，key为out_warehouse_id，value为sku在仓中的发货时效",
      "example": ""
    },
    {
      "name": "normal_stock_num",
      "type": "mixed",
      "description": "普通库存，非活动可售",
      "example": "1"
    },
    {
      "name": "channel_stock_num",
      "type": "mixed",
      "description": "渠道库存",
      "example": "1"
    },
    {
      "name": "batch_stocks",
      "type": "array",
      "description": "批次库存",
      "example": ""
    }
  ],
  "responseCodes": [
    {
      "code": "10000",
      "meaning": "success",
      "action": "正常处理"
    },
    {
      "code": "40004",
      "meaning": "非法的参数 / code: 195250981220, 找不到对应的sku（sub_code: isv.parameter-invalid:20050）",
