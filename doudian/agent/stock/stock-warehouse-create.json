  "params": [
    {
      "name": "out_warehouse_id",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "外部仓库ID，一个店铺下，同一个外部ID只能创建一个仓库",
      "example": "abc",
      "_depth": 0
    },
    {
      "name": "name",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "仓库名称",
      "example": "test",
      "_depth": 0
    },
    {
      "name": "intro",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "仓库介绍",
      "example": "test",
      "_depth": 0
    }
  ],
  "responseParams": [
    {
      "name": "data",
      "type": "number",
      "description": "仓库id",
      "example": "6853386941874864391"
    }
  ],
  "responseCodes": [
    {
      "code": "10000",
      "meaning": "成功",
      "action": "正常处理"
    }
  ],
