    },
    {
      "name": "address_id2",
      "in": "body",
      "type": "number",
      "required": false,
      "description": "市地址编码",
      "example": "110000",
      "_depth": 2
    },
    {
      "name": "address_id3",
      "in": "body",
      "type": "number",
      "required": false,
      "description": "区地址编码",
      "example": "110101",
      "_depth": 2
    },
    {
      "name": "address_id4",
      "in": "body",
      "type": "number",
      "required": false,
      "description": "街道地址编码",
      "example": "0",
      "_depth": 2
    }
