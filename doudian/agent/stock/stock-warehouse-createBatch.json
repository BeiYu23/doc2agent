    },
    {
      "name": "address_detail",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "仓地址详细地址，苹果门店店铺、超市小时达店铺建仓必传",
      "example": "xx区xx号",
      "_depth": 1
    },
    {
      "name": "warehouse_location",
      "in": "body",
