    {
      "name": "rank",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "顺序，可选desc、asc，与order_by同时生效",
      "example": "desc",
      "_depth": 0
    },
    {
      "name": "page",
      "in": "body",
      "type": "number",
      "required": true,
      "description": "页码，从0开始，最大到100",
      "example": "0",
      "_depth": 0
    },
    {
      "name": "size",
      "in": "body",
      "type": "number",
      "required": true,
      "description": "每页数量，最大100，超过100会限制到100",
      "example": "10",
      "_depth": 0
    }
