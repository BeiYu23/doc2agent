  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 店铺"
  },
  "notes": [
    "文档书: 库存API（版本 V1.01）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "name",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "货品名称",
      "example": "测试货品",
      "_depth": 0
    },
    {
      "name": "img",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "图片url，需要提前在素材中心上传",
      "example": "xxx",
      "_depth": 0
    },
    {
      "name": "cargo_id",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "货品ID，如果不为0，说明是update",
      "example": "123456",
      "_depth": 0
    },
    {
      "name": "code",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "货品外部编码",
      "example": "ABC",
      "_depth": 0
    }
  ],
  "responseParams": [
    {
      "name": "cargo_id",
      "type": "mixed",
      "description": "货品ID",
      "example": "123456"
    }
  ],
  "responseCodes": [
    {
      "code": "10000",
      "meaning": "成功",
      "action": "正常处理"
    }
  ],
  "examples": {
