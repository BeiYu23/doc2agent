{
  "id": "doudian.order.trace.batchRecord",
  "cnName": "在订单链路监控场景中",
  "docUrl": "/docs/doudian/order/order-trace-batchRecord",
  "name": "trace.batchRecord",
  "platform": "doudian",
  "group": "order",
  "description": "在订单链路监控场景中，批量(最大20条)回传轨迹信息。 信息回传后能自动记录并统计监控状态信息",
  "method": "GET",
  "path": "/trace/batchRecord",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 见平台说明"
  },
  "notes": [
    "文档书: 订单API（版本 V1.03）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "trace_list",
      "in": "body",
      "type": "array",
      "required": true,
      "description": "轨迹信息列表",
      "example": "",
      "_depth": 0
    },
    {
      "name": "order_id",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "订单ID",
      "example": "121212",
      "_depth": 1
    },
    {
      "name": "status",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "轨迹状态。ERP_TRANSFER(完成转单)，ERP_CHECK(完成审单)，CP_NOTIFY(完成通知仓储配货)，ACCEPT(仓库接单完成)，PRINT(完成打印拣货单/完成打印面单)，PICK(完成拣货)，CHECK(拣货复核完成)，PACKAGE(仓库完成打包)，CONFIRM(仓库通知ERP出货)",
      "example": "ERP_CHECK",
      "_depth": 1
    },
    {
      "name": "record_time",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "业务动作发生时间；格式：yyyy-MM-dd HH:mm:ss",
      "example": "2022-11-01 00:00:00",
      "_depth": 1
    },
    {
      "name": "ext_info",
      "in": "body",
      "type": "object",
      "required": false,
      "description": "扩展信息",
      "example": "",
