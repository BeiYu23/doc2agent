    {
      "name": "out_operator",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "当前操作人",
      "example": "**店:小王",
      "_depth": 2
    },
    {
      "name": "out_wms_app",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "关联wms的app信息",
      "example": "12497914",
      "_depth": 2
    },
    {
      "name": "out_customer_id",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "货主在wms的身份标识",
      "example": "BJ121",
      "_depth": 2
    },
    {
      "name": "remark",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "备注信息",
      "example": "自动流转",
      "_depth": 2
    },
    {
      "name": "warehouse_code",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "仓编码",
      "example": "CP12",
      "_depth": 1
    },
    {
      "name": "product_list",
      "in": "body",
      "type": "array",
      "required": false,
      "description": "仓商品信息",
      "example": "",
      "_depth": 1
    },
    {
      "name": "sku_order_id",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "子订单ID",
      "example": "4996000714287787070",
      "_depth": 2
    },
    {
      "name": "count",
      "in": "body",
      "type": "number",
      "required": true,
      "description": "商品数量",
      "example": "1",
      "_depth": 2
    },
    {
      "name": "sub_product_info_list",
      "in": "body",
      "type": "array",
      "required": false,
      "description": "子商品信息",
      "example": "",
      "_depth": 2
    },
    {
      "name": "sku_id",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "商品SkuId",
      "example": "30714287782120",
      "_depth": 3
    },
    {
      "name": "product_id",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "商品Id",
      "example": "30714287787070",
      "_depth": 3
    },
    {
      "name": "count",
      "in": "body",
      "type": "number",
      "required": true,
      "description": "商品数量",
      "example": "1",
      "_depth": 3
    }
  ],
