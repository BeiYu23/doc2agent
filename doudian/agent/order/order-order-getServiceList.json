{
  "id": "doudian.order.order.getServiceList",
  "platform": "doudian",
  "group": "order",
  "name": "order.getServiceList",
  "description": "获取售后平台客服工单列表，对应抖店功能：https://school.jinritemai.com/doudian/web/lark-doc/fdJHrykEbfsrM",
  "method": "GET",
  "path": "/order/getServiceList",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 店铺"
  },
  "notes": [
    "文档书: 订单API（版本 V1.05）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "start_time",
      "in": "body",
      "type": "number",
      "required": true,
      "description": "创建开始时间时间戳",
      "example": "121312313",
      "_depth": 0
    },
    {
      "name": "end_time",
      "in": "body",
      "type": "number",
      "required": true,
      "description": "创建结束时间时间戳，必须大于开始时间",
      "example": "123131221123",
      "_depth": 0
    },
    {
      "name": "status",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "1、不传代表获取全部服务请求     2、操作状态：0 #待处理 10 #审核中 100 #已关闭",
      "example": "0",
      "_depth": 0
    },
    {
      "name": "order_id",
      "in": "body",
      "type": "number",
      "required": false,
      "description": "订单id",
      "example": "212332343564454545",
      "_depth": 0
    },
    {
      "name": "service_id",
      "in": "body",
      "type": "number",
      "required": false,
      "description": "服务单id",
      "example": "12212121121212",
      "_depth": 0
    },
    {
      "name": "order_by",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "1、默认按服务单创建时间搜索     2、值为“create_time”：按服务单创建时间；值为“update_time”：按服务单更新时间",
      "example": "create_time",
      "_depth": 0
    },
    {
      "name": "page",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "页数（默认值为1，第一页从1开始）",
      "example": "1",
      "_depth": 0
    },
    {
      "name": "size",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "每页订单数（默认为10，最大100），超过100则会按照最大值100处理",
      "example": "100",
      "_depth": 0
    },
    {
      "name": "order",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "排序方式：ASC按时间升序，  DESC按时间降序     默认DESC",
      "example": "ASC",
      "_depth": 0
    }
  ],
  "responseParams": [
    {
      "name": "total",
      "type": "number",
      "description": "总数",
      "example": "1122"
    },
    {
      "name": "list",
      "type": "array",
      "description": "列表",
      "example": ""
    }
  ],
  "responseCodes": [
    {
      "code": "10000",
      "meaning": "success",
      "action": "正常处理"
    },
    {
      "code": "50002",
      "meaning": "业务处理失败 / 时间格式不正确（sub_code: isv.business-failed:10002）",
      "action": "-",
      "sub_code": "isv.business-failed:10002",
      "sub_msg": "时间格式不正确"
    }
  ],
  "examples": {
    "request": "curl -X GET 'https://openapi-fxg.jinritemai.com?app_key=your_appkey_here&method=&access_token=your_accesstoken_here&param_json={}&timestamp=2018-06-19%2016:06:59&v=2&sign=your_sign_here'",
    "responseSuccess": {
      "code": 10000,
      "msg": "success",
      "sub_code": "",
      "sub_msg": ""
    },
    "responseError": {
      "code": 50002,
      "msg": "业务处理失败",
      "sub_code": "isv.business-failed:10002",
      "sub_msg": "时间格式不正确"
    }
  },
  "source": "https://op.jinritemai.com/docs/api-docs/15/1835",
  "updatedAt": "2022-11-14",
  "_file_stem": "order-order-getServiceList",
  "cnName": "获取售后平台客服工单列表，对应抖店功能"
}
