{
  "id": "doudian.order.order.fulfillStateCallback",
  "platform": "doudian",
  "group": "order",
  "name": "order.fulfillStateCallback",
  "description": "大客户履约节点回传",
  "method": "GET",
  "path": "/order/fulfillStateCallback",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 店铺"
  },
  "notes": [
    "文档书: 订单API（版本 V1.01）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "shop_order_id",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "店铺单号",
      "example": "111",
      "_depth": 0
    },
    {
      "name": "sku_order_id_list",
      "in": "body",
      "type": "array",
      "required": true,
      "description": "sku单idList",
      "example": "[\"111\",\"222\"]",
      "_depth": 0
    },
    {
      "name": "state",
      "in": "body",
      "type": "mixed",
      "required": true,
      "description": "状态:1 = 备货",
      "example": "1",
      "_depth": 0
    },
    {
      "name": "state_time",
      "in": "body",
      "type": "mixed",
      "required": true,
      "description": "时间戳",
      "example": "1752201052",
      "_depth": 0
    }
  ],
  "responseParams": [],
  "responseCodes": [
    {
      "code": "10000",
      "meaning": "成功",
      "action": "正常处理"
    }
  ],
  "examples": {
    "request": "curl -X GET 'https://openapi-fxg.jinritemai.com/order/fulfillStateCallback?app_key=your_appkey_here&method=order.fulfillStateCallback&access_token=your_accesstoken_here&param_json={}&timestamp=2018-06-19%2016:06:59&v=2&sign=your_sign_here'",
    "responseSuccess": {
      "code": 10000,
      "msg": "success",
      "sub_code": "",
      "sub_msg": ""
    },
    "responseError": {
      "sub_code": "",
      "sub_msg": ""
    }
  },
  "source": "https://op.jinritemai.com/docs/api-docs/15/7646",
