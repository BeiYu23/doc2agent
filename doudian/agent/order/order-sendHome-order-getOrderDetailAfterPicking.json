{
  "id": "doudian.order.sendHome.order.getOrderDetailAfterPicking",
  "cnName": "拣货前退款后订单查询接口【即时零售】",
  "docUrl": "/docs/doudian/order/order-sendHome-order-getOrderDetailAfterPicking",
  "name": "sendHome.order.getOrderDetailAfterPicking",
  "platform": "doudian",
  "group": "order",
  "description": "拣货前退款后订单查询接口【即时零售】",
  "method": "GET",
  "path": "/sendHome/order/getOrderDetailAfterPicking",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 店铺"
  },
  "notes": [
    "文档书: 订单API（版本 V1.01）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "shop_order_id",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "店铺订单id",
      "example": "6930331302740104585",
      "_depth": 0
    }
  ],
  "responseParams": [
    {
      "name": "is_picked",
      "type": "mixed",
      "description": "是否拣货完成,0-拣货未完成,1-拣货完成",
      "example": "1"
    },
    {
      "name": "refund_type",
      "type": "mixed",
      "description": "退款类型,0-无售后退款,1-发生了部分退款,2-发生了整单退款",
      "example": "0"
    },
    {
      "name": "downgrade",
      "type": "mixed",
      "description": "是否降级,0-有降级（部分数据尚未完成计算）,1-无降级（全部数据已完成计算",
      "example": "1"
    },
    {
      "name": "downgrade_reason",
      "type": "mixed",
      "description": "降级原因,1-订单信息查询失败2-退款信息查询失败3-存在未完成的退款4-拣货信息查询失败5-未完成拣货6-资金分摊查询失败7-资金分摊计算结果不符合预期8-支付优惠查询失败9-支付优惠计算结果不符合预期10-其他原因",
      "example": "0"
    },
    {
      "name": "shop_order_detail",
      "type": "object",
      "description": "订单信息",
      "example": ""
    }
  ],
