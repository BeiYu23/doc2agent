{
  "id": "doudian.order.order.serviceDetail",
  "platform": "doudian",
  "group": "order",
  "name": "order.serviceDetail",
  "description": "商家服务单详情",
  "method": "GET",
  "path": "/order/serviceDetail",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 店铺"
  },
  "notes": [
    "文档书: 订单API（版本 V1.05）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "service_id",
      "in": "body",
      "type": "number",
      "required": true,
      "description": "服务请求列表中获取的id",
      "example": "123",
      "_depth": 0
    }
  ],
  "responseParams": [
    {
      "name": "detail",
      "type": "object",
      "description": "详情",
      "example": ""
    },
    {
      "name": "logs",
      "type": "array",
      "description": "日志",
      "example": ""
    }
  ],
  "responseCodes": [
    {
      "code": "10000",
      "meaning": "success",
      "action": "正常处理"
    },
    {
      "code": "50002",
      "meaning": "业务处理失败 / 10004:无权限（sub_code: isv.business-failed:10004）",
      "action": "10004:无权限",
      "sub_code": "isv.business-failed:10004",
      "sub_msg": "10004:无权限"
    }
  ],
  "examples": {
    "request": "curl -X GET 'https://openapi-fxg.jinritemai.com?app_key=your_appkey_here&method=&access_token=your_accesstoken_here&param_json={}&timestamp=2018-06-19%2016:06:59&v=2&sign=your_sign_here'",
    "responseSuccess": {
      "code": 10000,
      "msg": "success",
      "sub_code": "",
      "sub_msg": ""
    },
    "responseError": {
      "code": 50002,
      "msg": "业务处理失败",
      "sub_code": "isv.business-failed:10004",
      "sub_msg": "10004:无权限"
    }
  },
  "source": "https://op.jinritemai.com/docs/api-docs/15/1832",
