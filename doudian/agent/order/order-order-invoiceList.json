{
  "id": "doudian.order.order.invoiceList",
  "platform": "doudian",
  "group": "order",
  "name": "order.invoiceList",
  "description": "查看商家开票列表",
  "method": "GET",
  "path": "/order/invoiceList",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 店铺"
  },
  "notes": [
    "文档书: 订单API（版本 V2.01）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "order_id",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "父订单ID",
      "example": "4718699311644951110",
      "_depth": 0
    },
    {
      "name": "order_status",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "订单状态，逗号分割",
      "example": "3,5",
      "_depth": 0
    },
    {
      "name": "start_time",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "申请创建开始时间，时间戳，秒",
      "example": "1625638841",
      "_depth": 0
    },
    {
      "name": "end_time",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "申请创建结束时间，时间戳，秒",
      "example": "1625638841",
      "_depth": 0
    },
    {
      "name": "status",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "开票状态：1待开票、2已开票、3已关闭",
      "example": "1",
      "_depth": 0
    },
    {
      "name": "page_no",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "页数（默认为0，第一页从0开始），page_no* page_size不超过1万",
      "example": "0",
      "_depth": 0
    },
    {
      "name": "page_size",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "请求每页返回的数量，默认20，最多50",
      "example": "20",
      "_depth": 0
    },
    {
      "name": "order_by",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "默认排序规则为desc； 排序方式支持asc/desc",
      "example": "asc",
      "_depth": 0
    },
    {
      "name": "order_field",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "排序规则： 创建时间排序create_time，不传默认创建时间",
      "example": "create_time",
      "_depth": 0
    }
  ],
  "responseParams": [
    {
      "name": "invoice_list",
      "type": "array",
      "description": "发票信息清单",
      "example": ""
    },
    {
      "name": "total",
      "type": "mixed",
      "description": "总数",
      "example": "10"
    }
  ],
  "responseCodes": [
    {
      "code": "10000",
      "meaning": "success",
      "action": "正常处理"
    },
    {
      "code": "50002",
      "meaning": "业务处理失败 / 8888：系统繁忙，请稍后重试（sub_code: isv.business-failed:8888）",
      "action": "稍后重试",
      "sub_code": "isv.business-failed:8888",
      "sub_msg": "8888：系统繁忙，请稍后重试"
    },
    {
      "code": "40004",
      "meaning": "非法的参数 / 10009：PageSize 超过 100（sub_code: isv.parameter-invalid:10009）",
      "action": "PageSize设置为50",
      "sub_code": "isv.parameter-invalid:10009",
      "sub_msg": "10009：PageSize 超过 100"
    },
    {
      "code": "50002",
      "meaning": "业务处理失败 / 40007：批量获取政府补贴订单发票规则信息失败（sub_code: isv.business-failed:40007）",
      "action": "稍后重试",
      "sub_code": "isv.business-failed:40007",
      "sub_msg": "40007：批量获取政府补贴订单发票规则信息失败"
    },
    {
      "code": "50002",
      "meaning": "业务处理失败 / 10049: 开始时间错误（sub_code: isv.business-failed:10049）",
      "action": "修改开始时间",
      "sub_code": "isv.business-failed:10049",
      "sub_msg": "10049: 开始时间错误"
    }
  ],
