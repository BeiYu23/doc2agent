{
  "id": "doudian.order.order.orderDetail",
  "cnName": "订单详情查询",
  "docUrl": "/docs/doudian/order/order-order-orderDetail",
  "name": "order.orderDetail",
  "platform": "doudian",
  "group": "order",
  "description": "订单详情查询",
  "method": "GET",
  "path": "/order/orderDetail",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 店铺"
  },
  "notes": [
    "文档书: 订单API（版本 V30.01）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "shop_order_id",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "店铺父订单号，抖店平台生成，平台下唯一；",
      "example": "6917533224570258991",
      "_depth": 0
    }
  ],
  "responseParams": [
    {
      "name": "shop_order_detail",
      "type": "object",
      "description": "订单信息",
      "example": ""
    }
  ],
  "responseCodes": [
    {
      "code": "10000",
      "meaning": "success",
      "action": "正常处理"
    },
    {
      "code": "50002",
      "meaning": "业务处理失败 / 订单不是该店铺下的订单，无权查询（sub_code: isv.business-failed:20015）",
      "action": "请检查订单号是否正确",
      "sub_code": "isv.business-failed:20015",
      "sub_msg": "订单不是该店铺下的订单，无权查询"
    },
    {
      "code": "40004",
