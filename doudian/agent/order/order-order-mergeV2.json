  },
  "notes": [
    "文档书: 订单API（版本 V1.01）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "merge_list",
      "in": "body",
      "type": "array",
      "required": false,
      "description": "合单列表",
      "example": "",
      "_depth": 0
    },
    {
      "name": "order_id",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "店铺单id",
      "example": "123123",
      "_depth": 1
    },
    {
      "name": "open_address_id",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "open address id",
      "example": "xxxxxxxxxx",
      "_depth": 1
    }
  ],
  "responseParams": [
    {
      "name": "order_list",
      "type": "array",
      "description": "合单结果。可合单的订单ID列表用逗号分隔的字符串表示。比如，1111,2222表示订单1111和订单2222可合并发货。",
      "example": "['123123','4564566']"
    },
    {
      "name": "failed_order",
      "type": "string",
      "description": "key是失败订单id，value是失败原因",
      "example": "<\"111\":\"订单不在发货状态\">"
    }
  ],
