{
  "id": "doudian.btas-inspect.btas.sc.setInspectionResult",
  "platform": "doudian",
  "group": "btas-inspect",
  "name": "btas.sc.setInspectionResult",
  "description": "质检机构_上传订单质检结果",
  "method": "GET",
  "path": "/btas/sc/setInspectionResult",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 见平台说明"
  },
  "notes": [
    "文档书: BTAS质检API（版本 V1.01）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "order_code",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "订单码",
      "example": "234231",
      "_depth": 0
    },
    {
      "name": "result",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "质检结果：1-通过，2-不通过，5-无法质检，99-无需质检，触发退货发",
      "example": "1",
      "_depth": 0
    },
    {
      "name": "service_status",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "1：上传质检报告，2：取消质检报告",
      "example": "1",
      "_depth": 0
    },
    {
      "name": "service_charge",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "回传的这单的质检费用。单位（分）",
      "example": "3000",
      "_depth": 0
    },
    {
      "name": "service_center_id",
      "in": "body",
      "type": "number",
      "required": true,
      "description": "质检中心ID",
      "example": "1",
      "_depth": 0
    },
    {
      "name": "certification_code",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "质检编码,仅字母数字",
      "example": "SNAKE001001",
      "_depth": 0
    },
    {
      "name": "result_details",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "质检详情。JSON字符串",
      "example": "{\"brand\":\"苹果\",\"model\":\"Iphone 12 Pro Max\"}",
      "_depth": 0
    },
    {
      "name": "inspection_complete_time",
      "in": "body",
      "type": "number",
      "required": true,
      "description": "质检完成时间（秒,UTC）",
      "example": "1675244344",
      "_depth": 0
    }
  ],
