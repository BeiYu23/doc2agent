{
  "id": "doudian.btas-inspect.btas.saveInspectionOnline",
  "cnName": "商家_商家送检图片质检（线上质检）订单",
  "docUrl": "/docs/doudian/btas-inspect/btas-inspect-btas-saveInspectionOnline",
  "name": "btas.saveInspectionOnline",
  "platform": "doudian",
  "group": "btas-inspect",
  "description": "商家_商家送检图片质检（线上质检）订单",
  "method": "GET",
  "path": "/btas/saveInspectionOnline",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 店铺"
  },
  "notes": [
    "文档书: BTAS质检API（版本 V1.04）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "order_id",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "父订单（店铺单）编号",
      "example": "4775168038676399798",
      "_depth": 0
    },
    {
      "name": "product_order_id",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "商品单ID",
      "example": "4775168038676399799",
      "_depth": 0
    },
    {
      "name": "order_code",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "一件商品一个订单码，订单码由字节系统生成。 订单码",
      "example": "0123456787",
      "_depth": 0
    },
    {
      "name": "service_status",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "枚举值 1: 新增   2: 修改",
      "example": "1",
      "_depth": 0
    },
    {
      "name": "certification_code",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "质检扣",
      "example": "Q12312312312",
      "_depth": 0
    },
    {
      "name": "is_original_info",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "原盒包装 枚举值 1: 是  2: 否",
      "example": "1",
      "_depth": 0
    },
    {
      "name": "brand_id",
      "in": "body",
      "type": "number",
      "required": true,
      "description": "鉴定品牌，列表参数见接口 btas/listBrand",
      "example": "2",
      "_depth": 0
    },
    {
      "name": "return_intercept_type",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "0：发货优先，送检前存在退款申请可通过送检自动拒绝   1：售后优先：送检前存在退款申请则不可送检",
      "example": "0",
      "_depth": 0
    },
    {
      "name": "images",
      "in": "body",
      "type": "array",
      "required": true,
      "description": "送检图片",
      "example": "",
      "_depth": 0
    },
    {
      "name": "image_id",
      "in": "body",
      "type": "number",
      "required": true,
      "description": "图片ID 要求大于0",
      "example": "1",
      "_depth": 1
    },
    {
      "name": "image_url",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "图片链接",
      "example": "\"https://xxx.xxxx.xxxx\"",
      "_depth": 1
    },
    {
      "name": "image_comment",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "图片备注",
      "example": "\"带扣\"",
      "_depth": 1
    }
  ],
  "responseParams": [],
  "responseCodes": [
    {
      "code": "10000",
      "meaning": "success",
      "action": "正常处理"
    },
    {
      "code": "50002",
      "meaning": "业务处理失败 / 2038:鉴定扣已使用（sub_code: isv.business-failed:2038）",
      "action": "更换",
      "sub_code": "isv.business-failed:2038",
      "sub_msg": "2038:鉴定扣已使用"
    },
    {
      "code": "50002",
      "meaning": "业务处理失败 / 2027:线下质检订单请通过管理系统进行操作（sub_code: isv.business-failed:2027）",
      "action": "-",
      "sub_code": "isv.business-failed:2027",
      "sub_msg": "2027:线下质检订单请通过管理系统进行操作"
    },
    {
      "code": "50002",
      "meaning": "业务处理失败 / 10000:订单目前不满足送检条件，请检查取消状态或所绑定质检机构（sub_code: isv.business-failed:10000）",
      "action": "-",
      "sub_code": "isv.business-failed:10000",
      "sub_msg": "10000:订单目前不满足送检条件，请检查取消状态或所绑定质检机构"
    },
    {
      "code": "50002",
      "meaning": "业务处理失败 / 2036:拦截发货时候请先处理退款请求（sub_code: isv.business-failed:2036）",
      "action": "-",
      "sub_code": "isv.business-failed:2036",
      "sub_msg": "2036:拦截发货时候请先处理退款请求"
    }
  ],
  "examples": {
    "request": "curl -X GET 'https://openapi-fxg.jinritemai.com/btas/saveInspectionOnline?app_key=your_appkey_here&method=btas.saveInspectionOnline&access_token=your_accesstoken_here&param_json={}&timestamp=2018-06-19%2016:06:59&v=2&sign=your_sign_here'",
    "responseSuccess": {
      "code": 10000,
      "msg": "success",
      "sub_code": "",
      "sub_msg": ""
    },
    "responseError": {
      "code": 50002,
      "msg": "业务处理失败",
      "sub_code": "isv.business-failed:2038",
      "sub_msg": "2038:鉴定扣已使用"
    }
  },
  "source": "https://op.jinritemai.com/docs/api-docs/49/572",
  "updatedAt": "2021-06-07",
  "_file_stem": "btas-inspect-btas-saveInspectionOnline"
}
