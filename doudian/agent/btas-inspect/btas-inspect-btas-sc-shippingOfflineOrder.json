{
  "id": "doudian.btas-inspect.btas.sc.shippingOfflineOrder",
  "platform": "doudian",
  "group": "btas-inspect",
  "name": "btas.sc.shippingOfflineOrder",
  "description": "质检机构在收到实物质检商品质检完成，并且同步到平台后，进行发货。 此时，如果订单已经已经取消就是发往商家（如果商家是自提则接口会报错）；如果订单未取消，则发往消费者。",
  "method": "GET",
  "path": "/btas/sc/shippingOfflineOrder",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 见平台说明"
  },
  "notes": [
    "文档书: BTAS质检API（版本 V1.02）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "order_code",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "订单码",
      "example": "041513133",
      "_depth": 0
    },
    {
      "name": "sc_id",
      "in": "body",
      "type": "number",
      "required": true,
      "description": "质检机构ID",
      "example": "1",
      "_depth": 0
    }
  ],
  "responseParams": [
    {
      "name": "seller_send_type",
      "type": "string",
      "description": "商家送检方式。1，邮寄。2：面交",
      "example": "1"
    },
    {
      "name": "logistics_num",
      "type": "string",
      "description": "快递单号。面交没有这个字段",
      "example": "SF2342342"
    },
    {
      "name": "logistics_name_cn",
      "type": "string",
      "description": "快递公司名称",
      "example": "顺丰"
    },
    {
      "name": "logistics_name_en",
      "type": "string",
      "description": "快递公司英文名称",
      "example": "shunfeng"
    },
    {
      "name": "receiver_type",
      "type": "string",
      "description": "收货人类型，-1-未知;0-买家收货;1-卖家收货。-1的情况是质检站点在btas系统中，修改了发货信息，但是实际上发给谁，系统并不清楚",
      "example": "1"
    },
    {
      "name": "order_code",
      "type": "string",
      "description": "发货的orderCode",
      "example": "02131231"
    },
    {
      "name": "logistics_pdf_file",
      "type": "string",
      "description": "发货物流PDF文件",
      "example": "base64://s234234dsfadfaf"
    },
    {
      "name": "cancel_status",
      "type": "string",
      "description": "订单取消状态。0-未取消；1-申请取消；2-订单已经取消；4-退款&订单已取消；6-退货退款&订单已取消",
      "example": "0"
    }
  ],
  "responseCodes": [
    {
      "code": "10000",
      "meaning": "success",
      "action": "正常处理"
    },
    {
      "code": "50002",
      "meaning": "业务处理失败 / -2:电子面单订购关系不存在;（sub_code: isv.business-failed:-2）",
      "action": "-2:电子面单订购关系不存在;",
      "sub_code": "isv.business-failed:-2",
      "sub_msg": "-2:电子面单订购关系不存在;"
    },
    {
      "code": "50002",
      "meaning": "业务处理失败 / -1:运单不满足发货条件（sub_code: isv.business-failed:-1）",
      "action": "-1:运单不满足发货条件",
      "sub_code": "isv.business-failed:-1",
      "sub_msg": "-1:运单不满足发货条件"
    }
  ],
  "examples": {
    "request": "curl -X GET 'https://openapi-fxg.jinritemai.com/yunc/erpInboundCancel?app_key=your_appkey_here&method=yunc.erpInboundCancel&access_token=your_accesstoken_here&param_json={}&timestamp=2018-06-19%2016:06:59&v=2&sign=your_sign_here'",
    "responseSuccess": {
      "code": 10000,
      "msg": "success",
      "sub_code": "",
      "sub_msg": ""
    },
    "responseError": {
      "code": 50002,
      "msg": "业务处理失败",
      "sub_code": "isv.business-failed:-2",
      "sub_msg": "-2:电子面单订购关系不存在;"
    }
  },
  "source": "https://op.jinritemai.com/docs/api-docs/49/2948",
  "updatedAt": "2023-02-10",
  "_file_stem": "btas-inspect-btas-sc-shippingOfflineOrder",
  "cnName": "质检机构在收到实物质检商品质检完成"
}
