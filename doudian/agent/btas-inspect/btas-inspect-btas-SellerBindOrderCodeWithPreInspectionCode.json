{
  "id": "doudian.btas-inspect.btas.SellerBindOrderCodeWithPreInspectionCode",
  "platform": "doudian",
  "group": "btas-inspect",
  "name": "btas.SellerBindOrderCodeWithPreInspectionCode",
  "description": "商家_商家针对前置质检订单进行绑码或者换绑",
  "method": "GET",
  "path": "/btas/SellerBindOrderCodeWithPreInspectionCode",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 店铺"
  },
  "notes": [
    "文档书: BTAS质检API（版本 V1.01）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "order_code",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "订单码",
      "example": "0738304024",
      "_depth": 0
    },
    {
      "name": "inspection_code",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "质检证书编号，仅字母数字",
      "example": "ZJ324342351123",
      "_depth": 0
    },
    {
      "name": "inspection_sc_id",
      "in": "body",
      "type": "number",
      "required": true,
      "description": "质检机构ID",
      "example": "32",
      "_depth": 0
    }
  ],
  "responseParams": [],
  "responseCodes": [
    {
      "code": "10000",
      "meaning": "success",
      "action": "正常处理"
    },
    {
      "code": "20000",
      "meaning": "系统错误（sub_code: isp.service-error:-1）",
      "action": "重试",
      "sub_code": "isp.service-error:-1",
      "sub_msg": "系统错误"
    }
  ],
  "examples": {
    "request": "curl -X GET 'https://openapi-fxg.jinritemai.comtest/encrypt/2?app_key=your_appkey_here&method=test.encrypt.2&access_token=your_accesstoken_here&param_json={}&timestamp=2018-06-19%2016:06:59&v=2&sign=your_sign_here'",
    "responseSuccess": {
      "data": {
        "data": "2",
        "or": "7"
      },
      "code": 10000,
      "msg": "success",
      "sub_code": "",
      "sub_msg": ""
    },
    "responseError": {
      "code": 20000,
      "msg": "系统错误",
      "sub_code": "isp.service-error:-1",
      "sub_msg": "系统错误"
    }
  },
