{
  "id": "doudian.btas-inspect.btas.updateOrderCourier",
  "platform": "doudian",
  "group": "btas-inspect",
  "name": "btas.updateOrderCourier",
  "description": "更新订单的物流面单信息",
  "method": "GET",
  "path": "/btas/updateOrderCourier",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 店铺"
  },
  "notes": [
    "文档书: BTAS质检API（版本 V1.01）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "order_code",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "订单码",
      "example": "0454123123",
      "_depth": 0
    },
    {
      "name": "courier_code",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "快递单号(可以通过电子面单获取）",
      "example": "SF0234231213232423",
      "_depth": 0
    },
    {
      "name": "logistics_name_en",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "快递公司名称",
      "example": "shunfeng",
      "_depth": 0
    }
  ],
  "responseParams": [],
  "responseCodes": [
    {
      "code": "10000",
      "meaning": "success",
      "action": "正常处理"
    },
    {
      "code": "50002",
      "meaning": "业务处理失败 / -1:当前账号不能访问该接口，请联系开发人员配置（sub_code: isv.business-failed:-1）",
      "action": "联系开发者",
      "sub_code": "isv.business-failed:-1",
      "sub_msg": "-1:当前账号不能访问该接口，请联系开发人员配置"
    }
  ],
  "examples": {
    "request": "curl -X GET 'https://openapi-fxg.jinritemai.com/btas/updateOrderCourier?app_key=your_appkey_here&method=btas.updateOrderCourier&access_token=your_accesstoken_here&param_json={}&timestamp=2018-06-19%2016:06:59&v=2&sign=your_sign_here'",
    "responseSuccess": {
      "code": 10000,
      "msg": "success",
      "sub_code": "",
      "sub_msg": ""
    },
    "responseError": {
      "code": 50002,
      "msg": "业务处理失败",
      "sub_code": "isv.business-failed:-1",
      "sub_msg": "-1:当前账号不能访问该接口，请联系开发人员配置"
    }
  },
  "source": "https://op.jinritemai.com/docs/api-docs/49/3528",
  "updatedAt": "2023-04-12",
  "_file_stem": "btas-inspect-btas-updateOrderCourier",
  "cnName": "更新订单的物流面单信息"
}
