{
  "id": "doudian.dropshipping.iop.sellerDistribute",
  "platform": "doudian",
  "group": "dropshipping",
  "name": "iop.sellerDistribute",
  "description": "【商家】分配代发订单",
  "method": "GET",
  "path": "/iop/sellerDistribute",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 店铺"
  },
  "notes": [
    "文档书: 代发API（版本 V1.01）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "distribute_order_list",
      "in": "body",
      "type": "array",
      "required": true,
      "description": "待分配列表，一次批量最多100个",
      "example": "",
      "_depth": 0
    },
    {
      "name": "supplier_shop_id",
      "in": "body",
      "type": "number",
      "required": true,
      "description": "要分配的厂商的店铺ID",
      "example": "77977",
      "_depth": 1
    },
    {
      "name": "distr_order_id",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "代打订单号",
      "example": "77878786688878787",
      "_depth": 1
    }
  ],
  "responseParams": [
    {
      "name": "distribute_order_reuslts",
      "type": "array",
      "description": "分配结果明细",
      "example": ""
    }
  ],
  "responseCodes": [
    {
      "code": "10000",
      "meaning": "success",
      "action": "正常处理"
    },
    {
      "code": "40004",
      "meaning": "非法的参数 / 参数错误（sub_code: isv.parameter-invalid:10000）",
      "action": "请检查参数",
      "sub_code": "isv.parameter-invalid:10000",
      "sub_msg": "参数错误"
    }
  ],
  "examples": {
    "request": "curl -X GET 'https://openapi-fxg.jinritemai.com/iop/sellerDistribute?app_key=your_appkey_here&method=iop.sellerDistribute&access_token=your_accesstoken_here&param_json={}&timestamp=2018-06-19%2016:06:59&v=2&sign=your_sign_here'",
    "responseSuccess": {
      "data": {
        "distribute_order_reuslts": [
          {
            "distr_order_id": "77878786688878787",
            "err_no": "0",
            "message": "succ",
            "supplier_shop_id": "77977"
          }
        ]
      },
      "code": 10000,
      "msg": "success",
      "sub_code": "",
      "sub_msg": ""
    },
    "responseError": {
      "code": 40004,
      "msg": "非法的参数",
      "sub_code": "isv.parameter-invalid:10000",
      "sub_msg": "参数错误"
    }
  },
  "source": "https://op.jinritemai.com/docs/api-docs/59/958",
  "updatedAt": "2021-09-09",
  "_file_stem": "dropshipping-iop-sellerDistribute",
  "cnName": "【商家】分配代发订单"
}
