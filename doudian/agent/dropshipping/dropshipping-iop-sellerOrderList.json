{
  "id": "doudian.dropshipping.iop.sellerOrderList",
  "platform": "doudian",
  "group": "dropshipping",
  "name": "iop.sellerOrderList",
  "description": "【商家】查看代发订单列表",
  "method": "GET",
  "path": "/iop/sellerOrderList",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 店铺"
  },
  "notes": [
    "文档书: 代发API（版本 V4.01）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "start_update_time",
      "in": "body",
      "type": "number",
      "required": false,
      "description": "与订单成交时间段二选一传入，更新时间开始时间的时间戳，指格林威治时间 1970 年 01 月 01 日 00 时 00 分 00 秒(北京时间 1970 年 01 月 01 日 08 时 00 分 00 秒)起至现在的总秒数 PS：开始时间结束时间间距不超过半小时",
      "example": "1625628558",
      "_depth": 0
    },
    {
      "name": "end_update_time",
      "in": "body",
      "type": "number",
      "required": false,
      "description": "与订单成交时间段二选一传入，更新时间结束时间的时间戳，指格林威治时间 1970 年 01 月 01 日 00 时 00 分 00 秒(北京时间 1970 年 01 月 01 日 08 时 00 分 00 秒)起至现在的总秒数 PS：开始时间结束时间间距不超过半小时",
      "example": "1625628558",
      "_depth": 0
    },
    {
      "name": "page",
      "in": "body",
      "type": "number",
      "required": true,
      "description": "返回页码，页码从 0 开始 PS：当前采用分页返回，数量和页数会一起传",
      "example": "0",
      "_depth": 0
    },
    {
      "name": "size",
      "in": "body",
      "type": "number",
      "required": true,
      "description": "返回数量，最大 100",
      "example": "10",
      "_depth": 0
    },
    {
      "name": "product_name",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "商品名称，模糊查询，商家可以根据商品筛选所有的订单，分配给某个厂商",
      "example": "鞋子",
      "_depth": 0
    },
    {
      "name": "product_id",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "商品ID",
      "example": "3473196049974326153",
      "_depth": 0
    },
    {
      "name": "shop_order_id",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "店铺订单号（父订单号）",
      "example": "4781320682406083640",
      "_depth": 0
    },
    {
      "name": "order_status",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "订单状态 101-部分发货 2-备货中 3-已发货 4-已关闭 5-已完成",
      "example": "2",
      "_depth": 0
    },
    {
      "name": "distr_order_id",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "代打订单号",
      "example": "77878786688878787",
      "_depth": 0
    },
    {
      "name": "distr_status",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "分配状态0-未分配 1-已经分配 2-已回传 3-已取消",
      "example": "1",
      "_depth": 0
    },
    {
      "name": "after_sale_status",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "售后状态 1-无售后 2-售后中",
      "example": "1",
      "_depth": 0
    },
    {
      "name": "supplier_shop_id",
      "in": "body",
      "type": "number",
      "required": false,
      "description": "绑定的厂商的店铺ID",
      "example": "77977",
      "_depth": 0
    },
    {
      "name": "province_id",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "省ID",
      "example": "11000",
      "_depth": 0
    },
    {
      "name": "start_deal_time",
      "in": "body",
      "type": "number",
      "required": false,
      "description": "与更新时间段二选一传入，订单成交开始时间的时间戳，指格林威治时间 1970 年 01 月 01 日 00 时 00 分 00 秒(北京时间 1970 年 01 月 01 日 08 时 00 分 00 秒)起至现在的总毫秒数 PS：开始时间结束时间间距不超过半小时",
      "example": "1630482091",
      "_depth": 0
    },
    {
      "name": "end_deal_time",
      "in": "body",
      "type": "number",
      "required": false,
      "description": "与更新时间段二选一传入，订单成交结束时间的时间戳，指格林威治时间 1970 年 01 月 01 日 00 时 00 分 00 秒(北京时间 1970 年 01 月 01 日 08 时 00 分 00 秒)起至现在的总毫秒数 PS：开始时间结束时间间距不超过半小时",
      "example": "1630482091",
      "_depth": 0
    }
  ],
  "responseParams": [
    {
      "name": "distr_order_list",
      "type": "array",
      "description": "代打订单列表",
      "example": ""
    },
    {
      "name": "page",
      "type": "number",
      "description": "返回页码，页码从 0 开始 PS：当前采用分页返回，数量和页数会一起传",
      "example": "0"
    },
    {
      "name": "size",
      "type": "number",
      "description": "返回数量，最大 100",
      "example": "20"
    },
    {
      "name": "total",
      "type": "number",
      "description": "订单总数",
      "example": "100"
    }
  ],
