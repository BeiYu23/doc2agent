{
  "id": "doudian.dropshipping.iop.sellerCancleDistribute",
  "platform": "doudian",
  "group": "dropshipping",
  "name": "iop.sellerCancleDistribute",
  "description": "【商家】取消分配代发订单",
  "method": "GET",
  "path": "/iop/sellerCancleDistribute",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 店铺"
  },
  "notes": [
    "文档书: 代发API（版本 V1.02）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "distr_order_ids",
      "in": "body",
      "type": "array",
      "required": true,
      "description": "代打订单号",
      "example": "[\"34534534534534\",\"34535345345345\"]",
      "_depth": 0
    }
  ],
  "responseParams": [
    {
      "name": "succ_distr_order_ids",
      "type": "array",
      "description": "操作成功的代打订单号",
      "example": "[\"4535353535\",\"3453543534535\"]"
    },
    {
      "name": "fail_distr_order_ids",
      "type": "string",
      "description": "操作失败的代打订单号",
      "example": ""
    }
  ],
  "responseCodes": [
    {
      "code": "10000",
      "meaning": "success",
      "action": "正常处理"
    },
    {
      "code": "50002",
      "meaning": "业务处理失败 / 一次最多取消:100（sub_code: isv.business-failed:10000）",
      "action": "请检查订单数量",
      "sub_code": "isv.business-failed:10000",
      "sub_msg": "一次最多取消:100"
    }
  ],
  "examples": {
    "request": "curl -X GET 'https://openapi-fxg.jinritemai.com/iop/sellerCancleDistribute?app_key=your_appkey_here&method=iop.sellerCancleDistribute&access_token=your_accesstoken_here&param_json={}&timestamp=2018-06-19%2016:06:59&v=2&sign=your_sign_here'",
    "responseSuccess": {
      "data": {
        "fail_distr_order_ids": {},
        "succ_distr_order_ids": "[\"4535353535\",\"3453543534535\"]"
      },
      "code": 10000,
      "msg": "success",
      "sub_code": "",
      "sub_msg": ""
    },
    "responseError": {
      "code": 50002,
      "msg": "业务处理失败",
      "sub_code": "isv.business-failed:10000",
      "sub_msg": "一次最多取消:100"
    }
  },
  "source": "https://op.jinritemai.com/docs/api-docs/59/1876",
  "updatedAt": "2021-09-09",
  "_file_stem": "dropshipping-iop-sellerCancleDistribute"
}
