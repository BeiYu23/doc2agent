{
  "id": "doudian.dropshipping.iop.orderInfo",
  "platform": "doudian",
  "group": "dropshipping",
  "name": "iop.orderInfo",
  "description": "【厂商】订单详情",
  "method": "GET",
  "path": "/iop/orderInfo",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 店铺"
  },
  "notes": [
    "文档书: 代发API（版本 V5.01）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "user_id",
      "in": "body",
      "type": "mixed",
      "required": true,
      "description": "代打店铺id",
      "example": "343532434322232343243",
      "_depth": 0
    },
    {
      "name": "distr_order_id",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "代打订单号",
      "example": "77878786688878787",
      "_depth": 0
    }
  ],
  "responseParams": [
    {
      "name": "distr_order_id",
      "type": "string",
      "description": "代打订单号",
      "example": "77878786688878787"
    },
    {
      "name": "user_id",
      "type": "mixed",
      "description": "代打店铺id",
      "example": "55557775757756"
    },
    {
      "name": "user_name",
      "type": "string",
      "description": "代打店铺自定义名称",
      "example": "xxx店"
    },
    {
      "name": "seller_words",
      "type": "string",
      "description": "卖家备注",
      "example": "发xxx快递"
    },
    {
      "name": "distr_time",
      "type": "mixed",
      "description": "分配时间,秒",
      "example": "1625628558"
    },
    {
      "name": "distr_status",
      "type": "mixed",
      "description": "分配状态 0：未分配 1：已分配未回传；2已回传; 3已取消",
      "example": "1"
    },
    {
      "name": "product_name",
      "type": "string",
      "description": "商品名称",
      "example": "衣服"
    },
    {
      "name": "product_count",
      "type": "mixed",
      "description": "商品数量",
      "example": "2"
    },
    {
      "name": "product_id",
      "type": "string",
      "description": "商品id",
      "example": "1142351234"
    },
    {
      "name": "product_price",
      "type": "mixed",
      "description": "商品价格",
      "example": "990"
    },
    {
      "name": "sku_spec",
      "type": "string",
      "description": "规格",
      "example": "绿色/小"
    },
    {
      "name": "out_sku_id",
      "type": "string",
      "description": "商家配置的sku编码",
      "example": "A11"
    },
    {
      "name": "receiver_id",
      "type": "string",
      "description": "收件人姓名+电话+详细地址相同,receiver_id字段相同",
      "example": "4239E33B82F201A3D73D8DA2DDA21AD4"
    },
    {
      "name": "province",
      "type": "string",
      "description": "省",
      "example": "上海市"
    },
    {
      "name": "city",
      "type": "string",
      "description": "市",
      "example": "上海市"
    },
    {
      "name": "district",
      "type": "string",
      "description": "区",
      "example": "长宁区"
    },
    {
      "name": "street",
      "type": "string",
      "description": "街道",
      "example": "中关村"
    },
    {
      "name": "province_id",
      "type": "string",
      "description": "省ID",
      "example": "110000"
    },
    {
      "name": "city_id",
      "type": "string",
      "description": "市ID",
      "example": "110000"
    },
    {
      "name": "district_id",
      "type": "string",
      "description": "区ID",
      "example": "110000"
    },
    {
      "name": "street_id",
      "type": "string",
      "description": "街道IID",
      "example": "110000"
    },
    {
      "name": "distr_cancel_reason",
      "type": "string",
      "description": "代发取消原因",
      "example": "订单已取消"
    },
    {
      "name": "buyer_words",
      "type": "string",
      "description": "买家备注",
      "example": "买家备注信息"
    },
    {
      "name": "distr_order_aftersale_status",
      "type": "mixed",
      "description": "代发单售后状态，1-无售后或售后关闭，2-有售后",
      "example": "1"
    },
    {
      "name": "exp_ship_time",
      "type": "mixed",
      "description": "预期发货时间",
      "example": "1637224278"
    },
    {
      "name": "ship_time",
      "type": "mixed",
      "description": "发货时间",
      "example": "1637224278"
    },
    {
      "name": "serial_number_list",
      "type": "array",
      "description": "序列号",
      "example": "[\"546443524543534\",\"646443524543534\"]"
    },
    {
      "name": "pack_list",
      "type": "array",
      "description": "物流信息",
      "example": ""
    },
    {
      "name": "order_tag",
      "type": "string",
      "description": "标签信息",
      "example": "{\n   \"shop_optional_express_info\": \"{\\\"ServiceName\\\":\\\"顺丰速运\\\",\\\"ServiceCode\\\":\\\"shunfeng\\\",\\\"ExpressCompanys\\\":[{\\\"ExpressCompanyCode\\\":\\\"shunfeng\\\",\\\"ExpressCompany\\\":\\\"顺丰速运\\\"}],\\\"Amount\\\":200}\"\n}"
    }
  ],
  "responseCodes": [
    {
      "code": "10000",
      "meaning": "success",
      "action": "正常处理"
    },
    {
      "code": "40004",
      "meaning": "非法的参数 / 订单号不存在（sub_code: isv.parameter-invalid:40000）",
      "action": "检查订单号是否已取消分配",
      "sub_code": "isv.parameter-invalid:40000",
      "sub_msg": "订单号不存在"
    },
    {
      "code": "20000",
      "meaning": "系统错误 / 系统繁忙，请稍后重试（sub_code: isp.service-error:88888）",
      "action": "系统繁忙，请稍后重试",
      "sub_code": "isp.service-error:88888",
      "sub_msg": "系统繁忙，请稍后重试"
    },
    {
      "code": "50002",
      "meaning": "业务处理失败 / 10005:系统繁忙，请稍后重试（sub_code: isv.business-failed:10005）",
      "action": "系统繁忙，请稍后重试",
      "sub_code": "isv.business-failed:10005",
      "sub_msg": "10005:系统繁忙，请稍后重试"
    },
    {
      "code": "50002",
      "meaning": "业务处理失败 / 1000:系统繁忙，请稍后重试（sub_code: isv.business-failed:1000）",
      "action": "系统繁忙，请稍后重试",
      "sub_code": "isv.business-failed:1000",
      "sub_msg": "1000:系统繁忙，请稍后重试"
    }
  ],
