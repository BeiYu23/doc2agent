      "in": "body",
      "type": "boolean",
      "required": false,
      "description": "是否拒绝退款申请（默认不传即为false，则发货失败；true即拒绝退款，发货成功",
      "example": "false",
      "_depth": 0
    },
    {
      "name": "address_id",
      "in": "body",
