{
  "id": "doudian.dropshipping.iop.waybillReturn",
  "platform": "doudian",
  "group": "dropshipping",
  "name": "iop.waybillReturn",
  "description": "回传物流单号，实现代发订单的发货功能（注：回传成功后，原始订单也会同步更新成已发货状态）",
  "method": "GET",
  "path": "/iop/waybillReturn",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 店铺"
  },
  "notes": [
    "文档书: 代发API（版本 V6.03）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "user_id",
      "in": "body",
      "type": "number",
      "required": true,
      "description": "代打店铺id",
      "example": "543123423",
      "_depth": 0
    },
    {
      "name": "distr_order_id",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "代打订单号",
      "example": "884334435345",
      "_depth": 0
    },
    {
      "name": "company_code",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "物流公司，当包裹list为空或不合规时，该字段必填；后续即将废弃，建议传入pack_list；",
      "example": "jd",
      "_depth": 0
    },
    {
      "name": "track_no",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "面单号，当包裹list为空或不合规时，该字段必填；后续即将废弃，建议传入pack_list；",
      "example": "12345",
      "_depth": 0
    },
    {
