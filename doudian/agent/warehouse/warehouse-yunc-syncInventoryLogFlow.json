      "example": "7090525558416982316",
      "_depth": 1
    },
    {
      "name": "cargo_type",
      "in": "body",
      "type": "number",
      "required": true,
      "description": "1-普通货品  2-包材  3-耗材",
      "example": "1",
      "_depth": 1
    },
    {
      "name": "inventory_type",
      "in": "body",
      "type": "number",
      "required": true,
      "description": "库存类型 1-正品 2-残品",
      "example": "1",
      "_depth": 1
    },
    {
      "name": "inventory_status",
      "in": "body",
      "type": "number",
      "required": true,
      "description": "库存状态 1-正常 2-质检 3-冻结",
      "example": "1",
      "_depth": 1
