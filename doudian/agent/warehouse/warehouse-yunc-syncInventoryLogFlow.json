    },
    {
      "name": "api_time",
      "in": "body",
      "type": "number",
      "required": true,
      "description": "接口发送时间,秒级",
      "example": "1658880151",
      "_depth": 0
    },
    {
      "name": "details",
      "in": "body",
      "type": "array",
      "required": true,
      "description": "库存流水明细",
      "example": "",
      "_depth": 0
    },
    {
      "name": "occur_time",
      "in": "body",
      "type": "number",
      "required": true,
      "description": "业务发生时间,秒级",
      "example": "1658880151",
      "_depth": 1
    },
    {
      "name": "cargo_code",
      "in": "body",
      "type": "string",
