{
  "id": "doudian.warehouse.yunc.preCheckOutboundFeedback",
  "platform": "doudian",
  "group": "warehouse",
  "name": "yunc.preCheckOutboundFeedback",
  "description": "ToC出库回告预校验接口",
  "method": "GET",
  "path": "/yunc/preCheckOutboundFeedback",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 云仓"
  },
  "notes": [
    "文档书: 仓库作业API（版本 V1.01）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "outbound_order_no",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "出库单号",
      "example": "OB763843789875838983",
      "_depth": 0
    },
    {
      "name": "sn_order_check_info",
      "in": "body",
      "type": "object",
      "required": false,
      "description": "国补订单待校验信息(非国补SN订单，可以为空)",
      "example": "",
      "_depth": 0
    },
    {
      "name": "sn_code",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "SN码",
      "example": "S9457489789789",
      "_depth": 1
    },
    {
      "name": "imei_list",
      "in": "body",
      "type": "array",
      "required": false,
      "description": "Imei信息（非必填，应传尽传）",
      "example": "[\"22439089088\",\"45989u8934\"]",
      "_depth": 1
    },
    {
      "name": "additional_sn_infos",
      "in": "body",
      "type": "array",
      "required": false,
      "description": "附加SN信息，主要针对空调品类场景需要区分内机和外机的SN，空调品类国补场景内机和外机SN都必传。",
      "example": "",
      "_depth": 1
    },
    {
      "name": "sn_type",
      "in": "body",
      "type": "mixed",
      "required": true,
      "description": "1-内机SN \n2-外机SN",
      "example": "1",
      "_depth": 2
    },
    {
      "name": "sn_code",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "SN码",
      "example": "S9457489789789",
      "_depth": 2
    },
    {
      "name": "bar_code",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "货品69码",
      "example": "69837378979283",
      "_depth": 1
    },
    {
      "name": "warehouse_code",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "仓Code",
      "example": "V1068",
      "_depth": 0
    },
    {
      "name": "express_check_info",
      "in": "body",
      "type": "array",
      "required": false,
      "description": "快递商待校验信息（如单据下发时货品明细商未指定快递商，可以为空，否则必传）",
      "example": "",
      "_depth": 0
    },
    {
      "name": "express_code",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "使用的快递商Code",
      "example": "shunfeng",
      "_depth": 1
    },
    {
      "name": "cargo_code",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "货品Code",
      "example": "7898793749878945423",
      "_depth": 1
    }
  ],
  "responseParams": [
    {
      "name": "data",
      "type": "object",
      "description": "校验结果",
      "example": ""
    },
    {
      "name": "code",
      "type": "mixed",
      "description": "0：正常",
      "example": "错误码"
    },
    {
      "name": "msg",
      "type": "string",
      "description": "错误信息",
      "example": "系统错误"
    }
  ],
  "responseCodes": [
