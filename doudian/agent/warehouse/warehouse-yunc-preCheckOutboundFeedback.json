    },
    {
      "code": "50002",
      "meaning": "业务处理失败 / SN码校验失败（sub_code: isv.business-failed:4021）",
      "action": "请重试",
      "sub_code": "isv.business-failed:4021",
      "sub_msg": "SN码校验失败"
    }
  ],
  "examples": {
