    },
    {
      "name": "cargo_code",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "货品编码",
      "example": "7090525558416982316",
      "_depth": 1
    },
    {
      "name": "inventory_type",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "库存类型 1-正品 2-残品",
      "example": "1",
      "_depth": 1
    },
    {
      "name": "inventory_status",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "库存状态 1-正常",
      "example": "1",
      "_depth": 1
    },
    {
      "name": "total_num",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "库存总数量 （大于等于0）",
      "example": "100",
      "_depth": 1
    },
    {
      "name": "can_use_num",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "库存可用数量 （大于等于0）",
      "example": "100",
      "_depth": 1
    }
