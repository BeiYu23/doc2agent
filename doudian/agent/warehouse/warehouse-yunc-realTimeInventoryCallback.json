      "name": "idempotent_no",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "(字段长度: 50)幂等键本次请求的唯一键 最大50个字符",
      "example": "BC1234567789",
      "_depth": 0
    },
    {
      "name": "total_lines",
      "in": "body",
      "type": "number",
