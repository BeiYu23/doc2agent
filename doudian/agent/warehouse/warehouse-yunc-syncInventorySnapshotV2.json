    },
    {
      "name": "api_time",
      "in": "body",
      "type": "mixed",
      "required": true,
      "description": "字段长度(10):接口请求时间，秒级时间戳",
      "example": "1660752000",
      "_depth": 0
    },
    {
      "name": "details",
