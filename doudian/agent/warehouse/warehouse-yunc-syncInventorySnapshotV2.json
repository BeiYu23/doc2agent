      "name": "opening_inventory",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "字段长度(10):期初库存",
      "example": "123",
      "_depth": 1
    },
    {
      "name": "ending_inventory",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "字段长度(10):期末库存",
      "example": "123",
