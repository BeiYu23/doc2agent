{
  "id": "doudian.retail-order.instantShopping.order.uploadPic",
  "platform": "doudian",
  "group": "retail-order",
  "name": "instantShopping.order.uploadPic",
  "description": "商家上传图片",
  "method": "GET",
  "path": "YOUR_SECRET_KEY",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 店铺"
  },
  "notes": [
    "文档书: 订单管理API【即时零售】（版本 V1.01）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "shop_order_id",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "店铺单号",
      "example": "\"6954957304399009191\"",
      "_depth": 0
    },
    {
      "name": "url_list",
      "in": "body",
      "type": "array",
      "required": false,
      "description": "商家上传的图片列表",
      "example": "[\"https://cloud.maiyatian.com/order_YOUR_SECRET_KEY.jpg\",\"https://cloud.maiyatian.com/order_YOUR_SECRET_KEY.jpg\"]",
      "_depth": 0
    },
    {
      "name": "scene",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "业务场景标识。鲜花场景赋值为\"realShot\"",
      "example": "realShot",
      "_depth": 0
    }
  ],
  "responseParams": [],
