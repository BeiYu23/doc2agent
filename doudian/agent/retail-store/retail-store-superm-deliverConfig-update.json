{
  "id": "doudian.retail-store.superm.deliverConfig.update",
  "platform": "doudian",
  "group": "retail-store",
  "name": "superm.deliverConfig.update",
  "description": "时效管理更新",
  "method": "GET",
  "path": "/superm/deliverConfig/update",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 店铺"
  },
  "notes": [
    "文档书: 门店管理API【即时零售】（版本 V1.01）",
