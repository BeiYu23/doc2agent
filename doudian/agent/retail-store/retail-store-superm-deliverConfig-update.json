  ],
  "params": [
    {
      "name": "config_ids",
      "in": "body",
      "type": "array",
      "required": true,
      "description": "配置ID列表",
      "example": "213432",
      "_depth": 0
    },
    {
      "name": "shop_deliver_config",
      "in": "body",
      "type": "object",
      "required": true,
      "description": "配置信息",
      "example": "",
      "_depth": 0
    },
    {
      "name": "deliver_type",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "配送类型\n1：商家自行配置配送时长\n2：系统自动计算配置时长",
      "example": "1",
      "_depth": 1
    },
    {
      "name": "normal_time_cost",
      "in": "body",
      "type": "number",
      "required": false,
      "description": "三公里内常规时间配送时长（分钟）",
      "example": "20",
      "_depth": 1
    },
    {
      "name": "special_time_list",
      "in": "body",
      "type": "array",
      "required": false,
      "description": "三公里内特殊时段列表",
      "example": "",
      "_depth": 1
    },
    {
      "name": "start_time",
      "in": "body",
      "type": "number",
      "required": true,
      "description": "时间片（单位秒，表示第几秒，如36000表示10:00）",
      "example": "36000",
      "_depth": 2
    },
    {
      "name": "end_time",
      "in": "body",
      "type": "number",
      "required": true,
      "description": "时间片（单位秒，表示第几秒，如39600表示11:00）",
      "example": "39600",
      "_depth": 2
    },
    {
      "name": "time_cost",
      "in": "body",
      "type": "number",
      "required": true,
      "description": "时间片内对应的配送时长（分钟）",
      "example": "20",
      "_depth": 2
    },
    {
      "name": "over_limit_time_cost",
      "in": "body",
      "type": "number",
      "required": false,
      "description": "三公里外每公里增加的配送时长（分钟）",
      "example": "40",
      "_depth": 1
    }
  ],
