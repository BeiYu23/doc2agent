{
  "id": "doudian.retail-store.shop.getStoreList",
  "platform": "doudian",
  "group": "retail-store",
  "name": "shop.getStoreList",
  "description": "门店列表分页查询",
  "method": "GET",
  "path": "/shop/getStoreList",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 店铺"
  },
  "notes": [
    "文档书: 门店管理API【即时零售】（版本 V3.01）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "store_name_list",
      "in": "body",
      "type": "array",
      "required": false,
      "description": "门店名称集合，不支持模糊",
      "example": "[xxx]",
      "_depth": 0
    },
    {
      "name": "store_id_list",
      "in": "body",
      "type": "array",
      "required": false,
      "description": "门店id集合，用于查询门店信息",
      "example": "[123]",
      "_depth": 0
    },
    {
      "name": "store_code_list",
      "in": "body",
      "type": "array",
      "required": false,
      "description": "门店编码，开发者自定义",
      "example": "[123,aaa]",
      "_depth": 0
    },
    {
      "name": "state",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "绑定状态，1绑定中;2绑定成功;3:资质验证中;4账户认证中;5正常营业(c端可下单);6暂停营业",
      "example": "5",
      "_depth": 0
    },
    {
      "name": "poi_audit_state",
      "in": "body",
      "type": "array",
      "required": false,
      "description": "poi审核状态：0无提审;1审核中;2审核成功;3驳回;4部分通过",
      "example": "[1,2]",
      "_depth": 0
    },
    {
      "name": "province",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "省",
      "example": "四川省",
      "_depth": 0
    },
    {
      "name": "city",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "市",
      "example": "成都市",
      "_depth": 0
    },
    {
      "name": "district",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "区",
      "example": "高新区",
      "_depth": 0
    },
    {
      "name": "poi_id_list",
      "in": "body",
      "type": "array",
      "required": false,
      "description": "门店poiId集合",
      "example": "[123]",
      "_depth": 0
    },
    {
      "name": "name_fuzzy",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "门店名称，支持模糊查询",
      "example": "xxx",
      "_depth": 0
    },
    {
      "name": "store_code_fuzzy",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "门店编码，支持模糊查询",
      "example": "xxx",
      "_depth": 0
    },
    {
      "name": "qual_state",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "资质审核状态，0未提交；1审核中；2审核通过；3驳回",
      "example": "2",
      "_depth": 0
    },
    {
      "name": "remit_state",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "账户验证状态，0未提交；1验证中；2通过；3失败",
      "example": "2",
      "_depth": 0
    },
    {
      "name": "open_account_state",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "开户状态：0未开户;1已开户",
      "example": "1",
      "_depth": 0
    },
    {
      "name": "is_need_poi_audit_info",
      "in": "body",
      "type": "boolean",
      "required": false,
      "description": "是否需要poi审核信息，注：只要审核状态的审核不要传true，需要详细的提交信息时传true",
      "example": "1",
      "_depth": 0
    },
    {
      "name": "is_need_rel_shop_user",
      "in": "body",
      "type": "boolean",
      "required": false,
      "description": "是否需要关联的抖店信息，注：只要shopId不要传true，需要关联店铺名称等信息时传true",
      "example": "1",
      "_depth": 0
    },
    {
      "name": "page",
      "in": "body",
      "type": "mixed",
      "required": true,
      "description": "第几页(从0开始)",
      "example": "0",
      "_depth": 0
    },
    {
      "name": "page_size",
      "in": "body",
      "type": "mixed",
      "required": true,
      "description": "每页条数",
      "example": "10",
      "_depth": 0
    }
  ],
  "responseParams": [
    {
      "name": "ret_code",
      "type": "mixed",
      "description": "返回错误码",
      "example": "0"
    },
    {
      "name": "ret_msg",
      "type": "string",
      "description": "返回信息",
      "example": "success"
    },
    {
      "name": "total",
      "type": "mixed",
      "description": "总数",
      "example": "10"
    },
    {
      "name": "store_detail_list",
      "type": "array",
      "description": "与getStoreDetail接口返回一致",
      "example": ""
    }
  ],
  "responseCodes": [
    {
      "code": "10000",
      "meaning": "success",
      "action": "正常处理"
    },
    {
      "code": "50002",
      "meaning": "业务处理失败（sub_code: isv.business-failed:100）",
      "action": "请先重试，重试依然失败检查参数无误后发起咨询",
      "sub_code": "isv.business-failed:100",
      "sub_msg": "业务处理失败"
    },
    {
      "code": "50002",
      "meaning": "业务处理失败 / 参数错误（sub_code: isv.business-failed:1）",
      "action": "检查参数",
      "sub_code": "isv.business-failed:1",
      "sub_msg": "参数错误"
    },
    {
      "code": "50002",
      "meaning": "业务处理失败 / 查询失败（sub_code: isv.business-failed:3）",
      "action": "请先重试，重试依然失败检查参数无误后发起咨询",
      "sub_code": "isv.business-failed:3",
      "sub_msg": "查询失败"
    }
  ],
