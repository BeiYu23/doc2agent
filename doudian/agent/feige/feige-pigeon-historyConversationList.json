      "name": "page_no",
      "in": "body",
      "type": "mixed",
      "required": true,
      "description": "页数，从1开始",
      "example": "1",
      "_depth": 0
    },
    {
      "name": "page_size",
      "in": "body",
      "type": "mixed",
      "required": true,
      "description": "pageSize，单次最多1000条",
      "example": "100",
      "_depth": 0
    },
    {
      "name": "convention_id_list",
      "in": "body",
      "type": "array",
      "required": false,
      "description": "[\"1\",\"2\"]",
      "example": "会话id",
      "_depth": 0
    },
    {
      "name": "end_time_start",
      "in": "body",
      "type": "mixed",
      "required": true,
      "description": "查询end_time_start-end_time_end期间结束的会话\n\n注意：部分指标数据非T+1稳定，所以每天会更新近三天的数据。举例：会话A在10.29号结束，用户在10.30号评价了该会话，那么10.31号的时候1029日期的会话数据也会有更新。",
      "example": "1700064000",
      "_depth": 0
    },
    {
      "name": "end_time_end",
      "in": "body",
      "type": "mixed",
      "required": true,
      "description": "查询end_time_start-end_time_end期间结束的会话",
      "example": "1700064000",
      "_depth": 0
    }
  ],
