{
  "id": "doudian.feige.pigeon.ISVExecuteTool",
  "cnName": "执行ISV客服工具的接口",
  "docUrl": "/docs/doudian/feige/feige-pigeon-ISVExecuteTool",
  "name": "pigeon.ISVExecuteTool",
  "platform": "doudian",
  "group": "feige",
  "description": "执行ISV客服工具的接口，支持执行各种客服相关的自动化工具和脚本",
  "method": "GET",
  "path": "/pigeon/ISVExecuteTool",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 店铺"
  },
  "notes": [
    "文档书: 飞鸽API（版本 V1.01）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "tool_code",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "工具code",
      "example": "\"BASIC_SCRIPT\"",
      "_depth": 0
    },
    {
      "name": "execute_params",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "工具执行参数，部分工具存在必传参数",
      "example": "\"product_id_list\": \"[\\\"3740656536352063689\\\",\\\"3686240338055397653\\\"]\"",
      "_depth": 0
    },
    {
      "name": "script",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "回复话术（BASIC_SCRIPT工具必传）",
      "example": "\"您好\"",
      "_depth": 0
    },
    {
      "name": "biz_params_context",
      "in": "body",
      "type": "object",
      "required": true,
      "description": "固定业务参数，有就传，部分工具存在必传参数",
      "example": "",
      "_depth": 0
    },
    {
      "name": "talk_id",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "子会话ID",
      "example": "\"7524598324482114\"",
      "_depth": 1
    },
    {
      "name": "shop_order_id",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "商城订单ID",
      "example": "\"0\"",
      "_depth": 1
    },
    {
      "name": "sku_order_id",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "sku订单ID",
      "example": "\"0\"",
      "_depth": 1
    },
    {
      "name": "after_sale_id",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "售后ID",
      "example": "\"0\"",
      "_depth": 1
    },
    {
      "name": "product_id",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "产品ID",
      "example": "\"37608307150512459\"",
      "_depth": 1
    },
    {
      "name": "msg_id",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "消息ID",
      "example": "\"18370601871002\"",
      "_depth": 1
    },
    {
      "name": "pigeon_biz_type",
      "in": "body",
      "type": "mixed",
      "required": true,
      "description": "业务身份",
      "example": "2",
      "_depth": 0
    },
    {
      "name": "pigeon_shop_id",
      "in": "body",
      "type": "mixed",
      "required": true,
      "description": "飞鸽店铺ID",
      "example": "14562951",
      "_depth": 0
    },
    {
      "name": "biz_idempotent_no",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "工具执行幂等ID，过期时间2h",
      "example": "\"0217519571190490000717ab0:1837060187100\"",
      "_depth": 0
    },
    {
      "name": "trace_id",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "生命周期ID",
      "example": "\"0217511190490000ffff40a17ab0:1837100268\"",
      "_depth": 0
    },
    {
      "name": "doudian_open_id",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "执行对象ID，一般为消费者ID",
      "example": "\"104477413000\"",
      "_depth": 0
    },
    {
      "name": "ext",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "扩展字段",
      "example": "\"\"",
      "_depth": 0
    }
  ],
  "responseParams": [
    {
      "name": "result",
      "type": "string",
      "description": "工具执行结果。SUCCESS or FAILED",
      "example": "\"SUCCESS\""
    },
    {
      "name": "trace_id",
      "type": "string",
      "description": "生命周期ID",
      "example": "\"0217511190490000ffff40a17ab0:1837100268\""
    },
    {
      "name": "biz_err",
      "type": "object",
      "description": "业务错误",
      "example": ""
    }
  ],
