            "direction": "1",
            "direction_v2": "1",
            "doudian_open_id": "1",
            "msg_type": "1",
            "phase": "1",
            "robot_auto_answer": "1",
            "send_time_ts": "1",
            "server_msg_id": "1",
            "sponsor": "1",
            "staff_id": "1",
            "trans_in_staff_id": "1"
          }
        ]
      },
      "code": 10000,
      "msg": "success",
      "sub_code": "",
