{
  "id": "doudian.feige.pigeon.tokenExchange",
  "platform": "doudian",
  "group": "feige",
  "name": "pigeon.tokenExchange",
  "description": "飞鸽token换取登录参数",
  "method": "GET",
  "path": "/pigeon/tokenExchange",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 店铺"
  },
  "notes": [
    "文档书: 飞鸽API（版本 V3.02）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "token",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "密文token",
      "example": "YOUR_SECRET_KEY",
      "_depth": 0
    }
  ],
  "responseParams": [
    {
      "name": "login_param",
      "type": "string",
      "description": "登录态明文信息",
      "example": "{\\\"customer_service_id\\\":\\\"1%#YOUR_SECRET_KEY\\\",\\\"customer_service_name\\\":\\\"张三\\\",\\\"shop_id\\\":\\\"1111122233\\\"}"
    }
  ],
  "responseCodes": [
    {
      "code": "10000",
      "meaning": "success",
      "action": "正常处理"
    },
    {
      "code": "50002",
      "meaning": "业务处理失败 / 登录时间已过期（sub_code: isv.business-failed:33001）",
      "action": "使用新的 token， 目前是 10 分钟过期",
      "sub_code": "isv.business-failed:33001",
      "sub_msg": "登录时间已过期"
    },
    {
      "code": "20000",
      "meaning": "系统错误 / 内部错误（sub_code: isp.service-error:100002）",
      "action": "稍等重试或提交工单",
      "sub_code": "isp.service-error:100002",
      "sub_msg": "内部错误"
    },
    {
      "code": "20000",
      "meaning": "系统错误 / 内部错误（sub_code: isp.service-error:7）",
      "action": "稍等重试或提交工单",
      "sub_code": "isp.service-error:7",
      "sub_msg": "内部错误"
    },
    {
      "code": "40004",
      "meaning": "非法的参数 / 参数异常（sub_code: isv.parameter-invalid:100003）",
      "action": "使用正确的鉴权信息",
      "sub_code": "isv.parameter-invalid:100003",
      "sub_msg": "参数异常"
    }
  ],
  "examples": {
    "request": "curl -X GET 'https://openapi-fxg.jinritemai.com/pigeon/tokenExchange?app_key=your_appkey_here&method=pigeon.tokenExchange&access_token=your_accesstoken_here&param_json={}&timestamp=2018-06-19%2016:06:59&v=2&sign=your_sign_here'",
    "responseSuccess": {
      "data": {
        "login_param": "{\\\"customer_service_id\\\":\\\"1%#YOUR_SECRET_KEY\\\",\\\"customer_service_name\\\":\\\"侯志鹏\\\",\\\"shop_id\\\":\\\"1111114035\\\"}"
      },
      "code": 10000,
      "msg": "success",
      "sub_code": "",
      "sub_msg": ""
    },
    "responseError": {
      "code": 50002,
      "msg": "业务处理失败",
      "sub_code": "isv.business-failed:33001",
      "sub_msg": "登录时间已过期"
    }
  },
  "source": "https://op.jinritemai.com/docs/api-docs/188/1971",
  "updatedAt": "2022-06-01",
  "_file_stem": "feige-pigeon-tokenExchange",
  "cnName": "飞鸽token换取登录参数"
}
