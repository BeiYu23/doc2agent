{
  "id": "doudian.video.shopVideo.uploadVideo",
  "platform": "doudian",
  "group": "video",
  "name": "shopVideo.uploadVideo",
  "description": "商家短视频上传",
  "method": "GET",
  "path": "/shopVideo/uploadVideo",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 见平台说明"
  },
  "notes": [
    "文档书: 短视频API（版本 V1.01）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "url",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "视频url，目前支持mp4视频格式",
      "example": "https://media.w3.org/2010/05/sintel/trailer.mp4",
      "_depth": 0
    }
  ],
  "responseParams": [
    {
      "name": "task_id",
      "type": "string",
      "description": "任务ID，根据任务ID查询上传任务状态",
      "example": "7446661656018420006"
    }
  ],
  "responseCodes": [
    {
      "code": "10000",
      "meaning": "success",
      "action": "正常处理"
    },
    {
      "code": "40004",
      "meaning": "非法的参数 / URL解析失败（sub_code: isv.parameter-invalid:605025001）",
      "action": "检查URL是否合法，合法例子：https://media.w3.org/2010/05/sintel/trailer.mp4",
      "sub_code": "isv.parameter-invalid:605025001",
      "sub_msg": "URL解析失败"
    },
    {
      "code": "20000",
      "meaning": "系统错误（sub_code: isp.service-error:605025003）",
      "action": "稍后重试",
      "sub_code": "isp.service-error:605025003",
      "sub_msg": "系统错误"
    },
    {
      "code": "20000",
      "meaning": "系统错误（sub_code: isp.service-error:605025004）",
      "action": "稍后重试",
      "sub_code": "isp.service-error:605025004",
      "sub_msg": "系统错误"
    },
    {
      "code": "20000",
      "meaning": "系统错误（sub_code: isp.service-error:605025005）",
      "action": "稍后重试",
      "sub_code": "isp.service-error:605025005",
      "sub_msg": "系统错误"
    }
  ],
  "examples": {
    "request": "curl -X GET 'https://openapi-fxg.jinritemai.com/shopVideo/uploadVideo?app_key=your_appkey_here&method=shopVideo.uploadVideo&access_token=your_accesstoken_here&param_json={}&timestamp=2018-06-19%2016:06:59&v=2&sign=your_sign_here'",
    "responseSuccess": {
      "data": {
        "task_id": "7446661656018420006"
      },
      "code": 10000,
      "msg": "success",
      "sub_code": "",
      "sub_msg": ""
    },
    "responseError": {
      "code": 40004,
      "msg": "非法的参数",
      "sub_code": "isv.parameter-invalid:605025001",
      "sub_msg": "URL解析失败"
    }
  },
