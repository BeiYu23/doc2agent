  "params": [
    {
      "name": "user_id",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "作者账号id",
      "example": "11",
      "_depth": 0
    },
    {
      "name": "item_id",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "图文id",
      "example": "1",
      "_depth": 0
    },
    {
      "name": "page",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "页码",
      "example": "1",
      "_depth": 0
    },
    {
      "name": "page_size",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "每页数量，默认10",
      "example": "1",
      "_depth": 0
    },
    {
      "name": "product",
      "in": "body",
      "type": "object",
      "required": false,
      "description": "商品参数（使用商品id查询时，必传bind_scene，否则商品过滤无效）",
      "example": "",
      "_depth": 0
    },
    {
      "name": "product_id",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "商品id",
      "example": "123443",
      "_depth": 1
    },
    {
      "name": "bind_scene",
      "in": "body",
      "type": "string",
