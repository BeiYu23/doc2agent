{
  "id": "doudian.video.product.getPerformance",
  "platform": "doudian",
  "group": "video",
  "name": "product.getPerformance",
  "description": "查询商品指标信息",
  "method": "GET",
  "path": "/product/getPerformance",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 店铺"
  },
  "notes": [
    "文档书: 短视频API（版本 V1.01）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "product_id",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "商品ID",
      "example": "3626171943981559436",
      "_depth": 0
    }
  ],
  "responseParams": [
    {
      "name": "product_id",
      "type": "string",
      "description": "商品ID",
      "example": "3626171943981559436"
    },
    {
      "name": "has_sold",
      "type": "boolean",
      "description": "是否动销",
      "example": "true"
    },
    {
      "name": "has_visited",
      "type": "boolean",
      "description": "是否曝光",
      "example": "true"
    }
  ],
  "responseCodes": [
    {
      "code": "10000",
      "meaning": "success",
      "action": "正常处理"
    },
    {
      "code": "20000",
      "meaning": "系统错误 / productId不能为空（sub_code: isp.service-error:3000001）",
      "action": "productId不能为空",
      "sub_code": "isp.service-error:3000001",
      "sub_msg": "productId不能为空"
    },
    {
      "code": "20000",
      "meaning": "系统错误 / shopId不能为空（sub_code: isp.service-error:3000002）",
      "action": "shopId不能为空",
      "sub_code": "isp.service-error:3000002",
      "sub_msg": "shopId不能为空"
    },
    {
      "code": "20000",
      "meaning": "系统错误 / 商品不存在（sub_code: isp.service-error:3000003）",
      "action": "商品不存在",
      "sub_code": "isp.service-error:3000003",
      "sub_msg": "商品不存在"
    },
    {
      "code": "20000",
      "meaning": "系统错误 / 商品参数不合法（sub_code: isp.service-error:3000004）",
      "action": "商品参数不合法",
      "sub_code": "isp.service-error:3000004",
      "sub_msg": "商品参数不合法"
    }
  ],
  "examples": {
    "request": "curl -X GET 'https://openapi-fxg.jinritemai.com/product/getPerformance?app_key=your_appkey_here&method=product.getPerformance&access_token=your_accesstoken_here&param_json={}&timestamp=2018-06-19%2016:06:59&v=2&sign=your_sign_here'",
    "responseSuccess": {
      "data": {
        "has_sold": "true",
        "has_visited": "true",
        "product_id": "3626171943981559436"
      },
      "code": 10000,
      "msg": "success",
      "sub_code": "",
      "sub_msg": ""
    },
    "responseError": {
      "code": 20000,
      "msg": "系统错误",
      "sub_code": "isp.service-error:3000001",
      "sub_msg": "productId不能为空"
    }
  },
  "source": "https://op.jinritemai.com/docs/api-docs/1568/7351",
  "updatedAt": "2025-03-11",
  "_file_stem": "video-product-getPerformance"
}
