{
  "id": "doudian.video.shopVideo.searchItem",
  "cnName": "查询视频列表",
  "docUrl": "/docs/doudian/video/video-shopVideo-searchItem",
  "name": "shopVideo.searchItem",
  "platform": "doudian",
  "group": "video",
  "description": "查询视频列表",
  "method": "GET",
  "path": "/shopVideo/searchItem",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 店铺"
  },
  "notes": [
    "文档书: 短视频API（版本 V1.01）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "page",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "页码",
      "example": "1",
      "_depth": 0
    },
    {
      "name": "bind_scene",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "绑定场景，1-只查挂车短视频，2-查询所有非挂车短视频，3-查询所有未绑定商品的短视频",
      "example": "1",
      "_depth": 0
    },
    {
      "name": "optional_param",
      "in": "body",
      "type": "object",
      "required": false,
      "description": "可选参数: 是否获取相关数据",
      "example": "",
      "_depth": 0
    },
    {
      "name": "need_stats",
      "in": "body",
      "type": "boolean",
      "required": false,
      "description": "是否需要短视频表现",
      "example": "false",
      "_depth": 1
    },
    {
      "name": "need_high_quality_tag",
      "in": "body",
      "type": "boolean",
      "required": false,
      "description": "是否需要优质标签",
      "example": "false",
      "_depth": 1
    },
    {
      "name": "page_size",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "每页数量，默认10",
      "example": "10",
      "_depth": 0
    },
    {
      "name": "user_id",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "作者账号id，不传默认人店一体账号，支持渠道号",
      "example": "121212",
      "_depth": 0
    },
    {
      "name": "item_id",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "短视频id",
      "example": "121221221",
      "_depth": 0
    },
    {
      "name": "product",
      "in": "body",
      "type": "object",
      "required": false,
      "description": "商品参数",
      "example": "",
      "_depth": 0
    },
    {
      "name": "product_id",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "商品id",
      "example": "1212121212",
      "_depth": 1
    }
  ],
  "responseParams": [
    {
      "name": "data",
      "type": "object",
      "description": "返回数据",
      "example": ""
    },
    {
      "name": "total",
      "type": "mixed",
      "description": "总数",
      "example": "121212"
    }
  ],
  "responseCodes": [
    {
      "code": "10000",
      "meaning": "success",
      "action": "正常处理"
    },
    {
      "code": "50002",
      "meaning": "业务处理失败 / 1000001:当前商家暂未绑号（sub_code: isv.business-failed:1000001）",
      "action": "请商家绑号",
      "sub_code": "isv.business-failed:1000001",
      "sub_msg": "1000001:当前商家暂未绑号"
    },
    {
      "code": "50002",
      "meaning": "业务处理失败 / 20000000:下游服务内部异常(code=20000004)（sub_code: isv.business-failed:20000000）",
      "action": "稍后重试",
      "sub_code": "isv.business-failed:20000000",
      "sub_msg": "20000000:下游服务内部异常(code=20000004)"
    },
    {
      "code": "50002",
      "meaning": "业务处理失败 / 1000003:系统异常（sub_code: isv.business-failed:1000003）",
      "action": "系统异常",
      "sub_code": "isv.business-failed:1000003",
      "sub_msg": "1000003:系统异常"
    }
  ],
