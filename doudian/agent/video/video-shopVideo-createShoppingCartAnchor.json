{
  "id": "doudian.video.shopVideo.createShoppingCartAnchor",
  "platform": "doudian",
  "group": "video",
  "name": "shopVideo.createShoppingCartAnchor",
  "description": "创建挂车锚点",
  "method": "GET",
  "path": "/shopVideo/createShoppingCartAnchor",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 店铺"
  },
  "notes": [
    "文档书: 短视频API（版本 V1.01）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "product_id",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "商品ID",
      "example": "122121",
      "_depth": 0
    },
    {
      "name": "user_id",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "不传默认人店一体账号，支持渠道号",
      "example": "121221",
      "_depth": 0
    },
    {
      "name": "title",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "小黄车标题",
      "example": "这是标题",
      "_depth": 0
    }
  ],
  "responseParams": [
    {
      "name": "data",
      "type": "string",
      "description": "生成的锚点ID",
      "example": "1212122"
    }
  ],
  "responseCodes": [
    {
      "code": "10000",
      "meaning": "success",
      "action": "正常处理"
    },
    {
      "code": "50002",
      "meaning": "业务处理失败 / 1000001:当前商家暂未绑号（sub_code: isv.business-failed:1000001）",
      "action": "引导商家绑号",
      "sub_code": "isv.business-failed:1000001",
      "sub_msg": "1000001:当前商家暂未绑号"
    },
    {
      "code": "50002",
      "meaning": "业务处理失败 / 1000000:商品当前已下架，用户不可购买（sub_code: isv.business-failed:1000000）",
      "action": "传入正确状态的商品",
      "sub_code": "isv.business-failed:1000000",
      "sub_msg": "1000000:商品当前已下架，用户不可购买"
    }
  ],
  "examples": {
    "request": "curl -X GET 'https://openapi-fxg.jinritemai.com/shopVideo/createShoppingCartAnchor?app_key=your_appkey_here&method=shopVideo.createShoppingCartAnchor&access_token=your_accesstoken_here&param_json={}&timestamp=2018-06-19%2016:06:59&v=2&sign=your_sign_here'",
    "responseSuccess": {
      "data": {
        "data": "1212122"
      },
      "code": 10000,
      "msg": "success",
      "sub_code": "",
      "sub_msg": ""
    },
    "responseError": {
      "code": 50002,
      "msg": "业务处理失败",
      "sub_code": "isv.business-failed:1000001",
      "sub_msg": "1000001:当前商家暂未绑号"
    }
  },
  "source": "https://op.jinritemai.com/docs/api-docs/1568/7487",
  "updatedAt": "2025-06-03",
  "_file_stem": "video-shopVideo-createShoppingCartAnchor"
}
