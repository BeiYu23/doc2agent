  "name": "shopVideo.reportVideoPublishRecord",
  "description": "上报短视频上传记录",
  "method": "GET",
  "path": "/shopVideo/reportVideoPublishRecord",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 店铺"
  },
  "notes": [
    "文档书: 短视频API（版本 V1.01）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "item_id",
      "in": "body",
      "type": "number",
      "required": true,
      "description": "短视频ID",
      "example": "1872068485345111",
      "_depth": 0
    },
    {
      "name": "user_id",
      "in": "body",
      "type": "number",
      "required": false,
      "description": "作者账号id（抖音uid），不传默认人店一体账号，支持渠道号",
      "example": "7553945164076821278",
      "_depth": 0
    }
  ],
  "responseParams": [
    {
      "name": "success",
      "type": "boolean",
      "description": "是否上报成功",
      "example": "false"
    },
    {
      "name": "failed_reason",
      "type": "string",
      "description": "上报失败原因",
      "example": "userID与店铺的关联关系不存在"
    }
  ],
  "responseCodes": [
    {
      "code": "10000",
      "meaning": "成功",
      "action": "正常处理"
    }
  ],
