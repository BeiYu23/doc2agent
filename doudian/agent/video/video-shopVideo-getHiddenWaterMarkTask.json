{
  "id": "doudian.video.shopVideo.getHiddenWaterMarkTask",
  "platform": "doudian",
  "group": "video",
  "name": "shopVideo.getHiddenWaterMarkTask",
  "description": "查询加暗水印任务",
  "method": "GET",
  "path": "/shopVideo/getHiddenWaterMarkTask",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 见平台说明"
  },
  "notes": [
    "文档书: 短视频API（版本 V1.01）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "task_id",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "任务id",
      "example": "7458213968494985526",
      "_depth": 0
    }
  ],
  "responseParams": [
    {
      "name": "watermark_url",
      "type": "string",
      "description": "加完暗水印后的资源url，在status=3时有值，注意：该url有效期10分钟，禁止对外暴露，请在自己系统内转储后给商家播放/下载",
      "example": "https://v3-cold.douyinvod.com/b6fb2946ffc92fb4e"
    },
    {
      "name": "task_id",
      "type": "string",
      "description": "任务id",
      "example": "7458213968494985526"
    },
    {
      "name": "display_status",
      "type": "mixed",
      "description": "任务状态：1：上传视频中，2-加暗水印中，3：任务成功，4：任务失败",
      "example": "3"
    },
    {
      "name": "failed_reason",
      "type": "string",
      "description": "失败原因，在task_status=4时有值",
      "example": "系统异常"
    }
  ],
  "responseCodes": [
    {
      "code": "10000",
      "meaning": "success",
      "action": "正常处理"
    },
    {
      "code": "40004",
      "meaning": "非法的参数 / 参数错误（sub_code: isv.parameter-invalid:628002001）",
      "action": "根据异常描述调整参数",
      "sub_code": "isv.parameter-invalid:628002001",
      "sub_msg": "参数错误"
    }
  ],
  "examples": {
    "request": "curl -X GET 'https://openapi-fxg.jinritemai.com/shopVideo/getHiddenWaterMarkTask?app_key=your_appkey_here&method=shopVideo.getHiddenWaterMarkTask&access_token=your_accesstoken_here&param_json={}&timestamp=2018-06-19%2016:06:59&v=2&sign=your_sign_here'",
    "responseSuccess": {
      "data": {
        "display_status": "3",
        "failed_reason": "系统异常",
