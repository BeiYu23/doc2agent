{
  "id": "doudian.home-order.retailCustom.order.searchList",
  "cnName": "即时零售定制接口-订单详情列表",
  "docUrl": "/docs/doudian/home-order/home-order-retailCustom-order-searchList",
  "name": "retailCustom.order.searchList",
  "platform": "doudian",
  "group": "home-order",
  "description": "即时零售定制接口-订单详情列表",
  "method": "GET",
  "path": "YOUR_SECRET_KEY",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 店铺"
  },
  "notes": [
    "文档书: 到家订单管理（版本 V1.01）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "product",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "商品，number型代表商品ID，其它代表商品名称",
      "example": "3473196049974326153",
      "_depth": 0
    },
    {
      "name": "b_type",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "【下单端】 0、站外   1、火山   2、抖音   3、头条   4、西瓜   5、微信   6、值点app  7、头条lite   8、懂车帝  9、皮皮虾   11、抖音极速版   12、TikTok   13、musically   14、穿山甲   15、火山极速版   16、服务市场   26、番茄小说   27、UG教育营销电商平台   28、Jumanji   29、电商SDK",
      "example": "2",
      "_depth": 0
    },
    {
      "name": "after_sale_status_desc",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "售后状态：all-全部，in_aftersale-售后中，refund-退款中，refund_success-退款成功，refund_fail-退款失败，exchange_success-换货成功 aftersale_close-售后关闭",
      "example": "refund_success",
      "_depth": 0
    },
    {
      "name": "tracking_no",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "物流单号",
      "example": "43543",
      "_depth": 0
    },
    {
      "name": "presell_type",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "预售类型：0-普通订单；1-全款预售；2-定金预售；3-定金找货；",
      "example": "0",
      "_depth": 0
    },
    {
      "name": "order_type",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "订单类型 0、普通订单 2、虚拟商品订单 4、电子券（poi核销） 5、三方核销",
      "example": "1",
      "_depth": 0
    },
    {
      "name": "create_time_start",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "下单时间：开始，秒级时间戳",
      "example": "1617355413",
      "_depth": 0
    },
    {
      "name": "create_time_end",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "下单时间：截止，秒级时间戳",
      "example": "1617355413",
      "_depth": 0
    },
    {
      "name": "abnormal_order",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "异常订单，1-异常取消，2-风控审核中",
      "example": "1",
      "_depth": 0
    },
    {
      "name": "trade_type",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "交易类型：0-普通；1-拼团；2-定金预售；3-订金找货；4-拍卖；5-0元单；6-回收；7-寄卖；10-寄样；11-0元抽奖(超级福袋)；12-达人买样；13-普通定制；16-大众竞拍；18-小时达；102-定金预售的赠品单；103-收款；",
      "example": "1",
      "_depth": 0
    },
    {
      "name": "combine_status",
      "in": "body",
      "type": "array",
      "required": false,
      "description": "状态组合查询，直接输入状态码（只支持一个元素）",
      "example": "",
      "_depth": 0
    },
    {
      "name": "order_status",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "订单状态，\",\"分隔多个状态；1-待支付；101-部分发货；105-已支付；2-待发货；3-已发货；4-已取消；5-已完成",
      "example": "1",
      "_depth": 1
    },
    {
      "name": "main_status",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "【已废弃，不推荐使用】主流程状态，\",\"分隔多个状态；",
      "example": "103",
      "_depth": 1
    },
    {
      "name": "update_time_start",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "更新时间：开始",
      "example": "1617355413",
      "_depth": 0
    },
    {
      "name": "update_time_end",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "更新时间：截止",
      "example": "1617355413",
      "_depth": 0
    },
    {
      "name": "size",
      "in": "body",
      "type": "mixed",
      "required": true,
      "description": "单页大小，限制100以内",
      "example": "20",
      "_depth": 0
    },
    {
      "name": "page",
      "in": "body",
      "type": "mixed",
      "required": true,
      "description": "页码，0页开始",
      "example": "0",
      "_depth": 0
    },
    {
      "name": "order_by",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "排序条件(create_time 订单创建时间；update_time 订单更新时间；默认create_time；)",
      "example": "create_time",
      "_depth": 0
    },
    {
      "name": "order_asc",
      "in": "body",
      "type": "boolean",
      "required": false,
      "description": "排序类型，小到大或大到小，默认大到小",
      "example": "false",
      "_depth": 0
    },
    {
      "name": "fulfil_status",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "履约状态；如小时达未接单\"no_accept\"",
      "example": "no_accept",
      "_depth": 0
    }
  ],
  "responseParams": [
    {
      "name": "page",
      "type": "mixed",
      "description": "页数，从0开始",
      "example": "1"
    },
    {
      "name": "total",
      "type": "mixed",
      "description": "总订单数",
      "example": "1000"
    },
    {
      "name": "size",
      "type": "mixed",
      "description": "单页大小",
      "example": "20"
    },
    {
      "name": "shop_order_list",
      "type": "array",
      "description": "订单信息",
      "example": ""
    }
  ],
  "responseCodes": [
    {
      "code": "10000",
      "meaning": "success",
      "action": "正常处理"
    },
    {
      "code": "40004",
      "meaning": "非法的参数 / 订单查询只支持查询最近90天内的数据（sub_code: isv.parameter-invalid:20022）",
