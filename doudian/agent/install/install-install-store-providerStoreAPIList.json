{
  "id": "doudian.install.install.store.providerStoreAPIList",
  "cnName": "服务商门店列表",
  "docUrl": "/docs/doudian/install/install-install-store-providerStoreAPIList",
  "name": "install.store.providerStoreAPIList",
  "platform": "doudian",
  "group": "install",
  "description": "服务商门店列表",
  "method": "GET",
  "path": "/install/store/providerStoreAPIList",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 见平台说明"
  },
  "notes": [
    "文档书: 到店安装API（版本 V1.01）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "name",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "门店名称模糊匹配",
      "example": "门店名称",
      "_depth": 0
    },
    {
      "name": "store_custom_codes",
      "in": "body",
      "type": "array",
      "required": false,
      "description": "门店自用编码筛选",
      "example": "门店自用编码",
      "_depth": 0
    },
    {
      "name": "audit_status",
      "in": "body",
      "type": "array",
      "required": false,
      "description": "门店审核状态筛选",
      "example": "1",
      "_depth": 0
    },
    {
      "name": "rn",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "每一页数量",
      "example": "10",
      "_depth": 0
    },
    {
      "name": "store_ids",
      "in": "body",
      "type": "array",
      "required": false,
      "description": "门店id筛选",
      "example": "[123,456]",
      "_depth": 0
    },
    {
      "name": "phone_call_state",
      "in": "body",
      "type": "boolean",
      "required": false,
      "description": "隐私号接通状态筛选，true:接通，false:未接通",
      "example": "true",
      "_depth": 0
    },
    {
      "name": "store_status",
      "in": "body",
      "type": "array",
      "required": false,
      "description": "门店状态筛选",
      "example": "1：门店上线\n2：下线\n4：审核中\n5：审核成功\n6：审核失败",
      "_depth": 0
    },
    {
      "name": "pn",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "页码",
      "example": "1",
      "_depth": 0
    },
    {
      "name": "addr_params",
      "in": "body",
      "type": "array",
      "required": false,
      "description": "地址匹配使用的param，上面的省市区县的字段可以不使用了",
      "example": "",
      "_depth": 0
    },
    {
      "name": "district",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "区",
      "example": "海淀区",
      "_depth": 1
    },
    {
      "name": "city",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "市",
      "example": "北京市",
      "_depth": 1
    },
    {
      "name": "street",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "县",
      "example": "花园路街道",
      "_depth": 1
    },
    {
      "name": "province",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "省",
      "example": "北京市",
      "_depth": 1
    },
    {
      "name": "audit_callback_time_param",
      "in": "body",
      "type": "object",
      "required": false,
      "description": "审核时间",
      "example": "",
      "_depth": 0
    },
    {
      "name": "start_time",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "查询的起始时间，时间戳",
      "example": "1752637538",
      "_depth": 1
    },
    {
      "name": "end_time",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "查询的结束时间，时间戳",
      "example": "1752637538",
      "_depth": 1
    },
    {
      "name": "category_channel",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "类目渠道",
      "example": "0表示旧类目体系能力\n1 表示新类目体系能力",
      "_depth": 0
    }
  ],
  "responseParams": [
    {
      "name": "pn",
      "type": "mixed",
      "description": "页码",
      "example": "1"
    },
    {
      "name": "rn",
      "type": "mixed",
      "description": "页面数量",
      "example": "10"
    },
    {
      "name": "total",
      "type": "mixed",
      "description": "门店总量",
      "example": "100"
    },
    {
      "name": "store_list",
      "type": "array",
      "description": "门店信息列表",
      "example": ""
    }
  ],
  "responseCodes": [
    {
      "code": "10000",
      "meaning": "成功",
      "action": "正常处理"
    }
  ],
