{
  "id": "doudian.install.install.store.ProviderStoreAPIDetail",
  "platform": "doudian",
  "group": "install",
  "name": "install.store.ProviderStoreAPIDetail",
  "description": "服务商门店详情接口",
  "method": "GET",
  "path": "/install/store/ProviderStoreAPIDetail",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 见平台说明"
  },
  "notes": [
    "文档书: 到店安装API（版本 V1.01）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "store_id",
      "in": "body",
      "type": "mixed",
      "required": true,
      "description": "门店id",
      "example": "123",
      "_depth": 0
    },
    {
      "name": "category_channel",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "类目渠道",
      "example": "类目渠道 0 表示旧类目体系，1表示新类目体系",
      "_depth": 0
    }
  ],
  "responseParams": [
    {
      "name": "store_detail",
      "type": "object",
      "description": "返回的门店详情",
      "example": ""
    }
  ],
  "responseCodes": [
    {
      "code": "10000",
      "meaning": "success",
      "action": "正常处理"
    },
    {
      "code": "50002",
      "meaning": "业务处理失败（sub_code: isv.business-failed:-3）",
      "action": "业务处理失败",
      "sub_code": "isv.business-failed:-3",
      "sub_msg": "业务处理失败"
    }
  ],
