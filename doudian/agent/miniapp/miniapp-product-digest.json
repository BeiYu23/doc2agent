{
  "id": "doudian.miniapp.product.digest",
  "platform": "doudian",
  "group": "miniapp",
  "name": "product.digest",
  "description": "查询商品摘要信息",
  "method": "GET",
  "path": "/product/digest",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
