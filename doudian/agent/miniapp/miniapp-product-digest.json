  },
  "notes": [
    "文档书: 电商小程序（版本 V1.01）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "product_id",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "商品id",
      "example": "1",
      "_depth": 0
    },
    {
      "name": "product_shop_id",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "店铺id",
      "example": "1",
      "_depth": 0
    }
  ],
  "responseParams": [
