{
  "id": "doudian.miniapp.mini.activity.queryUserRights",
  "platform": "doudian",
  "group": "miniapp",
  "name": "mini.activity.queryUserRights",
  "description": "查询用户店铺下的权益列表",
  "method": "GET",
  "path": "/mini/activity/queryUserRights",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 店铺"
  },
  "notes": [
    "文档书: 电商小程序（版本 V1.01）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "activity_id",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "活动id",
      "example": "3640367995802523837",
      "_depth": 0
    },
    {
      "name": "doudian_open_id",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "抖店open_id",
      "example": "1@#YOUR_SECRET_KEY",
      "_depth": 0
    },
    {
      "name": "page_no",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "从1开始，默认值1",
      "example": "1",
      "_depth": 0
    },
    {
      "name": "page_size",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "不能超过100，默认值100",
      "example": "10",
      "_depth": 0
    }
  ],
  "responseParams": [
    {
      "name": "activity_info_list",
      "type": "array",
      "description": "用户活动权益列表",
      "example": ""
    },
    {
      "name": "total_cnt",
      "type": "mixed",
      "description": "总条数",
      "example": "5"
    }
  ],
  "responseCodes": [
    {
      "code": "10000",
      "meaning": "success",
      "action": "正常处理"
    },
    {
      "code": "40004",
      "meaning": "非法的参数 / 参数错误（sub_code: isv.parameter-invalid:606010000）",
      "action": "请检查请求入参",
      "sub_code": "isv.parameter-invalid:606010000",
      "sub_msg": "参数错误"
    },
    {
      "code": "20000",
      "meaning": "系统错误 / 系统内部错误，请稍后重试（sub_code: isp.service-error:606000103）",
      "action": "系统内部错误，请稍后重试",
      "sub_code": "isp.service-error:606000103",
      "sub_msg": "系统内部错误，请稍后重试"
    }
  ],
  "examples": {
    "request": "curl -X GET 'https://openapi-fxg.jinritemai.YOUR_SECRET_KEY?app_key=your_appkey_here&method=mini.activity.queryUserRights&access_token=your_accesstoken_here&param_json={}&timestamp=2018-06-19%2016:06:59&v=2&sign=your_sign_here'",
    "responseSuccess": {
      "data": {
        "activity_info_list": [
          {
            "activity_id": "7279187821620381228",
            "rights_count": "10",
            "used_amount": "5"
          }
        ],
        "total_cnt": "5"
      },
      "code": 10000,
      "msg": "success",
      "sub_code": "",
      "sub_msg": ""
    },
    "responseError": {
      "code": 40004,
      "msg": "非法的参数",
      "sub_code": "isv.parameter-invalid:606010000",
      "sub_msg": "参数错误"
    }
  },
  "source": "https://op.jinritemai.com/docs/api-docs/1434/6039",
