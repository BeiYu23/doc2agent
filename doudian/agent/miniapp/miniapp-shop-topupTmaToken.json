  },
  "notes": [
    "文档书: 电商小程序（版本 V1.01）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "saler",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "主播ID",
      "example": "93922552059",
      "_depth": 0
    },
    {
      "name": "game_id",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "腾讯侧的游戏ID",
      "example": "yxzj",
      "_depth": 0
    },
    {
      "name": "offer_id",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "腾讯侧的offerID",
      "example": "1450224787",
      "_depth": 0
    },
    {
      "name": "tencent_env",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "腾讯LLToken获取接口的环境",
      "example": "dev、test、sandbox、release",
      "_depth": 0
    },
    {
      "name": "use_sdk",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "获取sdk拉端参数",
      "example": "true、false",
      "_depth": 0
    },
    {
      "name": "device_platform",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "设备平台，android、ios",
      "example": "android、ios、iphone",
      "_depth": 0
    },
    {
      "name": "app_id",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "标识请求来自抖音、极速版或其他端",
      "example": "1128、2329",
      "_depth": 0
    },
    {
      "name": "channel",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "标识客户端渠道，区分内测包与线上包",
      "example": "local_test",
      "_depth": 0
    }
  ],
