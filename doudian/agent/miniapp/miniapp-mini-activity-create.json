      "in": "body",
      "type": "string",
      "required": true,
      "description": "活动名称",
      "example": "新品专享价",
      "_depth": 0
    },
    {
      "name": "product_id",
      "in": "body",
      "type": "number",
      "required": true,
      "description": "活动商品id",
      "example": "3639483739320549069",
      "_depth": 0
    },
    {
      "name": "activity_start_time",
      "in": "body",
      "type": "number",
      "required": true,
      "description": "活动开始时间",
      "example": "1695015497",
      "_depth": 0
    },
    {
      "name": "activity_end_time",
      "in": "body",
      "type": "number",
      "required": true,
      "description": "活动结束时间",
      "example": "1695015497",
      "_depth": 0
    },
    {
      "name": "user_buy_limit",
      "in": "body",
      "type": "number",
      "required": false,
      "description": "用户限购数量",
      "example": "10",
      "_depth": 0
    },
    {
      "name": "online_directly",
      "in": "body",
      "type": "boolean",
      "required": false,
      "description": "是否直接上线活动",
      "example": "true",
      "_depth": 0
    }
  ],
  "responseParams": [
