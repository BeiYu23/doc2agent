{
  "id": "doudian.cross-border.crossBorder.customsTaxInfo",
  "cnName": "服务商回告海关税费",
  "docUrl": "/docs/doudian/cross-border/cross-border-crossBorder-customsTaxInfo",
  "name": "crossBorder.customsTaxInfo",
  "platform": "doudian",
  "group": "cross-border",
  "description": "服务商回告海关税费",
  "method": "GET",
  "path": "/crossBorder/customsTaxInfo",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 店铺"
  },
  "notes": [
    "文档书: 跨境API（版本 V3.02）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "vendor",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "字节给供应链服务商定义的编码",
      "example": "QS",
      "_depth": 0
    },
    {
      "name": "customs_code",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "回执口岸【口岸代码】",
      "example": "3516",
      "_depth": 0
    },
    {
      "name": "customs_name",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "回执口岸【口岸名称】",
      "example": "平潭海关",
      "_depth": 0
    },
    {
      "name": "customs_tax_data",
      "in": "body",
      "type": "object",
      "required": true,
      "description": "税费信息",
      "example": "",
      "_depth": 0
    },
    {
      "name": "order_id",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "字节电商平台的交易订单号",
      "example": "9920138805717562814",
      "_depth": 1
    },
    {
      "name": "invt_no",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "进口清单编号 (宁波 非必传)",
      "example": "951620221063608616",
      "_depth": 1
    },
    {
      "name": "tax_no",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "电子税单编号 (宁波 非必传)",
      "example": "951620221063608616_0",
      "_depth": 1
    },
    {
      "name": "ebc_name",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "电商企业名称 (宁波 必传)",
      "example": "宁波xxxx物流有限公司",
      "_depth": 1
    },
    {
      "name": "return_time",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "回执时间 秒时间戳",
      "example": "1652932109",
      "_depth": 1
    },
    {
      "name": "customs_tax",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "应征关税，例如2.16元传2.16",
      "example": "0.0",
      "_depth": 1
    },
    {
      "name": "value_added_tax",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "应征增值税，例如2.16元传2.16",
      "example": "2.16",
      "_depth": 1
    },
    {
      "name": "consumption_tax",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "应征消费税，例如2.16元传2.16",
      "example": "0.0",
      "_depth": 1
    },
    {
      "name": "status",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "(宁波 非必传) 海关税单状态  1-已生成，2-已汇总 3-作废",
      "example": "1",
      "_depth": 1
    },
    {
      "name": "tax_detail_list",
      "in": "body",
      "type": "array",
      "required": true,
      "description": "商品税费列表",
      "example": "",
      "_depth": 1
    },
    {
      "name": "gnum",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "商品项号",
      "example": "1",
      "_depth": 2
    },
    {
      "name": "gcode",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "海关商品编码 (宁波传HS编码)",
      "example": "1806900000",
      "_depth": 2
    },
    {
      "name": "tax_price",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "完税总价格，例如23.74元传23.74",
      "example": "23.74",
      "_depth": 2
    },
    {
      "name": "customs_tax",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "关税，例如2.16元传2.16",
      "example": "0.0",
      "_depth": 2
    },
    {
      "name": "value_added_tax",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "增值税，例如2.16元传2.16",
      "example": "2.16",
      "_depth": 2
    },
    {
      "name": "consumption_tax",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "消费税，例如2.16元传2.16",
      "example": "0.0",
      "_depth": 2
    }
  ],
  "responseParams": [
    {
      "name": "code",
      "type": "number",
      "description": "成功就是0",
      "example": "0"
    },
    {
      "name": "msg",
      "type": "string",
      "description": "响应msg",
      "example": "成功"
    }
  ],
