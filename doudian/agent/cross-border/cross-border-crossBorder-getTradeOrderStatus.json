{
  "id": "doudian.cross-border.crossBorder.getTradeOrderStatus",
  "platform": "doudian",
  "group": "cross-border",
  "name": "crossBorder.getTradeOrderStatus",
  "description": "获取交易订单状态",
  "method": "GET",
  "path": "/crossBorder/getTradeOrderStatus",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 店铺"
  },
  "notes": [
    "文档书: 跨境API（版本 V1.03）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "vendor",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "服务商编码",
      "example": "-",
      "_depth": 0
    },
    {
      "name": "order_id",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "订单id",
      "example": "4789899944007763859",
      "_depth": 0
    }
  ],
  "responseParams": [
    {
      "name": "order_status",
      "type": "number",
      "description": "订单状态",
      "example": "1"
    },
    {
      "name": "final_status",
      "type": "number",
      "description": "最终状态",
      "example": "1"
    }
  ],
  "responseCodes": [
    {
      "code": "10000",
      "meaning": "success",
      "action": "正常处理"
    },
    {
      "code": "50002",
      "meaning": "业务处理失败 / 订单号不存在（sub_code: isv.business-failed:1005）",
      "action": "订单号不存在",
      "sub_code": "isv.business-failed:1005",
      "sub_msg": "订单号不存在"
    },
    {
      "code": "50002",
      "meaning": "业务处理失败 / orderId值不能为空！（sub_code: isv.business-failed:1002）",
      "action": "校验参数",
      "sub_code": "isv.business-failed:1002",
      "sub_msg": "orderId值不能为空！"
    }
  ],
  "examples": {
    "request": "curl -X GET 'https://openapi-fxg.jinritemai.com/crossBorder/getTradeOrderStatus?app_key=your_appkey_here&method=crossBorder.getTradeOrderStatus&access_token=your_accesstoken_here&param_json={}&timestamp=2018-06-19%2016:06:59&v=2&sign=your_sign_here'",
    "responseSuccess": {
      "data": {
        "final_status": "1",
        "order_status": "1"
      },
      "code": 10000,
      "msg": "success",
      "sub_code": "",
      "sub_msg": ""
    },
    "responseError": {
      "code": 50002,
      "msg": "业务处理失败",
      "sub_code": "isv.business-failed:1005",
      "sub_msg": "订单号不存在"
    }
  },
  "source": "https://op.jinritemai.com/docs/api-docs/53/1650",
