{
  "id": "doudian.cross-border.dutyFree.orderList",
  "cnName": "商家拉单",
  "docUrl": "/docs/doudian/cross-border/cross-border-dutyFree-orderList",
  "name": "dutyFree.orderList",
  "platform": "doudian",
  "group": "cross-border",
  "description": "商家拉单",
  "method": "GET",
  "path": "/dutyFree/orderList",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 店铺"
  },
  "notes": [
    "文档书: 跨境API（版本 V3.02）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "start_time",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "开始时间",
      "example": "2018-06-03 00:00:00",
      "_depth": 0
    },
    {
      "name": "end_time",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "结束时间，必须大于等于开始时间",
      "example": "2018-06-03 00:00:00",
      "_depth": 0
    },
    {
      "name": "order_by",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "默认按订单（跨境履约单）创建时间搜索",
      "example": "create_time",
      "_depth": 0
    },
    {
      "name": "is_desc",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "订单排序方式：0按时间升序， 1按时间降序 默认为1",
      "example": "1",
      "_depth": 0
    },
    {
      "name": "order_list",
      "in": "body",
      "type": "array",
      "required": false,
      "description": "需要查询的订单id列表 如果该字段不为空（列表至少包含 1 个订单号），此时参数只有vendor有用，其他参数不起作用。批量查询数量不超过100。",
      "example": "['order_id1','order_id2']",
      "_depth": 0
    },
    {
      "name": "page",
      "in": "body",
      "type": "number",
      "required": false,
      "description": "页数（默认为1）",
      "example": "1",
      "_depth": 0
    },
    {
      "name": "size",
      "in": "body",
      "type": "number",
      "required": false,
      "description": "每页模板数（默认为10）",
      "example": "10",
      "_depth": 0
    }
  ],
  "responseParams": [
    {
      "name": "data",
      "type": "array",
      "description": "订单数据结构",
      "example": "-"
    },
    {
      "name": "has_next",
      "type": "boolean",
      "description": "是否还有下一页",
      "example": "true"
    },
    {
      "name": "total",
      "type": "number",
      "description": "总数",
      "example": "100"
    }
  ],
  "responseCodes": [
    {
      "code": "10000",
      "meaning": "success",
      "action": "正常处理"
    },
    {
      "code": "50002",
      "meaning": "业务处理失败 / 开始时间必须早于结束时间（sub_code: isv.business-failed:1002）",
      "action": "请检查开始时间、结束时间",
      "sub_code": "isv.business-failed:1002",
      "sub_msg": "开始时间必须早于结束时间"
    }
  ],
