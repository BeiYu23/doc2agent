    },
    {
      "name": "invoice_scene",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "开票场景(1:蓝票)",
      "example": "1",
      "_depth": 1
    },
    {
      "name": "manual_invoice_info",
      "in": "body",
      "type": "array",
      "required": true,
      "description": "发票列表(文件数量大于0小于等于3)",
      "example": "",
      "_depth": 1
    },
    {
      "name": "file_url",
      "in": "body",
      "type": "string",
      "required": true,
