{
  "id": "doudian.logistics-provider.logistics.verifyWaybillMobile",
  "platform": "doudian",
  "group": "logistics-provider",
  "name": "logistics.verifyWaybillMobile",
  "description": "验证运单收件人手机号与入参是否一致",
  "method": "GET",
  "path": "/logistics/verifyWaybillMobile",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 物流商"
  },
  "notes": [
    "文档书: 物流商API（版本 V1.01）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "waybill_code",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "运单号",
      "example": "7321234545",
      "_depth": 0
    },
    {
      "name": "express_company",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "快递公司",
      "example": "shunfeng",
      "_depth": 0
    },
    {
      "name": "mobile",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "手机号",
      "example": "xxxxx",
      "_depth": 0
    }
  ],
  "responseParams": [
    {
      "name": "is_same",
      "type": "boolean",
      "description": "手机号是否一致",
      "example": "true"
    }
  ],
  "responseCodes": [
    {
      "code": "10000",
      "meaning": "success",
      "action": "正常处理"
    },
    {
      "code": "40004",
      "meaning": "非法的参数 / -（sub_code: isv.parameter-invalid:10001）",
      "action": "-",
      "sub_code": "isv.parameter-invalid:10001",
      "sub_msg": "-"
    },
    {
      "code": "50002",
      "meaning": "业务处理失败 / -（sub_code: isv.business-failed:10003）",
      "action": "-",
      "sub_code": "isv.business-failed:10003",
      "sub_msg": "-"
    }
  ],
  "examples": {
    "request": "curl -X GET 'https://openapi-fxg.jinritemai.com/logistics/verifyWaybillMobile?app_key=your_appkey_here&method=logistics.verifyWaybillMobile&access_token=your_accesstoken_here&param_json={}&timestamp=2018-06-19%2016:06:59&v=2&sign=your_sign_here'",
    "responseSuccess": {
      "data": {
        "is_same": "true"
      },
      "code": 10000,
      "msg": "success",
      "sub_code": "",
      "sub_msg": ""
    },
    "responseError": {
      "code": 40004,
      "msg": "非法的参数",
      "sub_code": "isv.parameter-invalid:10001",
      "sub_msg": "-"
    }
  },
  "source": "https://op.jinritemai.com/docs/api-docs/1048/3514",
  "updatedAt": "2023-04-21",
  "_file_stem": "logistics-provider-logistics-verifyWaybillMobile",
  "cnName": "验证运单收件人手机号与入参是否一致"
}
