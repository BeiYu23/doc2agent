{
  "id": "doudian.logistics-provider.power.callBackSessionResult",
  "platform": "doudian",
  "group": "logistics-provider",
  "name": "power.callBackSessionResult",
  "description": "会话创建响应",
  "method": "GET",
  "path": "/power/callBackSessionResult",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 物流商"
  },
  "notes": [
    "文档书: 物流商API（版本 V1.01）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "sessionId",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "字节会话ID",
      "example": "111111122334",
      "_depth": 0
    },
    {
      "name": "bpSessionId",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "物流商会话ID",
      "example": "23444",
      "_depth": 0
    },
    {
      "name": "actionTime",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "操作时间",
      "example": "1677478601",
      "_depth": 0
    },
    {
      "name": "sessionType",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "会话状态：1已分配、2排队中、3分配异常",
      "example": "1",
      "_depth": 0
    },
    {
      "name": "dealerId",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "物流商客服ID，sessionType为1时为必填",
      "example": "1111",
      "_depth": 0
    },
    {
      "name": "exceptionCode",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "异常编码，sessionType为3时为必填",
      "example": "eee",
      "_depth": 0
    },
    {
      "name": "exceptionMsg",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "异常描述，sessionType为3时为必填",
      "example": "服务异常",
      "_depth": 0
    },
    {
      "name": "company",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "服务商编码",
      "example": "powertestexpress",
      "_depth": 0
    }
  ],
  "responseParams": [],
