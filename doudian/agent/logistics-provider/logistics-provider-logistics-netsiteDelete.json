{
  "id": "doudian.logistics-provider.logistics.netsiteDelete",
  "cnName": "网点信息停用",
  "docUrl": "/docs/doudian/logistics-provider/logistics-provider-logistics-netsiteDelete",
  "name": "logistics.netsiteDelete",
  "platform": "doudian",
  "group": "logistics-provider",
  "description": "网点信息停用",
  "method": "GET",
  "path": "/logistics/netsiteDelete",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 物流商"
  },
  "notes": [
    "文档书: 物流商API（版本 V1.01）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "net_codes",
      "in": "body",
      "type": "array",
      "required": true,
      "description": "网点编码列表",
      "example": "[\"123456\"]",
      "_depth": 0
    }
  ],
  "responseParams": [],
  "responseCodes": [
    {
      "code": "10000",
      "meaning": "success",
      "action": "正常处理"
    },
    {
      "code": "50002",
      "meaning": "业务处理失败 / 要删除的网点太多，每次最多允许100个（sub_code: isv.business-failed:4006）",
      "action": "修改参数网点大小，再调用",
      "sub_code": "isv.business-failed:4006",
      "sub_msg": "要删除的网点太多，每次最多允许100个"
    }
  ],
  "examples": {
    "request": "curl -X GET 'https://openapi-fxg.jinritemai.com/logistics/netsiteDelete?app_key=your_appkey_here&method=logistics.netsiteDelete&access_token=your_accesstoken_here&param_json={}&timestamp=2018-06-19%2016:06:59&v=2&sign=your_sign_here'",
    "responseSuccess": {
      "code": 10000,
      "msg": "success",
      "sub_code": "",
      "sub_msg": ""
    },
    "responseError": {
      "code": 50002,
      "msg": "业务处理失败",
      "sub_code": "isv.business-failed:4006",
      "sub_msg": "要删除的网点太多，每次最多允许100个"
    }
  },
