{
  "id": "doudian.logistics-provider.logistics.confirmEbillInfo",
  "platform": "doudian",
  "group": "logistics-provider",
  "name": "logistics.confirmEbillInfo",
  "description": "校验面单信息",
  "method": "GET",
  "path": "/logistics/confirmEbillInfo",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 物流商"
  },
  "notes": [
    "文档书: 物流商API（版本 V1.01）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "uid",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "物流商平台用户id",
      "example": "123aa",
      "_depth": 0
    },
    {
      "name": "scene",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "1、小程序用户查件 2、小程序用户预约派送 3、小程序用户改地址 4、客服进线查件 5、可补充新增",
      "example": "1",
      "_depth": 0
    },
    {
      "name": "company",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "快递公司",
      "example": "shunfeng",
      "_depth": 0
    },
    {
      "name": "waybill_code",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "运单号",
      "example": "SF3103018291111",
      "_depth": 0
    },
    {
      "name": "mobile",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "手机号后四位",
      "example": "1234",
      "_depth": 0
    }
  ],
  "responseParams": [
    {
      "name": "is_conform",
      "type": "boolean",
      "description": "是否一致",
      "example": "true"
    }
  ],
  "responseCodes": [
    {
      "code": "10000",
      "meaning": "success",
      "action": "正常处理"
    },
    {
      "code": "50002",
      "meaning": "业务处理失败 / 订单信息不存在（sub_code: isv.business-failed:10014）",
      "action": "检查运单号正确性",
      "sub_code": "isv.business-failed:10014",
      "sub_msg": "订单信息不存在"
    },
    {
      "code": "80000",
      "meaning": "风控拦截 / 风控拦截，查询频率较高或触发风险管控（sub_code: isv.risk-control-failed:15104）",
      "action": "稍后重试或联系客服",
      "sub_code": "isv.risk-control-failed:15104",
      "sub_msg": "风控拦截，查询频率较高或触发风险管控"
    },
    {
      "code": "40004",
      "meaning": "非法的参数 / 参数错误，必传参数为空或其他参数错误（sub_code: isv.parameter-invalid:4006）",
      "action": "检查必传参数",
      "sub_code": "isv.parameter-invalid:4006",
      "sub_msg": "参数错误，必传参数为空或其他参数错误"
    }
  ],
  "examples": {
    "request": "curl -X GET 'https://openapi-fxg.jinritemai.com/logistics/confirmEbillInfo?app_key=your_appkey_here&method=logistics.confirmEbillInfo&access_token=your_accesstoken_here&param_json={}&timestamp=2018-06-19%2016:06:59&v=2&sign=your_sign_here'",
    "responseSuccess": {
      "data": {
        "is_conform": "true"
      },
      "code": 10000,
      "msg": "success",
      "sub_code": "",
      "sub_msg": ""
    },
    "responseError": {
      "code": 50002,
      "msg": "业务处理失败",
      "sub_code": "isv.business-failed:10014",
      "sub_msg": "订单信息不存在"
    }
  },
  "source": "https://op.jinritemai.com/docs/api-docs/1048/6894",
  "updatedAt": "2024-09-23",
  "_file_stem": "logistics-provider-logistics-confirmEbillInfo",
  "cnName": "校验面单信息"
}
