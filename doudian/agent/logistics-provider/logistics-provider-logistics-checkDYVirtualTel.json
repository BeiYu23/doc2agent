{
  "id": "doudian.logistics-provider.logistics.checkDYVirtualTel",
  "platform": "doudian",
  "group": "logistics-provider",
  "name": "logistics.checkDYVirtualTel",
  "description": "查询虚拟号是否抖音平台",
  "method": "GET",
  "path": "/logistics/checkDYVirtualTel",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 物流商"
  },
  "notes": [
    "文档书: 物流商API（版本 V1.01）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "system_source",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "系统来源，根据物流公司内部系统的代号传值，比如CRM系统，网点操作系统、小件员APP等，区分系统唯一性",
      "example": "xx系统",
      "_depth": 0
    },
    {
      "name": "virtual_tel_number",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "虚拟号",
      "example": "700001010100",
      "_depth": 0
    },
    {
      "name": "extra",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "扩展信息",
      "example": "{}",
      "_depth": 0
    },
    {
      "name": "user_type",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "请求用户类型，1-系统；2-业务员（快递员）；3-客服；4-总部业务人员；5-网点业务人员",
      "example": "1",
      "_depth": 0
    },
    {
      "name": "net_code",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "查询用户的所属机构编码",
      "example": "1234",
      "_depth": 0
    },
    {
      "name": "net_name",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "查询用户的所属机构名称",
      "example": "1234",
      "_depth": 0
    },
    {
      "name": "user_id",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "若userType≠1时，则必须传入具体用户的系统ID，可以结合systemSource中的系统的用户ID",
      "example": "1234",
      "_depth": 0
    }
  ],
  "responseParams": [
    {
      "name": "is_dy_virtual_tel",
      "type": "mixed",
      "description": "是否抖音电商虚拟号 1 是抖音电商虚拟号，0-不是",
      "example": "1"
    },
    {
      "name": "is_active",
      "type": "mixed",
      "description": "当前虚拟号是否生效中 1 生效中，0 已过期",
      "example": "1"
    },
    {
      "name": "request_id",
      "type": "string",
      "description": "唯一id，用于区分每次请求",
      "example": "2024321321321321"
    },
    {
      "name": "code",
      "type": "mixed",
      "description": "0表示成功",
      "example": "0"
    },
    {
      "name": "message",
      "type": "string",
      "description": "成功是\"\"，失败包含失败原因",
      "example": "\"\""
    }
  ],
  "responseCodes": [
    {
      "code": "10000",
      "meaning": "成功",
      "action": "正常处理"
    }
  ],
  "examples": {
    "request": "curl -X GET 'https://openapi-fxg.jinritemai.com/logistics/checkDYVirtualTel?app_key=your_appkey_here&method=logistics.checkDYVirtualTel&access_token=your_accesstoken_here&param_json={}&timestamp=2018-06-19%2016:06:59&v=2&sign=your_sign_here'",
    "responseSuccess": {
      "data": {
        "code": "0",
        "is_active": "1",
        "is_dy_virtual_tel": "1",
        "message": "\"\"",
        "request_id": "2024321321321321"
      },
      "code": 10000,
      "msg": "success",
      "sub_code": "",
      "sub_msg": ""
    },
    "responseError": {
      "sub_code": "",
      "sub_msg": ""
    }
  },
  "source": "https://op.jinritemai.com/docs/api-docs/1048/8157",
  "updatedAt": "2026-03-23",
  "_file_stem": "logistics-provider-logistics-checkDYVirtualTel"
}
