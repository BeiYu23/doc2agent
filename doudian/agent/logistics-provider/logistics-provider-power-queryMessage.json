{
  "id": "doudian.logistics-provider.power.queryMessage",
  "platform": "doudian",
  "group": "logistics-provider",
  "name": "power.queryMessage",
  "description": "消息查询",
  "method": "GET",
  "path": "/power/queryMessage",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 物流商"
  },
  "notes": [
    "文档书: 物流商API（版本 V1.01）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "sessionId",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "字节会话ID",
      "example": "11111",
      "_depth": 0
    },
    {
      "name": "company",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "服务商编码",
      "example": "powertestexpress",
      "_depth": 0
    }
  ],
  "responseParams": [
    {
      "name": "messageInfos",
      "type": "array",
      "description": "聊天记录信息",
      "example": ""
    }
  ],
  "responseCodes": [
    {
      "code": "10000",
      "meaning": "success",
      "action": "正常处理"
    },
    {
      "code": "50002",
      "meaning": "业务处理失败 / 参数错误（sub_code: isv.business-failed:10000）",
      "action": "必填项校验失败或未按文档要求传参数",
      "sub_code": "isv.business-failed:10000",
      "sub_msg": "参数错误"
    },
    {
      "code": "50002",
      "meaning": "业务处理失败 / 系统异常（sub_code: isv.business-failed:10002）",
      "action": "服务内部异常",
      "sub_code": "isv.business-failed:10002",
      "sub_msg": "系统异常"
    },
    {
      "code": "50002",
      "meaning": "业务处理失败 / 会话id不存在（sub_code: isv.business-failed:10003）",
      "action": "sessionId不存在",
      "sub_code": "isv.business-failed:10003",
      "sub_msg": "会话id不存在"
    }
  ],
  "examples": {
    "request": "curl -X GET 'https://openapi-fxg.jinritemai.com/power/queryMessage?app_key=your_appkey_here&method=power.queryMessage&access_token=your_accesstoken_here&param_json={}&timestamp=2018-06-19%2016:06:59&v=2&sign=your_sign_here'",
    "responseSuccess": {
      "data": {
        "messageInfos": [
          {
            "fromType": "0",
            "id": "7028553773102499884",
            "messageType": "1",
            "msgTime": "1636462854",
            "text": "\"\""
          }
        ]
      },
      "code": 10000,
      "msg": "success",
      "sub_code": "",
      "sub_msg": ""
    },
    "responseError": {
      "code": 50002,
      "msg": "业务处理失败",
      "sub_code": "isv.business-failed:10000",
      "sub_msg": "参数错误"
    }
  },
  "source": "https://op.jinritemai.com/docs/api-docs/1048/2992",
  "updatedAt": "2023-02-27",
  "_file_stem": "logistics-provider-power-queryMessage"
}
