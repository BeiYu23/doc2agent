{
  "id": "doudian.logistics-provider.logistics.verifyDeliveryCode",
  "platform": "doudian",
  "group": "logistics-provider",
  "name": "logistics.verifyDeliveryCode",
  "description": "核销寄件码",
  "method": "GET",
  "path": "/logistics/verifyDeliveryCode",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 物流商"
  },
  "notes": [
    "文档书: 物流商API（版本 V2.01）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "bizType",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "业务类型；\n枚举：COURIER_STATION--驿站寄件",
      "example": "COURIER_STATION",
      "_depth": 0
    },
    {
      "name": "orderId",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "订单号",
      "example": "LFO12345678904567",
      "_depth": 0
    },
    {
      "name": "deliveryCode",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "寄件码",
      "example": "6472",
      "_depth": 0
    },
    {
      "name": "operationTime",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "操作时间（格式：yyyy-MM-dd HH:mm:ss，24小时制）",
      "example": "2021-01-19 15:12:23",
      "_depth": 0
    },
    {
      "name": "partnerCode",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "服务商编码",
      "example": "yuantong",
      "_depth": 0
    },
    {
      "name": "postCode",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "驿站编码",
      "example": "xx",
      "_depth": 0
    },
    {
      "name": "postName",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "驿站名称",
      "example": "xxx",
      "_depth": 0
    },
    {
      "name": "brandCode",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "品牌编码",
      "example": "mamayizhan",
      "_depth": 0
    },
    {
      "name": "latitude",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "核销现场纬度，GCJ-02，6 位小数，与 longitude 成对可选",
      "example": "30.123456",
      "_depth": 0
    },
    {
      "name": "longitude",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "核销现场经度，GCJ-02，6 位小数，与 latitude 成对可选",
      "example": "120.123456",
      "_depth": 0
    }
  ],
  "responseParams": [
