{
  "id": "doudian.coupon.coupons.syncV2",
  "platform": "doudian",
  "group": "coupon",
  "name": "coupons.syncV2",
  "description": "卡券同步",
  "method": "GET",
  "path": "/coupons/syncV2",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 店铺"
  },
  "notes": [
    "文档书: 卡券API（版本 V4.01）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "order_id",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "子订单id",
      "example": "123421345",
      "_depth": 0
    },
    {
      "name": "sku_id",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "skuid",
      "example": "1",
      "_depth": 0
    },
    {
      "name": "cert_list",
      "in": "body",
      "type": "array",
      "required": true,
      "description": "卡券信息列表",
      "example": "",
      "_depth": 0
    },
    {
      "name": "valid_start",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "有效开始时间，大闸蟹场景必传",
      "example": "2010-01-01 12:12:12",
      "_depth": 1
    },
    {
      "name": "out_cert_id",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "外部卡券id",
      "example": "666",
      "_depth": 1
    },
    {
      "name": "status",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "状态：1未激活 2未使用",
      "example": "1",
      "_depth": 1
    },
    {
      "name": "valid_end",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "有效结束时间，大闸蟹场景必传",
      "example": "2010-01-01 12:12:12",
      "_depth": 1
    },
    {
      "name": "url_type",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "卡券跳转链接类型，2为小程序",
      "example": "0/2",
      "_depth": 1
    },
    {
      "name": "cert_link",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "卡券跳转链接，长度限制255",
      "example": "https://obd.gtimg.com/new-benefit-web-schema/dev/dist/index.html?ShortLinkId=6438f6f4a87f2&e=test&dyp=1&c=cafsdadsfas",
      "_depth": 1
    },
    {
      "name": "grant_time",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "发券时间",
      "example": "2010-01-01 12:12:12",
      "_depth": 1
    },
    {
      "name": "cert_key",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "卡密（三方卡券订单无需回传），长度限制64",
      "example": "1",
      "_depth": 1
    },
    {
      "name": "cert_no",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "卡券券码，长度限制64，请勿传中文字符",
      "example": "7136xxxasd",
      "_depth": 1
    },
    {
      "name": "can_extend_valid_count",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "可延期次数",
      "example": "1",
      "_depth": 1
    }
  ],
