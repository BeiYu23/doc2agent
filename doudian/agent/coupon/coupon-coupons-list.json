  "description": "平台卡券和三方卡券的status枚举不一样。平台卡券状态码status的枚举是1:未使用，2:已使用，3：已失效，查询时需入参cert_type=1；\n商家(三方)卡券状态码status的枚举是1 //未激活（表示初始状态）； 2 //未使用； 3 //已",
  "method": "GET",
  "path": "/coupons/list",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 店铺"
  },
  "notes": [
    "文档书: 卡券API（版本 V1.03）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "order_id",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "子订单id",
      "example": "123",
      "_depth": 0
    },
    {
      "name": "cert_no",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "卡号券码",
      "example": "卡券id",
      "_depth": 0
    },
    {
      "name": "cert_type",
      "in": "body",
      "type": "number",
      "required": false,
      "description": "卡券类型（0-三方卡券；1-平台卡券）",
      "example": "0",
      "_depth": 0
    }
  ],
  "responseParams": [
    {
      "name": "data",
      "type": "string",
      "description": "列表",
      "example": ""
    }
  ],
