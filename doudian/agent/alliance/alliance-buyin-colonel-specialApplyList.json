  },
  "notes": [
    "文档书: 精选联盟API（版本 V4.01）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "activity_id",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "活动 id(不传表示查机构下所有活动)",
      "example": "33241",
      "_depth": 0
    },
    {
      "name": "search_type",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "查询类型（0：待处理，1：历史记录，不传默认是待处理）",
      "example": "0",
      "_depth": 0
    },
    {
      "name": "page",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "页数（从 1 开始，不传默认为 1）",
      "example": "1",
      "_depth": 0
    },
    {
      "name": "size",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "每页条数（不传默认为 10，最大为200）",
      "example": "20",
      "_depth": 0
    },
    {
      "name": "sort_field",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "0或不填：以申请时间排序\n1：以审核时间排序",
      "example": "0,1",
      "_depth": 0
    },
    {
      "name": "sort_direction",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "0或不填：降序\n1：增序",
      "example": "0,1",
      "_depth": 0
    }
  ],
  "responseParams": [
    {
      "name": "special_apply_list",
      "type": "array",
      "description": "特殊申请列表",
      "example": ""
    },
    {
      "name": "total",
      "type": "mixed",
      "description": "总申请数",
      "example": "100"
    }
  ],
