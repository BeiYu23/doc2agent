  "params": [
    {
      "name": "page",
      "in": "body",
      "type": "mixed",
      "required": true,
      "description": "分页页数，从1开始",
      "example": "1",
      "_depth": 0
    },
    {
      "name": "size",
      "in": "body",
      "type": "mixed",
      "required": true,
      "description": "分页大小，最大20",
      "example": "20",
      "_depth": 0
    },
    {
      "name": "product_ids",
      "in": "body",
      "type": "array",
      "required": false,
      "description": "商品ID列表，用“,”分隔",
      "example": "35632345453243,34242532432",
      "_depth": 0
    },
    {
      "name": "status",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "商品状态。2：商品在架；3：商家关闭推广；4：商品下架；6：平台治理关闭；99：商家删除",
      "example": "2",
      "_depth": 0
    },
    {
      "name": "title",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "商品名称",
      "example": "测试商品的名称",
      "_depth": 0
    },
    {
      "name": "in_stock",
      "in": "body",
      "type": "boolean",
      "required": false,
      "description": "是否有库存",
      "example": "true",
      "_depth": 0
    },
    {
      "name": "check_status",
      "in": "body",
      "type": "array",
      "required": false,
      "description": "审核状态。 0：未审核；2：审核未通过；3：审核通过",
      "example": "3",
      "_depth": 0
    },
    {
      "name": "sort_by",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "排序字段。 update_time: 更新时间; cos_ratio: 佣金率",
      "example": "update_time",
      "_depth": 0
    },
    {
      "name": "sort_order",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "排序方式（Desc或者Asc）。Desc：降序；Asc：生序",
      "example": "Desc",
      "_depth": 0
    },
    {
      "name": "fields",
      "in": "body",
      "type": "array",
      "required": false,
      "description": "加载更多的字段，如 is_exclusive",
      "example": "[\"is_exclusive\"]",
      "_depth": 0
    },
    {
      "name": "launch",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "0或者不填：原联盟计划商品 1：查询新投放商品",
      "example": "1",
      "_depth": 0
    }
  ],
  "responseParams": [
    {
      "name": "total",
      "type": "mixed",
      "description": "总数，最大10000",
      "example": "200"
    },
    {
      "name": "product_list",
      "type": "array",
      "description": "商品列表",
      "example": ""
    }
