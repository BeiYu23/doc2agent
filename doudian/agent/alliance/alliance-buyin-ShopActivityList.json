{
  "id": "doudian.alliance.buyin.ShopActivityList",
  "cnName": "接口用于商家获取可参与的团长活动",
  "docUrl": "/docs/doudian/alliance/alliance-buyin-ShopActivityList",
  "name": "buyin.ShopActivityList",
  "platform": "doudian",
  "group": "alliance",
  "description": "接口用于商家获取可参与的团长活动，支持报名状态筛选，包括已提报和未提报两种状态",
  "method": "GET",
  "path": "/buyin/ShopActivityList",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 店铺"
  },
  "notes": [
    "文档书: 精选联盟API（版本 V3.08）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "apply_status",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "1、我报名的活动 2、可以报名的活动",
      "example": "1",
      "_depth": 0
    },
    {
      "name": "page",
      "in": "body",
      "type": "number",
      "required": false,
      "description": "页码，从1开始。分页模式下生效，超过10000条会被限制，推荐使用游标模式 retrieve_mode=1",
      "example": "1",
      "_depth": 0
    },
    {
      "name": "page_size",
      "in": "body",
      "type": "number",
      "required": false,
      "description": "每页条数",
      "example": "20",
      "_depth": 0
    },
    {
      "name": "commission_rate_min",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "最低佣金率（5%,传5）",
      "example": "5",
      "_depth": 0
    },
    {
      "name": "commission_rate_max",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "最高佣金率（5%,传5）",
      "example": "5",
      "_depth": 0
    },
    {
      "name": "service_rate_min",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "最低服务费率（5%,传5）",
      "example": "5",
      "_depth": 0
    },
    {
      "name": "service_rate_max",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "最高服务费率（5%,传5）",
      "example": "5",
      "_depth": 0
    },
    {
      "name": "product_category_id",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "类目ID",
      "example": "1",
      "_depth": 0
    },
    {
      "name": "inst_acti_name",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "团长名称或活动名称-模糊搜索",
      "example": "一个团长",
      "_depth": 0
    },
    {
      "name": "retrieve_mode",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "获取模式。0: 分页模式（默认），最多返回10000条数据；1: 游标模式（推荐），返回条数无限制",
      "example": "1",
      "_depth": 0
    },
    {
      "name": "cursor",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "游标。首页不需要传，请求下一页时需传入上一次请求响应的next_cursor值",
      "example": "/ep2kokeo21me..lfkeokfok3o",
      "_depth": 0
    },
    {
      "name": "colonel_buyin_id",
      "in": "body",
      "type": "number",
      "required": false,
      "description": "团长百应ID",
      "example": "4739745019873796",
      "_depth": 0
    },
    {
      "name": "ad_commission_rate_min",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "佣金率min（5%,传5）",
      "example": "5",
      "_depth": 0
    },
    {
      "name": "ad_service_rate_min",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "服务费率min（5%,传5）",
      "example": "5",
      "_depth": 0
    },
    {
      "name": "cos_limit_type",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "佣金限制类型，可不指定，1:不限制 2:仅双佣金 3:仅固定佣金",
      "example": "1",
      "_depth": 0
    },
    {
      "name": "ad_service_rate_max",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "服务费率max（5%,传5）",
      "example": "5",
      "_depth": 0
    },
    {
      "name": "ad_commission_rate_max",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "佣金率max（5%,传5）",
      "example": "5",
      "_depth": 0
    }
  ],
  "responseParams": [
    {
      "name": "data",
      "type": "array",
      "description": "数据",
      "example": ""
    },
    {
      "name": "total",
      "type": "number",
      "description": "数据总数，游标模式下不返回",
      "example": "100"
    },
    {
      "name": "next_cursor",
      "type": "string",
      "description": "下一页游标。游标模式下返回，最后一页返回空",
      "example": "oiofw00902j43njl..232/232"
    }
  ],
  "responseCodes": [
    {
      "code": "10000",
      "meaning": "success",
      "action": "正常处理"
    },
