  "method": "GET",
  "path": "/buyin/updateSampleConfs",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 店铺"
  },
  "notes": [
    "文档书: 精选联盟API（版本 V1.01）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "product_sample_configs",
      "in": "body",
      "type": "array",
      "required": true,
      "description": "达人买样返款设置",
      "example": "",
      "_depth": 0
    },
    {
      "name": "product_id",
      "in": "body",
      "type": "mixed",
      "required": true,
      "description": "商品 id",
      "example": "34312324232145",
      "_depth": 1
    },
    {
      "name": "buy_style",
      "in": "body",
      "type": "mixed",
      "required": true,
      "description": "商品是否支持达人买样返款；1-支持达人买样返款，2-不支持达人买样返款。除特殊类目（虚拟充值、奢侈品、汽车整车、二手类目）外其他所有商品需填 1，特殊类目商品可自主选择是否支持达人买样返款",
      "example": "1",
      "_depth": 1
    },
    {
      "name": "buy_volume_limit",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "达人买样返款订单量门槛，值需在3-10000范围内。达人带货结算订单量≥所设订单量，返还达人买样全款；如果不支持达人买样返款此字段无意义",
      "example": "5",
      "_depth": 1
    }
  ],
  "responseParams": [
    {
      "name": "failed_reason",
      "type": "string",
      "description": "部分处理失败的商品id和对应原因",
      "example": "null"
