{
  "id": "doudian.alliance.alliance.colonelActivityProduct",
  "platform": "doudian",
  "group": "alliance",
  "name": "alliance.colonelActivityProduct",
  "description": "活动商品查询接口",
  "method": "GET",
  "path": "/alliance/colonelActivityProduct",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 机构, 团长"
  },
  "notes": [
    "文档书: 精选联盟API（版本 V10.01）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "activity_id",
      "in": "body",
      "type": "mixed",
      "required": true,
      "description": "活动ID",
      "example": "11111",
      "_depth": 0
    },
    {
      "name": "search_type",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "召回结果排序条件，[推荐按更新时间倒序查]。0：报名时间；1：活动价格排序；2：活动佣金比例排序；4：更新时间排序",
      "example": "4",
      "_depth": 0
    },
    {
      "name": "sort_type",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "排序顺序。0：升序；1：降序",
      "example": "0",
      "_depth": 0
    },
    {
      "name": "page",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "页码，从1开始。分页模式下生效，超过10000条会被限制，推荐使用游标模式 retrieve_mode=1",
      "example": "1",
      "_depth": 0
    },
    {
      "name": "count",
      "in": "body",
      "type": "mixed",
      "required": true,
      "description": "每页数量（每页最多20）",
      "example": "20",
      "_depth": 0
    },
    {
      "name": "cooperation_info",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "商家ID or 商家名称 or 一级团长名称 or 一级团长ID",
      "example": "23412312",
      "_depth": 0
    },
    {
      "name": "cooperation_type",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "合作类型. 0: 不限; 1: 商家; 2: 团长",
      "example": "0",
      "_depth": 0
    },
    {
      "name": "product_info",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "商品ID/名称（支持根据商品id或者商品名称搜索，商品ID精准匹配，商品名称模糊匹配）",
      "example": "一个商品",
      "_depth": 0
    },
    {
      "name": "status",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "活动商品状态，不传查所有状态。0：待审核；1：推广中；2：申请未通过；3：合作已终止；6：合作已到期",
      "example": "0",
      "_depth": 0
    },
    {
      "name": "retrieve_mode",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "获取模式。0: 分页模式（默认），最多返回10000条数据；1: 游标模式（推荐），返回条数无限制",
      "example": "1",
      "_depth": 0
    },
    {
      "name": "cursor",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "游标。首页不需要传，请求下一页时需传入上一次请求响应的next_cursor值",
      "example": "cefe2r3r2332dcd2/ddf32",
      "_depth": 0
    }
  ],
  "responseParams": [
    {
      "name": "data",
      "type": "array",
      "description": "活动商品列表",
      "example": ""
    },
    {
      "name": "total",
      "type": "mixed",
      "description": "活动商品条数，游标模式下不返回",
      "example": "10"
    },
    {
      "name": "institution_id",
      "type": "mixed",
      "description": "机构id",
      "example": "111111"
    },
    {
      "name": "next_cursor",
      "type": "string",
      "description": "下一页游标。游标模式下返回，最后一页返回空",
      "example": "ee2k23i492njwtio5j435ij34n5n34"
    }
  ],
  "responseCodes": [
    {
      "code": "10000",
      "meaning": "success",
      "action": "正常处理"
    },
    {
      "code": "50002",
      "meaning": "业务处理失败 / 参数校验失败（sub_code: isv.business-failed:257）",
      "action": "参数校验失败",
      "sub_code": "isv.business-failed:257",
      "sub_msg": "参数校验失败"
    },
    {
