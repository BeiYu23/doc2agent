    {
      "code": "50002",
      "meaning": "业务处理失败 / 不允许继续翻页，请使用游标模式加载更多数据（sub_code: isv.business-failed:8197）",
      "action": "请使用游标模式加载更多数据，详情：https://op.jinritemai.com/docs/notice-docs/5/3237",
      "sub_code": "isv.business-failed:8197",
      "sub_msg": "不允许继续翻页，请使用游标模式加载更多数据"
    },
    {
      "code": "50002",
      "meaning": "业务处理失败 / 4200:账号状态异常，请检查账号状态（sub_code: isv.business-failed:4200）",
      "action": "4200:账号状态异常，请检查账号状态",
      "sub_code": "isv.business-failed:4200",
      "sub_msg": "4200:账号状态异常，请检查账号状态"
    }
  ],
