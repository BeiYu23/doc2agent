  "name": "buyin.kolMaterialsProductsSearch",
  "platform": "doudian",
  "group": "alliance",
  "description": "检索精选联盟商品，需达人/抖客授权",
  "method": "GET",
  "path": "/buyin/kolMaterialsProductsSearch",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 达人, 抖客, MCN机构, 团长"
  },
  "notes": [
    "文档书: 精选联盟API（版本 V2.01）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "title",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "商品标题，返回标题中包含某个关键词的商品",
      "example": "测试商品名称",
      "_depth": 0
    },
    {
      "name": "first_cids",
      "in": "body",
      "type": "array",
      "required": false,
      "description": "筛选商品一级类目",
      "example": "[1,2,3,4]",
      "_depth": 0
    },
    {
      "name": "second_cids",
      "in": "body",
      "type": "array",
      "required": false,
      "description": "筛选商品二级类目",
      "example": "[22]",
      "_depth": 0
    },
    {
      "name": "third_cids",
      "in": "body",
      "type": "array",
      "required": false,
      "description": "筛选商品三级类目",
      "example": "[333]",
      "_depth": 0
    },
    {
      "name": "price_min",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "筛选价格区间-最小值（单位为分）",
      "example": "1",
      "_depth": 0
    },
    {
      "name": "price_max",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "筛选价格区间-最大值（单位为分）",
      "example": "1000",
      "_depth": 0
    },
    {
      "name": "sell_num_min",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "筛选历史销量区间-最小值",
      "example": "0",
      "_depth": 0
    },
    {
      "name": "sell_num_max",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "筛选历史销量区间-最大值",
      "example": "1000",
      "_depth": 0
    },
    {
      "name": "search_type",
      "in": "body",
      "type": "mixed",
      "required": true,
      "description": "召回结果排序条件，0默认排序1历史销量排序2价格排序3佣金金额排序4佣金比例排序；",
      "example": "0",
      "_depth": 0
    },
    {
      "name": "sort_type",
      "in": "body",
      "type": "mixed",
      "required": true,
      "description": "排序顺序（0升序1降序）",
      "example": "0",
      "_depth": 0
    },
    {
      "name": "cos_fee_min",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "筛选普通佣金区间-最小值（单位为分）",
      "example": "1",
      "_depth": 0
    },
    {
      "name": "cos_fee_max",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "筛选普通佣金区间-最大值（单位为分）",
      "example": "50",
      "_depth": 0
    },
    {
      "name": "cos_ratio_min",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "筛选普通佣金率区间-最小值 （乘100，例如1.1%为110）",
      "example": "1",
      "_depth": 0
    },
    {
      "name": "cos_ratio_max",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "筛选普通佣金率区间-最大值（乘100，例如1.1%为110）",
      "example": "15",
      "_depth": 0
    },
    {
      "name": "page",
      "in": "body",
      "type": "mixed",
      "required": true,
      "description": "分页（从1开始）",
      "example": "1",
      "_depth": 0
    },
    {
      "name": "page_size",
      "in": "body",
      "type": "mixed",
      "required": true,
      "description": "每页的数量（小于等于20）",
      "example": "10",
      "_depth": 0
    },
    {
      "name": "share_status",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "获取商品分销状态。1: 仅返回可分销商品；0:返回全量商品",
      "example": "1",
      "_depth": 0
    },
    {
      "name": "activity_id",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "【废弃】推荐使用tag字段。",
      "example": "1",
      "_depth": 0
    },
    {
      "name": "tag",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "商品标签。 0:返回全量商品; 1:返回超值购商品; 2:返回抖音超市(次日达)商品",
      "example": "1",
      "_depth": 0
    }
  ],
  "responseParams": [
    {
      "name": "total",
      "type": "mixed",
      "description": "商品总数",
      "example": "1000"
    },
    {
      "name": "products",
