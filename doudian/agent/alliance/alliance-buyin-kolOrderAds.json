{
  "id": "doudian.alliance.buyin.kolOrderAds",
  "platform": "doudian",
  "group": "alliance",
  "name": "buyin.kolOrderAds",
  "description": "查询达人的直播间分销、商品分销、活动页分销订单",
  "method": "GET",
  "path": "/buyin/kolOrderAds",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 达人"
  },
  "notes": [
    "文档书: 精选联盟API（版本 SNAPSHOT）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "size",
      "in": "body",
      "type": "number",
      "required": false,
      "description": "每页订单数目，取值区间： [1, 20]",
      "example": "20",
      "_depth": 0
    },
    {
      "name": "cursor",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "下一页索引（第一页传“0”）",
      "example": "0",
      "_depth": 0
    },
    {
      "name": "start_time",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "支付时间开始，最早支持2021年10月01日",
      "example": "2006-01-02 15:04:05",
      "_depth": 0
    },
    {
      "name": "end_time",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "支付时间结束，该时间不能超过start_time+90",
      "example": "2006-01-02 15:04:05",
      "_depth": 0
    },
    {
      "name": "order_ids",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "订单号。多个订单号用英文 , 分隔，最多支持10个订单号",
      "example": "4737996432465788974,4737996432465780075",
      "_depth": 0
    },
    {
      "name": "pid",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "PID",
      "example": "dy_1234_4567_789",
      "_depth": 0
    },
    {
      "name": "distribution_type",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "Live-直播间，ProductDetail-商品详情，Activity-活动（百亿补贴/秒杀）Mix-H5自建活动页",
      "example": "Live",
      "_depth": 0
    },
    {
      "name": "open_id",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "用户抖店open_id",
      "example": "dsrr34fd43fe",
      "_depth": 0
    },
    {
      "name": "time_type",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "查询时间类型。pay: 支付时间（默认）; update：联盟侧更新时间，非订单状态更新时间",
      "example": "update",
      "_depth": 0
    },
    {
      "name": "query_order_type",
      "in": "body",
      "type": "number",
      "required": false,
      "description": "不填或者填0：查询分销订单，1：查询比价订单",
      "example": "0",
      "_depth": 0
    }
  ],
  "responseParams": [
    {
      "name": "data",
      "type": "object",
      "description": "结果",
      "example": ""
    }
  ],
