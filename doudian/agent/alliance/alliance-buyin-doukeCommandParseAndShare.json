  "name": "buyin.doukeCommandParseAndShare",
  "platform": "doudian",
  "group": "alliance",
  "description": "口令解析&转链",
  "method": "GET",
  "path": "/buyin/doukeCommandParseAndShare",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 抖客"
  },
  "notes": [
    "文档书: 精选联盟API（版本 V2.01）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "command",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "抖口令或短链",
      "example": "3.:/ hO长[抱拳]按????墆此条消息，搭[呲牙]揩ƿȎƲ[拥抱]ȳɫǹ搜索，查看商品详情ηηcuTRuYrzTv8Я\\t##cuTRuYrzTv8##",
      "_depth": 0
    },
    {
      "name": "share_params",
      "in": "body",
      "type": "object",
      "required": false,
      "description": "转链参数，无需转链可不传",
      "example": "",
      "_depth": 0
    },
    {
      "name": "pid",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "抖客PID",
      "example": "dy_123_233_2222",
      "_depth": 1
    },
    {
      "name": "external_info",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "自定义字段，只允许 数字、字母和_，限制长度为40",
      "example": "111_222",
      "_depth": 1
    },
    {
      "name": "need_share_info_field",
      "in": "body",
      "type": "object",
      "required": false,
      "description": "所需的转链分享物料，默认仅返回deeplink（建议按需获取，获取多种会导致响应耗时增加）",
      "example": "",
      "_depth": 1
    },
    {
      "name": "need_share_command",
      "in": "body",
      "type": "boolean",
      "required": false,
      "description": "是否需要口令",
      "example": "false",
      "_depth": 2
    },
    {
      "name": "need_qrcode",
      "in": "body",
      "type": "boolean",
      "required": false,
      "description": "是否需要二维码",
      "example": "false",
      "_depth": 2
    },
    {
      "name": "need_zlink",
      "in": "body",
      "type": "boolean",
      "required": false,
      "description": "是否需要zlink",
      "example": "false",
      "_depth": 2
    },
    {
      "name": "need_share_link",
      "in": "body",
      "type": "boolean",
      "required": false,
      "description": "是否需要站外H5链接（仅商品生效）",
      "example": "false",
      "_depth": 2
    },
    {
      "name": "platform",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "回流端标识 0：抖音 1：抖音极速版",
      "example": "0",
      "_depth": 1
    }
  ],
  "responseParams": [
