{
  "id": "doudian.alliance.buyin.institutePidCreate",
  "platform": "doudian",
  "group": "alliance",
  "name": "buyin.institutePidCreate",
  "description": "抖客PID创建",
  "method": "GET",
  "path": "/buyin/institutePidCreate",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 机构, 抖客"
  },
  "notes": [
    "文档书: 精选联盟API（版本 V2.01）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "media_type",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "推广媒体类型，0:其他, 1:微信, 2:QQ, 3:微博, 4:抖音, 5:头条",
      "example": "1",
      "_depth": 0
    },
    {
      "name": "media_name",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "渠道名称，没有media_id时自动创建渠道；存在media_id时无效",
      "example": "微信1群",
      "_depth": 0
    },
    {
      "name": "media_id",
      "in": "body",
      "type": "number",
      "required": false,
      "description": "渠道ID，和media_name二选一",
      "example": "222",
      "_depth": 0
    },
    {
      "name": "site_name",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "推广位名称(最长10个字符)",
      "example": "张三",
      "_depth": 0
    }
  ],
  "responseParams": [
    {
      "name": "pid",
      "type": "string",
      "description": "机构PID",
      "example": "dy_xxx_xxx_xxx"
    }
  ],
