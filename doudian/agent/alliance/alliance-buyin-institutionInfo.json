{
  "id": "doudian.alliance.buyin.institutionInfo",
  "platform": "doudian",
  "group": "alliance",
  "name": "buyin.institutionInfo",
  "description": "获取机构信息",
  "method": "GET",
  "path": "/buyin/institutionInfo",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 机构, MCN机构, 抖客, 团长"
  },
  "notes": [
    "文档书: 精选联盟API（版本 V1.01）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [],
  "responseParams": [
    {
      "name": "institution_id",
      "type": "number",
      "description": "机构ID",
      "example": "38989329849343243"
    },
    {
      "name": "colonel",
      "type": "object",
      "description": "团长信息",
      "example": ""
    },
    {
      "name": "mcn",
      "type": "object",
      "description": "MCN信息",
      "example": ""
    },
    {
      "name": "douke",
      "type": "object",
      "description": "抖客信息",
      "example": ""
    }
  ],
  "responseCodes": [
    {
      "code": "10000",
      "meaning": "success",
      "action": "正常处理"
    },
    {
      "code": "20000",
      "meaning": "系统错误 / 服务打瞌睡了，请稍后再试（sub_code: isp.service-error:256）",
      "action": "服务打瞌睡了，请稍后再试",
      "sub_code": "isp.service-error:256",
      "sub_msg": "服务打瞌睡了，请稍后再试"
    },
    {
      "code": "50002",
      "meaning": "业务处理失败 / 无效用户（sub_code: isv.business-failed:4157）",
      "action": "无效用户",
      "sub_code": "isv.business-failed:4157",
      "sub_msg": "无效用户"
    }
  ],
  "examples": {
    "request": "curl -X GET 'https://openapi-fxg.jinritemai.com/buyin/institutionInfo?app_key=your_appkey_here&method=buyin.institutionInfo&access_token=your_accesstoken_here&param_json={}&timestamp=2018-06-19%2016:06:59&v=2&sign=your_sign_here'",
    "responseSuccess": {
      "data": {
        "colonel": {
          "buyin_id": "78794839403200001",
          "name": "这是团长名称"
        },
        "douke": {
          "buyin_id": "78794839403200003",
          "name": "这是抖客名称"
        },
        "institution_id": "38989329849343243",
        "mcn": {
          "buyin_id": "78794839403200002",
          "name": "这是机构名称"
        }
      },
      "code": 10000,
      "msg": "success",
      "sub_code": "",
      "sub_msg": ""
    },
    "responseError": {
