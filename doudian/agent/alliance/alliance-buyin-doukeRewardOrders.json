      "example": "20230308",
      "_depth": 0
    },
    {
      "name": "end_date",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "查询结束日期，格式：20230308，奖励订单只保存近30天的订单",
      "example": "20230308",
      "_depth": 0
    },
    {
      "name": "distribution_type",
      "in": "body",
      "type": "mixed",
      "required": false,
