      "example": "0",
      "_depth": 0
    },
    {
      "name": "product_info",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "商品信息（支持传商品id或者商品名称，传商品id精确匹配，传商品名称模糊匹配）",
      "example": "1237623814243",
      "_depth": 0
    },
    {
      "name": "sort_field",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "排序字段。0：默认（同百应）；1：更新时间",
      "example": "1",
      "_depth": 0
    },
    {
      "name": "sort_direction",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "排序方式。1：升序；2：倒序，sort_field为1时有效",
      "example": "1",
      "_depth": 0
    }
  ],
  "responseParams": [
