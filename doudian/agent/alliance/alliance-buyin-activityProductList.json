      "example": "1",
      "_depth": 0
    },
    {
      "name": "size",
      "in": "body",
      "type": "mixed",
      "required": true,
      "description": "每页条数（最大20）",
      "example": "20",
      "_depth": 0
    },
    {
      "name": "activity_id",
      "in": "body",
      "type": "mixed",
      "required": true,
      "description": "活动ID",
      "example": "54321",
      "_depth": 0
    },
    {
      "name": "applied_sub_status",
      "in": "body",
      "type": "mixed",
      "required": false,
