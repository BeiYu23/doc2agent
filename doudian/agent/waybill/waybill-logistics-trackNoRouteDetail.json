{
  "id": "doudian.waybill.logistics.trackNoRouteDetail",
  "platform": "doudian",
  "group": "waybill",
  "name": "logistics.trackNoRouteDetail",
  "description": "查询条件：\n1、必须是通过抖音电子面单获取的单号并且调用过发货接口回传的运单号才可以查询到物流轨迹；",
  "method": "GET",
  "path": "/logistics/trackNoRouteDetail",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 店铺"
  },
  "notes": [
    "文档书: 电子面单API（版本 V1.06）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "logistics_code",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "物流商编码；需使用【/order/logisticsCompanyList】接口响应参数中的code；",
      "example": "shentong",
      "_depth": 0
    },
    {
      "name": "track_no",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "运单号；可使用电子面单接口获取返回的单号查询【/logistics/newCreateOrder】或商家店铺后台查看",
      "example": "78393454",
      "_depth": 0
    }
  ],
  "responseParams": [
    {
      "name": "route__node_list",
      "type": "array",
      "description": "轨迹信息",
      "example": ""
    },
    {
      "name": "track_info",
      "type": "object",
      "description": "运单信息",
      "example": ""
    }
  ],
