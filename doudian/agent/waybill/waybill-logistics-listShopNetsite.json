{
  "id": "doudian.waybill.logistics.listShopNetsite",
  "platform": "doudian",
  "group": "waybill",
  "name": "logistics.listShopNetsite",
  "description": "本接口可以查询商家和物流商的订购关系以及物流单号使用情况",
  "method": "GET",
  "path": "/logistics/listShopNetsite",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 店铺"
  },
  "notes": [
    "文档书: 电子面单API（版本 V1.05）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "logistics_code",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "物流服务商编码（想获取全量物流，则传空字符串）",
      "example": "111",
      "_depth": 0
    }
  ],
  "responseParams": [
    {
      "name": "netsites",
      "type": "array",
      "description": "商家已开通的网点列表信息",
      "example": ""
    },
    {
      "name": "logistics_code",
      "type": "string",
      "description": "快递公司编码",
      "example": "zhongtong"
    },
    {
      "name": "company_type",
      "type": "string",
      "description": "物流服务商业务类型 1：直营  2：加盟 3：落地配 4：直营带网点",
      "example": "1"
    }
  ],
  "responseCodes": [
    {
      "code": "10000",
      "meaning": "success",
      "action": "正常处理"
    },
    {
      "code": "50002",
      "meaning": "业务处理失败 / 4006:店铺ID非法（sub_code: isv.business-failed:4006）",
      "action": "请检查您的店铺id是否正确",
      "sub_code": "isv.business-failed:4006",
      "sub_msg": "4006:店铺ID非法"
    }
  ],
  "examples": {
    "request": "curl -X GET 'https://openapi-fxg.jinritemai.com?app_key=your_appkey_here&method=&access_token=your_accesstoken_here&param_json={}&timestamp=2018-06-19%2016:06:59&v=2&sign=your_sign_here'",
    "responseSuccess": {
      "code": 10000,
      "msg": "success",
      "sub_code": "",
      "sub_msg": ""
    },
    "responseError": {
      "code": 50002,
      "msg": "业务处理失败",
      "sub_code": "isv.business-failed:4006",
      "sub_msg": "4006:店铺ID非法"
    }
  },
  "source": "https://op.jinritemai.com/docs/api-docs/1262/1843",
  "updatedAt": "2023-03-20",
  "_file_stem": "waybill-logistics-listShopNetsite"
}
