{
  "id": "doudian.phone-industry.maintenance.order.supplierUpdateServiceItem",
  "platform": "doudian",
  "group": "phone-industry",
  "name": "maintenance.order.supplierUpdateServiceItem",
  "description": "服务item信息更新，如果之前未回传过此item则视为新增",
  "method": "GET",
  "path": "YOUR_SECRET_KEY",
  "baseUrl": "https://openapi-fxg.jinritemai.com",
  "auth": {
    "type": "access_token+sign",
    "description": "调用网关需携带 app_key / access_token / timestamp / v / sign 等公共参数，sign 按 HMAC-SHA256 签名算法生成；权限主体: 见平台说明"
  },
  "notes": [
    "文档书: 手机行业管理（版本 V1.01）",
    "公共参数（method/app_key/access_token/param_YOUR_SECRET_KEY_method）见 doudian/agent/_common.json"
  ],
  "params": [
    {
      "name": "operation_time",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "操作时间，格式：\"yyyy-MM-dd HH:mm:ss\"，使用时间递增保证新状态覆盖老状态",
      "example": "2024-06-06 12:00:00",
      "_depth": 0
    },
    {
      "name": "item_service_item_update_info_map",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "每个item的使用详情，key为当前的item code",
      "example": "",
      "_depth": 0
    },
    {
      "name": "new_item_code",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "更新后的item code，无更新时不传",
      "example": "SN2",
      "_depth": 1
    },
    {
      "name": "service_usage_status",
      "in": "body",
      "type": "mixed",
      "required": false,
      "description": "更新后的服务状态，无更新时不传",
      "example": "1",
      "_depth": 1
    },
    {
      "name": "activated_period",
      "in": "body",
      "type": "string",
      "required": false,
      "description": "更新后的服务生效周期（起止时间），无更新时不传，变更为已激活状态时必传，格式：\"yyyy-MM-dd HH:mm:ss~yyyy-MM-dd HH:mm:ss\"",
      "example": "2024-06-06 12:00:00~2026-06-06 12:00:00",
      "_depth": 1
    },
    {
      "name": "order_id",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "服务店铺订单号",
      "example": "6930810465707234468",
      "_depth": 0
    },
    {
      "name": "service_entity_code",
      "in": "body",
      "type": "string",
      "required": true,
      "description": "服务实体编码",
      "example": "test",
      "_depth": 0
    },
    {
      "name": "service_shop_id",
      "in": "body",
      "type": "mixed",
      "required": true,
      "description": "服务店铺id",
      "example": "113243254",
      "_depth": 0
    }
  ],
  "responseParams": [],
  "responseCodes": [
    {
      "code": "10000",
      "meaning": "success",
      "action": "正常处理"
    },
    {
      "code": "40004",
      "meaning": "非法的参数 / 操作时间乱序错误（sub_code: isv.parameter-invalid:101011）",
      "action": "操作时间乱序错误",
      "sub_code": "isv.parameter-invalid:101011",
      "sub_msg": "操作时间乱序错误"
    },
    {
      "code": "50002",
      "meaning": "业务处理失败 / 501:未查询到相关单据，请修改服务订单id或者服务店铺id后重试（sub_code: isv.business-failed:501）",
      "action": "501:未查询到相关单据，请修改服务订单id或者服务店铺id后重试",
      "sub_code": "isv.business-failed:501",
      "sub_msg": "501:未查询到相关单据，请修改服务订单id或者服务店铺id后重试"
    }
  ],
